#!/bin/sh
# veron-trace -- walk a file in this image back toward stage 1, over
# recorded, hash-verified edges. DESIGN.md section 6, built at stage-5 scope.
#
#   veron-trace <path>              where did this file come from
#   veron-trace --forward <name>    what depends on this package
#   veron-trace --verify            every recorded edge must agree
#
# SHELL AND AWK, NOT PYTHON, BECAUSE THIS RUNS ON THE FLASHED MACHINE.
# python is build_only and is not in the image; busybox sh, awk and
# sha256sum are. The records are one fact per line (substages.tsv,
# packages.tsv, CHAIN -- written by tools/veron-trace-records at build
# time), so everything below is grep and awk, which is also the design's
# own requirement: a provenance format that needs a program to read is one
# nobody audits.
#
# WHAT --verify CHECKS, AND WHAT AN EDGE IS. A builder line (B) repeats,
# in the consumer's own record, the output hash the builder's record (S)
# published. Two independently written numbers that must agree is the
# falsifiable claim; --verify walks every one and fails on any mismatch.
# It also checks the seams: the tcc digest stage 4 says it received must
# equal the committed stage-3 record. A digest recorded as 'unknown' is
# ABSENCE, stated -- only two PRESENT records disagreeing is failure.
#
# THE STAGE-4 INTERIOR IS ONE COARSE EDGE AND IS PRINTED AS EXACTLY THAT.
# Stage 4 has seam records in and out but no per-substage records yet, so
# the walk crosses it in one step, labeled 'substage records pending'. A
# trace that quietly smoothed that over would assert something untrue in a
# format that looks authoritative.
#
# WHAT CANNOT BE CHECKED FROM IN HERE: the image-level digest. These
# records ride inside the image, so the image's own sha256 cannot (the
# IMAGE-SHA256 self-reference). Verifying the partition against the
# published digest is done from outside, which is where a checksum of a
# disk belongs.
set -u

RECORDS=${VERON_TRACE_RECORDS:-/usr/share/veron/trace}
ROOT=/
MODE=trace
TARGET=
HASH_FILES=no
DEPTH=short
STRAYS=no
INVENTORY=no
SNAPSHOT=no
BASELINE=/persist/veron-trace/baseline.tsv

while [ $# -gt 0 ]; do
    case "$1" in
        --records) RECORDS=$2; shift 2 ;;
        --root)    ROOT=$2; shift 2 ;;
        --verify)  MODE=verify; shift ;;
        --strays)  STRAYS=yes; shift ;;
        --inventory) INVENTORY=yes; shift ;;
        --snapshot)  SNAPSHOT=yes; INVENTORY=yes; STRAYS=yes; shift ;;
        --baseline)  BASELINE=$2; shift 2 ;;
        --forward) MODE=forward; TARGET=$2; shift 2 ;;
        --commands) MODE=commands; TARGET=$2; shift 2 ;;
        --kernel)   MODE=kernel; shift ;;
        --with-deps) DEPTH=deps; shift ;;
        --full)      DEPTH=full; shift ;;
        --hash-files) HASH_FILES=yes; shift ;;
        --help|-h)
            echo "usage: veron-trace [--records DIR] [--root DIR] <path>"
            echo "       veron-trace [--records DIR] --forward <package>"
            echo "       veron-trace [--records DIR] [--hash-files --root DIR] --verify"
            echo "         --strays: census every path; --inventory: name mutable files"
            exit 0 ;;
        *) TARGET=$1; shift ;;
    esac
done

SUB=$RECORDS/substages.tsv
PKG=$RECORDS/packages.tsv
CHAIN=$RECORDS/CHAIN
for f in "$SUB" "$PKG" "$CHAIN"; do
    [ -s "$f" ] || { echo "veron-trace: no records: $f missing or empty" >&2
                     echo "  (records live in $RECORDS; --records overrides)" >&2
                     exit 2; }
done

chain() { awk -v k="$1 $2" '$1" "$2 == k { print $NF; exit }' "$CHAIN"; }

# ---- what a clean boot writes into a home, and who writes it ------------
# THE HOME SKELETON IS EXPECTED AND ATTRIBUTABLE, and saying so is the
# difference between an audit and a count. On a fresh flash, four things
# appear in /home/veron before the person does anything: the shell history
# (busybox ash, via HISTFILE), fontconfig's per-user cache with its
# CACHEDIR.TAG, and the empty XDG share/state dirs the session exports
# paths into. Everything ELSE under a home is the person's own doing --
# downloads, configs, work -- and is labeled as exactly that, because
# "here is what you have done" is a different sentence from "here are
# twelve files". Patterns, not hashes: history and caches are content the
# MACHINE generates per use, so their bytes cannot be pinned by anyone --
# the honest record is who writes them, and the baseline (--snapshot) is
# what answers "has it changed since".
classify_observed() {
    case "$1" in
        *home/veron/.ash_history)          echo "expected on a clean boot: shell history (busybox ash)" ;;
        *home/veron/.cache/fontconfig/*)   echo "expected on a clean boot: fontconfig per-user cache" ;;
        *home/veron/.cache/*)              echo "runtime cache (regenerable)" ;;
        *home/veron/.local/state/*)        echo "expected location: session state (XDG_STATE_HOME)" ;;
        *home/veron/.local/share/*)        echo "expected location: session data (XDG data dir)" ;;
        *home/veron/*)                     echo "USER ACTIVITY -- yours, listed so you can see it" ;;
        *) echo "" ;;
    esac
}

# ---- the downward substage walk, shared by trace and forward ------------
# From an id, follow B lines down until a substage repeats its own hash as
# its builder (the self-assembly root). Prints one line per substage and
# notes each architecture change, because the cross is the fact worth the
# most and the easiest to lose.
walk_down() {
    awk -F'\t' -v start="$1" '
        $1 == "S" { root[$2] = $5; sha[$2] = $6; arch[$2] = $4 }
        $1 == "B" { bref[$2] = $3; bsha[$2] = $4 }
        END {
            id = start; prev = ""
            for (n = 0; n < 64; n++) {
                if (!(id in sha)) { printf "  %-24s NOT IN RECORDS\n", id; exit 1 }
                mark = ""
                if (prev != "" && arch[prev] != arch[id])
                    mark = sprintf("   <- crosses architectures (%s -> %s)", arch[id], arch[prev])
                printf "  %-24s sha256 %.16s...  [%s]%s\n", id, sha[id], arch[id], mark
                if (!(id in bref)) { print "  (no builder line -- record ends here)"; exit 1 }
                if (bref[id] == id) {
                    printf "  ROOT REACHED  %s assembles itself (root=%s)\n", id, root[id]
                    exit 0
                }
                prev = id; id = bref[id]
            }
        }' "$SUB"
}

# =========================================================================
if [ "$MODE" = verify ]; then
    fails=0; edges=0

    # (1) every B edge against the S record it names
    out=$(awk -F'\t' '
        $1 == "S" { sha[$2] = $6 }
        $1 == "B" { ref[NR] = $3; got[NR] = $4; own[NR] = $2 }
        END {
            e = 0; f = 0
            for (i in ref) {
                e++
                if (!(ref[i] in sha)) { printf "MISSING\t%s\t%s\n", own[i], ref[i]; f++ }
                else if (sha[ref[i]] != got[i]) { printf "MISMATCH\t%s\t%s\n", own[i], ref[i]; f++ }
            }
            printf "COUNTS\t%d\t%d\n", e, f
        }' "$SUB")
    edges=$(printf '%s\n' "$out" | awk -F'\t' '$1=="COUNTS"{print $2}')
    fails=$(printf '%s\n' "$out" | awk -F'\t' '$1=="COUNTS"{print $3}')
    printf '%s\n' "$out" | awk -F'\t' '$1=="MISSING"  {printf "  EDGE FAIL  %s names builder %s which has no record\n", $2, $3}
                                       $1=="MISMATCH" {printf "  EDGE FAIL  %s repeats a hash its builder %s did not publish\n", $2, $3}'

    # (2) the 4->3 seam: what stage 4 says it received vs the committed record
    reftcc=$(chain stage4 ref-tcc)
    tcc3=$(awk '$1=="stage3" && $2=="tcc-amd64" { print $4; exit }' "$CHAIN")
    if [ -n "$reftcc" ] && [ "$reftcc" != unknown ] && [ -n "$tcc3" ] && [ "$tcc3" != unknown ]; then
        edges=$((edges + 1))
        if [ "$reftcc" != "$tcc3" ]; then
            echo "  SEAM FAIL  stage 4's received tcc != committed stage-3 record"
            fails=$((fails + 1))
        fi
    else
        echo "  seam 4<-3: one side unrecorded -- stated, not counted"
    fi

    # (3) the 5->4 seam is present (its agreement was enforced at build time,
    # when the sysroot tarball was hashed against SYSROOT-SHA256 before use;
    # here the recorded value existing at all is what can still be asserted)
    s4=$(chain stage4 sysroot)
    [ -n "$s4" ] && [ "$s4" != unknown ] \
        && echo "  seam 5<-4: sysroot $s4" \
        || echo "  seam 5<-4: unrecorded on this image -- stated"

    # (4) conflicting file records: one path claimed twice with two hashes
    dup=$(awk -F'\t' '$1=="F" { if ($4 in h && h[$4] != $2) { print $4; bad=1 } h[$4]=$2 }
                      END { exit bad?1:0 }' "$PKG") || {
        echo "  RECORD FAIL  path recorded twice with different hashes:"
        printf '%s\n' "$dup" | sed 's/^/    /'
        fails=$((fails + 1))
    }
    edges=$((edges + 1))

    # (5) optionally, the live filesystem against the package records --
    # the deep, slow check a person runs when they suspect the disk.
    if [ "$HASH_FILES" = yes ]; then
        # A stripped image is the shipping case, so the stripped record wins
        # where it exists; packages.tsv is the expectation everywhere else.
        STRIPPED=$RECORDS/stripped.tsv
        [ -f "$STRIPPED" ] || STRIPPED=/dev/null
        n=0; bad=0
        while IFS="$(printf '\t')" read -r tag sha size path pkg; do
            [ "$tag" = F ] || continue
            f=$ROOT/$path
            [ -f "$f" ] || continue
            n=$((n + 1))
            want=$(awk -F'\t' -v p="$path" '$1=="F" && $4==p { print $2; exit }' "$STRIPPED")
            [ -n "$want" ] || want=$sha
            got=$(sha256sum "$f" | cut -d' ' -f1)
            if [ "$got" != "$want" ]; then
                echo "  FILE FAIL  $path (package $pkg) matches neither its record nor the strip overlay"
                bad=$((bad + 1))
            fi
        done < "$PKG"
        echo "  files re-hashed under $ROOT: $n checked, $bad mismatched"
        edges=$((edges + n)); fails=$((fails + bad))
        # SYMLINKS ARE VERIFIED AS SYMLINKS: the recorded fact about a link
        # is its target string, so readlink is the check -- hashing through
        # it would re-verify the target under the wrong name.
        ln=0; lbad=0
        while IFS="$(printf '\t')" read -r tag tgt path pkg; do
            [ "$tag" = L ] || continue
            f=$ROOT/$path
            [ -L "$f" ] || continue
            ln=$((ln + 1))
            got=$(readlink "$f")
            if [ "$got" != "$tgt" ]; then
                echo "  LINK FAIL  $path (package $pkg) points at $got, recorded $tgt"
                lbad=$((lbad + 1))
            fi
        done < "$PKG"
        echo "  symlinks re-read under $ROOT: $ln checked, $lbad mismatched"
        edges=$((edges + ln)); fails=$((fails + lbad))
    fi

    # (6) THE OTHER DIRECTION: a FULL CENSUS, not a filtered walk. The
    # package records prove the shipped files are intact; this proves the
    # rest of the disk is ACCOUNTED FOR. Every path on the root filesystem
    # lands in exactly one named category with a count and a stated reason
    # -- "excluded" is never "unmentioned":
    #   package files/symlinks -- the records above own these;
    #   build extras           -- extra.tsv, computed at image time;
    #   flash payload          -- modules/firmware/kernels, written by
    #                             tools/flash-amd64.sh from PINNED tarballs
    #                             (KERNEL-GENERIC-SHA256, firmware.toml);
    #                             pinned at the tarball, not yet per file,
    #                             and the census says that rather than
    #                             hiding it;
    #   mutable state          -- what the SYSTEM writes (home, var, the
    #                             runtime wifi/resolv files) -- named and
    #                             counted, not verifiable by a build record;
    #   STRAY                  -- everything else. Named individually, and
    #                             the only category that FAILS: a file the
    #                             build did not ship, the flash did not
    #                             install and the system did not write is
    #                             exactly /usr/bin/backdoor.
    # Other filesystems are censused BY MOUNT below rather than silently
    # skipped by -xdev: a clean boot should be able to say "/tmp: 0 files"
    # out loud.
    if [ "$STRAYS" = yes ]; then
        INVMODE=0; [ "$INVENTORY" = yes ] && INVMODE=1
        EXTRA=$RECORDS/extra.tsv
        [ -f "$EXTRA" ] || EXTRA=/dev/null
        # BOTH SPELLINGS OF THE MERGED /usr, because /lib IS A SYMLINK TO
        # usr/lib on this image and find walks the REAL paths: the first
        # on-device census filed all 7059 flash-time firmware and module
        # files as STRAYs for want of the usr/ prefix -- the same usr-merge
        # alias the single-file lookup already handles.
        CATS='usr/lib/modules/|flash payload: kernel modules (pinned tarball at flash)
lib/modules/|flash payload: kernel modules (pinned tarball at flash)
usr/lib/firmware/|flash payload: firmware tree (pinned tarball at flash)
lib/firmware/|flash payload: firmware tree (pinned tarball at flash)
boot/|flash payload: boot files
vmlinuz-generic|flash payload: generic kernel
Image|flash payload: minimal kernel
initramfs.cpio.gz|flash payload: initramfs
initramfs-fw.cpio.gz|flash payload: fallback initramfs
home/|mutable state: user data|inv
root/|mutable state: root user data|inv
var/|mutable state: system logs and spool|inv
srv/|mutable state
opt/|mutable state
mnt/|mutable state: mountpoints
media/|mutable state: mountpoints
tmp/|runtime scratch (on the root fs; expected empty on a clean boot)|inv
etc/wpa_supplicant.conf|runtime state: written by wpa-start|inv
etc/resolv.conf|runtime state: written by dhcp|inv
lost+found|filesystem structure'
        out=$( { awk -F'\t' '($1=="F"||$1=="Fb"){print $4} ($1=="L"||$1=="Lb"){print $3}' "$PKG"
                 echo "===RECORDS-END==="
                 find "$ROOT" -xdev \( -type f -o -type l \) 2>/dev/null
               } | awk -v root="$ROOT" -v extra="$EXTRA" -v cats="$CATS" -v invmode="$INVMODE" '
            BEGIN {
                while ((getline ln < extra) > 0) xt[ln] = 1
                nc = split(cats, C, "\n")
                for (i = 1; i <= nc; i++) {
                    split(C[i], kv, "|"); pref[i] = kv[1]; lab[i] = kv[2]
                    inv[i] = (kv[3] == "inv")
                }
                loading = 1
            }
            loading { if ($0 == "===RECORDS-END===") { loading = 0; next }
                      rec[$0] = 1; next }
            {
                rel = $0
                sub("^" root, "", rel); sub("^/*", "", rel)
                if (rel == "") next
                total++
                if (rel in rec)  { pkg++;    next }
                if (rel in xt)   { extras++; next }
                for (i = 1; i <= nc; i++)
                    if (index(rel, pref[i]) == 1) {
                        cnt[i]++
                        if (invmode && inv[i]) print "INV\t" rel "\t" lab[i]
                        next
                    }
                print "  STRAY  " rel " -- on the disk, in no record"
                stray++
            }
            END {
                printf "  census of the root filesystem: %d path(s), every one categorised:\n", total
                printf "    %6d  package files and symlinks (the records above)\n", pkg
                printf "    %6d  build extras (extra.tsv, recorded at image time)\n", extras
                for (i = 1; i <= nc; i++)
                    if (cnt[i] > 0) printf "    %6d  %s  [%s]\n", cnt[i], lab[i], pref[i]
                printf "    %6d  STRAY\n", stray + 0
                print "COUNT " stray + 0
            }')
        scount=$(printf '%s\n' "$out" | awk '$1=="COUNT"{print $2}')
        printf '%s\n' "$out" | grep -v '^COUNT' | grep -v '^INV'
        # THE INVENTORY: mutable and runtime files NAMED with observed size
        # and sha256, because "4 file(s)" should be four readable lines.
        # OBSERVED, NOT EXPECTED, and labeled so: user and runtime state
        # has no build record to compare against IN PRINCIPLE -- the build
        # cannot hash files that did not exist until the machine was used.
        # An expectation for these can only come from a baseline the
        # machine itself records; until that exists, this is the honest
        # maximum.
        OBS=$(mktemp 2>/dev/null || echo /tmp/veron-trace-obs.$$)
        : > "$OBS"
        if [ "$INVENTORY" = yes ]; then
            printf '%s\n' "$out" | awk -F'\t' '$1=="INV"' | \
            while IFS="$(printf '\t')" read -r tag rel lab; do
                f=$ROOT/$rel
                cls=$(classify_observed "$rel"); [ -n "$cls" ] && lab=$cls
                if [ -L "$f" ]; then
                    echo "    observed  $rel -> $(readlink "$f")   [$lab]"
                elif [ -f "$f" ]; then
                    sha=$(sha256sum "$f" | cut -d' ' -f1)
                    printf '%s\t%s\t%s\n' "$rel" "$sha" "$(wc -c < "$f" | tr -d ' ')" >> "$OBS"
                    echo "    observed  $rel  $(wc -c < "$f" | tr -d ' ') bytes  sha256 $(printf %.16s "$sha")...   [$lab]"
                fi
            done
        fi
        edges=$((edges + 1)); fails=$((fails + scount))

        # THE OTHER MOUNTS, EACH NAMED. -xdev keeps the walk above on the
        # root device; what it skipped is enumerated here from the mount
        # table so nothing is silently out of scope. Kernel-virtual
        # filesystems are stated as such rather than walked (their entries
        # are live kernel objects, not shipped files); real filesystems --
        # tmpfs scratch, /persist -- get a file count, which on a clean
        # boot is itself a meaningful number.
        MTAB=${VERON_TRACE_MOUNTS:-/proc/mounts}
        if [ -r "$MTAB" ]; then
            echo "  other filesystems (from $MTAB):"
            while read -r dev mp fstype rest; do
                [ "$mp" = / ] && continue
                # Mountpoints are counted where they LIVE ($mp, not under
                # --root): the mount table is a fact about the running
                # system, and this census only means something live.
                case "$fstype" in
                    proc|sysfs|devtmpfs|devpts|cgroup*|securityfs|debugfs|tracefs|bpf|mqueue|pstore|efivarfs|hugetlbfs|autofs|fusectl|configfs|binfmt_misc)
                        echo "    $mp  $fstype  kernel-virtual -- live kernel objects, not shipped files" ;;
                    *)
                        n=$(find "$mp" -xdev \( -type f -o -type l \) 2>/dev/null | wc -l)
                        echo "    $mp  $fstype  $n file(s)"
                        # The same rule for real filesystems the root walk
                        # cannot reach: every file named, sized, hashed as
                        # observed. /home/veron is a bind of
                        # /persist/home/veron and lands HERE, which is
                        # where "what ARE those 4 files" gets its answer.
                        if [ "$INVENTORY" = yes ] && [ "$n" -gt 0 ]; then
                            find "$mp" -xdev \( -type f -o -type l \) 2>/dev/null | while read -r f; do
                                rel=${f#/}
                                cls=$(classify_observed "$rel")
                                sfx=""; [ -n "$cls" ] && sfx="   [$cls]"
                                if [ -L "$f" ]; then
                                    echo "      observed  $rel -> $(readlink "$f")$sfx"
                                else
                                    sha=$(sha256sum "$f" | cut -d' ' -f1)
                                    printf '%s\t%s\t%s\n' "$rel" "$sha" "$(wc -c < "$f" | tr -d ' ')" >> "$OBS"
                                    echo "      observed  $rel  $(wc -c < "$f" | tr -d ' ') bytes  sha256 $(printf %.16s "$sha")...$sfx"
                                fi
                            done
                        fi ;;
                esac
            done < "$MTAB"
        else
            echo "  no mount table readable at $MTAB -- other filesystems not censused"
        fi

        # THE BASELINE: expectations for mutable state can only come from a
        # record the machine itself takes -- the build cannot hash a shell
        # history that does not exist yet. --snapshot writes the observed
        # set (path, sha, size) to /persist so it survives reboots; later
        # runs diff against it and REPORT: new since the baseline, changed
        # since it, gone since it. Reported, never failed: a download in a
        # home directory is the owner using their machine, and the point is
        # that they can SEE it -- an intrusion verdict about user data is
        # not this tool's to make.
        # THE TOOL'S OWN ARTIFACTS ARE NOT EVIDENCE: the baseline file and
        # the in-flight observation list would otherwise diff against
        # themselves forever (baseline NEW on the first audit after every
        # snapshot). Filtered by path, stated here rather than discovered.
        obs_filtered() { awk -F'\t' -v a="${BASELINE#/}" -v b="${OBS#/}" \
                             '$1 != a && $1 != b' "$OBS" | sort; }
        if [ "$SNAPSHOT" = yes ]; then
            mkdir -p "$(dirname "$BASELINE")" 2>/dev/null || true
            if obs_filtered > "$BASELINE" 2>/dev/null; then
                echo "  baseline written: $BASELINE ($(wc -l < "$BASELINE" | tr -d ' ') mutable file(s) recorded)"
            else
                echo "  baseline NOT written: cannot write $BASELINE (--baseline overrides the path)"
            fi
        elif [ -s "$BASELINE" ] && [ "$INVENTORY" = yes ]; then
            echo "  against the baseline $BASELINE:"
            obs_filtered | awk -F'\t' -v bl="$BASELINE" '
                BEGIN { while ((getline ln < bl) > 0) {
                            split(ln, b, "\t"); base[b[1]] = b[2] } }
                { now[$1] = 1
                  if (!($1 in base))          { print "    NEW      " $1; d++ }
                  else if (base[$1] != $2)    { print "    CHANGED  " $1; d++ } }
                END { for (p in base) if (!(p in now)) { print "    GONE     " p; d++ }
                      if (!d) print "    unchanged since the baseline" }'
        fi
        rm -f "$OBS"
    fi

    if [ "$fails" -eq 0 ]; then
        echo "VERON-TRACE-OK  $edges edge(s), every one agreed"
        exit 0
    fi
    echo "VERON-TRACE-FAIL  $fails of $edges edge(s) disagreed"
    exit 1
fi

# =========================================================================
if [ "$MODE" = kernel ]; then
    # WHAT IS RUNNING, AND IS IT WHAT WAS SHIPPED. The running kernel's
    # bytes cannot be re-hashed from userspace, so this is the honest
    # chain of custody, stated as such: uname names what booted, the disk
    # files are hashed against their CHAIN pins, and the link between the
    # two is grub having loaded those files -- as strong as the platform
    # allows without Secure Boot, and not stronger.
    echo "running: $(uname -sr 2>/dev/null || echo unknown)  ($(uname -v 2>/dev/null || true))"
    case "$(uname -r 2>/dev/null)" in
        *generic*) echo "  -> the GENERIC kernel (grub entry: Veron)" ;;
        *)         echo "  -> the MINIMAL kernel, or not a Veron kernel" ;;
    esac
    echo ""
    rc=0
    for pair in "Image stage4 kernel" "vmlinuz-generic generic vmlinuz-generic"; do
        f=${pair%% *}; key=${pair#* }
        want=$(chain $key)
        if [ ! -f "$ROOT/$f" ]; then echo "  /$f: not present under $ROOT"; continue; fi
        if [ -z "$want" ] || [ "$want" = unknown ]; then
            echo "  /$f: on disk, no pin in CHAIN (records predate the boot-chain shipping)"
            rc=1; continue
        fi
        got=$(sha256sum "$ROOT/$f" | cut -d' ' -f1)
        if [ "$got" = "$want" ]; then
            echo "  /$f: matches its record ($(printf %.16s "$want")...)"
        else
            echo "  /$f: DOES NOT MATCH its record"; rc=1
        fi
    done
    exit $rc
fi

# =========================================================================
if [ "$MODE" = commands ]; then
    # HOW A FILE WAS COMPILED, IN THE WORDS THAT COMPILED IT. commands.tsv
    # carries the PLAN's literal argv per step -- copied verbatim at build
    # time, kept true by the plan --check gate -- so this prints the exact
    # commands, cwd and env of every step, offline. Three depths:
    #   (default)    this package alone
    #   --with-deps  the package and its transitive dependency closure, in
    #                BUILD ORDER (commands.tsv preserves the PLAN's order,
    #                which is the topological order the build ran in), then
    #                the boundary: every argv above executed under the
    #                stage-4 sysroot's toolchain -- the leaves were compiled
    #                by gcc 15.2.0 from that sysroot, which is where stage
    #                5's own records end and the seam records take over.
    #   --full       the closure, then the chain below it: the stage-4
    #                interior as the coarse edge it is (its commands are the
    #                committed bridge scripts at this image's commit, named
    #                rather than reproduced -- per-substage records pending),
    #                then stages 3..1, whose substage records are walked
    #                with their hashes and whose commands are the committed
    #                stage scripts. Pointers with digests below stage 5,
    #                verbatim argv within it: exactly as much as is
    #                recorded, and no smoother.
    CMDS=$RECORDS/commands.tsv
    [ -s "$CMDS" ] || { echo "veron-trace: no commands.tsv in $RECORDS" >&2
                        echo "  (records predate the command shipping)" >&2; exit 2; }
    [ -n "$TARGET" ] || { echo "veron-trace: --commands needs a package or path" >&2; exit 2; }
    PKGN=$TARGET
    if ! awk -F'	' -v p="$PKGN" '$1=="P" && $2==p { found=1; exit } END { exit !found }' "$PKG"; then
        REL=${TARGET#/}
        line=$(awk -F'	' -v p="$REL" '($1=="F" && $4==p) || ($1=="L" && $3==p) { print; exit }' "$PKG")
        [ -n "$line" ] || { case "$REL" in usr/*) ;; *) REL=usr/$REL
            line=$(awk -F'	' -v p="$REL" '($1=="F" && $4==p) || ($1=="L" && $3==p) { print; exit }' "$PKG") ;; esac; }
        [ -n "$line" ] || { echo "veron-trace: $TARGET is neither a package nor a recorded path" >&2; exit 1; }
        [ "$(printf '%s' "$line" | cut -f1)" = L ]             && PKGN=$(printf '%s' "$line" | cut -f4)             || PKGN=$(printf '%s' "$line" | cut -f5)
        echo "$TARGET is installed by package $PKGN"
        echo ""
    fi

    print_pkg() {
        awk -F'\t' -v p="$1" '
            $1=="P" && $2==p { printf "== %s %s ==\n", $2, $3
                               printf "   source sha256 %s   recipe-sha %s\n", $4, $5 }' "$PKG"
        awk -F'\t' -v p="$1" '
            $2 != p { next }
            $1=="U" { printf "   source %s\n", $3 }
            $1=="S" { printf "   [%s] %-14s cwd %s\n", $3, $4, $5 }
            $1=="E" { printf "        env  %s\n", $4 }
            $1=="V" { printf "        %s\n", $4 }' "$CMDS"
        echo ""
    }

    case "$DEPTH" in
    short)
        print_pkg "$PKGN"
        ;;
    deps|full)
        CLOSURE=$(awk -F'	' -v t="$PKGN" '
            $1=="D" { dep[$2] = dep[$2] " " $3 }
            END {
                q[1] = t; head = 1; tail = 1; seen[t] = 1
                while (head <= tail) {
                    split(dep[q[head++]], ds, " ")
                    for (i in ds) if (ds[i] != "" && !(ds[i] in seen)) {
                        seen[ds[i]] = 1; q[++tail] = ds[i] }
                }
                for (p in seen) print p
            }' "$PKG")
        n=$(printf '%s
' "$CLOSURE" | wc -l | tr -d ' ')
        echo "$PKGN and its $((n - 1)) transitive dependencies, in the build order that ran:"
        echo ""
        # commands.tsv preserves PLAN order == build order; walk it and
        # print members of the closure as they appear.
        for p in $(awk -F'	' '$1=="U" { print $2 }' "$CMDS"); do
            printf '%s
' "$CLOSURE" | grep -qx "$p" && print_pkg "$p"
        done
        echo "-- the boundary --"
        echo "Every argv above executed against the stage-4 sysroot: its gcc"
        echo "15.2.0 is the cc/c++ those steps resolved, its headers and"
        echo "libraries are what they compiled and linked against. The leaf"
        echo "dependencies have no stage-5 dependencies precisely because the"
        echo "sysroot IS their dependency. That sysroot, digest-checked before"
        echo "any of the above ran:"
        s4=$(chain stage4 sysroot); echo "    sysroot  ${s4:-unknown}   [4/latest-x86_64]"
        if [ "$DEPTH" = full ]; then
            echo ""
            echo "-- below the boundary, to stage 1 --"
            echo "The stage-4 interior is one coarse edge: its commands are the"
            echo "committed bridge scripts under spikes/stage4/bridge/ at this"
            echo "image's commit ($(chain stage5 commit)), building"
            echo "  tcc-amd64 -> gcc 4.7.4 -> gcc 10.2.0 -> gcc 15.2.0 -> the sysroot"
            echo "in a box holding busybox and tcc and nothing else. Per-substage"
            echo "records for that interior are pending, and this line will keep"
            echo "saying so until they exist."
            reftcc=$(chain stage4 ref-tcc)
            [ -n "$reftcc" ] && [ "$reftcc" != unknown ]                 && echo "  the tcc stage 4 received:  $reftcc  (verified against the committed stage-3 record)"
            echo ""
            echo "Stages 3..1, hash-verified per substage; their commands are the"
            echo "committed stage scripts (stages/3-micro-c/, stages/2-pico-c/,"
            echo "stages/1-self-assembly/) at the same commit:"
            top=$(awk '$1=="stage3" && $2=="tcc-amd64" { print $3; exit }' "$CHAIN")
            walk_down "${top:-3/6/tcc-amd64}"
        fi
        ;;
    esac
    exit 0
fi

# =========================================================================
if [ "$MODE" = forward ]; then
    [ -n "$TARGET" ] || { echo "veron-trace: --forward needs a package name" >&2; exit 2; }
    # The post-CVE question: what is downstream of this package. The reverse
    # dependency closure over D lines, then the file count of the closure.
    awk -F'\t' -v t="$TARGET" '
        $1 == "D" { rdep[$3] = rdep[$3] " " $2 }
        $1 == "P" { pkg[$2] = 1 }
        $1 == "F" { nf[$5]++ }
        END {
            if (!(t in pkg)) { printf "%s: no package record\n", t; exit 1 }
            queue[1] = t; head = 1; tail = 1; seen[t] = 1
            while (head <= tail) {
                cur = queue[head++]
                split(rdep[cur], deps, " ")
                for (i in deps) if (deps[i] != "" && !(deps[i] in seen)) {
                    seen[deps[i]] = 1; queue[++tail] = deps[i]
                }
            }
            files = 0
            for (p in seen) files += nf[p]
            printf "%d package(s) depend on %s (transitively), %d recorded file(s) descend from it:\n", tail - 1, t, files
            for (i = 2; i <= tail; i++) printf "  %s\n", queue[i]
        }' "$PKG"
    exit $?
fi

# ========================================================================= 
# trace <path>
[ -n "$TARGET" ] || { echo "veron-trace: nothing to trace (try --help)" >&2; exit 2; }
REL=${TARGET#/}

# THE BOOT ARTIFACTS: no package installs them, but CHAIN carries their
# pins (folded in at build time from stage-4's PROVENANCE, the 4/kernel
# release and the built initramfs), so they trace like anything else: by
# hash, offline. initramfs-fw.cpio.gz is the stated exception -- it is
# assembled AT FLASH TIME from firmware blobs, so no pre-flash record of
# it can exist, and this says that instead of "unrecorded".
boot_key=""; boot_desc=""
case "$REL" in
    Image)             boot_key="stage4 kernel"
                       boot_desc="the minimal kernel, built by stage 4 beside the sysroot it ships with" ;;
    vmlinuz-generic)   boot_key="generic vmlinuz-generic"
                       boot_desc="the generic kernel, published by 4-generic-kernel-amd64, pinned by KERNEL-GENERIC-SHA256, installed by the flash" ;;
    config-generic)    boot_key="generic config-generic"
                       boot_desc="the generic kernel's build config, published beside it" ;;
    initramfs.cpio.gz) boot_key="stage5 initrd"
                       boot_desc="the stage-5 initramfs, built by guest/mkinitramfs.py in the publishing run" ;;
    initramfs-fw.cpio.gz)
        echo "$TARGET: assembled at flash time from the initramfs plus the"
        echo "  pinned firmware tarballs (sources/firmware.toml); the assembly"
        echo "  itself happens on the flashing machine, so no build-time"
        echo "  record of the combined file can exist. Its INPUTS are pinned;"
        echo "  trace those instead: /initramfs.cpio.gz and the firmware pins."
        exit 0 ;;
esac
if [ -n "$boot_key" ]; then
    want=$(chain $boot_key)
    if [ -z "$want" ] || [ "$want" = unknown ]; then
        echo "$TARGET: $boot_desc"
        echo "  no pin in CHAIN -- these records predate the boot-chain shipping"
        exit 1
    fi
    state="not checked (no such file under $ROOT)"; MISMATCH=0
    if [ -f "$ROOT/$REL" ]; then
        got=$(sha256sum "$ROOT/$REL" | cut -d' ' -f1)
        if [ "$got" = "$want" ]; then state="matches the bytes on disk"
        else state="DOES NOT MATCH the bytes on disk"; MISMATCH=1; fi
    fi
    printf '%s   sha256 %.16s...   [%s]\n' "$REL" "$want" "$state"
    echo ""
    echo "  $boot_desc"
    echo ""
    echo "  built with  the stage-4 toolchain"
    s4=$(chain stage4 sysroot)
    echo "    sysroot   ${s4:-unknown}   [4/latest-x86_64, digest-checked before use]"
    echo "    interior  substage records pending -- one coarse edge"
    echo ""
    top=$(awk '$1=="stage3" && $2=="tcc-amd64" { print $3; exit }' "$CHAIN")
    walk_down "${top:-3/6/tcc-amd64}"
    rc=$?
    [ "$MISMATCH" -eq 0 ] || exit 1
    exit $rc
fi

# F lines carry the path in field 4 (F sha size path pkg); L lines in
# field 3 (L target path pkg). One predicate per shape, or a file is
# reported unrecorded because its SIZE failed to equal its PATH.
lookup() { awk -F'\t' -v p="$1" \
    '($1=="F" && $4==p) || ($1=="L" && $3==p) { print; exit }' "$PKG"; }
line=$(lookup "$REL")
if [ -z "$line" ]; then
    # /usr-merge shapes: /bin is a symlink into usr/bin on this image, so a
    # path typed the short way is retried the long way before giving up.
    case "$REL" in usr/*) ;; *) REL=usr/$REL; line=$(lookup "$REL") ;;
    esac
fi
if [ -z "$line" ]; then
    # A path only a BOOTSTRAP staged: the record is real, the bytes in the
    # image are not its -- the shipping package overwrote them. Say which
    # cycle rather than "unrecorded", and keep walking under the OWNER.
    staged=$(awk -F'\t' -v p="$REL" \
        '($1=="Fb" && $4==p) || ($1=="Lb" && $3==p) { print ($1=="Fb" ? $5 : $4); exit }' "$PKG")
    if [ -n "$staged" ]; then
        echo "$TARGET: staged by $staged (build-only) and overwritten before"
        echo "  the image was made -- no shipping package records this exact"
        echo "  path, which is a record gap worth reporting, not a trace."
        exit 1
    fi
fi
[ -n "$line" ] || {
    echo "$TARGET: not in any package record."
    echo "  Files the workflow writes directly (/etc/veron-release) and"
    echo "  files created at runtime have no package; everything a recipe"
    echo "  installed does. The image-wide list is files.tsv, published"
    echo "  beside the image."
    exit 1
}

tag=$(printf '%s' "$line" | cut -f1)
if [ "$tag" = L ]; then
    tgt=$(printf '%s' "$line" | cut -f2)
    pkgname=$(printf '%s' "$line" | cut -f4)
    printf '%s   symlink -> %s   [package %s]\n' "$REL" "$tgt" "$pkgname"
else
    sha=$(printf '%s' "$line" | cut -f2)
    size=$(printf '%s' "$line" | cut -f3)
    pkgname=$(printf '%s' "$line" | cut -f5)
    # THE IMAGE IS STRIPPED AFTER PACKAGING, so the bytes on disk are
    # allowed to differ from the DESTDIR record in exactly one recorded
    # way: stripped.tsv, written at build time from the post-strip tree.
    # It is consulted first; a file matching neither record is a genuine
    # mismatch. (The FULL image ships unstripped and matches packages.tsv
    # directly -- there stripped.tsv simply never matches, which is fine.)
    ssha=$(awk -F'\t' -v p="$REL" '$1=="F" && $4==p { print $2; exit }' \
           "$RECORDS/stripped.tsv" 2>/dev/null || true)
    state="not checked (no such file under $ROOT)"
    MISMATCH=0
    if [ -f "$ROOT/$REL" ]; then
        got=$(sha256sum "$ROOT/$REL" | cut -d' ' -f1)
        if [ -n "$ssha" ] && [ "$got" = "$ssha" ]; then
            state="matches the bytes on disk (stripped at build; pre-strip record above)"
        elif [ "$got" = "$sha" ]; then
            state="matches the bytes on disk"
        else
            state="DOES NOT MATCH the bytes on disk"; MISMATCH=1
        fi
    fi
    printf '%s   sha256 %.16s...  %s bytes   [%s]\n' "$REL" "$sha" "$size" "$state"
fi

awk -F'\t' -v p="$pkgname" '
    $1 == "P" && $2 == p {
        ship = (NF >= 7 && $7 == "build-only") ? "   (build-only: staged, never ships)" : ""
        printf "\n  built by  %s %s   [stage 5]%s\n", $2, $3, ship
        printf "    source  sha256 %.16s...\n", $4
        printf "    recipe  recipe-sha %.16s...\n", $5
        printf "    license %s\n", $6
    }
    $1 == "D" && $2 == p { deps = deps " " $3 }
    END { if (deps != "") printf "    deps   %s\n", deps }' "$PKG"

echo ""
echo "  built with  the stage-4 toolchain"
s4=$(chain stage4 sysroot); k4=$(chain stage4 kernel)
echo "    sysroot   ${s4:-unknown}   [4/latest-x86_64, digest-checked before use]"
echo "    kernel    ${k4:-unknown}"
echo "    interior  substage records pending -- one coarse edge"
echo "              (gcc 15.2.0 <- gcc 10.2.0 <- gcc 4.7.4 <- tcc-amd64;"
echo "               the received tcc digest is in stage4-PROVENANCE)"
echo ""

top=$(awk '$1=="stage3" && $2=="tcc-amd64" { print $3; exit }' "$CHAIN")
walk_down "${top:-3/6/tcc-amd64}"
rc=$?
# THE EXIT CODE IS USABLE, NOT DECORATION: a traced file whose bytes do not
# match its record is a finding, and a script calling this must be able to
# see it without parsing prose.
[ "${MISMATCH:-0}" -eq 0 ] || exit 1
exit $rc
