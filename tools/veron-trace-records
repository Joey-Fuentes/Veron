#!/usr/bin/env python3
"""veron-trace-records -- assemble the flat record set veron-trace walks.

BUILD-SIDE ONLY, AND THAT IS THE POINT OF ITS EXISTENCE AS A SEPARATE
PROGRAM. The image ships no Python, so the on-device tracer is shell + awk
reading one-fact-per-line TSVs (DESIGN.md section 6: "records must be
readable without the tool"). The nested inputs -- substages*.toml,
ledger/*.json, the seam PROVENANCE files -- are flattened HERE, once, by the
build, so the device never needs a parser.

WHAT IT WRITES into --out:

  substages.tsv   stages 1-3, flattened. Tab-separated, first field a tag:
                    S <id> <stage> <arch> <root> <output-sha256> <bytes>
                    B <id> <builder-ref> <builder-sha256>
                    I <id> <role> <sha256> <name>
                  The B line is the falsifiable edge: its sha256 must equal
                  the S line of the ref'd id, independently written by the
                  stage that produced it. veron-trace --verify checks every
                  one.

  packages.tsv    stage 5, flattened from ledger/*.json:
                    P <name> <version> <source-sha256> <recipe-sha256> <license>
                    F <sha256> <size> <path> <package>
                    L <target> <path> <package>
                    D <package> <dep>

  CHAIN           the seam facts, one per line: what stage 5 consumed from
                  4/latest-x86_64 (sysroot, kernel, the digest of stage 4's
                  own PROVENANCE), the tcc digest stage 4 received, and the
                  committed stage-3 record it must agree with. The stage-5
                  IMAGE digest is deliberately absent: these records ride
                  inside that image, so the digest cannot (the IMAGE-SHA256
                  self-reference, again).

  stage4-PROVENANCE   the consumed stage-4 record, verbatim, because the
                  coarse stage-4 interior edge is described there and hiding
                  the primary text behind a summary would be backwards.

Missing seam inputs (no dl-sysroot on a local run) write 'unknown' rather
than failing: absence of a record is stated; only DISAGREEMENT between two
present records is an error, and that judgement belongs to --verify.
"""
import argparse
import glob
import json
import os
import shutil
import sys
import tomllib


def flatten_substages(repo, out):
    tomls = sorted(glob.glob(os.path.join(repo, "stages", "*", "substages*.toml")))
    lines = []
    for t in tomls:
        with open(t, "rb") as f:
            doc = tomllib.load(f)
        for s in doc.get("substage", []):
            sid = s["id"]
            outs = s.get("output", [])
            osha = outs[0]["sha256"] if outs else "-"
            obytes = str(outs[0].get("bytes", "-")) if outs else "-"
            lines.append("\t".join(["S", sid, str(s.get("stage", "-")),
                                    s.get("arch", "-"), s.get("root", "-"),
                                    osha, obytes]))
            for i in s.get("input", []):
                role = i.get("role", "-")
                if role == "builder":
                    lines.append("\t".join(["B", sid, i.get("ref", "-"),
                                            i.get("sha256", "-")]))
                else:
                    name = i.get("path") or i.get("name") or "-"
                    lines.append("\t".join(["I", sid, role,
                                            i.get("sha256", "-"), name]))
    with open(os.path.join(out, "substages.tsv"), "w") as f:
        f.write("\n".join(lines) + "\n")
    return len(lines)


def flatten_ledger(ledger, out, build_only):
    """build_only: package names whose DESTDIR is staged for a bootstrap
    cycle and OVERWRITTEN before the image exists (recipe build_only=true --
    freetype-bootstrap under harfbuzz is the case that found this). Their
    ledger records are true records of a build that happened, so they are
    kept -- but their file lines are tagged Fb/Lb rather than F/L, because
    the paths they name are owned by the shipping package in the image, and
    a duplicate-path check that reads a declared bootstrap as a conflict
    fails a correct build (run 86917062743, five freetype paths)."""
    lines = []
    for j in sorted(glob.glob(os.path.join(ledger, "*.json"))):
        with open(j) as f:
            rec = json.load(f)
        name = rec["name"]
        staged_only = name in build_only
        ftag, ltag = ("Fb", "Lb") if staged_only else ("F", "L")
        prov = rec.get("provenance", {})
        inputs = rec.get("inputs", {})
        lines.append("\t".join(["P", name, str(rec.get("version", "-")),
                                str(prov.get("sha256", "-")),
                                str(inputs.get("recipe_sha256", "-")),
                                str(rec.get("license", "-")),
                                "build-only" if staged_only else "ships"]))
        deps = inputs.get("deps", {})
        seen = set()
        for kind in ("runtime", "link", "build"):
            for d in deps.get(kind, []):
                if d not in seen:
                    seen.add(d)
                    lines.append("\t".join(["D", name, d]))
        for fe in rec.get("files", []):
            path = fe.get("path", "-")
            kind = fe.get("kind")
            # THE KINDS ARE file_manifest's WORDS, READ FROM ITS SOURCE THIS
            # TIME: "file", "symlink", "unreadable". The first version
            # matched "l" -- a schema assumed rather than read -- so every
            # symlink flattened as an F line whose hash field held the LINK
            # TARGET STRING, and the first on-device deep verify failed 484
            # paths that were never wrong (every conf.d and .so symlink on
            # the machine). Same defect class as the F-field-order bug: a
            # reader written from memory of a producer. Both spellings are
            # accepted so a future short-form producer does not regress this.
            if kind in ("symlink", "l"):
                lines.append("\t".join([ltag, str(fe.get("value", "-")),
                                        path, name]))
            elif kind == "unreadable":
                # A path the ledger could not hash is a stated gap, not a
                # checkable fact -- emitting it as F would fail verify on
                # a record that never claimed a digest.
                continue
            else:
                lines.append("\t".join([ftag, str(fe.get("value", "-")),
                                        str(fe.get("size", "-")), path, name]))
    with open(os.path.join(out, "packages.tsv"), "w") as f:
        f.write("\n".join(lines) + "\n")
    return len(lines)


def seam_value(path, key):
    """First 'key <value>' line of a PROVENANCE-shaped file, or None."""
    try:
        with open(path) as f:
            for ln in f:
                parts = ln.split()
                if len(parts) >= 2 and parts[0] == key:
                    return parts[1]
    except OSError:
        pass
    return None


def sha256_of(path):
    import hashlib
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return None


def committed_tcc(repo):
    t = os.path.join(repo, "stages", "3-micro-c", "substages-amd64.toml")
    try:
        with open(t, "rb") as f:
            doc = tomllib.load(f)
        for s in doc.get("substage", []):
            if s["id"] == "3/6/tcc-amd64":
                return s["output"][0]["sha256"]
    except (OSError, KeyError, IndexError):
        pass
    return None


def strip_overlay(root, records):
    """POST-STRIP TRUTH, WRITTEN WHERE THE TRACER LOOKS. The image is
    stripped AFTER the records are installed into it, so packages.tsv
    describes pre-strip DESTDIR bytes and every stripped ELF on the flashed
    machine reads DOES NOT MATCH (measured: /usr/bin/foot, first flash with
    the tracer aboard). This re-hashes every recorded path against the
    post-strip tree and records the ones that CHANGED into stripped.tsv --
    same F shape, and the tracer consults it first. NO SELF-REFERENCE:
    stripped.tsv is not itself in packages.tsv (the workflow installs it,
    no recipe does), and writing it changes no other file's bytes. The
    FULL image is built before the strip and so matches packages.tsv
    directly -- each image agrees with the records it carries."""
    pkgs = os.path.join(records, "packages.tsv")
    changed = []
    checked = 0
    with open(pkgs) as f:
        for ln in f:
            parts = ln.rstrip("\n").split("\t")
            if not parts or parts[0] != "F":
                continue
            _, sha, _size, path = parts[0], parts[1], parts[2], parts[3]
            fp = os.path.join(root, path)
            if not os.path.isfile(fp) or os.path.islink(fp):
                continue
            checked += 1
            got = sha256_of(fp)
            if got and got != sha:
                changed.append("F\t%s\t%d\t%s" % (got, os.path.getsize(fp), path))
    with open(os.path.join(records, "stripped.tsv"), "w") as f:
        f.write("\n".join(changed) + ("\n" if changed else ""))
    print("veron-trace-records: strip overlay -- %d path(s) checked, "
          "%d changed by the strip" % (checked, len(changed)))


def extras(root, records):
    """EVERYTHING THE IMAGE SHIPS THAT NO PACKAGE INSTALLED, written down.
    The package records answer "are the shipped files intact"; a strays walk
    needs the other list -- what ELSE the build deliberately put in the tree
    (veron-release, this tracer, these records, the test fixtures) -- or
    every one of those reads as an intruder. COMPUTED, NOT MAINTAINED: the
    tree is walked and every path absent from packages.tsv is recorded, so
    a new workflow-installed file can never silently join the allowlist of
    someone's memory. extra.tsv names itself before writing itself -- the
    one self-reference that is safe, because the fact recorded is the PATH,
    not the bytes."""
    pkgs = os.path.join(records, "packages.tsv")
    recorded = set()
    with open(pkgs) as f:
        for ln in f:
            p = ln.rstrip("\n").split("\t")
            if not p:
                continue
            if p[0] in ("F", "Fb") and len(p) >= 4:
                recorded.add(p[3])
            elif p[0] in ("L", "Lb") and len(p) >= 3:
                recorded.add(p[2])
    extra = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for fn in sorted(filenames):
            full = os.path.join(dirpath, fn)
            rel = os.path.relpath(full, root)
            if rel not in recorded:
                extra.append(rel)
    out = os.path.join(records, "extra.tsv")
    rel_out = os.path.relpath(out, root)
    if rel_out not in extra:
        extra.append(rel_out)
    with open(out, "w") as f:
        f.write("\n".join(sorted(extra)) + ("\n" if extra else ""))
    print("veron-trace-records: extras -- %d path(s) the build added beyond "
          "the packages" % len(extra))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--strip-overlay", metavar="ROOT", default=None,
                    help="post-strip mode: re-hash every recorded path under "
                         "ROOT and write stripped.tsv into --records")
    ap.add_argument("--extras", metavar="ROOT", default=None,
                    help="walk ROOT and record every path no package "
                         "installed into extra.tsv in --records")
    ap.add_argument("--records", default=None,
                    help="records dir (with --strip-overlay)")
    ap.add_argument("--repo", help="repository root")
    ap.add_argument("--ledger", help="stage-5 ledger dir")
    ap.add_argument("--stage4-dir", default=None,
                    help="dir holding the consumed 4/latest-x86_64 download "
                         "(SYSROOT-SHA256, PROVENANCE); optional")
    ap.add_argument("--commit", default=os.environ.get("GITHUB_SHA", "unknown"))
    ap.add_argument("--run", default=os.environ.get("GITHUB_RUN_ID", "unknown"))
    ap.add_argument("--build-only", default="",
                    help="space-separated package names that are staged but "
                         "never installed (from `veron build-only-names`); "
                         "their file lines are tagged staged-not-shipped")
    ap.add_argument("--out")
    ap.set_defaults()
    a = ap.parse_args()

    if a.strip_overlay or a.extras:
        if not a.records:
            ap.error("--strip-overlay/--extras require --records")
        if a.strip_overlay:
            strip_overlay(a.strip_overlay, a.records)
        if a.extras:
            extras(a.extras, a.records)
        return 0
    if not (a.repo and a.ledger and a.out):
        ap.error("--repo, --ledger and --out are required (or use --strip-overlay)")

    os.makedirs(a.out, exist_ok=True)
    ns = flatten_substages(a.repo, a.out)
    np_ = flatten_ledger(a.ledger, a.out, set(a.build_only.split()))

    sysroot_sha = kernel_sha = prov_sha = reftcc = "unknown"
    if a.stage4_dir:
        s4p = os.path.join(a.stage4_dir, "PROVENANCE")
        s4s = os.path.join(a.stage4_dir, "SYSROOT-SHA256")
        try:
            with open(s4s) as f:
                sysroot_sha = f.read().split()[0]
        except (OSError, IndexError):
            pass
        kernel_sha = seam_value(s4p, "kernel") or "unknown"
        # ref-tcc rides inside stage 4's PROVENANCE (the embedded in/4
        # record). Older releases predate the line; 'unknown' is the honest
        # value and --verify treats it as absent rather than as wrong.
        reftcc = seam_value(s4p, "ref-tcc") or "unknown"
        prov_sha = sha256_of(s4p) or "unknown"
        if os.path.exists(s4p):
            shutil.copy(s4p, os.path.join(a.out, "stage4-PROVENANCE"))

    tcc3 = committed_tcc(a.repo) or "unknown"
    with open(os.path.join(a.out, "CHAIN"), "w") as f:
        f.write("stage5 commit %s\n" % a.commit)
        f.write("stage5 run %s\n" % a.run)
        f.write("stage4 sysroot %s\n" % sysroot_sha)
        f.write("stage4 kernel %s\n" % kernel_sha)
        f.write("stage4 provenance %s\n" % prov_sha)
        f.write("stage4 ref-tcc %s\n" % reftcc)
        f.write("stage3 tcc-amd64 3/6/tcc-amd64 %s\n" % tcc3)

    print("veron-trace-records: %d substage lines, %d package lines -> %s"
          % (ns, np_, a.out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
