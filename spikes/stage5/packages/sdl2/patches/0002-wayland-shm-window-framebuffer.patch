+/* A wl_shm window framebuffer for the Wayland backend.
+ *
+ * Upstream's Wayland driver puts pixels on a surface only through EGL; its
+ * one use of wl_shm is the cursor. With no GL API compiled in, SDL's
+ * software renderer draws into a buffer that has nowhere to go: the window
+ * is created, configured and acked, and never shows a frame. This is the
+ * native framebuffer path the driver lacked, built on its own
+ * Wayland_SHMBuffer helper. SDL_video.c only reaches it after the texture
+ * path finds no accelerated renderer, so with GL present nothing changes.
+ */
+int Wayland_CreateWindowFramebuffer(_THIS, SDL_Window *window, Uint32 *format, void **pixels, int *pitch)
+{
+    SDL_WindowData *wind = window->driverdata;
+    int w, h, i;
+
+    SDL_GetWindowSizeInPixels(window, &w, &h);
+    Wayland_DestroyWindowFramebuffer(_this, window);
+
+    for (i = 0; i < 2; ++i) {
+        if (Wayland_AllocSHMBuffer(w, h, &wind->fb_shm[i]) < 0) {
+            Wayland_DestroyWindowFramebuffer(_this, window);
+            return -1;
+        }
+    }
+    wind->fb_pitch = w * 4;
+    wind->fb_pixels = SDL_calloc((size_t)h, (size_t)wind->fb_pitch);
+    if (!wind->fb_pixels) {
+        Wayland_DestroyWindowFramebuffer(_this, window);
+        return SDL_OutOfMemory();
+    }
+    wind->fb_w = w;
+    wind->fb_h = h;
+    wind->fb_next = 0;
+
+    *format = SDL_PIXELFORMAT_ARGB8888;
+    *pixels = wind->fb_pixels;
+    *pitch = wind->fb_pitch;
+    return 0;
+}
+
+int Wayland_UpdateWindowFramebuffer(_THIS, SDL_Window *window, const SDL_Rect *rects, int numrects)
+{
+    SDL_WindowData *wind = window->driverdata;
+    struct Wayland_SHMBuffer *buf;
+
+    if (!wind->fb_pixels || !wind->surface) {
+        return SDL_SetError("Window framebuffer not available");
+    }
+
+    buf = &wind->fb_shm[wind->fb_next];
+    wind->fb_next ^= 1;
+    SDL_memcpy(buf->shm_data, wind->fb_pixels, (size_t)wind->fb_h * (size_t)wind->fb_pitch);
+
+    wl_surface_attach(wind->surface, buf->wl_buffer, 0, 0);
+    if (wl_compositor_get_version(wind->waylandData->compositor) >= 4) {
+        wl_surface_damage_buffer(wind->surface, 0, 0, wind->fb_w, wind->fb_h);
+    } else {
+        wl_surface_damage(wind->surface, 0, 0, wind->window_width, wind->window_height);
+    }
+    wl_surface_commit(wind->surface);
+    WAYLAND_wl_display_flush(wind->waylandData->display);
+    return 0;
+}
+
+void Wayland_DestroyWindowFramebuffer(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *wind = window->driverdata;
+    int i;
+
+    if (!wind) {
+        return;
+    }
+    for (i = 0; i < 2; ++i) {
+        Wayland_ReleaseSHMBuffer(&wind->fb_shm[i]);
+    }
+    SDL_free(wind->fb_pixels);
+    wind->fb_pixels = NULL;
+    wind->fb_w = wind->fb_h = wind->fb_pitch = 0;
+}
+
 #endif /* SDL_VIDEO_DRIVER_WAYLAND */
 
