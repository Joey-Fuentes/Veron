#!/bin/sh
# A CONFIRMED POWER CHOICE, RATHER THAN A CLICK THAT HALTS THE MACHINE.
#
# yambar has no menu widget: yambar-particles(5) gives `on-click`, which runs a
# command, and there is no popup, submenu or dropdown of any kind. So the bar's
# Shutdown label used to be left-click=poweroff, right-click=reboot -- two
# invisible bindings, no confirmation, and a stray click ended the session.
#
# fuzzel IS ALREADY THE MENU IN THIS SYSTEM and it has a dmenu mode. Verified
# against `fuzzel --help` on the machine rather than assumed:
#
#     -d,--dmenu           dmenu compatibility mode
#     -p,--prompt=PROMPT   string to use as input prompt ("> ")
#
# In that mode fuzzel reads lines on stdin and prints the chosen one, so three
# lines in gives a real chooser with the options visible.
#
# CANCEL IS FIRST AND IS THE DEFAULT. fuzzel preselects the first entry, so
# Enter without deliberately moving selects Cancel. Escape also exits non-zero
# and matches nothing. Both safe outcomes reach the `*)` arm below.
#
# THIS SCRIPT EXISTS BECAUSE on-click IS NOT A SHELL. yambar-particles(5):
# "the string is *not* executed in a shell. Environment variables are not
# expanded." A pipeline cannot be written inline, so it lives in a file and the
# bar names the file.
set -u

choice=$(printf 'Cancel\nShut Down\nRestart\n' \
         | fuzzel --dmenu --prompt 'Power: ' 2>/dev/null) || exit 0

# dinit's OWN shutdown, BY ABSOLUTE PATH.
#
# THE ABSOLUTE PATH IS THE ENTIRE FIX, AND THE FIRST EXPLANATION WRITTEN HERE
# WAS WRONG. It claimed this image has no poweroff or reboot. It does: dinit
# installs both, as SYMLINKS to its own shutdown, and shutdown dispatches on
# argv[0]. files.tsv says so plainly --
#
#     usr/sbin/poweroff  dinit  symlink -> shutdown
#     usr/sbin/reboot    dinit  symlink -> shutdown
#
# -- and the launcher's own Shut Down entry, which calls /usr/sbin/poweroff,
# has always worked. The claim came from reading dinit's installs.txt, which
# is one of the listings CI reports as stale; the image itself was never
# consulted.
#
# WHAT ACTUALLY BROKE was the bare name. This runs from yambar, whose PATH is
# whatever the session gave it rather than a login shell's, and /bin comes
# first in some of them -- so `poweroff` found BUSYBOX's applet, which signals
# PID 1 the way sysvinit expects and dinit does not answer. The menu ran, the
# applet returned, and the machine sat there.
#
# BOTH FLAGS WERE TESTED ON THE MACHINE: `/usr/sbin/shutdown -r` and
# `/usr/sbin/shutdown -p` both work from foot. Either spelling would do now
# that the path is absolute; this one names the action rather than relying on
# argv[0].
# THE REQUEST GOES TO powerd, BECAUSE THIS MENU IS NOT ROOT ANY MORE.
# The comment above ("both flags were tested on the machine") was true
# in the root-session era and stopped being true the day the session
# dropped privilege: dinit's control socket is root's, and calling
# shutdown from here died with `connect: No such file or directory`
# (metal, 2026-08-18). The desktop asks; veron-powerd performs; the
# splash repaints on the way down because the stop is CLEAN.
req() {
    if [ -p /run/veron-power/cmd ] && echo "$1" > /run/veron-power/cmd 2>/dev/null; then
        exit 0
    fi
    fuzzel --dmenu --prompt "power service not running (dinitctl status veron-powerd)  " </dev/null >/dev/null 2>&1
    exit 1
}
case "$choice" in
    "Shut Down") req poweroff ;;
    "Restart")   req reboot ;;
    *)           exit 0 ;;
esac
