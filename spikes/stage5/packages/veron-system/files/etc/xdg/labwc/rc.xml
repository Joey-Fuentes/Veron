<?xml version="1.0" encoding="UTF-8"?>
<!--
  Veron's labwc configuration.

  UPSTREAM INSTALLS ITS OWN rc.xml TO share/doc/labwc/ AS DOCUMENTATION
  (meson.build:27), not to /etc/xdg. So labwc starts with NO configuration at
  all unless a distribution supplies one, and labwc's src/common/dir.c:28
  searches XDG_CONFIG_HOME then XDG_CONFIG_DIRS — which /etc/profile sets to
  /etc/xdg. This file is that supply.

  DELIBERATELY MINIMAL. Every binding here names a program this set actually
  builds; nothing refers to a terminal or launcher that does not exist. The
  full option surface is in share/doc/labwc/rc.xml.all for anyone who wants it.
-->
<labwc_config>

  <core>
    <!-- FOLLOW THE MOUSE is the openbox default labwc inherits. Stated so it
         is a choice rather than an inheritance. -->
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
  </core>

  <theme>
    <!-- NO THEME NAME ELEMENT: naming a theme that is not installed makes
         labwc fall back silently. The built-in theme is what this image has.
         (A bare element name in an XML comment is itself a parse error, which
         is how the first draft of this file failed.) -->
    <cornerRadius>4</cornerRadius>
    <font place="ActiveWindow">
      <!-- monospace RESOLVES THROUGH fontconfig TO DejaVu Sans Mono via the
           57-dejavu-sans-mono.conf snippet the dejavu-fonts package installs.
           Without that package this renders nothing — which is why fonts were
           in the same batch as the terminal. -->
      <name>sans-serif</name>
      <size>10</size>
    </font>
  </theme>

  <keyboard>
    <!-- W- IS THE SUPER KEY. These four are the whole interface: a terminal,
         a launcher, close, and a way out. -->
    <keybind key="W-Return">
      <action name="Execute" command="/usr/bin/foot" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="/usr/bin/fuzzel" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
        <!-- A-Tab AND A-S-Tab, WHICH ARE THE ONLY WAY BACK FROM Iconify.
         The client menu offers Minimize and nothing restores it: the window
         vanishes, so it is no longer focused and W-q cannot reach it, and the
         bar's window list reports names without acting on them: yambar's
         foreign-toplevel module exposes no actions and labwc has no IPC. Until
         these binds existed a minimised window was unreachable until labwc
         restarted.

         NextWindow and PreviousWindow are confirmed present in labwc's own
         rc.xml.all; nothing here is guessed. -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- A-Space IS THE WAY OUT OF THE CLIENT MENU'S OWN TRAPS, and it is
         labwc's own default binding rather than an invention.

         That menu offers Decorations and Fullscreen. Both remove the titlebar,
         and the titlebar is where every route back to the menu lived: the
         TitleBar right-click, the WindowMenu button and the Icon are all on
         it. Choosing either was a one way trip, and W-q, which closes the
         window, was the only exit.

         This binds the menu to a key, so it is reachable when there is no
         titlebar to click. It also means ToggleDecorations and
         ToggleFullscreen never have to be named here: labwc's own menu already
         has them, and those two action names do not appear anywhere in
         rc.xml.all, so writing them would have been guesswork. -->
    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" atCursor="no" />
    </keybind>

    <!-- W-a MAXIMISES, NOT W-Up, WHICH IS WHERE THIS WAS WRONG. An earlier
         draft bound W-Up to ToggleMaximize; labwc's own rc.xml.all uses W-a
         for that and reserves the arrows for SnapToEdge. Following the
         convention costs nothing and means anything written about labwc
         elsewhere applies here. -->
    <keybind key="W-a">
      <action name="ToggleMaximize" />
    </keybind>

    <!-- SNAPPING TO HALVES, which is the other thing the arrows are for and
         the reason W-Up had to give them up. -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="SnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-Down">
      <action name="SnapToEdge" direction="down" />
    </keybind>

    <!-- A-F4 CLOSES, which is what every other desktop uses and what a person
         coming from one will try first. W-q stays as it was. -->
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>

    <!-- THE HARDWARE KEYS, WHICH EMIT XF86 SYMBOLS AND WERE BOUND TO NOTHING.
         scripts/backlight and amixer already existed; the only route to them
         was clicking a bar label, which is a poor answer for a key that exists
         on the keyboard.

         amixer -c 1 IS THIS MACHINE'S ANALOGUE CARD and the sound service
         picks the card at boot by reading /proc/asound. These binds cannot ask
         it, so they name card 1: right here, wrong on a machine whose
         analogue codec enumerates first. A wrapper that reads the same
         /etc/asound.conf the service wrote is the better answer and is not
         written. -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="/etc/dinit.d/scripts/backlight up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="/etc/dinit.d/scripts/backlight down" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="/bin/sh -c 'amixer -c 1 sset Master 5%+ unmute'" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="/bin/sh -c 'amixer -c 1 sset Master 5%- unmute'" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="/bin/sh -c 'amixer -c 1 sset Master toggle'" />
    </keybind>

<!-- EXIT IS BOUND BECAUSE THIS RUNS BESIDE A CONSOLE, NOT INSTEAD OF ONE.
         Leaving the compositor returns to a machine that still has a shell. -->
    <keybind key="W-S-e">
      <action name="Exit" />
    </keybind>
  </keyboard>

  <!-- WITHOUT THIS SECTION THE TITLEBAR IS A PICTURE. It drew, with a close,
       maximise and minimise button on it, and clicking any of them did
       nothing; windows could not be moved or resized either. The reason is the
       same one recorded at the top of this file about rc.xml itself: labwc
       ships its mouse bindings in share/doc/labwc/rc.xml.all as DOCUMENTATION
       and has no built-in defaults, so a compositor with no distribution
       config has decorations that respond to nothing.

       MEASURED ON THE MACHINE, NOT COPIED FROM MEMORY. Every context and
       action name below was read out of /usr/share/doc/labwc/rc.xml.all in a
       running image. Inventing these is how a config file parses cleanly and
       silently does nothing: a name labwc does not know is not an error. -->
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>

    <!-- MOVE AND RESIZE. Title drags the window; the eight frame edges and
         corners resize it. Frame carries the modifier-drag so a window can be
         moved without reaching for its titlebar at all. -->
    <context name="Title">
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus" />
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Top">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Bottom">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Left">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Right">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="TLCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="TRCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="BLCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="BRCorner">
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

    <!-- THE TITLEBAR ITSELF. Press-to-focus is separate from the button
         contexts below, which is why TitleBar and Title are two names: one is
         the whole bar, the other the text area that drags. -->
    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ShowMenu" menu="client-menu" />
      </mousebind>
    </context>

    <!-- THE THREE BUTTONS THAT WERE DRAWN AND DEAD. Close, Iconify and
         Maximize are the decoration buttons; WindowMenu and Icon are the
         top-left corner. -->
    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close" />
      </mousebind>
    </context>
    <context name="Iconify">
      <mousebind button="Left" action="Click">
        <action name="Iconify" />
      </mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="WindowMenu">
      <mousebind button="Left" action="Click">
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
    </context>
    <context name="Icon">
      <mousebind button="Left" action="Click">
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
    </context>
    <context name="Shade">
      <mousebind button="Left" action="Click">
        <action name="ToggleShade" />
      </mousebind>
    </context>
    <context name="AllDesktops">
      <mousebind button="Left" action="Click">
        <action name="ToggleOmnipresent" />
      </mousebind>
    </context>

    <!-- THE CLIENT AREA. Press-to-focus, so clicking inside a window raises
         it. Without this, focus follows nothing and a click into an
         unfocused terminal is swallowed. -->
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>
