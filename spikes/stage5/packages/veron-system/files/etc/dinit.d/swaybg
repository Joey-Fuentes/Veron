# The wallpaper, owned by dinit for the same reason yambar is: an
# autostart entry's lifetime belongs to nobody, and the pkill that cleaned
# up the previous session's copy raced its teardown. See yambar for the
# full account, including the stop/start asymmetry -- everything there
# applies here unchanged.
#
# THE FILE-OR-COLOUR CHOICE MOVED HERE FROM AUTOSTART, in sh so a missing
# wallpaper still gives a desktop rather than a failed service: swaybg
# reads PNG only (gdk-pixbuf is declined in its recipe), and -c is the
# fallback for an image that is not there.
type = process
command = /bin/busybox sh -c 'if [ -f /usr/share/veron/wallpaper.png ]; then exec /bin/busybox sh /etc/dinit.d/scripts/wayland-app /usr/bin/swaybg -m fill -i /usr/share/veron/wallpaper.png; else exec /bin/busybox sh /etc/dinit.d/scripts/wayland-app /usr/bin/swaybg -c "#1a1a1a"; fi'
run-as = veron
restart = true
depends-on = labwc
depends-on = xdg-runtime
depends-on = device-nodes
