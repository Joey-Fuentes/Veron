# Everything in /etc/fstab except the root, mounted before anything else runs.
#
# `type = scripted` because this is one action with a defined end, not a
# process to supervise. dinit considers it started when the command exits 0.
#
# busybox mount reads /etc/fstab and `-a` mounts every entry; the root is not
# listed there, so there is nothing to re-mount. /dev is already a devtmpfs
# from the initramfs, and mount is a no-op on an existing mount rather than an
# error -- which is why this does not need to know how it was booted.
type = scripted
command = /bin/busybox mount -a
restart = false
