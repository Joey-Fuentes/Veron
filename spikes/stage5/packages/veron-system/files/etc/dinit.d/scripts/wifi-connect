#!/bin/busybox sh
# Pick a network, type the password once, and be connected on every boot after.
#
# THIS IS THE ONE THING A PERSON DOES BY HAND, and it is a click rather than a
# dialog that appears unbidden: the launcher has a Wi-Fi entry, and this is
# what it runs. A machine that already has a network never sees it.
#
# fuzzel IS THE UI BECAUSE IT IS ALREADY THE MENU. Its dmenu mode reads lines
# on stdin and prints the chosen one -- `-d,--dmenu` and `-p,--prompt`,
# confirmed against fuzzel --help on the machine. The same mechanism the power
# menu uses. Nothing new is packaged for this.
#
# THE PASSWORD IS HASHED, NOT STORED. wpa_passphrase turns an SSID and a
# passphrase into a 64-hex-digit PSK, and that is what lands in the config. It
# is password-equivalent for joining that one network, which is unavoidable,
# but it is not the string that might be reused elsewhere and it never appears
# in a file or a process listing.
#
# IT WRITES TO /persist, WHICH IS THE POINT. /etc/wpa_supplicant.conf is a
# symlink into the persistent partition, so a network entered once is there
# after a reboot. Without that partition the write still works -- onto the
# tmpfs overlay -- and is simply forgotten at power-off, which is the honest
# behaviour for a machine with nowhere to keep it.
set -u

die() { fuzzel --dmenu --prompt "$1  " </dev/null >/dev/null 2>&1; exit 1; }

IFACE=
for d in /sys/class/net/*; do
    [ -d "$d/wireless" ] && { IFACE=$(basename "$d"); break; }
done
[ -n "$IFACE" ] || die "No wireless device"

# -p IS NOT OPTIONAL AND ITS ABSENCE COST A ROUND OF DEBUGGING.
#
# wpa_supplicant writes its control socket where the config says --
# ctrl_interface=/run/wpa_supplicant -- but wpa_cli defaults to
# /var/run/wpa_supplicant, and this image has no /var/run symlink. So every
# wpa_cli call looked in a directory that does not exist, `ping` failed, this
# script concluded no supplicant was running, started a second one, and that
# one died with:
#
#   ctrl_iface exists and seems to be in use - cannot override it
#   Failed to initialize control interface '/run/wpa_supplicant'
#
# which surfaced to the user as "wpa_supplicant would not start" -- a message
# about the wrong process entirely.
#
# THE SYMLINK IS ALSO ADDED, in files/var/run, because anything else that
# assumes the conventional path will hit the same wall. This flag is the
# specific fix and the symlink is the general one; both are wanted.
CTRL=/run/wpa_supplicant
mkdir -p "$CTRL"

# THE SUPPLICANT MUST BE RUNNING TO SCAN, and the wpa service now guarantees
# one on every boot -- with an empty config if no network is saved. That is a
# change made for this script's benefit: it used to start its own when none was
# running, which is impossible now that the session is unprivileged.
if ! /usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" ping >/dev/null 2>&1; then
    # THIS NO LONGER STARTS A SUPPLICANT ITSELF, because it cannot: this menu
    # runs as the desktop user now, and both `wpa_supplicant -B` and
    # `ip link set up` are root-only. The wpa service starts one at boot
    # whether or not a network is saved, so reaching here means that service
    # failed rather than that the machine is unconfigured -- a different
    # problem, and worth saying which.
    die "no supplicant on $IFACE -- check: dinitctl status wpa"
fi

# ONE LINE PER SSID, STRONGEST FIRST, DUPLICATES REMOVED. scan_results is
# tab-separated: bssid / frequency / signal / flags / ssid. A network with no
# SSID is hidden and cannot be joined from a list.
ssid_list() {
    /usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" scan_results 2>/dev/null \
        | awk -F'\t' 'NR>2 && $5 != "" { if (!seen[$5]++) print $5 }'
}

# WHAT THE SUPPLICANT ALREADY KNOWS, BEFORE ASKING IT FOR MORE.
#
# THE OLD ORDER WAS scan, sleep 3, scan_results, AND IT WAS WRONG TWICE.
#
# Wrong the first time because a cold radio does not finish a scan in three
# seconds, so scan_results returned the cache from BEFORE the scan -- which on
# a fresh boot is empty. The menu came up with no networks. Clicking again
# showed the results the FIRST click had eventually produced, which is exactly
# the "close it and open it again and now it works" everyone hit.
#
# Wrong the second time because those three seconds were spent even when the
# supplicant already had perfectly good results. wpa_supplicant scans on its
# own while associated, so the cache is usually warm and the menu could have
# been instant.
#
# So: read the cache first and only wait if it is empty.
CACHED=$(ssid_list)

/usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" scan >/dev/null 2>&1 || \
    die "the supplicant would not scan -- is it running on $IFACE?"

if [ -z "$CACHED" ]; then
    # POLLED, NOT SLEPT, AND WITH A DEADLINE. A fixed sleep is simultaneously
    # too long when the answer arrives in 400 ms and too short when the radio
    # is cold, which is how one number managed to cause both complaints.
    n=0
    while [ "$n" -lt 16 ]; do
        CACHED=$(ssid_list)
        [ -n "$CACHED" ] && break
        sleep 0.5
        n=$((n + 1))
    done
fi

# THE CURRENT CONNECTION IS THE FIRST THING THE MENU SAYS, because "am I on
# wifi" is the question a bar click is usually asking, and the answer used to
# be nowhere in this interface at all.
CUR=$(/usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" status 2>/dev/null \
      | awk -F= '$1 == "ssid" { print $2 }')
STATE=$(/usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" status 2>/dev/null \
        | awk -F= '$1 == "wpa_state" { print $2 }')

MENU=""
if [ -n "$CUR" ] && [ "$STATE" = "COMPLETED" ]; then
    MENU="Connected: $CUR
Disconnect from $CUR"
elif [ -n "$STATE" ] && [ "$STATE" != "INACTIVE" ] && [ "$STATE" != "DISCONNECTED" ]; then
    MENU="Status: $STATE"
fi
[ -z "$CACHED" ] && MENU="${MENU:+$MENU
}No networks found -- choose Rescan"

SSID=$(printf '%s%s%s\nRescan\n' "${MENU:+$MENU
}" "$CACHED" "${CACHED:+
}" \
       | fuzzel --dmenu --prompt 'Wi-Fi: ' 2>/dev/null) || exit 0
[ -n "$SSID" ] || exit 0

case "$SSID" in
    "Connected: "*|"Status: "*|"No networks found"*)
        exit 0 ;;
    "Disconnect from "*)
        /usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" disconnect >/dev/null 2>&1
        exit 0 ;;
    Rescan)
        # THE RESCAN IS THE SAME SCRIPT AGAIN, and by then the scan this run
        # already issued has had the time the user spent reading the menu.
        exec "$0" ;;
esac

# fuzzel HAS NO PASSWORD FIELD, and pretending otherwise would be worse than
# saying so. The passphrase is typed into a normal dmenu prompt, which means it
# is visible on screen while being typed. That is a real limitation of building
# a UI out of a launcher, and the alternative -- a toolkit dialog -- is now
# possible since fltk is in the set, and is the right fix.
PASS=$(printf '' | fuzzel --dmenu --prompt "Password for $SSID: " 2>/dev/null) || exit 0
[ -n "$PASS" ] || exit 0

BLOCK=$(/usr/sbin/wpa_passphrase "$SSID" "$PASS" 2>/dev/null) || die "Bad passphrase"
case "$BLOCK" in *psk=*) : ;; *) die "Bad passphrase" ;; esac

# THE PLAINTEXT LINE IS STRIPPED. wpa_passphrase emits the passphrase as a
# comment beside the hash, which would put it in the file this exists to avoid
# putting it in.
# THE WRITE IS CHECKED, BECAUSE ITS SILENT FAILURE WAS THE WHOLE BUG.
# On the first consumer flash this script could not write root's /etc
# file, said nothing, and reconfigure reloaded an empty config -- which
# surfaced as "wrong password?" against a correct password (2026-08-18).
# A failure here now names the actual culprit.
if ! printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=veron\nupdate_config=1\n\n' > /etc/wpa_supplicant.conf 2>/dev/null; then
    die "cannot write the network config -- is /persist mounted and group-writable?"
fi
echo "$BLOCK" | grep -v '^[[:space:]]*#psk=' >> /etc/wpa_supplicant.conf

# reconfigure IS THE STEP THAT ACTUALLY JOINS THE NETWORK, and its failure was
# invisible. Everything here used to end in >/dev/null 2>&1, so when wpa_cli
# could not reach the supplicant -- which it could not, before -p was passed --
# the config was written, nothing reloaded it, and the dialog simply closed. To
# the person using it that is indistinguishable from success, and the only
# symptom is a browser with no network some minutes later.
#
# THE STATUS IS CHECKED RATHER THAN ASSUMED. A reconfigure that returns OK only
# means the supplicant accepted the command; association takes a few seconds
# and can still fail on a wrong passphrase, which is by far the most likely
# mistake and deserves to be reported as itself.
if ! /usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" reconfigure 2>&1 | grep -q OK; then
    die "could not tell the supplicant to reload -- is wpa_supplicant running?"
fi

# UP TO 15 SECONDS, POLLED. A fixed sleep is either too short on a slow
# association or wasted time on a fast one.
n=0
while [ "$n" -lt 15 ]; do
    STATE=$(/usr/sbin/wpa_cli -p "$CTRL" -i "$IFACE" status 2>/dev/null \
            | sed -n 's/^wpa_state=//p')
    [ "$STATE" = "COMPLETED" ] && break
    n=$((n + 1))
    sleep 1
done

[ "$STATE" = "COMPLETED" ] || die "could not join $SSID (wpa_state=${STATE:-unknown}) -- wrong password?"

# DHCP ONLY AFTER ASSOCIATION. Asking for a lease on an interface with no
# carrier just times out, and the boot-time dhcp service has long since given
# up on an interface that was not associated when it ran.
/usr/sbin/dhcpcd -n "$IFACE" >/dev/null 2>&1 || /usr/sbin/dhcpcd "$IFACE" >/dev/null 2>&1 &

exit 0
