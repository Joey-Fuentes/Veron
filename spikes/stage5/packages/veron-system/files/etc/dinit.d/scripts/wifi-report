#!/bin/busybox sh
# What the wifi is doing, for the bar.
#
# THE BAR HAD NO WIFI STATUS AT ALL. It had a "Wi-Fi" label on the left next to
# the launchers, which ran the connect script -- an action, not an indicator.
# So the one thing a person actually wants from a bar, "am I connected and to
# what", was the one thing it could not answer, and the only way to find out
# was to open the connect menu and read it.
#
# A script MODULE RATHER THAN A wifi ONE, because yambar has no wifi module.
# It has `network`, which reports link state and addresses from rtnetlink and
# knows nothing about SSIDs or signal strength. The information wanted here
# comes from wpa_supplicant, so it is read the same way everything else about
# wifi in this system is read: wpa_cli over its control socket.
#
# THE PROTOCOL IS THE SAME ONE backlight-report USES -- `name|type|value` lines
# terminated by a blank line, per yambar-modules-script(5) -- and the same
# only-emit-on-change rule, because yambar repaints the bar for every set it
# reads and a poll that prints the same thing forever repaints forever.
set -u

CTRL=/run/wpa_supplicant
INTERVAL=5
LAST=

# THE SIGNAL IS A DOMINO THAT FILLS FROM THE BOTTOM UP.
#
# THE BLOCK RAMP WAS WRONG FOR A REASON WORTH RECORDING. Four block elements
# gave four levels, and the top one was U+2588 FULL BLOCK -- a filled
# rectangle, which is also exactly what a MISSING glyph looks like. The bar
# showed a solid white box at full signal and read as broken while working
# perfectly. A glyph indistinguishable from tofu is a bad glyph however well
# it renders.
#
# DejaVu HAS THE WHOLE DOMINO BLOCK. Confirmed on the machine, not assumed:
#
#     fc-query --format '%{charset}' DejaVuSans.ttf | tr ' ' '\n' | grep ^1f
#     ...  1f030-1f093  ...
#
# VERTICAL TILES, NOT HORIZONTAL, AND THE ORDER IS THE POINT. Vertical tiles
# start at U+1F063 = VERTICAL-00-00, seven per row, and the FIRST number is the
# TOP half. So holding the bottom at six and raising the top gives a tile that
# visibly fills upward as the signal improves:
#
#     1..6   00-01 .. 00-06   U+1F064..U+1F069   bottom half filling
#     7..12  01-06 .. 06-06   U+1F070..U+1F093   top half filling
#
# Each of those eight boundary codepoints was checked against the arithmetic
# rather than transcribed.
#
# THIRTEEN LEVELS IS MORE PRECISION THAN THE SIGNAL DESERVES, and that is the
# right way round. Usable RSSI runs about -30 dBm (sitting on the router) to
# -90 (unusable): 60 dB across 12 steps, 5 dB per pip. wpa_cli reports RSSI as
# an integer dBm, so the input is 1 dB precise and the display is the coarser
# of the two -- no invented resolution.
#
# For reference: -40 shows 10 pips, -60 shows 6, -70 shows 4, -80 shows 2.
pips() {
    case "$1" in
        ''|*[!0-9-]*) printf '\360\237\201\242' ; return ;;
    esac
    # (RSSI + 90) / 5, clamped. Integer arithmetic only -- busybox ash has no
    # floating point and this needs none.
    n=$(( ($1 + 90) / 5 ))
    [ "$n" -lt 0 ] && n=0
    [ "$n" -gt 12 ] && n=12
    case "$n" in
        0) printf '🁣' ;;
        1) printf '🁤' ;;
        2) printf '🁥' ;;
        3) printf '🁦' ;;
        4) printf '🁧' ;;
        5) printf '🁨' ;;
        6) printf '🁩' ;;
        7) printf '🁰' ;;
        8) printf '🁷' ;;
        9) printf '🁾' ;;
        10) printf '🂅' ;;
        11) printf '🂌' ;;
        12) printf '🂓' ;;
    esac
}

while true; do
    ICON=$(printf '\360\237\201\242')   # U+1F062 vertical back -- no link
    TEXT='wifi off'
    STATE=down

    if /usr/sbin/wpa_cli -p "$CTRL" ping >/dev/null 2>&1; then
        S=$(/usr/sbin/wpa_cli -p "$CTRL" status 2>/dev/null)
        WPA=$(printf '%s\n' "$S" | awk -F= '$1 == "wpa_state" { print $2 }')
        SSID=$(printf '%s\n' "$S" | awk -F= '$1 == "ssid" { print $2 }')

        case "$WPA" in
            COMPLETED)
                # THE SIGNAL IS A SECOND CALL AND ONLY WHEN CONNECTED, because
                # signal_poll on an unassociated interface returns an error and
                # costs a round trip to learn nothing.
                RSSI=$(/usr/sbin/wpa_cli -p "$CTRL" signal_poll 2>/dev/null \
                       | awk -F= '$1 == "RSSI" { print $2 }')
                ICON=$(pips "$RSSI")
                TEXT="${SSID:-connected}"
                STATE=up
                ;;
            SCANNING|AUTHENTICATING|ASSOCIATING|ASSOCIATED|4WAY_HANDSHAKE|GROUP_HANDSHAKE)
                # DOUBLE BLANK: a tile that is face-up but has no pips, which
                # is exactly what connecting is -- a link, no signal yet.
                ICON=$(printf '\360\237\201\243')   # U+1F063
                TEXT='connecting'
                STATE=busy
                ;;
            *)
                ICON=$(printf '\360\237\201\242')   # U+1F062 back
                TEXT='not connected'
                STATE=idle
                ;;
        esac
    fi

    OUT="$ICON|$TEXT|$STATE"
    if [ "$OUT" != "$LAST" ]; then
        echo "icon|string|$ICON"
        echo "ssid|string|$TEXT"
        echo "state|string|$STATE"
        echo ""
        LAST=$OUT
    fi
    sleep "$INTERVAL"
done
