#!/bin/busybox sh
# Start the supplicant, if a network has been saved.
#
# NO CONFIG IS THE FIRST-BOOT CASE AND IS NOT AN ERROR. /etc/wpa_supplicant.conf
# is a symlink into /persist, made by guest/init; on a machine with no persist
# partition, or before any network has been entered, it points at nothing. This
# says so once and exits 0 rather than letting dinit report a failed service on
# every boot of a machine that simply has no wifi configured yet.
#
# THE INTERFACE IS FOUND, NOT ASSUMED. wlan0 is what the test machine calls it,
# but the name depends on the driver and on whether anything renames it. The
# first wireless interface in /sys/class/net is the one with a `wireless`
# directory.
set -u

CONF=/etc/wpa_supplicant.conf

# THE SUPPLICANT NOW STARTS EVEN WITH NO SAVED NETWORK, and that is a change
# forced by the desktop no longer being root.
#
# It used to exit here, and the Wi-Fi menu started its own wpa_supplicant on
# demand. That worked when the menu ran as uid 0. It cannot now: starting a
# daemon and bringing an interface up are both root-only, and the menu runs as
# `veron` like everything else in the session. So the daemon is always here,
# owned by root, and the menu only ever speaks to it through wpa_cli.
#
# AN EMPTY CONFIG IS A VALID CONFIG. wpa_supplicant with no network blocks
# scans nothing and associates with nothing; it sits there offering a control
# socket, which is exactly what is wanted.
if [ ! -s "$CONF" ]; then
    echo "VERON-WIFI-UNCONFIGURED  no saved network -- starting a supplicant anyway"
    printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=veron\nupdate_config=1\n' > "$CONF" 2>/dev/null || {
        echo "VERON-WIFI-NO-CONFIG  cannot write $CONF"
        exit 0
    }

# THE BOOTSTRAP CONFIG MUST BE GROUP-WRITABLE OR THE MENU IS DECORATIVE.
# root creates this file; wifi-connect runs as veron and REWRITES it when
# a person picks a network. Without these two lines the first consumer
# flash failed exactly there: root:root 0644, the menu's write bounced
# silently, and reconfigure reloaded emptiness (2026-08-18).
/bin/busybox chgrp veron "$CONF" 2>/dev/null || true
/bin/busybox chmod 0660 "$CONF" 2>/dev/null || true
fi

# GROUP=veron ON THE CONTROL INTERFACE, added to configs that predate it.
# wpa_supplicant creates /run/wpa_supplicant and its socket root:root without
# it, and wpa_cli run by the desktop user then gets EACCES -- which surfaces as
# "the supplicant would not scan", naming the wrong culprit. A config already
# saved on /persist was written before this existed, so it is upgraded in
# place rather than requiring the user to re-enter a network.
if ! /bin/busybox grep -q "GROUP=veron" "$CONF" 2>/dev/null; then
    /bin/busybox sed -i 's#^ctrl_interface=.*#ctrl_interface=DIR=/run/wpa_supplicant GROUP=veron#' "$CONF" 2>/dev/null \
        && echo "VERON-WIFI-CTRL-REGROUPED  $CONF now admits group veron"
fi

IFACE=
for d in /sys/class/net/*; do
    [ -d "$d/wireless" ] && { IFACE=$(basename "$d"); break; }
done
[ -n "$IFACE" ] || {
    echo "VERON-WIFI-NO-INTERFACE  no wireless device present"
    exit 0
}

mkdir -p /run/wpa_supplicant
ip link set "$IFACE" up 2>/dev/null || true
echo "VERON-WIFI-STARTING  $IFACE"
exec /usr/sbin/wpa_supplicant -i "$IFACE" -c "$CONF"
