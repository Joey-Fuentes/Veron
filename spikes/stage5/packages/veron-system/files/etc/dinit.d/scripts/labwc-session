#!/bin/busybox sh
# Start labwc with an environment dinit does not provide.
#
# dinit does NOT source /etc/profile -- that is a login shell's job -- so a
# service started at boot inherits PID 1's environment. That has no PATH worth
# using and, critically, no XDG_RUNTIME_DIR, which labwc treats as fatal at
# src/main.c:242 before it touches a DRM device.
set -u

export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export XDG_RUNTIME_DIR=/run/user/0
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}
# WAYLAND CLIENTS FIND THE COMPOSITOR THROUGH THIS. Without it labwc still
# creates wayland-0 in XDG_RUNTIME_DIR, but anything launched from autostart
# inherits whatever the service had -- naming it makes the socket a decision.
export XDG_SESSION_TYPE=wayland
# LANG IS SET HERE TOO BECAUSE dinit DOES NOT SOURCE /etc/profile. A service
# started at boot gets PID 1's environment, so the export in /etc/profile
# reaches a login shell and nothing else -- and everything labwc autostarts
# inherits from here.
export LANG=C.UTF-8

# FAIL WITH A REASON, NOT A STACK TRACE. Each of these is a distinct fault with
# a distinct fix, and labwc's own error for the first two is about DRM rather
# than about what is actually missing.
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "labwc-session: $XDG_RUNTIME_DIR missing -- the xdg-runtime service"
    echo "  did not run or could not create it. dinitctl status xdg-runtime"
    exit 1
fi
if [ ! -S /run/seatd.sock ]; then
    echo "labwc-session: no /run/seatd.sock -- seatd is not running, so"
    echo "  wlroots cannot acquire a session and will report no DRM device."
    echo "  dinitctl status seatd"
    exit 1
fi
if [ ! -e /dev/dri/card0 ]; then
    # NOT A HARD EXIT. wlroots can fall back to other backends, and saying so
    # is more useful than refusing to start -- but the cause is worth naming
    # because the kernel side of it is recorded in KERNEL-CHANGES.md.
    echo "labwc-session: no /dev/dri/card0 -- DRM or virtio-gpu is absent from"
    echo "  this kernel. labwc -Dbackends=drm has nothing to open."
fi
if [ ! -x /usr/bin/labwc ]; then
    echo "labwc-session: no /usr/bin/labwc in this image"
    exit 1
fi

echo "labwc-session: starting labwc (runtime=$XDG_RUNTIME_DIR config=$XDG_CONFIG_DIRS)"
# exec SO dinit SUPERVISES labwc ITSELF rather than this wrapper. Without it
# dinit would watch a shell that had already finished its work, and killing
# the service would kill the wrapper and orphan the compositor.
exec /usr/bin/labwc
