#!/bin/busybox sh
# veron-flashd -- the privileged half of the flasher, and the FIRST
# instance of the request->validate->apply boundary the no-privilege
# ruling implies (2026-08-18): the desktop asks, root decides, and the
# refusals are the security. The power service will be the second
# tenant of this pattern.
#
# PROTOCOL, DELIBERATELY DUMB: one FIFO, one verb.
#   FLASH   <image> <dev>                  -- removable targets ONLY
#   INSTALL <image> <dev> <capacity-bytes> -- INTERNAL targets only, and
#     the request must state the target's exact capacity: the GUI reads
#     /sys, the service re-reads it, and a mismatch is a refusal. A
#     request cannot name a disk it has not looked at. This is the
#     bare-metal install path: booted from the live stick, the stick is
#     the sacred boot disk and the internal drive is the legal target.
# Status streams to /run/veron-flash/status, world-readable, appended --
# the GUI tails it; so can a person with cat.
set -u
DIR=/run/veron-flash
mkdir -p "$DIR"
[ -p "$DIR/cmd" ] || /bin/busybox mknod "$DIR/cmd" p 2>/dev/null || /bin/busybox mkfifo "$DIR/cmd"
/bin/busybox chgrp veron "$DIR/cmd" 2>/dev/null || true
/bin/busybox chmod 620 "$DIR/cmd"
: > "$DIR/status"; /bin/busybox chmod 644 "$DIR/status"
say() { echo "$@" >> "$DIR/status"; }
say "veron-flashd: ready"

while :; do
  # a FIFO read blocks until a writer arrives; one request at a time
  read -r verb img dev want_cap < "$DIR/cmd" || { /bin/busybox sleep 1; continue; }
  case "$verb" in FLASH|INSTALL) : ;; *) say "REFUSED: unknown verb '$verb'"; continue ;; esac

  # ---- VALIDATION IS THE PRODUCT ----------------------------------
  case "$dev" in *[!a-z0-9]*|"") say "REFUSED: '$dev' is not a device name"; continue ;; esac
  [ -b "/dev/$dev" ]            || { say "REFUSED: /dev/$dev is not a block device"; continue; }
  [ -e "/sys/block/$dev" ]      || { say "REFUSED: $dev is a partition, not a disk"; continue; }
  read -r rem < "/sys/block/$dev/removable" 2>/dev/null || rem=0
  # THE BOOT DISK IS SACRED UNDER EVERY VERB -- derived fresh, refused
  # by name, no exception exists or ever will.
  rootsrc=$(/bin/busybox awk '$2=="/"{print $1}' /proc/mounts | head -1)
  rootdisk=$(echo "$rootsrc" | /bin/busybox sed 's|/dev/||; s|p\{0,1\}[0-9]*$||')
  [ "$dev" != "$rootdisk" ]     || { say "REFUSED: $dev is the disk this system is running from"; continue; }
  cap=$(( $(cat "/sys/block/$dev/size") * 512 ))
  if [ "$verb" = "FLASH" ]; then
    [ "$rem" = "1" ]            || { say "REFUSED: $dev is not removable -- FLASH writes sticks, never internal disks. Installing to an internal disk is the INSTALL verb, with its own consent."; continue; }
  else
    # INSTALL: internal only, and the capacity handshake is the consent.
    [ "$rem" = "0" ]            || { say "REFUSED: $dev is removable -- INSTALL targets internal disks; use FLASH for sticks"; continue; }
    case "${want_cap:-}" in ''|*[!0-9]*) say "REFUSED: INSTALL requires the target's capacity in bytes"; continue ;; esac
    [ "$want_cap" = "$cap" ]    || { say "REFUSED: capacity mismatch -- request says $want_cap, $dev is $cap. The requester has not looked at this disk."; continue; }
    say "INSTALL consented: $dev, $cap bytes -- THIS ERASES EVERY OPERATING SYSTEM ON IT"
  fi
  [ -f "$img" ]                 || { say "REFUSED: no such image: $img"; continue; }
  size=$(/bin/busybox stat -c %s "$img" 2>/dev/null || echo 0)
  [ "$size" -gt 1048576 ]       || { say "REFUSED: $img is implausibly small ($size bytes)"; continue; }
  [ "$size" -le "$cap" ]        || { say "REFUSED: image ($size) exceeds $dev ($cap)"; continue; }

  # ---- unmount anything the desktop auto-mounted, then write ------
  for p in /dev/$dev?*; do /bin/busybox umount "$p" 2>/dev/null; done
  say "writing $size bytes to /dev/$dev ..."
  if ! /bin/busybox dd if="$img" of="/dev/$dev" bs=4M conv=fsync 2>>"$DIR/status"; then
    say "FLASH FAILED during write -- the stick may be inconsistent"
    continue
  fi
  say "write complete; reading every byte back (the part dd cannot promise) ..."
  # cmp -n: the mount-diary lesson -- compare exactly the image's length,
  # and compare it BEFORE anything can auto-mount and scribble.
  if /bin/busybox cmp -n "$size" "$img" "/dev/$dev" >>"$DIR/status" 2>&1; then
    say "VERIFIED: /dev/$dev holds the image byte-for-byte ($size bytes read back)"
  else
    say "VERIFY FAILED: the stick does not hold what was written -- do not boot it"
  fi
done
