#!/bin/busybox sh
# Stage 5's init. PID 1 in the guest.
#
# WHY STAGE 5 HAS ITS OWN. Stage 4's initramfs (spikes/stage4/bridge/
# rungs-sysroot.sh L1180) mounts the sysroot over 9p, runs ITS OWN eight
# t_* tests and a gcc-in-guest check, and exits. It knows nothing about
# stage 5, and teaching it would invert the dependency -- stage 4's job ends
# at "a booting system". So the stage-5 tests ran only under bwrap, and the
# QEMU output was entirely stage 4's.
#
# This also lets the guest boot the EXT4 IMAGE AS A DISK rather than only
# over a 9p share. That matters: the disk is the artifact a user would flash,
# and 9p is a development convenience. If virtio-blk or ext4 are missing from
# the kernel, this falls back to 9p and says so rather than failing.
#
# busybox is STATICALLY linked in the sysroot, so this initramfs is one
# binary and this script -- no loader, no libc, nothing to keep in sync.

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     none /proc  2>/dev/null
mount -t sysfs    none /sys   2>/dev/null
mount -t devtmpfs none /dev   2>/dev/null

echo "VERON-STAGE5-INIT"
echo "  kernel: $(uname -sr)"

ROOT=/mnt/root
mkdir -p "$ROOT"
VIA=none

# ---- 1. the real image, as a disk -------------------------------------
# The strongest available claim: this is the artifact, mounted the way a
# machine would mount it.
for dev in /dev/vda /dev/sda /dev/vdb; do
    [ -b "$dev" ] || continue
    if mount -t ext4 -o ro "$dev" "$ROOT" 2>/dev/null; then
        VIA="disk($dev)"
        echo "VERON-IMAGE-MOUNT-OK  $dev mounted ext4 read-only"
        break
    fi
done

# ---- 2. fall back to the 9p share --------------------------------------
if [ "$VIA" = none ]; then
    echo "VERON-IMAGE-MOUNT-SKIP  no ext4 block device -- virtio-blk or ext4"
    echo "  may not be in this kernel. Falling back to 9p, which proves the"
    echo "  TREE rather than the IMAGE."
    # msize matters: the default 9p transfer unit is small and the tools read
    # large files. Stage 4 learned this the same way.
    if mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=262144 \
             veronsysroot "$ROOT" 2>/dev/null; then
        VIA=9p
        echo "  9p sysroot mounted read-only"
    fi
fi

if [ "$VIA" = none ]; then
    echo "VERON-STAGE5-GUEST-FAIL  no root to test: neither disk nor 9p"
    poweroff -f
fi

# ---- 2.5 BOOT THE SYSTEM, IF ASKED --------------------------------------
#
# READ-ONLY BASE + tmpfs OVERLAY, WHICH IS THE LIVE-IMAGE DESIGN AND NOT AN
# INVENTION. OpenWrt mounts squashfs at /rom with a writable overlay on top;
# casper and live-boot do squashfs + tmpfs; Alpine's diskless mode runs
# entirely from RAM and persists only an explicit named blob. This is the
# same shape, with ext4 as the lower.
#
# WHY NOT A WRITABLE ROOT: the image on disk stays byte-identical to the one
# that was built, so `veron compare` against files.tsv works on a RUNNING
# system rather than being a claim about build time. That is the project's
# central claim, made checkable after boot.
#
# WHY tmpfs AND NOT A SECOND PARTITION: nothing needs to survive a reboot.
# There is no machine-id consumer, no sshd host keys, no passwords, no user
# data, no package manager. The first thing that will need persistence is
# FIDO2 credential enrollment, and a second partition can be added then --
# `AUTHENTICATION.md` records that. Persisting nothing is not a limitation
# here, it is an accurate description of the system.
#
# CONFIG_TMPFS_XATTR=y IS REQUIRED AND IS SET. overlayfs needs trusted.* or
# user.* xattrs on the upper filesystem; without it this mount fails with
# "upper fs does not support xattr". Verified present in the running kernel's
# own embedded config, not assumed.
#
# GATED ON THE COMMAND LINE, DEFAULT OFF. `veron.boot=system` switches root
# into dinit; anything else runs the tests and powers off exactly as before.
# The boot path is the one thing in this project that can only be tested at
# the END of a full run, so the old path stays reachable and a failure here
# falls back to it rather than leaving a kernel with no shell.
BOOTMODE=test
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in veron.boot=*) BOOTMODE="${w#veron.boot=}" ;; esac
done

if [ "$BOOTMODE" = system ] && [ "$VIA" != none ]; then
    echo "=== VERON-SWITCHROOT: read-only base, tmpfs overlay, dinit as PID 1 ==="
    OVL=/mnt/ovl
    if mkdir -p "$OVL" && mount -t tmpfs -o mode=0755 tmpfs "$OVL" 2>/dev/null \
       && mkdir -p "$OVL/upper" "$OVL/work" "$OVL/merged" \
       && mount -t overlay overlay \
            -o "lowerdir=$ROOT,upperdir=$OVL/upper,workdir=$OVL/work" \
            "$OVL/merged" 2>/dev/null; then
        echo "  VERON-OVERLAY-OK    lower=$VIA (ro)  upper=tmpfs"
        # /proc, /sys and /dev MOVE rather than being remounted: the new root
        # needs them and they are already correct. --move keeps the same
        # mount, so nothing is set up twice and nothing is lost.
        for m in proc sys dev; do
            mkdir -p "$OVL/merged/$m"
            mount --move "/$m" "$OVL/merged/$m" 2>/dev/null || \
                mount --bind "/$m" "$OVL/merged/$m" 2>/dev/null
        done
        if [ -x "$OVL/merged/sbin/dinit" ] || [ -x "$OVL/merged/usr/bin/dinit" ]; then
            DINIT=/sbin/dinit
            [ -x "$OVL/merged/sbin/dinit" ] || DINIT=/usr/bin/dinit
            echo "  VERON-SWITCHROOT-EXEC  $DINIT"
            exec switch_root "$OVL/merged" "$DINIT"
            # switch_root REPLACES this process. Reaching the next line means
            # it failed, and the message says which half.
            echo "  VERON-SWITCHROOT-FAIL  switch_root returned"
        else
            echo "  VERON-SWITCHROOT-FAIL  no dinit in the image"
        fi
    else
        echo "  VERON-OVERLAY-FAIL  could not assemble the overlay"
        echo "    tmpfs xattr support (CONFIG_TMPFS_XATTR) is what this needs"
    fi
    echo "  falling back to the test harness rather than leaving no shell"
fi

# ---- 3. run the stage 5 tests in it ------------------------------------
mkdir -p "$ROOT/proc" "$ROOT/tmp" "$ROOT/dev" 2>/dev/null
mount -t proc  none "$ROOT/proc" 2>/dev/null
mount -t tmpfs none "$ROOT/tmp"  2>/dev/null
# /dev MATTERS, and its absence was silently costing a test. GNU hello's
# atexit-1 needs /dev/full to provoke a write error; without it the suite
# reports SKIP rather than FAIL, so the guest quietly ran one fewer test than
# the runner -- 5 pass 2 skip against 6 pass 1 skip -- and nothing said why.
# A skip that nobody can explain is worth less than a failure that can be.
mount -t devtmpfs none "$ROOT/dev" 2>/dev/null \
    || mount --bind /dev "$ROOT/dev" 2>/dev/null

# ---- 3a. WHAT A COMPOSITOR WOULD NEED, MEASURED BEFORE ANYTHING NEEDS IT ---
#
# QEMU is given -device virtio-gpu-pci and -device virtio-keyboard-pci. Whether
# the guest SEES them is a property of this kernel, not of the command line,
# and it decides whether wlroots has anything to bind to:
#
#   /dev/dri/card0     the DRM device  -Dbackends=drm resolves against
#   /dev/input/event*  the evdev nodes libinput reads
#
# THE KERNEL SHIPS AS Image AND NOTHING ELSE. stage4-complete copies
# arch/arm64/boot/Image and never runs modules_install, and this system has no
# kmod and no modprobe -- so a symbol left at =m by arm64 defconfig is not
# merely unloaded, it does not exist. DRM_VIRTIO_GPU=m would be indistinguish-
# able from DRM_VIRTIO_GPU=n here.
#
# Reported, NOT enforced. Nothing today needs either node, and failing the
# boot over them would stop a green run for a capability no package uses yet.
# The point is to know the answer BEFORE six recipes are written against it --
# the same mistake as -Dbackends=auto, one layer down: a compositor that builds
# green and finds no device.
echo "=== VERON-GRAPHICS-PROBE: what this kernel gives a compositor ==="
if [ -e /dev/dri/card0 ]; then
    echo "  VERON-DRM-OK        /dev/dri/card0 present"
else
    echo "  VERON-DRM-ABSENT    no /dev/dri/card0 -- DRM or virtio-gpu is not"
    echo "                      built in. wlroots -Dbackends=drm has nothing"
    echo "                      to open; fix is set_cfg DRM y / DRM_VIRTIO_GPU y"
    echo "                      in stage4-complete, beside DEVTMPFS."
fi
if [ -e /dev/input/event0 ]; then
    echo "  VERON-EVDEV-OK      $(ls /dev/input/event* 2>/dev/null | wc -l) event node(s)"
else
    echo "  VERON-EVDEV-ABSENT  no /dev/input/event* -- INPUT_EVDEV or"
    echo "                      VIRTIO_INPUT is not built in. libinput reads"
    echo "                      these and nothing else."
fi
echo "  drm modules: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"

if [ -x "$ROOT/usr/bin/veron-stage5-test" ]; then
    echo "=== VERON-STAGE5-GUEST: the packages, under the kernel this chain built ==="
    echo "  root via: $VIA"
    chroot "$ROOT" /usr/bin/veron-stage5-test
else
    echo "VERON-STAGE5-GUEST-FAIL  no /usr/bin/veron-stage5-test in the root"
fi

# ---- 4. the self-rebuild gate ------------------------------------------
# The tier-1 claim: the system rebuilds itself, on itself, from source. Run
# LAST because it is the slow part and because a failure here is a different
# and weaker kind of bad news than the package tests failing -- those say the
# system is broken, this says some byte depends on the environment.
#
# The root is mounted read-only, so the rebuild needs writable scratch; the
# gate mounts its own tmpfs at the same paths the runner used.
# OPT-IN, AND VIA THE KERNEL COMMAND LINE rather than by leaving the script
# out of the image. If a test option changed what the image CONTAINS, the
# image hash would depend on it -- and the reproducibility claim is about the
# artifact, not about how it was exercised. So the payload always ships and
# the cmdline decides whether to use it.
#
# DEFAULT OFF. Rebuilding two small packages under TCG took twelve minutes.
# That does not scale, and it answers a question the runner already answers
# faster: G3 builds twice natively. This gate is for occasional confirmation,
# not for every push.
SELFREBUILD=0
grep -q 'veron.selfrebuild=1' /proc/cmdline 2>/dev/null && SELFREBUILD=1

if [ "$SELFREBUILD" = 1 ] && [ -x "$ROOT/veron/selfrebuild.sh" ]; then
    mount -o remount,rw "$ROOT" 2>/dev/null || true
    chroot "$ROOT" /veron/selfrebuild.sh
else
    echo "VERON-SELFREBUILD-SKIP  off by default (boot with veron.selfrebuild=1)"
fi

echo "VERON-STAGE5-GUEST-DONE"
poweroff -f
