#!/bin/busybox sh
# Stage 5's init. PID 1 in the guest.
#
# WHY STAGE 5 HAS ITS OWN. Stage 4's initramfs (spikes/stage4/bridge/
# rungs-sysroot.sh L1180) mounts the sysroot over 9p, runs ITS OWN eight
# t_* tests and a gcc-in-guest check, and exits. It knows nothing about
# stage 5, and teaching it would invert the dependency -- stage 4's job ends
# at "a booting system". So the stage-5 tests ran only under bwrap, and the
# QEMU output was entirely stage 4's.
#
# This also lets the guest boot the EXT4 IMAGE AS A DISK rather than only
# over a 9p share. That matters: the disk is the artifact a user would flash,
# and 9p is a development convenience. If virtio-blk or ext4 are missing from
# the kernel, this falls back to 9p and says so rather than failing.
#
# busybox is STATICALLY linked in the sysroot, so this initramfs is one
# binary and this script -- no loader, no libc, nothing to keep in sync.

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     none /proc  2>/dev/null
mount -t sysfs    none /sys   2>/dev/null
mount -t devtmpfs none /dev   2>/dev/null

echo "VERON-STAGE5-INIT"
echo "  kernel: $(uname -sr)"

ROOT=/mnt/root
mkdir -p "$ROOT"
VIA=none

# ---- 1. the real image, as a disk -------------------------------------
# The strongest available claim: this is the artifact, mounted the way a
# machine would mount it.
#
# veron.root= IS TRIED FIRST, AND IT EXISTS BECAUSE THE PROBE LIST CANNOT
# COVER REAL HARDWARE. /dev/vda, /dev/sda and /dev/vdb are what qemu presents
# and are enough for every boot this project runs itself. A laptop with an
# NVMe disk presents /dev/nvme0n1p5, which no list of plausible names will
# ever contain -- so the only way to boot the image from a partition is for
# the caller to say which one.
#
# WHY NOT root=, WHICH IS THE NAME THE KERNEL ALREADY USES. root= is consumed
# by the kernel when it mounts a root filesystem itself; this init runs from
# an initramfs and does the mounting, so the kernel never acts on it and two
# different things would be reading one parameter. A distinct name says who
# it is for. `veron.boot=` and `veron.net=` set that pattern already.
#
# THE LIST STILL RUNS IF THIS IS ABSENT OR FAILS. Every existing boot passes
# no veron.root= and behaves exactly as before -- this is one extra iteration
# of a loop that was already there.
VERON_ROOT=
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in veron.root=*) VERON_ROOT="${w#veron.root=}" ;; esac
done

for dev in $VERON_ROOT /dev/vda /dev/sda /dev/vdb; do
    [ -b "$dev" ] || continue
    if mount -t ext4 -o ro "$dev" "$ROOT" 2>/dev/null; then
        VIA="disk($dev)"
        echo "VERON-IMAGE-MOUNT-OK  $dev mounted ext4 read-only"
        break
    fi
done

# NAMED AND NOT THERE IS A DIFFERENT FAULT FROM NOT NAMED, and it is worth one
# line to separate them. A typo, a partition that is not ext4, and a kernel
# with no driver for the controller all produce the same silence otherwise.
if [ -n "$VERON_ROOT" ] && [ "$VIA" = none ]; then
    echo "VERON-ROOT-NAMED-FAIL  veron.root=$VERON_ROOT did not mount"
    if [ ! -b "$VERON_ROOT" ]; then
        echo "  it is not a block device in this kernel. Either the name is"
        echo "  wrong or the driver for its controller is not built in --"
        echo "  there are no modules in this image and nothing can be loaded."
    else
        echo "  it exists but did not mount as ext4 read-only."
    fi
    echo "  --- block devices this kernel can see ---"
    # /proc/partitions rather than lsblk: busybox has no lsblk applet here,
    # and this file exists whenever the block layer does.
    sed 's/^/    /' /proc/partitions 2>/dev/null || echo "    (no /proc/partitions)"
fi

# ---- 2. fall back to the 9p share --------------------------------------
if [ "$VIA" = none ]; then
    echo "VERON-IMAGE-MOUNT-SKIP  no ext4 block device -- virtio-blk or ext4"
    echo "  may not be in this kernel. Falling back to 9p, which proves the"
    echo "  TREE rather than the IMAGE."
    # msize matters: the default 9p transfer unit is small and the tools read
    # large files. Stage 4 learned this the same way.
    if mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=262144 \
             veronsysroot "$ROOT" 2>/dev/null; then
        VIA=9p
        echo "  9p sysroot mounted read-only"
    fi
fi

if [ "$VIA" = none ]; then
    echo "VERON-STAGE5-GUEST-FAIL  no root to test: neither disk nor 9p"
    poweroff -f
fi

# ---- 2.5 BOOT THE SYSTEM, IF ASKED --------------------------------------
#
# READ-ONLY BASE + tmpfs OVERLAY, WHICH IS THE LIVE-IMAGE DESIGN AND NOT AN
# INVENTION. OpenWrt mounts squashfs at /rom with a writable overlay on top;
# casper and live-boot do squashfs + tmpfs; Alpine's diskless mode runs
# entirely from RAM and persists only an explicit named blob. This is the
# same shape, with ext4 as the lower.
#
# WHY NOT A WRITABLE ROOT: the image on disk stays byte-identical to the one
# that was built, so `veron compare` against files.tsv works on a RUNNING
# system rather than being a claim about build time. That is the project's
# central claim, made checkable after boot.
#
# WHY tmpfs AND NOT A SECOND PARTITION: nothing needs to survive a reboot.
# There is no machine-id consumer, no sshd host keys, no passwords, no user
# data, no package manager. The first thing that will need persistence is
# FIDO2 credential enrollment, and a second partition can be added then --
# `AUTHENTICATION.md` records that. Persisting nothing is not a limitation
# here, it is an accurate description of the system.
#
# CONFIG_TMPFS_XATTR=y IS REQUIRED AND IS SET. overlayfs needs trusted.* or
# user.* xattrs on the upper filesystem; without it this mount fails with
# "upper fs does not support xattr". Verified present in the running kernel's
# own embedded config, not assumed.
#
# GATED ON THE COMMAND LINE, DEFAULT OFF. `veron.boot=system` switches root
# into dinit; anything else runs the tests and powers off exactly as before.
# The boot path is the one thing in this project that can only be tested at
# the END of a full run, so the old path stays reachable and a failure here
# falls back to it rather than leaving a kernel with no shell.
BOOTMODE=test
NETROLE=none
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in
      veron.boot=*) BOOTMODE="${w#veron.boot=}" ;;
      veron.net=*)  NETROLE="${w#veron.net=}" ;;
    esac
done

# ---- 2.4 THE TWO-VM ETHERNET TEST ---------------------------------------
#
# WHY TWO VMs AND NOT QEMU'S BUILT-IN DHCP. `-netdev user` (SLIRP) has a
# built-in DHCP server, and testing dhcpcd against it would be easier. It
# would also be testing SLIRP: a minimal server with fixed lease semantics
# that is not the code anyone ships. Two Veron instances on a plain L2 segment
# test the thing this project actually produces -- busybox udhcpd on one side,
# the packaged dhcpcd with its _dhcpcd privsep user on the other, iproute2 in
# between -- against each other.
#
# It is also hermetic and unprivileged. `-netdev socket` connects two QEMU
# processes directly: no TAP, no bridge, no /dev/net/tun, no CAP_NET_ADMIN,
# no host stack and no internet. It works the same on a GitHub runner and on a
# laptop. The kernel already has what it needs -- VIRTIO_NET=y and PACKET=y,
# confirmed in the published Image's own embedded config.
#
# EVERY MARKER NAMES WHAT IT MEASURED. "VERON-DHCP-OK" alone would be the
# reassuring-zero shape this project keeps finding, so the address is printed
# with it and a failure says which stage failed rather than that something did.
if [ "$NETROLE" != none ]; then
    echo "=== VERON-NET: two-VM ethernet, role=$NETROLE ==="
    NIC=
    for i in /sys/class/net/*; do
        n=${i##*/}
        [ "$n" = lo ] && continue
        NIC=$n; break
    done
    if [ -z "$NIC" ]; then
        # NOT "the test failed" -- the kernel produced no interface at all,
        # which is a different fault from DHCP not completing.
        echo "VERON-NET-FAIL  no non-loopback interface; VIRTIO_NET missing?"
    else
        echo "  interface: $NIC"
        ip link set "$NIC" up 2>/dev/null || ifconfig "$NIC" up 2>/dev/null
    fi
fi

if [ "$NETROLE" = server ] && [ -n "$NIC" ]; then
    # THE SERVER IS busybox udhcpd, WHICH COSTS NO PACKAGE. It is already in
    # the initramfs and in the image. dnsmasq or ISC dhcpd would be a truer
    # server and a new dependency; udhcpd is a real implementation and the
    # question here is whether OUR CLIENT works, not whose server is better.
    #
    # /tmp AND /var/lib/misc ARE CREATED FIRST, and the first version did not.
    # mkinitramfs makes bin, proc, sys, dev and mnt/root and nothing else, so
    # the config write failed with "can't create /tmp/udhcpd.conf: nonexistent
    # directory" -- and the run still printed VERON-NET-SERVER-UP, because the
    # marker came after the write with nothing between them checking it. That
    # is the reassuring-marker shape this project keeps finding, committed
    # here by the code that was supposed to be testing for it.
    mkdir -p /tmp /var/lib/misc
    ip addr add 10.42.0.1/24 dev "$NIC" 2>/dev/null
    : > /var/lib/misc/udhcpd.leases
    # WRITTEN WITH THE INTERFACE ALREADY SUBSTITUTED. The first version wrote
    # a placeholder and sed'd it afterwards, which is two chances to fail
    # instead of one.
    {
        echo "start           10.42.0.100"
        echo "end             10.42.0.120"
        echo "interface       $NIC"
        echo "lease_file      /var/lib/misc/udhcpd.leases"
        echo "option subnet   255.255.255.0"
        echo "option router   10.42.0.1"
        echo "option dns      10.42.0.1"
        echo "option lease    600"
    } > /tmp/udhcpd.conf
    if [ ! -s /tmp/udhcpd.conf ]; then
        echo "VERON-NET-SERVER-FAIL  could not write /tmp/udhcpd.conf"
    else
        # -f FOREGROUND so it does not daemonise out from under this script.
        udhcpd -f /tmp/udhcpd.conf 2>&1 | sed 's/^/    udhcpd: /' &
        _pid=$!
        # THE MARKER COMES AFTER THE PROCESS IS CONFIRMED ALIVE, not after it
        # is launched. udhcpd prints "started" even when its config is
        # missing, so "it ran" is not evidence that it is serving.
        sleep 1
        if kill -0 "$_pid" 2>/dev/null; then
            echo "VERON-NET-SERVER-UP  10.42.0.1 on $NIC, leases 10.42.0.100-120"
            # THE SERVER VM IS A FIXTURE AND MUST NOT PROCEED. The first
            # version fell through to the test harness, which finished in
            # about four seconds and powered the machine off -- so by the time
            # the client had booted and broadcast, there was nothing on the
            # other end of the socket. The client reported five DISCOVERs and
            # "no lease, failing", which looks exactly like a broken L2 link
            # and was in fact a server that had already gone home.
            #
            # Same shape as dinit in the system boot: a process whose job is
            # to keep running cannot be treated as a step that completes. It
            # waits here forever and the caller kills the VM when the client
            # is done.
            echo "VERON-NET-SERVER-WAIT  serving until killed; this VM runs no tests"
            wait "$_pid"
            echo "VERON-NET-SERVER-EXIT  udhcpd stopped"
            poweroff -f
        else
            echo "VERON-NET-SERVER-FAIL  udhcpd exited immediately"
        fi
    fi
fi

if [ "$NETROLE" = client ] && [ -n "$NIC" ]; then
    # THE CLIENT IS THE PACKAGED dhcpcd, NOT busybox udhcpc. udhcpc would
    # prove the link works and nothing about the package this test exists for.
    # -1 exits after one lease, -t bounds the wait, and the marker is emitted
    # from the ADDRESS THAT ARRIVED rather than from dhcpcd's exit status --
    # "it exited 0" and "the interface has an address" are different claims.
    #
    # AND IT LIVES IN THE IMAGE, NOT IN THE INITRAMFS, WHICH IS WHERE THIS
    # LOOKED FOR EVERY RUN SO FAR. This branch executes before switch_root, so
    # a bare `/usr/sbin/dhcpcd` resolves against the initramfs -- and
    # mkinitramfs.py packs exactly two things, busybox and this script. The
    # test reported
    #
    #     VERON-NET-FAIL  no /usr/sbin/dhcpcd in the image
    #
    # which was true of the initramfs and false of the image, and read as a
    # missing package. dhcpcd has been built and pinned throughout;
    # packages/dhcpcd/installs.txt lists usr/sbin/dhcpcd.
    #
    # chroot "$ROOT" IS HOW THIS FILE ALREADY RUNS IMAGE BINARIES. $ROOT is
    # mounted at line 37, long before here, and veron-stage5-test is invoked
    # the same way at the bottom. Running "$ROOT/usr/sbin/dhcpcd" directly
    # would not work: it is dynamically linked and would look for its loader
    # and libraries in the initramfs.
    #
    # THE INTERFACE IS THE KERNEL'S, NOT THE ROOT'S. chroot changes the
    # filesystem view and nothing else, so dhcpcd configures the same eth0
    # this script sees and the `ip` check below still observes the result.
    if [ -x "$ROOT/usr/sbin/dhcpcd" ]; then
        # dhcpcd NEEDS THESE MOUNTS INSIDE THE ROOT. /proc and /sys for
        # interface state, /run for its control socket and pid file, /dev for
        # the raw packet socket. The harness mounts the same set further down
        # for the same reason.
        mkdir -p "$ROOT/var/db/dhcpcd" 2>/dev/null
        mount -t proc  none "$ROOT/proc" 2>/dev/null
        mount -t sysfs none "$ROOT/sys"  2>/dev/null
        mount -t tmpfs none "$ROOT/run"  2>/dev/null
        mount --bind /dev "$ROOT/dev"    2>/dev/null
        chroot "$ROOT" /usr/sbin/dhcpcd -1 -t 30 "$NIC" 2>&1 \
            | sed 's/^/    dhcpcd: /'
    else
        echo "VERON-NET-FAIL  no /usr/sbin/dhcpcd under $ROOT (image not mounted?)"
    fi
    addr=$(ip -o -4 addr show dev "$NIC" 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p')
    case "$addr" in
      10.42.0.*)
        echo "VERON-DHCP-OK  $NIC has $addr from the server VM"
        # THE ROUTE AND A REAL PACKET, because an address alone does not mean
        # the two machines can talk. ping to the server is the one ICMP that
        # is meaningful here: both ends are ours and there is no NAT.
        ip route show | sed 's/^/    route: /'
        if ping -c 2 -W 3 10.42.0.1 >/dev/null 2>&1; then
            echo "VERON-NET-PING-OK  reached the server at 10.42.0.1"
        else
            echo "VERON-NET-PING-FAIL  have $addr but cannot reach 10.42.0.1"
        fi
        ;;
      "") echo "VERON-DHCP-FAIL  no IPv4 address on $NIC after dhcpcd" ;;
      *)  echo "VERON-DHCP-FAIL  $NIC has $addr, not from 10.42.0.0/24" ;;
    esac
fi

if [ "$BOOTMODE" = system ] && [ "$VIA" != none ]; then
    echo "=== VERON-SWITCHROOT: read-only base, tmpfs overlay, dinit as PID 1 ==="
    OVL=/mnt/ovl
    if mkdir -p "$OVL" && mount -t tmpfs -o mode=0755 tmpfs "$OVL" 2>/dev/null \
       && mkdir -p "$OVL/upper" "$OVL/work" "$OVL/merged" \
       && mount -t overlay overlay \
            -o "lowerdir=$ROOT,upperdir=$OVL/upper,workdir=$OVL/work" \
            "$OVL/merged" 2>/dev/null; then
        echo "  VERON-OVERLAY-OK    lower=$VIA (ro)  upper=tmpfs"

        # ---- /persist: THE ONE THING THAT SURVIVES A REBOOT -------------
        #
        # THE COMMENT ABOVE SAID "nothing needs to survive a reboot" AND
        # PREDICTED ITS OWN EXPIRY: "The first thing that will need
        # persistence is FIDO2 credential enrollment, and a second partition
        # can be added then." A wifi password arrived first. The shape is the
        # one that comment describes -- a second partition, not a writable
        # root -- so the central claim survives: the image on disk is still
        # byte-identical to the one that was built, and `veron compare`
        # against files.tsv still works on a running system.
        #
        # BY LABEL, NOT BY NUMBER. The partition is whatever the operator made
        # it -- on the test machine parted assigned p7, because p6 was already
        # an HP diagnostic partition even though the free space sat physically
        # between 5 and 6. A label is immune to that and to any later
        # repartitioning.
        #
        # ABSENT IS NOT AN ERROR. A machine with no persist partition boots
        # exactly as before and forgets everything at power-off, which is the
        # documented behaviour of every image built before this. The symlinks
        # below are made either way: they land on the tmpfs overlay when there
        # is nowhere else, so the same paths work and the writes are simply
        # not kept.
        PERSIST="$OVL/merged/persist"
        mkdir -p "$PERSIST"
        # THE LABEL IS READ OUT OF THE SUPERBLOCK RATHER THAN ASKED FOR.
        # findfs and blkid are both util-linux, and this busybox comes from
        # the stage-4 sysroot whose applet set is decided there -- neither is
        # guaranteed. An ext4 label lives at byte 0x478 of the superblock,
        # which starts at 1024, so it is 16 bytes at offset 1144 and dd can
        # read it.
        _pdev=
        for _c in /dev/nvme?n?p* /dev/sd?? /dev/vd??; do
            [ -b "$_c" ] || continue
            _lbl=$(dd if="$_c" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\0')
            [ "$_lbl" = "veron-persist" ] && { _pdev=$_c; break; }
        done
        if [ -n "$_pdev" ] && mount -t ext4 "$_pdev" "$PERSIST" 2>/dev/null; then
            echo "  VERON-PERSIST-OK    $_pdev at /persist"
            mkdir -p "$PERSIST/alsa"
            # THE AUTH STORE, BORN WITH THE MOUNT: machine credentials,
            # not user data -- enrolment (veron, 1000) writes, the auth
            # group (110) reads to verify, nobody walks a home to reach
            # them. See veron_confdir in veron-auth.
            #
            # TRAVERSAL ON /persist ITSELF, o+x, is the piece machine #1's
            # 2026-08-17 lockout was missing: the mount left /persist 0700
            # veron, so the greeter (uid 999) could not even enter it to
            # reach a correctly-grouped subdir. o+x grants pass-through,
            # not listing -- the store's own 0750 still gates who reads.
            chmod o+x "$PERSIST" \
                && echo "  VERON-PERSIST-TRAV  o+x set on $PERSIST" \
                || echo "  VERON-PERSIST-TRAV-FAIL  chmod o+x $PERSIST failed"
            mkdir -p "$PERSIST/veron-auth"
            # NUMERIC gid VIA sh, because this initramfs busybox chown may
            # not resolve the name `auth` (its /etc/group is the image's,
            # loaded later) and silently left the group `veron` -- the
            # exact symptom on machine #1. `.` separator + numeric both
            # sides is the form busybox chown always honors.
            # OWNERSHIP IS NOT TOUCHED HERE, AND THAT IS THE FIX.
            # guest/init runs in the initramfs, whose /etc/group has no
            # `auth` entry, so `chown 1000:110` could not resolve the gid
            # -- and busybox chown, given a gid it cannot map, RESET the
            # group to veron's primary (veron) every boot, CLOBBERING the
            # correct group that veron-enroll had set in the booted system.
            # That was machine #1's "enrol works, reboot breaks it" loop
            # (2026-08-17): image 1 showed group auth right after enrol,
            # image 2 showed group veron after the very next boot. So the
            # rule now: the initramfs sets ONLY what it can prove correct
            # (the mode and the setgid bit), and NEVER the group. The group
            # is auth, and only veron-enroll -- which runs where getgrnam
            # ("auth") works -- is allowed to set it. A never-yet-enrolled
            # store has no files to read anyway, so leaving its group alone
            # costs nothing.
            chmod 2750 "$PERSIST/veron-auth"
            # PROVE IT, LOUDLY: a store the greeter cannot read is a
            # lockout, so the boot log states the resulting ownership.
            chmod o+x "$PERSIST"   # re-assert: nothing between here and use may reset it
            echo "  VERON-AUTH-STORE    $(ls -ldn "$PERSIST" "$PERSIST/veron-auth" | awk '{print $1, $3, $4, $NF}' | tr '\n' ' ')"
        else
            echo "  VERON-PERSIST-NONE  no LABEL=veron-persist -- state is not kept"
        fi

        # THE SYMLINKS ARE MADE HERE AND NOT SHIPPED IN THE IMAGE, because a
        # symlink in the image would point into an empty directory on any
        # machine without the partition, and programs would create files there
        # that silently vanish. Made after the mount, they point at whatever
        # /persist actually is.
        #
        # -f BECAUSE THE OVERLAY MAY ALREADY CARRY A REAL FILE at either path
        # from the image, and a symlink is what is wanted.
        ln -sf /persist/wpa_supplicant.conf "$OVL/merged/etc/wpa_supplicant.conf"
        mkdir -p "$OVL/merged/var/lib/alsa"
        ln -sf /persist/alsa/asound.state "$OVL/merged/var/lib/alsa/asound.state"

        # THE LOADABILITY CHECK COMES BEFORE THE MOUNTS ARE MOVED.
        #
        # Ordering matters and got this wrong once already. The move loop
        # below relocates /proc, /sys and /dev OUT of this root and into the
        # overlay; that is correct on the path where switch_root succeeds and
        # ruinous on the path where it does not, because the fallback harness
        # then runs in a root with no /dev. The first version of this check
        # sat after the move, and the graphics probe duly reported
        #
        #   VERON-DRM-ABSENT    no /dev/dri/card0
        #   VERON-EVDEV-ABSENT  no /dev/input/event*
        #
        # on a kernel with CONFIG_DRM_VIRTIO_GPU=y, INPUT_EVDEV=y and a live
        # /dev/dri/card0 -- an absence manufactured entirely by the order of
        # two blocks. Nothing is moved until the exec is known to be worth
        # doing.
        DINIT=""
        for c in /sbin/dinit /usr/bin/dinit; do
            [ -x "$OVL/merged$c" ] && { DINIT=$c; break; }
        done
        if [ -z "$DINIT" ]; then
            echo "  VERON-SWITCHROOT-FAIL  no dinit in the image"
        else
            # THE EXECUTABLE BIT IS NOT LOADABILITY, AND -x SAID YES TO A
            # KERNEL PANIC. dinit is a PIE needing
            # /lib/ld-linux-aarch64.so.1. Booted against a root that shipped
            # dinit and no loader, `[ -x ]` passed, switch_root exec'd, and:
            #
            #   switch_root: can't execute '/usr/bin/dinit': No such file or
            #   directory
            #   Kernel panic - not syncing: Attempted to kill init!
            #
            # The ENOENT names the INTERPRETER, not dinit -- which is why it
            # reads as though the binary were missing when it was sitting
            # right there, executable, at the path in the message.
            #
            # AND THE FALLBACK BELOW WAS FICTION. `exec switch_root` replaces
            # this script, so once switch_root fails there is no init left to
            # fall back to: the comment above promised "a failure here falls
            # back rather than leaving a kernel with no shell", and what
            # happened was a panic. The check has to come BEFORE the exec,
            # because after it there is nothing left to check with.
            #
            # 126/127 ARE THE SHELL'S "CANNOT EXECUTE" AND "NOT FOUND". Any
            # other code means dinit loaded and merely disliked its
            # arguments, so this does not depend on dinit accepting
            # --version.
            chroot "$OVL/merged" /bin/sh -c "exec $DINIT --version" \
                >/dev/null 2>&1
            rc=$?
            if [ "$rc" = 126 ] || [ "$rc" = 127 ]; then
                echo "  VERON-SWITCHROOT-FAIL  $DINIT is present and"
                echo "    executable but cannot be LOADED -- almost always a"
                echo "    missing dynamic loader or shared library."
                # THE LOADER IS FOUND, NOT NAMED. This read
                # /lib/ld-linux-aarch64.so.1 literally, which is right on one
                # architecture and actively misleading on the other: on x86_64
                # the loader is /lib64/ld-linux-x86-64.so.2, so a healthy image
                # would have been told its loader "IS MISSING" by our own
                # diagnostic. A message that names the wrong file is worse than
                # no message -- it sends the next reader after a loader that
                # was never supposed to be there.
                #
                # The CHECK above is already architecture-neutral: rc 126/127
                # is the shell's "cannot execute", whatever the interpreter
                # was. Only the explanation was pinned to one arch.
                _ld=$(ls "$OVL"/merged/lib64/ld-linux-*.so.* \
                         "$OVL"/merged/lib/ld-linux-*.so.* \
                         "$OVL"/merged/lib/ld-musl-*.so.* 2>/dev/null | head -1)
                if [ -n "$_ld" ]; then
                    echo "    a loader IS present: ${_ld#$OVL/merged}"
                    echo "    so the missing piece is a shared library rather"
                    echo "    than the interpreter."
                else
                    echo "    NO DYNAMIC LOADER IN THE IMAGE at /lib or"
                    echo "    /lib64. Build the kit with \`veron loginkit\`,"
                    echo "    which resolves PT_INTERP and refuses this."
                fi
            else
                # /run IS MOUNTED BEFORE dinit STARTS, AND THAT IS NOT
                # COSMETIC ORDERING.
                #
                # dinit creates its control socket at startup, before it runs
                # a single service. /etc/fstab asks early-filesystems for a
                # tmpfs on /run -- which runs AFTER dinit is already up, so
                # the mount lands on top of the socket and hides it.
                # Measured, both ways, on the real kernel:
                #
                #   veron# ls -la /run/          (as shipped)
                #   total 0                      <- empty
                #   veron# dinitctl list
                #   dinitctl: connecting to socket: /run/dinitctl:
                #   No such file or directory
                #
                #   veron# ls -la /run/          (with /run out of fstab)
                #   srw------- 1 root root 0 dinitctl
                #   veron# dinitctl list
                #   [[+]     ] boot
                #   [{+}     ] early-filesystems
                #   [{+}     ] console (pid: 89)
                #
                # So the system booted and could not be inspected, controlled
                # or shut down cleanly, and nothing said why. `[  OK  ] boot`
                # was true and told you nothing about it.
                #
                # MOUNTED HERE RATHER THAN REMOVED FROM fstab. Dropping the
                # entry also works -- the overlay's upper is a tmpfs, so /run
                # is writable regardless -- but that makes /run's writability
                # a property of ONE BOOT PATH rather than of the system.
                # Mounting it here gives dinit a real tmpfs whichever way the
                # root arrived, and early-filesystems then SKIPS it, because
                # that script mounts what is missing rather than running
                # `mount -a`.
                mkdir -p "$OVL/merged/run"
                mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs \
                      "$OVL/merged/run" 2>/dev/null || \
                    echo "  VERON-RUN-WARN  no tmpfs on /run -- dinitctl will not connect"
                # /proc, /sys and /dev MOVE rather than being
                # remounted: the new root needs them and they are already
                # correct. --move keeps the same mount, so nothing is set up
                # twice and nothing is lost.
                for m in proc sys dev; do
                    mkdir -p "$OVL/merged/$m"
                    mount --move "/$m" "$OVL/merged/$m" 2>/dev/null || \
                        mount --bind "/$m" "$OVL/merged/$m" 2>/dev/null
                done
                echo "  VERON-SWITCHROOT-EXEC  $DINIT"
                exec switch_root "$OVL/merged" "$DINIT"
                # switch_root REPLACES this process. Reaching the next line
                # means it failed, and the message says which half.
                echo "  VERON-SWITCHROOT-FAIL  switch_root returned"
            fi
        fi
    else
        echo "  VERON-OVERLAY-FAIL  could not assemble the overlay"
        echo "    tmpfs xattr support (CONFIG_TMPFS_XATTR) is what this needs"
    fi
    echo "  falling back to the test harness rather than leaving no shell"
fi

# ---- 3. run the stage 5 tests in it ------------------------------------
mkdir -p "$ROOT/proc" "$ROOT/tmp" "$ROOT/dev" 2>/dev/null
mount -t proc  none "$ROOT/proc" 2>/dev/null
mount -t tmpfs none "$ROOT/tmp"  2>/dev/null
# /dev MATTERS, and its absence was silently costing a test. GNU hello's
# atexit-1 needs /dev/full to provoke a write error; without it the suite
# reports SKIP rather than FAIL, so the guest quietly ran one fewer test than
# the runner -- 5 pass 2 skip against 6 pass 1 skip -- and nothing said why.
# A skip that nobody can explain is worth less than a failure that can be.
mount -t devtmpfs none "$ROOT/dev" 2>/dev/null \
    || mount --bind /dev "$ROOT/dev" 2>/dev/null

# ---- 3a. WHAT A COMPOSITOR WOULD NEED, MEASURED BEFORE ANYTHING NEEDS IT ---
#
# QEMU is given -device virtio-gpu-pci and -device virtio-keyboard-pci. Whether
# the guest SEES them is a property of this kernel, not of the command line,
# and it decides whether wlroots has anything to bind to:
#
#   /dev/dri/card0     the DRM device  -Dbackends=drm resolves against
#   /dev/input/event*  the evdev nodes libinput reads
#
# THE KERNEL SHIPS AS Image AND NOTHING ELSE. stage4-complete copies
# arch/arm64/boot/Image and never runs modules_install, and this system has no
# kmod and no modprobe -- so a symbol left at =m by arm64 defconfig is not
# merely unloaded, it does not exist. DRM_VIRTIO_GPU=m would be indistinguish-
# able from DRM_VIRTIO_GPU=n here.
#
# Reported, NOT enforced. Nothing today needs either node, and failing the
# boot over them would stop a green run for a capability no package uses yet.
# The point is to know the answer BEFORE six recipes are written against it --
# the same mistake as -Dbackends=auto, one layer down: a compositor that builds
# green and finds no device.
echo "=== VERON-SANDBOX-PROBE: what this kernel gives a browser sandbox ==="
# WHAT wpewebkit's BUBBLEWRAP SANDBOX NEEDS FROM THE KERNEL, ASKED RATHER THAN
# ASSUMED. ENABLE_BUBBLEWRAP_SANDBOX=ON puts WPEWebProcess and
# WPENetworkProcess inside a bwrap container: a user namespace to drop
# privileges without being root, and seccomp to install the syscall filter
# libseccomp builds. Neither is set by stage 4's kernel config -- it sets
# DEVTMPFS, DRM, VIRTIO_GPU, EVDEV, 9P and OVERLAY_FS and nothing about
# namespaces -- so whether arm64 defconfig happens to supply them is unknown.
#
# A SANDBOX THAT SILENTLY DOES NOT ENGAGE IS WORSE THAN NO SANDBOX, because
# the browser still runs and nothing says the confinement is absent. This
# prints the answer on every boot.
if [ -e /proc/self/uid_map ]; then
    echo "  VERON-USERNS-OK     /proc/self/uid_map present"
    _m=$(cat /proc/sys/user/max_user_namespaces 2>/dev/null)
    echo "                      max_user_namespaces=${_m:-unset}"
else
    echo "  VERON-USERNS-ABSENT no /proc/self/uid_map -- CONFIG_USER_NS is off."
    echo "                      bwrap cannot create a container, so wpewebkit's"
    echo "                      sandbox will fail to start its web process."
    echo "                      Fix is set_cfg USER_NS y in stage 4."
fi
if grep -qa "^Seccomp:" /proc/self/status 2>/dev/null; then
    echo "  VERON-SECCOMP-OK    /proc/self/status reports Seccomp"
else
    echo "  VERON-SECCOMP-ABSENT  no Seccomp field -- CONFIG_SECCOMP is off, so"
    echo "                      the libseccomp filter has nothing to install."
    echo "                      Fix is set_cfg SECCOMP y in stage 4."
fi

echo "=== VERON-GRAPHICS-PROBE: what this kernel gives a compositor ==="
if [ -e /dev/dri/card0 ]; then
    echo "  VERON-DRM-OK        /dev/dri/card0 present"
else
    echo "  VERON-DRM-ABSENT    no /dev/dri/card0 -- DRM or virtio-gpu is not"
    echo "                      built in. wlroots -Dbackends=drm has nothing"
    echo "                      to open; fix is set_cfg DRM y / DRM_VIRTIO_GPU y"
    echo "                      in stage4-complete, beside DEVTMPFS."
fi
if [ -e /dev/input/event0 ]; then
    echo "  VERON-EVDEV-OK      $(ls /dev/input/event* 2>/dev/null | wc -l) event node(s)"
else
    echo "  VERON-EVDEV-ABSENT  no /dev/input/event* -- INPUT_EVDEV or"
    echo "                      VIRTIO_INPUT is not built in. libinput reads"
    echo "                      these and nothing else."
fi
echo "  drm modules: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ')"

if [ -x "$ROOT/usr/bin/veron-stage5-test" ]; then
    echo "=== VERON-STAGE5-GUEST: the packages, under the kernel this chain built ==="
    echo "  root via: $VIA"
    chroot "$ROOT" /usr/bin/veron-stage5-test
else
    echo "VERON-STAGE5-GUEST-FAIL  no /usr/bin/veron-stage5-test in the root"
fi

# ---- 4. the self-rebuild gate ------------------------------------------
# The tier-1 claim: the system rebuilds itself, on itself, from source. Run
# LAST because it is the slow part and because a failure here is a different
# and weaker kind of bad news than the package tests failing -- those say the
# system is broken, this says some byte depends on the environment.
#
# The root is mounted read-only, so the rebuild needs writable scratch; the
# gate mounts its own tmpfs at the same paths the runner used.
# OPT-IN, AND VIA THE KERNEL COMMAND LINE rather than by leaving the script
# out of the image. If a test option changed what the image CONTAINS, the
# image hash would depend on it -- and the reproducibility claim is about the
# artifact, not about how it was exercised. So the payload always ships and
# the cmdline decides whether to use it.
#
# DEFAULT OFF. Rebuilding two small packages under TCG took twelve minutes.
# That does not scale, and it answers a question the runner already answers
# faster: G3 builds twice natively. This gate is for occasional confirmation,
# not for every push.
SELFREBUILD=0
grep -q 'veron.selfrebuild=1' /proc/cmdline 2>/dev/null && SELFREBUILD=1

if [ "$SELFREBUILD" = 1 ]; then
    # THE PAYLOAD ARRIVES FROM OUTSIDE THE IMAGE, BECAUSE IT IS NOT PART OF
    # THE OPERATING SYSTEM.
    #
    # It used to live at /veron inside the root: the pinned tarballs, every
    # recipe, the policy and the driver -- 970 MiB, 21% of the image, read by
    # nothing in the running system. It also made the published image change
    # whenever the DRIVER changed, which is how two runs with byte-identical
    # package contents ended up with different IMAGE-SHA256 and nothing in
    # files.tsv able to say why.
    #
    # Attached over a second 9p share instead. The test is stronger this way:
    # it rebuilds a system it is not part of, rather than one carrying its own
    # verifier and its own expected-output manifest.
    #
    # READ-ONLY. Nothing here should write back to the runner's tree;
    # selfrebuild.sh mounts its own tmpfs on /build, /dest and /out.
    # PYTHONDONTWRITEBYTECODE stops the interpreter trying to leave .pyc files
    # on a read-only mount, which is a warning nobody needs to read.
    # MOUNTED UNDER $ROOT/tmp, WHICH IS ALREADY A tmpfs THIS SCRIPT PUT THERE.
    #
    # The obvious place is $ROOT/veron, and it does not work: the root is
    # mounted read-only, so `mkdir` fails and the mount has nowhere to land.
    # The previous code got away with it because /veron was baked into the
    # image, so the directory already existed.
    #
    # Using $ROOT/tmp also removes `mount -o remount,rw "$ROOT"`, which was
    # making the image WRITABLE to run a test against it -- the one thing the
    # read-only-base design exists to prevent. The test now cannot modify the
    # artifact it is measuring, which is a property worth having rather than a
    # side effect worth tolerating.
    #
    # READ-ONLY, and PYTHONDONTWRITEBYTECODE so the interpreter does not try
    # to leave .pyc files on it.
    mkdir -p "$ROOT/tmp/veron" 2>/dev/null
    if mount -t 9p -o trans=virtio,version=9p2000.L,ro,msize=262144 \
             veronpayload "$ROOT/tmp/veron" 2>/dev/null; then
        if [ -x "$ROOT/tmp/veron/selfrebuild.sh" ]; then
            # SET ON THE chroot ITSELF, NOT VIA /usr/bin/env. The first
            # version ran `chroot "$ROOT" /usr/bin/env VERON_PAYLOAD=... `,
            # with a `|| chroot ... selfrebuild.sh` fallback. The kit has no
            # /usr/bin/env, so the first form failed, the fallback ran WITHOUT
            # the variable, and selfrebuild dutifully reported
            # `VERON-SELFREBUILD-SKIP  no /veron payload` while the payload
            # was mounted three directories away. A fallback that drops the
            # one argument that matters is worse than no fallback.
            #
            # chroot(1) passes its environment through, so this needs nothing
            # from inside the image.
            VERON_PAYLOAD=/tmp/veron PYTHONDONTWRITEBYTECODE=1 \
                chroot "$ROOT" /tmp/veron/selfrebuild.sh
        else
            echo "VERON-SELFREBUILD-SKIP  payload mounted but has no selfrebuild.sh"
        fi
    else
        echo "VERON-SELFREBUILD-SKIP  no veronpayload 9p share offered."
        echo "  The payload is built beside the image, not inside it -- the"
        echo "  boot must attach it with -fsdev/-device mount_tag=veronpayload."
    fi
else
    echo "VERON-SELFREBUILD-SKIP  off by default (boot with veron.selfrebuild=1)"
fi

echo "VERON-STAGE5-GUEST-DONE"
poweroff -f
