#!/bin/busybox sh
# Run a Wayland session helper as a dinit service: build the session
# environment, wait for the compositor's socket, exec the program.
#
#     wayland-app /usr/bin/yambar -c /etc/xdg/yambar/config.yml
#
# WHY THE HELPERS ARE SERVICES NOW. They used to be labwc autostart
# entries, and cleanup of the previous session's copies was a pkill at the
# start of the NEXT session -- which races the old session's teardown, so
# anything not yet running when the pkill fired survived it. Verified on
# hardware: the pkill was present in the image and two yambars still stood
# after a restart. No placement of a kill fixes a race; ownership does.
# As dinit services with `depends-on = labwc`, stopping the compositor
# stops them by construction, and there is nothing left over to kill.
#
# READINESS IS THE SOCKET, BECAUSE THERE IS NO NOTIFY PROTOCOL. dinit
# considers a process service started the moment it is running, but labwc
# creates its wayland socket some time after exec -- so a helper started on
# the service dependency alone races the compositor and loses. The wait
# below is what "the session is ready" means here: the socket exists and is
# a socket. wayland-1.lock and friends are files beside it, which is why
# -S does the deciding rather than the glob.
#
# THE ENVIRONMENT IS REBUILT, NOT INHERITED, for the same reason
# labwc-session rebuilds it: dinit services get PID 1's environment. The
# values are the session's fixed points -- uid 1000's runtime dir and home
# -- and are the same ones labwc-session exports, which is what keeps a
# helper and its compositor in one world.
#
# exec, SO dinit SUPERVISES THE HELPER ITSELF. The helper dying (a VT
# switch takes the bar down, and it does not reconnect) is then a service
# exit, and `restart = true` in the service file is what brings it back --
# replacing the while-loop the autostart entry used to carry.
set -u

export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}
export HOME=/home/veron
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
# THE SAME TWO LINES labwc-session CARRIES, AND FOR THE SAME REASONS: a
# helper's CHILDREN inherit this environment -- the bar's launcher click
# spawns fuzzel, its terminal click spawns foot -- and without these the
# menu lists upstream .desktop files instead of the curated set in
# /usr/share/veron, and the terminal opens in dinit's OWN cwd, which is
# /etc/dinit.d (it chdirs there to load services and never leaves, and
# every service inherits it). Both seen on machine #1's FLASHED image,
# dinit-started bar, first click (2026-08-16): the uncurated menu and a
# shell born in the service directory.
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/share/veron:/usr/local/share:/usr/share}
# AND THE DINIT SOCKET, or the bar's children cannot manage services:
# dinitctl defaults to a per-user socket this system does not run, so a
# terminal spawned from the bar answered "perhaps no user instance is
# running?" to `dinitctl stop media` during the enrollment test
# (machine #1, 2026-08-16) -- while a keybind terminal, running under
# labwc-session's env (which exports this at line 65), would have
# worked. The two spawn paths must be one world.
export DINIT_SOCKET_PATH=${DINIT_SOCKET_PATH:-/run/dinitctl}
cd "$HOME" 2>/dev/null || cd / || true

if [ $# -lt 1 ]; then
    echo "wayland-app: nothing to run" >&2
    exit 1
fi

# UP TO 60 SECONDS, THEN FAIL AND SAY SO. A compositor that has not made a
# socket in a minute is not starting; exiting lets dinit's rate-limited
# restart own the retry instead of this script polling forever, and puts a
# line in the log instead of a helper silently absent.
# TENTHS, NOT SECONDS, AND THE LIVE SOCKET, NOT THE FIRST NAME. The waits
# below used `sleep 1`, twice: once for the socket, once for the output. That
# was one to two seconds of the bare compositor on the panel before the bar
# and the wallpaper arrived -- the "UI flashing" -- on every boot, for a
# readiness that is usually there within a tenth. Same 60-second budget,
# polled at 0.1s. And the socket glob took the FIRST wayland-* it found: if
# labwc had ever gone down uncleanly, a stale wayland-0 sat beside the live
# wayland-1, the helper connected to the corpse, died, was restarted into
# the same corpse, and dinit gave up -- a desktop with no bar and no
# background, "sometimes". A live compositor holds an flock on its
# wayland-N.lock; a stale one's lock is free. The held lock is the tell.
live_socket() {
    _pick=""
    for _s in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$_s" ] || continue
        [ -z "$_pick" ] && _pick=$_s
        if [ -e "$_s.lock" ]; then
            # flock -n fails (exit 1) when the compositor holds it: live.
            # An absent flock applet (exit 127) cannot decide; keep _pick.
            /bin/busybox flock -n "$_s.lock" /bin/busybox true 2>/dev/null
            [ $? -eq 1 ] && { _pick=$_s; break; }
        fi
    done
    [ -n "$_pick" ] && printf '%s\n' "$_pick"
}
n=0
while [ "$n" -lt 600 ]; do
    s=$(live_socket)
    if [ -n "$s" ]; then
        WAYLAND_DISPLAY=${s##*/}
        export WAYLAND_DISPLAY
        # AN OUTPUT IS PART OF "READY". The uevent feed means the socket can
        # appear before the first display does (the DRM connector landed
        # ~28s into machine #1's boot); yambar started in that window,
        # exited on "no monitors", and dinit's rate limiter rightly gave up
        # (2026-08-16). Wait for a lit connector inside the same budget; if
        # none comes, exec anyway and let dinit's restart own the rest.
        while [ "$n" -lt 600 ]; do
            /bin/busybox grep -qs '^enabled$' /sys/class/drm/card*/card*/enabled && break
            /bin/busybox sleep 0.1
            n=$((n + 1))
        done
        exec "$@"
    fi
    /bin/busybox sleep 0.1
    n=$((n + 1))
done
echo "wayland-app: no wayland socket in $XDG_RUNTIME_DIR after 60s" >&2
exit 1
