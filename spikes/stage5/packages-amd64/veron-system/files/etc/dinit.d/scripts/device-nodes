#!/bin/busybox sh
# Give the desktop user the device nodes seatd does not broker.
#
# WHY THIS EXISTS AT ALL. On a normal distribution udev applies rules that put
# /dev/snd/* in group audio and /dev/dri/* in group video. There is no udev in
# this image -- libudev-zero provides the API without the daemon -- so device
# nodes are whatever devtmpfs made them, which is root:root with the driver's
# own mode. For sound that is 0600, and a non-root desktop cannot open it.
#
# SEATD ALREADY COVERS THE HARD CASES AND THIS IS THE REMAINDER. seatd opens
# the DRM device and the evdev nodes itself and passes file descriptors over
# its socket, so the compositor needs no permission on /dev/dri/card0 or
# /dev/input/event*. ALSA has no such broker: alsa-lib opens /dev/snd/* by
# path, directly, in the process that wants sound.
#
# NOT A LOOP OVER EVERYTHING IN /dev. Only the nodes a desktop needs are
# touched, by name, because a script that regroups devices it was not asked
# about is how a permission mistake gets made quietly.
#
# HOTPLUG IS NOT HANDLED HERE, and that is a real limit worth stating: a USB
# sound card plugged in after boot gets root:root nodes and will not be
# openable by the desktop until this runs again. Fixing that properly means
# wiring busybox mdev as the kernel's hotplug helper, which is a separate
# change with its own failure modes.
set -u

echo "device-nodes: regrouping for the desktop user"

# THE FOUR SYMLINKS EVERY SHELL SCRIPT ASSUMES, AND WHICH NOTHING HERE WAS
# CREATING.
#
# devtmpfs makes device NODES. It does not make /dev/fd, /dev/stdin,
# /dev/stdout or /dev/stderr -- on an ordinary distribution those come from
# udev rules or from systemd, and this image has libudev-zero, which provides
# the API without the daemon and therefore without the rules. Same gap this
# script already exists to fill for /dev/snd permissions; it simply never
# covered these.
#
# WHAT BREAKS WITHOUT THEM IS PROCESS SUBSTITUTION, EVERYWHERE. `<(...)` is
# implemented as /dev/fd/N, so every script using it fails on a system where
# /dev/fd does not exist. Found on real hardware in the vault:
#
#     /usr/bin/pass: line 110: /dev/fd/63: No such file or directory
#     cat <(echo works)  ->  can't open '/dev/fd/64'
#
# pass carried on and prompted anyway, which is why this went unnoticed: the
# guest test for pass runs `pass version` and never reaches line 110. Nothing
# else in the image had exercised `<(...)` before.
#
# NOT A STRIPPING CASUALTY. The trim removes archives, headers and gcc's C++
# back-end; /dev is devtmpfs, mounted at boot, and no trim can touch it. This
# has been missing since the first boot.
#
# AND IT CANNOT BE FIXED BY HAND. devtmpfs is recreated empty on every boot,
# so a symlink made from a root shell is gone at the next start. It has to be
# made here, on every boot, by a service that runs as root.
for l in fd:/proc/self/fd stdin:/proc/self/fd/0 \
         stdout:/proc/self/fd/1 stderr:/proc/self/fd/2; do
    name=${l%%:*}
    target=${l#*:}
    if [ ! -e "/dev/$name" ]; then
        /bin/busybox ln -sf "$target" "/dev/$name" 2>/dev/null
    fi
done
# REPORTED, NOT ASSUMED. If /dev is read-only or the link cannot be made, the
# next line says so rather than leaving process substitution quietly broken
# for the life of the session.
if [ -e /dev/fd ] && [ -e /dev/stdin ]; then
    echo "  /dev/{fd,stdin,stdout,stderr} -> /proc/self/fd"
else
    echo "  WARNING: /dev/fd could not be created -- <(...) will not work"
fi

# SOUND. 0660 rather than 0666: group members only, which is the point of
# having a group. ABSENT IS NOT AN ERROR -- a machine with no sound card has
# no /dev/snd, and dinit treats a non-zero exit as a failed start on a service
# the session depends on.
if [ -d /dev/snd ]; then
    /bin/busybox chgrp -R audio /dev/snd 2>/dev/null
    # THE DIRECTORY NEEDS ITS EXECUTE BIT AND THE DEVICES DO NOT.
    #
    # `chmod -R 0660 /dev/snd` applied 0660 to /dev/snd ITSELF, and a directory
    # without +x cannot be traversed. The names still listed -- the directory
    # was readable -- but every stat inside failed:
    #
    #     ls: /dev/snd/controlC0: Permission denied
    #     alsamixer: cannot open mixer: Permission denied
    #
    # which reads as a device permission problem and is not one. 0750 on the
    # directory, 0660 on the character devices.
    /bin/busybox chmod 0750 /dev/snd 2>/dev/null
    /bin/busybox find /dev/snd -type c -exec /bin/busybox chmod 0660 {} + 2>/dev/null
    echo "  /dev/snd -> audio (dir 0750, nodes 0660)"
fi

# THE GPU RENDER NODE, which the browser's WebProcess opens for accelerated
# rendering. The kernel usually creates it 0666 already; this makes the
# grouping explicit so a driver that does not is not a silent regression.
if [ -e /dev/dri/renderD128 ]; then
    /bin/busybox chgrp render /dev/dri/renderD128 2>/dev/null
    /bin/busybox chmod 0660 /dev/dri/renderD128 2>/dev/null
    echo "  /dev/dri/renderD128 -> render 0660"
fi

# THE CARD NODE STAYS root:root ON PURPOSE. seatd opens it and hands over the
# descriptor; loosening it would give every process on the machine the ability
# to become DRM master and take the display, which is exactly what seatd
# exists to prevent.

# THE BACKLIGHT, which the bar's own buttons write. /sys/class/backlight/*/
# brightness is root-owned 0644 and the session is not root any more, so
# without this the bar reports VERON-BACKLIGHT-DENIED on every click. Group
# video already means "may drive the display" here, so it is the honest owner.
for bl in /sys/class/backlight/*/brightness; do
    [ -e "$bl" ] || continue
    /bin/busybox chgrp video "$bl" 2>/dev/null
    /bin/busybox chmod 0664 "$bl" 2>/dev/null
    echo "  $bl -> video 0664"
done

# dinit's CONTROL SOCKET, WHICH IS HOW Shut Down AND Restart WORK.
#
# /usr/sbin/shutdown does not halt anything itself -- it asks dinit to, over
# /run/dinitctl, and that socket is root-only. The power menu runs as the
# desktop user, so without this both entries silently do nothing, which is
# exactly the bug we just finished fixing for a different reason.
#
# WHAT THIS GRANTS, STATED PLAINLY: anyone in group power can start, stop and
# restart any service dinit knows about, and can shut the machine down. It
# does NOT let them run arbitrary commands as root -- dinit only executes the
# service files in /etc/dinit.d, which stay root-owned and unwritable. For a
# laptop whose console user is the person at the keyboard, that is a fair
# trade for not having a setuid binary.
if [ -S /run/dinitctl ]; then
    /bin/busybox chgrp power /run/dinitctl 2>/dev/null
    /bin/busybox chmod 0660 /run/dinitctl 2>/dev/null
    echo "  /run/dinitctl -> power 0660"
fi

# THE CONSOLE TTY, WHICH THE SHELL RUNS AS veron ON.
#
# devtmpfs creates /dev/tty* as root:tty 0620 -- writable by group tty, not
# readable -- and a getty needs both. This regroups the device the console
# service will actually use, which is tty2 when console= names a virtual
# terminal (the compositor has the one console= points at) and the serial line
# otherwise.
#
# THE SAME RULE THE SERVICE USES, DUPLICATED, AND THAT IS A REAL SMELL. If
# scripts/console-getty changes which device it picks and this does not, the
# console service fails to start with a permission error and nothing explains
# why. The right shape is one script exporting the choice; this is the smaller
# change and the duplication is written down rather than hidden.
CTTY=
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in console=*) CTTY="${w#console=}"; CTTY="${CTTY%%,*}" ;; esac
done
[ -n "$CTTY" ] || CTTY=tty1
case "$CTTY" in tty0|tty1) CTTY=tty2 ;; esac

if [ -c "/dev/$CTTY" ]; then
    /bin/busybox chgrp tty "/dev/$CTTY" 2>/dev/null
    /bin/busybox chmod 0660 "/dev/$CTTY" 2>/dev/null
    echo "  /dev/$CTTY -> tty 0660 (console shell)"
else
    echo "  /dev/$CTTY absent -- the console service will report it"
fi

# AND tty3, WHICH console-auth USES. devtmpfs makes every /dev/tty* root:tty
# 0620 -- group-writable, not group-readable -- and a getty needs to read as
# well as write. The console service's own tty is regrouped above; this is the
# same treatment for the authenticated console beside it, and leaving it out
# is a getty that dies with a permission error naming a device that plainly
# exists.
#
# NOT DERIVED FROM console=, DELIBERATELY. This one is a fixed VT precisely so
# that it cannot collide with whatever the console service picked.
if [ -c /dev/tty3 ]; then
    /bin/busybox chgrp tty /dev/tty3 2>/dev/null
    /bin/busybox chmod 0660 /dev/tty3 2>/dev/null
    echo "  /dev/tty3 -> tty 0660 (authenticated console)"
fi

# THE COMPOSITOR LOG, WHICH THE PERSON DEBUGGING IT MUST BE ABLE TO READ.
#
# dinit creates /run/labwc.log itself, as root, before dropping to veron for
# the service -- so the file is root-owned 0644 and the desktop user cannot
# read it. The CI desktop step hit exactly that:
#
#     veron# cat /run/labwc.log
#     cat: can't open '/run/labwc.log': Permission denied
#
# A log that only root can read, on a system with no way to become root, is a
# log nobody reads. Created here with the right owner so dinit appends to an
# existing file rather than making one.
if [ ! -e /run/labwc.log ]; then
    : > /run/labwc.log 2>/dev/null || true
fi
/bin/busybox chown veron:veron /run/labwc.log 2>/dev/null
/bin/busybox chmod 0644 /run/labwc.log 2>/dev/null
echo "  /run/labwc.log -> veron"

# THE HOME DIRECTORY, because /home is on the read-only image with a tmpfs
# overlay and nothing has created it. Owned by the user or nothing they run
# can write a config.
/bin/busybox mkdir -p /home/veron 2>/dev/null
/bin/busybox chown veron:veron /home/veron 2>/dev/null
/bin/busybox chmod 0700 /home/veron 2>/dev/null

# AND IT SURVIVES A REBOOT, IF THERE IS SOMEWHERE FOR IT TO SURVIVE.
#
# /home sits on the tmpfs overlay over a read-only image, so without this
# every downloaded file, every browser profile and every shell history is
# discarded at poweroff. That is correct for a live image and wrong for the
# machine someone actually uses.
#
# A BIND MOUNT, NOT A SYMLINK. HOME=/home/veron is exported by the session and
# baked into a dozen places; with a bind mount that path stays literally true
# and nothing -- not the browser, not glib's XDG lookup, not a shell -- has to
# know the storage is elsewhere. A symlink would leak /persist into every
# resolved path and into anything that calls realpath().
#
# THE WHOLE HOME, NOT A DOWNLOADS FOLDER. Persisting one directory would mean
# deciding, one at a time and forever, which parts of a home directory matter.
# The home directory is the unit a person thinks in.
#
# IT MUST HAPPEN BEFORE ANYTHING OPENS A FILE THERE. This service runs before
# labwc, so the mount is in place before the session, the browser or the bar
# can create anything in the tmpfs copy that the bind would then hide.
if [ -d /persist ]; then
    /bin/busybox mkdir -p /persist/home/veron 2>/dev/null
    /bin/busybox chown veron:veron /persist/home/veron 2>/dev/null
    /bin/busybox chmod 0700 /persist/home/veron 2>/dev/null
    if /bin/busybox mount --bind /persist/home/veron /home/veron 2>/dev/null; then
        echo "  /home/veron -> /persist/home/veron (persistent)"
    else
        echo "  /home/veron is on tmpfs -- the bind mount failed, nothing kept"
    fi
else
    # NAMED, NOT SILENT. A machine with no persist partition is a legitimate
    # configuration -- the live image is one -- but "my downloads disappeared"
    # should be answerable from the boot log rather than by experiment.
    echo "  /home/veron is on tmpfs -- no /persist, nothing is kept"
fi

# PERSISTENCE, IF THERE IS ANY. /persist is where wifi credentials and mixer
# state live. It is mounted by guest/init before dinit starts, root-owned; the
# desktop user needs to write it or a network entered once is forgotten.
if /bin/busybox mountpoint -q /persist 2>/dev/null || [ -d /persist ]; then
    /bin/busybox chown -R veron:veron /persist 2>/dev/null || true
    /bin/busybox chmod 0700 /persist 2>/dev/null || true
    echo "  /persist -> veron"
fi

exit 0
