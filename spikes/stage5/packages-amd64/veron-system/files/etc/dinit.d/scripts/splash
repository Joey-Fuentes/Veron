#!/bin/busybox sh
# The wallpaper, on the framebuffer, before anything else has a face --
# and again on the way down. RULED (Joe, 2026-08-18): boot and shutdown
# show no console chatter on the panel, black screen at worst, and the
# splash IS the desktop wallpaper so every transition's seam is visible
# to the eye that tests it: wallpaper (this, on fb0) -> wallpaper
# (labwc+swaybg, same pixels) -> mouse -> yambar. Serial stays verbose:
# ttyS0 is where the evidence lives, and the panel's silence is a
# loglevel decision (fragment v10), not a truncation.
#
# busybox fbsplash, PPM, drawn at the panel's top-left. The image is
# the shipped wallpaper.png converted once at authoring time -- swaybg
# reads PNG, fbsplash reads PPM, and shipping both spellings costs 3 MB
# against a slot with hundreds free.
set -u
[ -e /dev/fb0 ] || exit 0            # no framebuffer, nothing to paint
[ "${1:-}" = down ] && exec /bin/busybox fbsplash -s /usr/share/veron/wallpaper.ppm -d /dev/fb0
exec /bin/busybox fbsplash -s /usr/share/veron/wallpaper.ppm -d /dev/fb0
