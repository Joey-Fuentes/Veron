#!/bin/busybox sh
# veron-flashd -- the privileged half of the flasher, and the FIRST
# instance of the request->validate->apply boundary the no-privilege
# ruling implies (2026-08-18): the desktop asks, root decides, and the
# refusals are the security. The power service will be the second
# tenant of this pattern.
#
# PROTOCOL, DELIBERATELY DUMB: one FIFO, one verb.
#   FLASH   <image> <dev>                  -- removable targets ONLY
#   STREAM  <url> <zst-sha> <img-sha> <dev> -- download-and-write with
#     NOTHING STORED: slot A keeps ~100 MB free by ruling and persist is
#     256 MB, so an 870 MB archive plus a 4.2 GB image fits nowhere on
#     this appliance BY DESIGN (first on-device flash attempt proved it,
#     2026-08-18). The stream is hashed in flight against the archive
#     digest, the decompressed bytes are hashed on their way to the
#     device, and the device is READ BACK and hashed again -- three
#     digests, zero scratch, same byte-exact verdict.
#   INSTALL <image> <dev> <capacity-bytes> -- INTERNAL targets only, and
#     the request must state the target's exact capacity: the GUI reads
#     /sys, the service re-reads it, and a mismatch is a refusal. A
#     request cannot name a disk it has not looked at. This is the
#     bare-metal install path: booted from the live stick, the stick is
#     the sacred boot disk and the internal drive is the legal target.
#   RESTORE-PERSIST <backup-dir> <dev> -- the preserve half of maintenance
#     mode. After a reflash, copy the RAM-banked persist (written by
#     veron-maintenance-init before the pivot) into the freshly written
#     stick's persist partition, so user state survives a geometry change.
#     Writes a filesystem, not a raw image; targets p4 by PARTUUID on <dev>.
#   ARM-MAINTENANCE <preserve|discard> -- the privileged half of entering
#     maintenance mode. Mounts efivarfs, reads BootCurrent, and writes a
#     one-shot BootNext (via veron-efiboot clone-cmdline) whose command line
#     boots init=/usr/bin/veron-maintenance-init. The flasher measures RAM
#     fit first; this half needs root, which the flasher is not.
# Status streams to /run/veron-flash/status, world-readable, appended --
# the GUI tails it; so can a person with cat.
set -u
DIR=/run/veron-flash
mkdir -p "$DIR"
[ -p "$DIR/cmd" ] || /bin/busybox mknod "$DIR/cmd" p 2>/dev/null || /bin/busybox mkfifo "$DIR/cmd"
/bin/busybox chgrp veron "$DIR/cmd" 2>/dev/null || true
/bin/busybox chmod 620 "$DIR/cmd"
: > "$DIR/status"; /bin/busybox chmod 644 "$DIR/status"
say() { echo "$@" >> "$DIR/status"; }
# MAINTENANCE MODE inverts one rule. Normally an unknowable boot disk is a
# hard refusal -- the safe default when we cannot tell what we are running from.
# But the maintenance boot pivots root into a tmpfs on purpose, precisely so the
# stick STOPS being the root and becomes a legal target; there, root-is-RAM is
# expected and rootdisk being empty is the SIGNAL that the pivot worked, not a
# reason to refuse. We read the flag once, from the cmdline the maintenance boot
# was launched with, and let it relax exactly that one refusal below -- nothing
# else. Every other validation still applies to the stick in full.
maint=0
case " $(cat /proc/cmdline 2>/dev/null) " in *" veron.maintenance=1 "*) maint=1 ;; esac
[ "$maint" = 1 ] && say "veron-flashd: maintenance mode -- the boot device is a legal target"

while :; do
  # a FIFO read blocks until a writer arrives; one request at a time
  read -r verb a1 a2 a3 a4 < "$DIR/cmd" || { /bin/busybox sleep 1; continue; }
  case "$verb" in
    FLASH)   img=$a1; dev=$a2; want_cap= ;;
    INSTALL) img=$a1; dev=$a2; want_cap=$a3 ;;
    STREAM)  url=$a1; zsha=$a2; isha=$a3; dev=$a4; img=; want_cap= ;;
    RESTORE-PERSIST) backup=$a1; dev=$a2; img=; want_cap= ;;
    ARM-MAINTENANCE) mode=$a1; img=; want_cap= ;;
    *) say "REFUSED: unknown verb '$verb'"; continue ;;
  esac

  # ARM-MAINTENANCE stands entirely apart from the disk verbs: it writes no
  # disk, so it runs before the sacred-disk machinery. It arms the one-shot
  # boot into RAM that maintenance mode needs, and it is here in flashd -- the
  # root service -- because writing an EFI boot variable needs privilege the
  # flasher (the veron user, always unprivileged) does not have. The flasher
  # measured that the pivot fits in RAM before asking; this half is the part
  # only root can do.
  if [ "$verb" = "ARM-MAINTENANCE" ]; then
    case "$mode" in preserve|discard) : ;; *) say "REFUSED: ARM-MAINTENANCE mode must be preserve or discard"; continue ;; esac
    # efivarfs carries the boot variables and is not mounted at boot (nothing
    # needed it until now). Mount it read-write; without it BootCurrent cannot
    # be read nor a BootNext written.
    EV=/sys/firmware/efi/efivars
    if ! /bin/busybox mountpoint -q "$EV" 2>/dev/null; then
      /bin/busybox mount -t efivarfs efivarfs "$EV" 2>>"$DIR/status" \
        || { say "REFUSED: could not mount efivarfs -- EFI variables are unreachable"; continue; }
    fi
    # BootCurrent names the entry the firmware booted -- the one to clone so the
    # device path (disk, ESP partition, kernel file) is exactly right. It is a
    # 6-byte variable: 4 attribute bytes then the 2-byte little-endian number.
    bc="$EV/BootCurrent-8be4df61-93ca-11d2-aa0d-00e098032b8c"
    [ -r "$bc" ] || { say "REFUSED: BootCurrent is not present -- this firmware did not record the booted entry"; continue; }
    lo=$(/bin/busybox od -An -tu1 -j4 -N1 "$bc" | /bin/busybox tr -d ' ')
    hi=$(/bin/busybox od -An -tu1 -j5 -N1 "$bc" | /bin/busybox tr -d ' ')
    [ -n "$lo" ] && [ -n "$hi" ] || { say "REFUSED: could not read BootCurrent"; continue; }
    cur=$(printf '%04X' "$(( lo + hi * 256 ))")
    # Build the maintenance command line from the running one: keep everything,
    # drop the existing init= (and any stale maintenance flags), add ours.
    base=$(/bin/busybox sed -e 's/[[:space:]]*init=[^ ]*//g' \
                            -e 's/[[:space:]]*veron\.maintenance=[^ ]*//g' \
                            -e 's/[[:space:]]*veron\.persist=[^ ]*//g' /proc/cmdline)
    mcmd="$base init=/usr/bin/veron-maintenance-init veron.maintenance=1 veron.persist=$mode"
    say "arming a one-shot maintenance boot (cloning Boot$cur) ..."
    if ! /usr/bin/veron-efiboot clone-cmdline "Boot$cur" Boot0099 --cmdline "$mcmd" >>"$DIR/status" 2>&1; then
      say "REFUSED: could not write the maintenance boot entry"; continue
    fi
    if ! /usr/bin/veron-efiboot boot-next Boot0099 >>"$DIR/status" 2>&1; then
      say "REFUSED: wrote the entry but could not set BootNext"; continue
    fi
    say "ARMED: reboot to enter maintenance mode (persist=$mode)"
    continue
  fi

  # ---- VALIDATION IS THE PRODUCT ----------------------------------
  case "$dev" in *[!a-z0-9]*|"") say "REFUSED: '$dev' is not a device name"; continue ;; esac
  [ -b "/dev/$dev" ]            || { say "REFUSED: /dev/$dev is not a block device"; continue; }
  [ -e "/sys/block/$dev" ]      || { say "REFUSED: $dev is a partition, not a disk"; continue; }
  read -r rem < "/sys/block/$dev/removable" 2>/dev/null || rem=0
  # THE BOOT DISK IS SACRED UNDER EVERY VERB -- derived fresh, refused
  # by name, no exception exists or ever will.
  # THE NAME LIES, THE NUMBERS DO NOT. With no initramfs the kernel's
  # root mount reads "/dev/root" in /proc/mounts -- a name that strips
  # to nothing and matched nothing, and the first on-device run showed
  # the boot stick LISTED AS A TARGET (2026-08-18). So the sacred disk
  # is derived from major:minor via /sys, which cannot be aliased:
  # mountinfo field 3 -> /sys/dev/block/MAJ:MIN -> .../block/DISK/PART.
  rootmm=$(/bin/busybox awk '$5=="/"{print $3; exit}' /proc/self/mountinfo)
  rootlink=$(/bin/busybox readlink -f "/sys/dev/block/$rootmm" 2>/dev/null || echo "")
  case "$rootlink" in
    */block/*/*) rootdisk=$(echo "$rootlink" | /bin/busybox sed 's|.*/block/\([^/]*\)/.*|\1|') ;;
    */block/*)   rootdisk=$(/bin/busybox basename "$rootlink") ;;
    *)           rootdisk="" ;;
  esac
  # No knowable boot disk: a hard refusal on a normal boot (we will not guess),
  # but EXPECTED under maintenance mode, where root is a tmpfs by design and the
  # stick is meant to be writable. Only maintenance relaxes this; a normal boot
  # that cannot name its root still refuses everything.
  if [ -z "$rootdisk" ]; then
    if [ "$maint" = 1 ]; then
      say "maintenance mode: root is RAM, no sacred disk -- $dev is writable"
    else
      say "REFUSED: cannot determine the boot disk -- refusing everything rather than guessing"; continue
    fi
  else
    [ "$dev" != "$rootdisk" ]   || { say "REFUSED: $dev is the disk this system is running from"; continue; }
  fi
  cap=$(( $(cat "/sys/block/$dev/size") * 512 ))
  if [ "$verb" = "FLASH" ]; then
    [ "$rem" = "1" ]            || { say "REFUSED: $dev is not removable -- FLASH writes sticks, never internal disks. Installing to an internal disk is the INSTALL verb, with its own consent."; continue; }
  else
    # INSTALL: internal only, and the capacity handshake is the consent.
    [ "$rem" = "0" ]            || { say "REFUSED: $dev is removable -- INSTALL targets internal disks; use FLASH for sticks"; continue; }
    case "${want_cap:-}" in ''|*[!0-9]*) say "REFUSED: INSTALL requires the target's capacity in bytes"; continue ;; esac
    [ "$want_cap" = "$cap" ]    || { say "REFUSED: capacity mismatch -- request says $want_cap, $dev is $cap. The requester has not looked at this disk."; continue; }
    say "INSTALL consented: $dev, $cap bytes -- THIS ERASES EVERY OPERATING SYSTEM ON IT"
  fi
  if [ "$verb" = "STREAM" ]; then
    case "$zsha$isha" in *[!0-9a-f]*|"") say "REFUSED: STREAM needs both digests"; continue ;; esac
    say "streaming $url onto /dev/$dev -- nothing stored, three digests checked"
    for p in /dev/$dev?*; do /bin/busybox umount "$p" 2>/dev/null; done
    W=/run/veron-flash/work; /bin/busybox rm -rf "$W"; /bin/busybox mkdir -p "$W"
    /bin/busybox mkfifo "$W/zst" "$W/raw"
    # transport hash reads the archive tee; content hash reads the raw tee
    /bin/busybox sha256sum < "$W/zst" > "$W/zsha" &
    /bin/busybox sha256sum < "$W/raw" > "$W/isha" &
    if ! /usr/bin/curl -fsSL "$url" \
         | /bin/busybox tee "$W/zst" \
         | /usr/bin/zstd -dc \
         | /bin/busybox tee "$W/raw" \
         | /bin/busybox dd of="/dev/$dev" bs=4M conv=fsync 2>"$W/dd"; then
      say "STREAM FAILED during transfer -- $(tail -1 "$W/dd" 2>/dev/null)"; wait; continue
    fi
    wait
    got_z=$(/bin/busybox cut -d' ' -f1 "$W/zsha"); got_i=$(/bin/busybox cut -d' ' -f1 "$W/isha")
    nbytes=$(/bin/busybox awk '/bytes/{print $1; exit}' "$W/dd")
    [ "$got_z" = "$zsha" ] || { say "VERIFY FAILED: archive digest mismatch (got $got_z) -- the download was not the release"; continue; }
    [ "$got_i" = "$isha" ] || { say "VERIFY FAILED: image digest mismatch after decompress -- do not boot this stick"; continue; }
    say "stream digests OK ($nbytes bytes written); reading the device back ..."
    back=$(/bin/busybox dd if="/dev/$dev" bs=4M iflag=count_bytes count="$nbytes" 2>/dev/null | /bin/busybox sha256sum | /bin/busybox cut -d' ' -f1)
    if [ "$back" = "$isha" ]; then
      say "VERIFIED: /dev/$dev holds the release byte-for-byte ($nbytes bytes, read back and hashed)"
    else
      say "VERIFY FAILED on read-back: the device does not hold what was written -- do not boot it"
    fi
    continue
  fi
  if [ "$verb" = "RESTORE-PERSIST" ]; then
    # The preserve half of maintenance mode. veron-maintenance-init banked the
    # old persist into RAM before the pivot; after a fresh image lands on the
    # stick its persist partition (p4) is empty. This copies the RAM bank into
    # that new partition so user state survives a geometry-changing reflash.
    # It writes a FILESYSTEM, not a raw image, so it stands apart from FLASH.
    case "$backup" in /*) : ;; *) say "REFUSED: persist backup path must be absolute"; continue ;; esac
    [ -d "$backup" ]              || { say "REFUSED: no persist backup at $backup"; continue; }
    # p4 by PARTUUID on the freshly written stick; the kernel re-read the table
    # after the flash, so by-partuuid resolves to the new partition node.
    pnode=/dev/disk/by-partuuid/aaaa0004-0000-4000-8000-564552304e04
    [ -b "$pnode" ]              || { say "REFUSED: persist partition not found on the flashed stick yet"; continue; }
    # sanity: the persist partition must live on the disk we just flashed, not
    # some other disk that happens to carry the same PARTUUID.
    presolved=$(/bin/busybox readlink -f "$pnode" 2>/dev/null || echo "")
    case "$presolved" in
      /dev/"$dev"*) : ;;
      *) say "REFUSED: $pnode is not on /dev/$dev -- refusing to write persist to another disk"; continue ;;
    esac
    say "restoring persist onto $pnode (from $backup) ..."
    M=/run/veron-flash/persist-dst; /bin/busybox rm -rf "$M"; /bin/busybox mkdir -p "$M"
    if ! /bin/busybox mount "$pnode" "$M" 2>>"$DIR/status"; then
      say "RESTORE-PERSIST FAILED: could not mount the new persist partition"; continue
    fi
    if /bin/busybox cp -a "$backup"/. "$M"/ 2>>"$DIR/status"; then
      /bin/busybox sync
      /bin/busybox umount "$M"
      say "VERIFIED: persist restored to $pnode"
    else
      /bin/busybox sync; /bin/busybox umount "$M" 2>/dev/null
      say "RESTORE-PERSIST FAILED during copy -- persist may be incomplete"
    fi
    continue
  fi
  [ -f "$img" ]                 || { say "REFUSED: no such image: $img"; continue; }
  size=$(/bin/busybox stat -c %s "$img" 2>/dev/null || echo 0)
  [ "$size" -gt 1048576 ]       || { say "REFUSED: $img is implausibly small ($size bytes)"; continue; }
  [ "$size" -le "$cap" ]        || { say "REFUSED: image ($size) exceeds $dev ($cap)"; continue; }

  # ---- unmount anything the desktop auto-mounted, then write ------
  for p in /dev/$dev?*; do /bin/busybox umount "$p" 2>/dev/null; done
  say "writing $size bytes to /dev/$dev ..."
  if ! /bin/busybox dd if="$img" of="/dev/$dev" bs=4M conv=fsync 2>>"$DIR/status"; then
    say "FLASH FAILED during write -- the stick may be inconsistent"
    continue
  fi
  say "write complete; reading every byte back (the part dd cannot promise) ..."
  # cmp -n: the mount-diary lesson -- compare exactly the image's length,
  # and compare it BEFORE anything can auto-mount and scribble.
  if /bin/busybox cmp -n "$size" "$img" "/dev/$dev" >>"$DIR/status" 2>&1; then
    say "VERIFIED: /dev/$dev holds the image byte-for-byte ($size bytes read back)"
  else
    say "VERIFY FAILED: the stick does not hold what was written -- do not boot it"
  fi
done
