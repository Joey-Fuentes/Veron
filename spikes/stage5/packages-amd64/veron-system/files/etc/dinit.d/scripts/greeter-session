#!/bin/busybox sh
# The greeter's world, built from nothing: its own runtime dir (prepped
# root-side by the gate), the greeter config dir, and a PATH. No user
# environment, no user cwd, no dinit socket exported -- lock.c's media
# kick fails harmlessly here because the GATE kicks the mount itself.
set -u
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export XDG_RUNTIME_DIR=/run/greeter/run
export HOME=/var/lib/greeter
cd /
# THE CRASH NOTE LANDS WHERE veron CAN READ IT. The service's console
# logfile is root-owned; signal 6 taught us a greeter's last words are
# diagnosis (machine #1, 2026-08-16). The gate makes /run/greeter
# world-listable; this file is the greeter's own.
exec /usr/bin/labwc -C /etc/xdg/labwc-greeter 2>/run/greeter/labwc.log
