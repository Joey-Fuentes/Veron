#!/bin/busybox sh
# The greeter's world, built from nothing: its own runtime dir (prepped
# root-side by the gate), the greeter config dir, and a PATH. No user
# environment, no user cwd, no dinit socket exported -- lock.c's media
# kick fails harmlessly here because the GATE kicks the mount itself.
set -u
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export XDG_RUNTIME_DIR=/run/greeter/run
export HOME=/var/lib/greeter
# A LOGIN SCREEN MUST EXIST MORE THAN IT MUST BE FAST. The greeter's
# labwc refused software rendering and ABORTED (machine #1's log,
# 2026-08-16: "Software rendering detected, please use the
# WLR_RENDERER... to proceed", then the backend assertion, signal 6).
# With the render group fixed GL should come up; this makes the
# fallback a slower face instead of a corpse.
# PIXMAN, NOT just "allow software". WLR_RENDERER_ALLOW_SOFTWARE=1 only
# WHITELISTS the GLES2/EGL path to run on llvmpipe -- it still needs a
# working EGL/GBM stack and a render node the greeter can open, and when
# that failed the greeter fell to "Software rendering detected, please
# use WLR_RENDERER..." then aborted (signal 6 = a wlroots 0.19 teardown
# assertion firing because renderer init never completed). WLR_RENDERER=
# pixman selects the Pixman renderer, which composites on the CPU into
# DRM dumb buffers and needs NO EGL, NO GL, NO GPU access at all -- so a
# greeter with only a seat (no render-node/amdgpu access) always starts.
# A lock screen does trivial 2D; Pixman is the right tool and removes GPU
# probing, seat-master contention, and driver timing as failure modes.
# (2026-08-17 research: render/egl.c error branch + backend/backend.c
# assert wl_list_empty(new_input), wlroots commit 8f56f7ca, >=0.19.0.)
export WLR_RENDERER=pixman
export WLR_RENDERER_ALLOW_SOFTWARE=1
# BELT AND SUSPENDERS: if anything still reaches the GL path, force the
# whole Mesa stack to software so it cannot abort on a missing GPU.
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export WLR_BACKENDS=drm
# and make the greeter's home writable-cache location exist, or fontconfig
# and the shader cache spam "Permission denied" every frame (harmless but
# noisy, and a wedged cache dir can slow first paint).
/bin/busybox mkdir -p "$HOME/.cache" 2>/dev/null || true
cd /
# THE CRASH NOTE LANDS WHERE veron CAN READ IT. The service's console
# logfile is root-owned; signal 6 taught us a greeter's last words are
# diagnosis (machine #1, 2026-08-16). The gate makes /run/greeter
# world-listable; this file is the greeter's own.
exec /usr/bin/labwc -C /etc/xdg/labwc-greeter 2>/run/greeter/labwc.log
