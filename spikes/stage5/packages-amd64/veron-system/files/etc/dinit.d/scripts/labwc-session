#!/bin/busybox sh
# Start labwc with an environment dinit does not provide.
#
# dinit does NOT source /etc/profile -- that is a login shell's job -- so a
# service started at boot inherits PID 1's environment. That has no PATH worth
# using and, critically, no XDG_RUNTIME_DIR, which labwc treats as fatal at
# src/main.c:242 before it touches a DRM device.
set -u

# DEFAULT-DENY, AND THE SESSION IS THE ONE THAT DENIES. Three designs
# gated the boot from OUTSIDE this script -- an autostart lock, a
# supervised lock, a greeter orchestrator -- and each found a way to die
# reporting success (the greeter fell to signal 6 and the desktop stood
# anyway, machine #1, 2026-08-16). So the enforcement lives HERE now:
# this script, the only road to a user session, refuses to run while the
# machine is armed and no verified-boot marker exists. The marker is
# written by root's gate ONLY after the greeter's veron-lock returned 0;
# nothing unprivileged can mint it, and no failure anywhere can mint it
# either -- every crash, everywhere, now lands on the closed side.
# dinit restarts this service on exit; the rate-limited loop of refusals
# is a machine saying no, which is the design.
if /bin/busybox grep -qx 'autologin=off' /home/veron/.config/veron/auth.conf 2>/dev/null \
   && [ ! -f /run/veron-boot-authed ]; then
    echo "labwc-session: armed and unverified -- the session refuses to start"
    exit 1
fi

export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}

# XDG_DATA_DIRS, WHICH IS HOW THE LAUNCHER'S MENU IS CURATED.
#
# fuzzel lists .desktop files, and the only ones any package installs are
# foot, foot-server, footclient and yambar -- three variants of one terminal
# and something already running. That is not a menu. So /usr/share/veron holds
# Veron's own entries -- Browser, Files, Volume, Shut Down, Restart -- and also
# a NoDisplay=true copy of each of the four names above, which is the spec's
# own way of saying "installed, do not show in a menu" rather than deleting
# another package's file.
#
# THIS USED TO BE DONE WITH XDG_DATA_HOME AND THAT WAS THE WRONG VARIABLE.
# The curation worked -- the spec searches XDG_DATA_HOME first and a file found
# first wins -- but XDG_DATA_HOME is not a search path. It is where every
# application on the system is told to WRITE ITS OWN STATE, and pointing it at
# a shipped directory told WebKit, and anything else with a data store, to keep
# per-user data inside the image. Measured on the running system:
#
#     HOME=/  XDG_DATA_HOME=/usr/share/veron  XDG_CACHE_HOME=
#
# XDG_DATA_DIRS is the search path, it is searched in order, and the first hit
# still wins -- so naming /usr/share/veron ahead of the spec default gives
# exactly the same menu with none of the side effect. The default is the
# spec's, /usr/local/share:/usr/share, and it is spelled out rather than
# assumed for the same reason PATH is.
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/share/veron:/usr/local/share:/usr/share}

# AND THE PER-USER DIRECTORIES, WHERE THEY BELONG. /etc/passwd already says
# root's home is /root; nothing was establishing it, because the console shell
# is not a login shell and inherits whatever init had -- which is `/`. These
# are on the tmpfs overlay, so they are writable, and they vanish on reboot,
# which is what a stateless image should do rather than being unable to write
# at all.
# /home/veron, BECAUSE THIS RUNS AS veron NOW. dinit's run-as sets the uid but
# not the environment, so HOME would otherwise still be whatever PID 1 had.
export HOME=${HOME:-/home/veron}
case "$HOME" in /|/root) export HOME=/home/veron ;; esac
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" 2>/dev/null || :
# WAYLAND CLIENTS FIND THE COMPOSITOR THROUGH THIS. Without it labwc still
# creates wayland-0 in XDG_RUNTIME_DIR, but anything launched from autostart
# inherits whatever the service had -- naming it makes the socket a decision.
export XDG_SESSION_TYPE=wayland

# THE SYSTEM dinit SOCKET, FOR EVERY TERMINAL THE DESKTOP OPENS. /etc/profile
# exports this too -- for LOGIN shells, which a foot window launched from the
# session is not. Measured on hardware: a fresh desktop terminal's bare
# `dinitctl status` failed looking for /run/user/1000/dinitctl, the same
# mistake-shape as getty and HOME. Everything in the session inherits this
# process's environment, so the export belongs here beside the rest of it.
export DINIT_SOCKET_PATH=${DINIT_SOCKET_PATH:-/run/dinitctl}

# FLTK_SCHEME, FOR THE FLTK PROGRAM THIS PROJECT DOES NOT OWN.
#
# veron-about and veron-filechooser call veron_fltk_style() and set their own
# palette and box types. veron-edit is FLTK's own editor example, carried
# unmodified on purpose, so the only way to reach it is the environment.
#
# window->show(argc, argv) APPLIES IT WITHOUT ANY CODE. Fl_arg.cxx:326 calls
# Fl::scheme(Fl::scheme()), which with no scheme set is Fl::scheme(NULL), and
# that reads this variable (Fl_get_system_colors.cxx:198). The editor example
# uses that form, so it picks the scheme up for free.
#
# gleam RATHER THAN oxy. Both are flat-ish and modern; oxy averages its
# gradients toward FL_WHITE (fl_oxy.cxx:158), which on anything dark washes
# the surface out. gleam shades between two colours instead.
export FLTK_SCHEME=${FLTK_SCHEME:-gleam}
# WLR_RENDERER=pixman, AND IT IS THE COMPOSITOR SETTING THAT MAKES THE BROWSER
# RENDER. This is the least obvious line in the file, so:
#
# wpewebkit's web process picked the DMA-BUF buffer transport and could not
# allocate:
#
#     KMS: DRM_IOCTL_MODE_CREATE_DUMB failed: Permission denied
#     Failed to create GBM buffer of size 1024x768: Permission denied
#
# THE FIRST LINE IS MESA, NOT WEBKIT -- it does not appear anywhere in the
# wpewebkit tree. With no GPU, Mesa resolves the GBM device to kms_swrast,
# whose buffers are backed by KMS DUMB BUFFERS. CREATE_DUMB is a modeset
# ioctl: the kernel gates it on DRM MASTER and deliberately does not mark it
# DRM_RENDER_ALLOW, so it cannot be issued on a render node at all.
#
# WHICH IS WHY chmod DID NOT FIX IT. /dev/dri/renderD128 was set to
# root:video 0660 by early-filesystems and the error did not change by one
# character -- the ioctl was never going to the render node. DRM master is
# exclusive per device and labwc holds it; a second process cannot have it,
# root or not. This is not a permissions problem and no uid or mode fixes it.
#
# THE TRANSPORT IS CHOSEN BECAUSE THE COMPOSITOR OFFERS IT. WebProcessGLib.cpp
# :153 creates a GBM display whenever RendererBufferTransportMode::Hardware is
# set, and that is set because labwc advertises zwp_linux_dmabuf_v1. The
# escape hatch next to it, WEBKIT_DMABUF_RENDERER_DISABLE_GBM, is wrapped in
# `#if PLATFORM(GTK)` -- checked in our own tarball -- so it does NOTHING on
# the WPE port. There is no client-side variable to force shared memory.
#
# SO THE LEVER IS HERE. wlroots reads WLR_RENDERER at
# render/wlr_renderer.c:228; `pixman` selects the software renderer, which
# does not advertise dmabuf. WPE then negotiates wl_shm and presents through
# createWaylandBufferSHM in WPEViewWayland.cpp -- a path that needs no GPU and
# touches no DRM node.
#
# AND IT COSTS NOTHING WE HAVE. There is no GPU: mesa is already llvmpipe and
# labwc is already compositing on the CPU. This states that rather than
# routing it through a GBM allocator that cannot work.
export WLR_RENDERER=pixman
# AND THE SAME TRUTH ON THE CLIENT SIDE. WebProcessGLib.cpp:197 reads this and
# SkiaPaintingEngine.cpp:55 says what happens without it: "If
# WEBKIT_SKIA_ENABLE_CPU_RENDERING is unset, we will allocate a GPU-ONLY
# worker pool". There is no GPU, so that pool paints through llvmpipe by a
# longer route.
#
# THIS IS NOT THE FIX FOR THE GBM FAILURE -- painting and buffer transport are
# separate, and CPU painting still creates the GBM display. WLR_RENDERER above
# is what removes the allocation. This is here because it is CORRECT for a
# machine with no GPU, and because leaving the browser to discover that at
# runtime is the same class of omission as letting ninja pick its own -j.
export WEBKIT_SKIA_ENABLE_CPU_RENDERING=1
# LIBGL_ALWAYS_SOFTWARE=1 IS THE ONE THAT ACTUALLY STOPS THE GBM ALLOCATION,
# AND IT IS WPE'S OWN SWITCH RATHER THAN A MESA SIDE EFFECT.
#
# WPEDisplay.cpp:632 defines isSotfwareRast() -- upstream's typo -- which reads
# LIBGL_ALWAYS_SOFTWARE and accepts 1/y/yes/t/true. wpe_display_get_drm_device
# opens with:
#
#     if (isSotfwareRast())
#         return nullptr;
#
# and that nullptr is the whole mechanism. WebProcessPoolGLib.cpp:200 is
#
#     if (!parameters.drmDevice.isNull())
#         parameters.rendererBufferTransportMode.add(...Hardware);
#     ...
#     parameters.rendererBufferTransportMode.add(...SharedMemory);
#
# so a null device means Hardware is never added, SharedMemory is added
# unconditionally, and WebProcessGLib.cpp:153 never builds a GBM display.
#
# WHY THE EARLIER GUESS WAS WRONG. Hardware is NOT chosen because the
# compositor advertises zwp_linux_dmabuf_v1 -- it is chosen because
# drmMainDevice() returned something. DRMMainDevice.cpp:195 takes an EARLY
# RETURN under WPEPlatform, straight from wpe_display_get_drm_device(), so
# WEBKIT_WEB_RENDER_DEVICE_FILE below it is unreachable here too. Setting
# WLR_RENDERER=pixman changed labwc's renderer -- visible as new
# "libEGL: failed to create dri2 screen" lines -- and did not change the web
# process's device at all, which is why the CREATE_DUMB errors survived it.
#
# THE COMMENT IN DRMMainDevice.cpp:214 SAYS THIS IS EXPECTED: "If we can get
# the render node from EGL we should use that even if it's nullptr (WHICH IS
# THE CASE WITH SOFTWARE RASTERIZATION)". Software rasterisation having no DRM
# device is the designed state; this variable is how you declare it.
export LIBGL_ALWAYS_SOFTWARE=1
# THE CURSOR THEME, NAMED RATHER THAN GUESSED AT.
#
# wlroots/xcursor/xcursor.c:515 reads XCURSOR_PATH first, then falls back to
# XDG_DATA_HOME and a built-in directory. Naming the path means the lookup
# does not depend on XDG_DATA_HOME being set the way a desktop would set it,
# and naming the theme means we are not relying on a fallback to a theme
# called `default` -- which is precisely the lookup that failed:
#
#     Could not create cursor theme for 'default'
#     Could not load cursor theme, disabling named cursors support
#
# veron-cursors ships `default` as a symlink to left_ptr, so both the theme
# name and the cursor name now resolve.
# WLR_NO_HARDWARE_CURSORS=1, AND THIS IS THE ONE THAT MADE A CURSOR APPEAR.
#
# wlroots puts the cursor on a KMS HARDWARE CURSOR PLANE by default. On
# virtualised DRM drivers that plane needs a hotspot the old ioctls did not
# carry, so the kernel hides it from clients that have not opted in with
# DRM_CLIENT_CAP_CURSOR_PLANE_HOTSPOT -- and the result is a compositor that
# tracks the pointer perfectly and draws nothing. Measured here: the theme
# loaded ("Loaded cursor theme 'Veron'"), the pointer moved, and the screen was
# bare until this was set.
#
# IT IS NOT IMPLIED BY WLR_RENDERER=pixman. The renderer decides how the SCENE
# is composited; the cursor can still be routed to a separate plane
# independently. Two different decisions, and both have to be made.
#
# WITH IT, wlroots COMPOSITES THE CURSOR INTO THE FRAMEBUFFER it is already
# drawing -- the path this system uses for everything else, and the one it is
# known to do correctly here.
export WLR_NO_HARDWARE_CURSORS=1
export XCURSOR_PATH=/usr/share/icons
export XCURSOR_THEME=Veron
export XCURSOR_SIZE=24
# LANG IS SET HERE TOO BECAUSE dinit DOES NOT SOURCE /etc/profile. A service
# started at boot gets PID 1's environment, so the export in /etc/profile
# reaches a login shell and nothing else -- and everything labwc autostarts
# inherits from here.
export LANG=C.UTF-8

# cd $HOME BECAUSE EVERY CHILD INHERITS THIS PROCESS'S DIRECTORY. dinit runs
# its services from wherever it happens to be -- /etc/dinit.d -- and labwc
# passes that to the compositor, which passes it to every terminal, editor and
# browser launched from the bar. A new foot window opening in /etc/dinit.d is
# the visible symptom; the real one is that anything writing a relative path
# writes it into the service directory.
#
# THIS USED TO BE `cd /`, WHICH FIXED THE SERVICE DIRECTORY AND STOPPED THERE.
# The root of a read-only filesystem is no better a place to land than
# /etc/dinit.d: a terminal opens there, `ls` shows the whole system, and
# anything saved with a relative path goes to the top of the tree. Setting HOME
# does not move the working directory -- they are independent, which is why the
# variable read /home/veron while foot still opened in /.
#
# THE FALLBACK MATTERS. If /home/veron does not exist -- device-nodes failed,
# or this is a boot where the overlay is missing -- `cd` fails and the shell
# keeps /etc/dinit.d, which is the case this line exists to prevent. So / is
# the second choice rather than no choice.
cd "$HOME" 2>/dev/null || cd / || true


# TZ, BECAUSE WITHOUT IT EVERYTHING IS UTC AND ALMOST NOBODY IS.
#
# There is no /etc/localtime and no tzdata package, so glibc falls back to UTC.
# CreepJS shows the result plainly: locale en-US beside Coordinated Universal
# Time, on a machine whose address geolocates to the US east coast. A clock
# that disagrees with the IP is a signal bot detection weighs, and it is wrong
# for the person using the machine besides -- every timestamp reads four or
# five hours off.
#
# A POSIX TZ STRING, NOT A ZONE NAME. TZ=America/New_York needs
# /usr/share/zoneinfo/America/New_York and this image ships no zoneinfo at all;
# glibc silently falls back to UTC when the file is missing, so the wrong form
# fails invisibly. The POSIX form carries the offset and the DST rules inline
# and needs no file:
#
#   EST5EDT      standard is UTC-5, daylight is UTC-4
#   M3.2.0       DST starts the second Sunday in March
#   M11.1.0      and ends the first Sunday in November
#
# THAT ENCODES A LOCATION AND A LAW, WHICH IS THE COST. US rules changed in
# 2007 and could change again; a zone name would follow tzdata, this will not.
# It is also simply wrong for anyone not on US eastern time. Shipping tzdata
# and a real /etc/localtime is the correct answer and is a package this set
# does not have.
export TZ=${TZ:-EST5EDT,M3.2.0,M11.1.0}

# FAIL WITH A REASON, NOT A STACK TRACE. Each of these is a distinct fault with
# a distinct fix, and labwc's own error for the first two is about DRM rather
# than about what is actually missing.
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "labwc-session: $XDG_RUNTIME_DIR missing -- the xdg-runtime service"
    echo "  did not run or could not create it. dinitctl status xdg-runtime"
    exit 1
fi
if [ ! -S /run/seatd.sock ]; then
    echo "labwc-session: no /run/seatd.sock -- seatd is not running, so"
    echo "  wlroots cannot acquire a session and will report no DRM device."
    echo "  dinitctl status seatd"
    exit 1
fi
if [ ! -e /dev/dri/card0 ]; then
    # NOT A HARD EXIT. wlroots can fall back to other backends, and saying so
    # is more useful than refusing to start -- but the cause is worth naming
    # because the kernel side of it is recorded in KERNEL-CHANGES.md.
    echo "labwc-session: no /dev/dri/card0 -- DRM or virtio-gpu is absent from"
    echo "  this kernel. labwc -Dbackends=drm has nothing to open."
fi
if [ ! -x /usr/bin/labwc ]; then
    echo "labwc-session: no /usr/bin/labwc in this image"
    exit 1
fi

echo "labwc-session: starting labwc (runtime=$XDG_RUNTIME_DIR config=$XDG_CONFIG_DIRS)"
# exec SO dinit SUPERVISES labwc ITSELF rather than this wrapper. Without it
# dinit would watch a shell that had already finished its work, and killing
# the service would kill the wrapper and orphan the compositor.
#
# THE pkill OVER yambar/swaybg/fuzzel THAT USED TO SIT HERE IS GONE, AND
# NOTHING REPLACES IT IN THIS FILE. It ran at NEW session start, which races
# the OLD session's teardown -- anything not yet running when it fired
# survived it, and two yambars stood on one output with the pkill verifiably
# present in the image. No placement of a kill fixes a race; ownership does.
# yambar and swaybg are dinit services now (`depends-on = labwc`), so
# stopping the compositor stops them by construction and there is nothing
# left over for a kill to catch. fuzzel needed no cleanup to begin with: it
# is keybind-launched and exits with each use.
exec /usr/bin/labwc
