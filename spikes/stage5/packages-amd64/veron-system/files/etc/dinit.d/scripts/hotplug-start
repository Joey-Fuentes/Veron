#!/bin/busybox sh
# Start hotplug handling: the kernel uevent helper, or a loud nothing.
#
# THE MDEV DAEMON ROAD IS GONE, AND CI'S BOOT LOG IS WHY. The seed busybox
# turned out to have daemon mode, this script preferred it, and busybox
# mdev's rule engine applies a default root:root 0660 policy to EVERY
# uevent node it touches -- it fought devtmpfs over the whole of /dev
# until `getty: can't open '/dev/null': Permission denied` was printing
# between service starts and both consoles rate-limited to death. Making
# mdev safe would mean whitelisting the world in mdev.conf; the handler
# below only needs four subsystems and leaves everything else exactly as
# devtmpfs made it. Surgical beats general here.
#
# The kernel uevent-helper road execs scripts/hotplug-handler per event --
# input/hidraw/drm permissions, media mount on insertion, unmount on
# removal -- and touches nothing else. If CONFIG_UEVENT_HELPER is absent
# from this kernel, that is stated plainly and the service stays green:
# a loud absence instead of a crash loop, and the m131 enter-kick remains
# the mount path meanwhile.
H=/etc/dinit.d/scripts/hotplug-handler

if [ -w /proc/sys/kernel/hotplug ]; then
    echo "hotplug: kernel uevent helper -> $H"
    echo "$H" > /proc/sys/kernel/hotplug
    trap 'echo "" > /proc/sys/kernel/hotplug 2>/dev/null; exit 0' TERM INT
    while :; do /bin/busybox sleep 3600 & wait $!; done
fi

echo "VERON-HOTPLUG-NONE  /proc/sys/kernel/hotplug is not writable"
echo "  hotplugged devices keep devtmpfs defaults; insertion will not"
echo "  auto-mount. The enter-kick (m131) remains the mount path."
while :; do /bin/busybox sleep 86400 & wait $!; done
