#!/bin/busybox sh
# Start hotplug handling: register the kernel uevent helper, replay
# coldplug, and EXIT -- "started" now MEANS "every device present at boot
# has been announced and its module load attempted", which is what lets
# device-nodes and labwc genuinely depend on this service (dinit gates on
# a scripted service's exit, not on a process merely existing).
#
# THE MDEV DAEMON ROAD IS GONE, AND CI'S BOOT LOG IS WHY. The seed busybox
# turned out to have daemon mode, this script preferred it, and busybox
# mdev's rule engine applies a default root:root 0660 policy to EVERY
# uevent node it touches -- it fought devtmpfs over the whole of /dev
# until `getty: can't open '/dev/null': Permission denied` was printing
# between service starts and both consoles rate-limited to death. Making
# mdev safe would mean whitelisting the world in mdev.conf; the handler
# only needs modalias autoload plus four subsystems' permissions, and
# leaves everything else exactly as devtmpfs made it.
#
# THE COLDPLUG REPLAY IS THE HALF THAT MAKES IT AUTOMATIC. The handler
# only sees events that fire AFTER it is registered; everything the kernel
# discovered before this service ran -- which on a laptop is everything --
# would stay silent. Writing `add` to every uevent node re-announces the
# lot: each replayed event carries its MODALIAS, the handler modprobes it,
# and amdgpu/wifi/sound/webcam load with no human and no per-machine list.
# This is the mechanism the roadmap promised four times as "mdev is the
# answer"; the answer turned out to be forty lines and no mdev.
#
# Machine #1's proof, 2026-08-16: booted with a dead touchpad and mouse,
# no runtime root to modprobe them alive -- the exact hole this fills.
# THE REPLAY IS NARROW, AND THE MODULE LOADS ARE ONE CALL. The first replay
# wrote `add` to EVERY uevent under /sys/devices -- 404 of them in qemu,
# far more on a laptop -- and each write forks the handler: a shell, a
# modprobe that re-reads the whole modules.alias, the udev-zero helper, a
# chgrp. Hundreds of those at once, and labwc's start sits right behind
# this service -- so the desktop came up into a CPU storm and the bar and
# background stuttered in seconds later. What the replay actually has to
# deliver is two things: every boot-time MODALIAS handed to modprobe, and
# the kernel's helper registered for what comes later. The first is ONE
# `modprobe -a` over the aliases collected from sysfs (modprobe's own job,
# done once); the second is the sysctl. Per-subsystem permissions for
# boot-time nodes are device-nodes' job, so the only events worth re-
# announcing are the four subsystems the handler grants and block (for the
# media service) -- tens, not hundreds, and each one now does no modprobe.
H=/etc/dinit.d/scripts/hotplug-handler
if [ -w /proc/sys/kernel/hotplug ]; then
    echo "hotplug: kernel uevent helper -> $H"
    echo "$H" > /proc/sys/kernel/hotplug

    # 1. modules: every modalias present at boot, loaded in one modprobe.
    #    Sorted unique; modprobe -a -q skips what is built in or loaded.
    aliases=$(/bin/busybox find /sys/devices -name modalias -type f 2>/dev/null \
              | /bin/busybox xargs /bin/busybox cat 2>/dev/null \
              | /bin/busybox sort -u)
    na=$(printf '%s\n' "$aliases" | /bin/busybox grep -c .)
    [ -n "$aliases" ] && printf '%s\n' "$aliases" | /bin/busybox xargs /bin/busybox modprobe -a -q 2>/dev/null
    echo "hotplug: $na modalias entries handed to one modprobe"

    # 2. permissions: re-announce only the subsystems the handler acts on.
    #    /run/veron-coldplug, present for the duration, tells the handler
    #    this is the boot replay and not an insertion (no media start).
    : > /run/veron-coldplug
    n=0
    for c in input drm hidraw backlight block; do
        for u in /sys/class/$c/*/uevent; do
            [ -f "$u" ] || continue
            echo add > "$u" 2>/dev/null && n=$((n+1))
        done
    done
    # the helpers the kernel forked for those writes run asynchronously;
    # give them a moment before the mark goes, so none is mistaken for an
    # insertion. Then the mark is gone and every later event is real.
    /bin/busybox sleep 0.2
    rm -f /run/veron-coldplug
    echo "hotplug: coldplug replay complete ($n uevents re-announced in input drm hidraw backlight block)"
    exit 0
fi
echo "VERON-HOTPLUG-NONE  /proc/sys/kernel/hotplug is not writable"
echo "  boot-time devices keep devtmpfs defaults; modules will not"
echo "  autoload; insertion will not auto-mount."
exit 0
