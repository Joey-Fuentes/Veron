# The status bar, owned by dinit rather than by autostart.
#
# WHY IT MOVED. As an autostart entry its lifetime belonged to nobody:
# killing labwc left it running, restarting labwc started another, and the
# pkill meant to clean up raced the old session's teardown -- two yambars
# on one output, verified on hardware, with the pkill verifiably present in
# the image. `depends-on = labwc` gives the lifetime an owner -- measured on
# hardware as dinit REFUSING `dinitctl stop labwc` while this runs, naming
# this service and pointing at --force. Stop-the-desktop is therefore
# `dinitctl stop labwc --force`, which takes the dependents down with it;
# nothing stops implicitly, and after a compositor CRASH nothing is left
# for a kill to chase, because a dependent cannot outlive its dependency.
#
# THE OLD AUTOSTART ENTRY'S TWO JOBS ARE KEPT, JUST RELOCATED:
#   the while-loop      -> restart = true (see the measured VT-switch note
#                          below for what it does and does not cover)
#   the session env     -> scripts/wayland-app, which also waits for the
#                          compositor's socket, because dinit says "started"
#                          the moment labwc is running and the socket comes
#                          later
#
# -c IS STILL REQUIRED: yambar does not search XDG_CONFIG_DIRS -- it checks
# $HOME/.config and $XDG_CONFIG_HOME and stops (main.c, get_config_path) --
# so the shipped config must be named outright.
#
# logfile FOR THE SAME REASON labwc HAS ONE: a parse error names the line,
# and that message going nowhere is how a broken config looks like a bar
# that simply is not there.
#
# TWO MEASURED LIMITS, STATED PLAINLY. First: after a manual
# stop/start of the compositor, `dinitctl start labwc` does not restart this
# -- dinit starts dependencies, not dependents -- so start it by hand too.
# Second, THE VT SWITCH: the old autostart comment claimed yambar exits on a
# VT switch and does not reconnect. Measured on hardware, it does not exit
# either -- the boot-era process survives with its bar surface gone and
# never recreates it when the output returns, so `restart = true` has
# nothing to act on. `dinitctl restart yambar` brings the bar back in a
# second; why yambar ignores the output re-add is an upstream question,
# recorded rather than guessed at.
type = process
command = /bin/busybox sh /etc/dinit.d/scripts/wayland-app /usr/bin/yambar -c /etc/xdg/yambar/config.yml
run-as = veron
restart = true
logfile = /run/yambar.log
# logfile-permissions = 644, BECAUSE dinit FORCES 0600 OTHERWISE. dinit opens
# the log S_IRUSR|S_IWUSR (run-child-proc.cc) and, per dinit-service(5),
# resets an existing file's mode to this setting every time the service
# starts -- so the chmod 0644 device-nodes does at boot was undone the moment
# the service launched. The maintenance gate and boot-capture read this log
# as the unprivileged veron shell and got "Permission denied" on every run,
# which is why neither could report what libinput/the compositor did. This
# is dinit's own mechanism for making a service log readable; it holds.
logfile-permissions = 644
depends-on = labwc
depends-on = xdg-runtime
depends-on = device-nodes
