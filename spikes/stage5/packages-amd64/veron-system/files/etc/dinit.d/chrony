# chronyd: authenticated time.
#
# type = process, NOT bgprocess. chronyd forks by default; the script passes -n
# so dinit supervises the actual process rather than a pid file.
#
# IT GOES THROUGH A SCRIPT because /var/lib/chrony has to be owned by _chrony
# and that cannot be done at build time -- package builds are unprivileged, and
# the chown failed the whole stage 5 run with `Invalid argument` when it was
# attempted there.
type = process
command = /etc/dinit.d/scripts/chrony-start

# AFTER dhcp, BECAUSE NTS NEEDS DNS AND DNS NEEDS A LEASE. time.cloudflare.com
# has to resolve before any of this works, and a chronyd started before the
# network simply retries -- noisily, and for as long as it takes.
depends-on = dhcp
depends-on = early-filesystems

# RESTART, BECAUSE A CLOCK THAT STOPS BEING DISCIPLINED IS A CLOCK THAT DRIFTS.
# Unlike labwc, where restart = false is correct because a compositor that keeps
# dying should not loop forever, a time daemon losing its network should keep
# trying.
restart = true
restart-delay = 10

smooth-recovery = true
logfile = /run/chrony.log
