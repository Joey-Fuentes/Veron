# splash -- the wallpaper on the framebuffer from the GPU driver's handoff until
# labwc's first frame, and again at shutdown after labwc stops. Ordered after
# hotplug because the coldplug replay is what loads the real GPU driver, and
# a paint before that lands on the firmware framebuffer simpledrm is about to
# tear down (the black screen). labwc depends on this, so the panel never
# shows a black frame between the driver and the compositor.
type = scripted
command = /bin/busybox sh /etc/dinit.d/scripts/splash
stop-command = /bin/busybox sh /etc/dinit.d/scripts/splash down
restart = false
depends-on = early-filesystems
depends-on = hotplug
