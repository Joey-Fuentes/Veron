# The power boundary: the desktop writes poweroff|reboot into
# /run/veron-power/cmd; this root service performs it via dinit's own
# shutdown. See scripts/powerd. restart = true so a refused verb (the
# say-and-loop path) never leaves the machine without a power service.
type = process
command = /etc/dinit.d/scripts/powerd
restart = true
depends-on = early-filesystems
