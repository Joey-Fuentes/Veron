# Minimal login environment. PATH mirrors policy/defaults.toml's build PATH so
# a shell in the booted image resolves the same binaries the build did.
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
# THE PROMPT TELLS THE TRUTH ABOUT PRIVILEGE. `#` is the universal
# "you are root" signal and `$` means an ordinary user; this image's
# entire design is that the desktop account is uid 1000, NOT root, so a
# hardcoded `veron# ' misreported every console all the way through
# machine #1's bring-up (2026-08-17) -- a `whoami` said `veron` under a
# `#` prompt. Keyed on the real uid now: root (0) keeps `#`, everyone
# else gets `$`. busybox sh evaluates this at each login.
if [ "$(id -u)" = 0 ]; then
    export PS1='veron# '
else
    export PS1='veron$ '
fi
export TERM=${TERM:-linux}

# XDG_RUNTIME_DIR, CREATED BY THE xdg-runtime SERVICE AND EXPORTED HERE.
#
# A Wayland compositor will not start without it: labwc's src/main.c:242
# exits EXIT_FAILURE outright if the variable is unset, before it touches a
# DRM device or reads a config file. So this is the difference between
# "labwc is installed" and "labwc runs".
#
# THE DIRECTORY IS NOT CREATED HERE. Creating it in the login shell would
# make it exist only for interactive logins, and a compositor launched any
# other way would still fail. The service owns the directory; this exports
# where it is. If the service failed, the variable points at nothing and
# labwc says so -- which is better than this script silently making one.
# /run/user/1000, MATCHING THE uid THE DESKTOP RUNS AS.
#
# This said /run/user/0 after the session moved to uid 1000, and the directory
# it named no longer existed. A login shell therefore had XDG_RUNTIME_DIR
# pointing at nothing, and anything launched from it that needs the compositor
# failed with a message about the DISPLAY rather than about the variable:
#
#     Failed to connect to display of type wpe-display-veron:
#     veron: no Wayland display
#
# The compositor was running the whole time. Only the shell could not find it.
export XDG_RUNTIME_DIR=/run/user/1000

# WAYLAND_DISPLAY, WHICH NOTHING IN THIS SYSTEM SET AT ALL.
#
# wl_display_connect(NULL) reads this variable, and every graphical program
# here goes through it. labwc exports it to processes IT spawns, but a shell
# on a VT is a separate dinit service and inherits nothing from the
# compositor -- so anything launched from a terminal died with
#
#     Failed to connect to display of type wpe-display-veron:
#     veron: no Wayland display
#
# which reads as a backend fault and is a missing environment variable. Fixing
# XDG_RUNTIME_DIR alone was not enough: the runtime dir says WHERE to look and
# this says WHAT to look for, and both have to be right.
#
# THE SOCKET IS DISCOVERED, NOT ASSUMED. labwc takes wayland-0 when it is
# free and wayland-1 if something else holds it, so hardcoding wayland-0 is
# right until the day it is not. The first socket in the runtime directory is
# the compositor's; if there is none, the variable is left unset and the
# error message is the honest one about there being no display.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for _sock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        case "$_sock" in *.lock) continue ;; esac
        [ -S "$_sock" ] || continue
        WAYLAND_DISPLAY=${_sock##*/}
        export WAYLAND_DISPLAY
        break
    done
    unset _sock
fi

# XDG_CONFIG_DIRS, BECAUSE labwc INSTALLS ITS CONFIG AS DOCUMENTATION.
#
# meson.build:27 puts rc.xml, menu.xml and themerc in
# share/doc/labwc/ -- they are examples, not defaults, and nothing lands in
# /etc/xdg. labwc's src/common/dir.c:28 searches XDG_CONFIG_HOME then
# XDG_CONFIG_DIRS, so Veron's own copies go in /etc/xdg and this names it.
# Stated rather than left to the spec default for the same reason PATH is:
# a default that happens to be right is not a decision.
export XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}

# XDG_DATA_DIRS, WHICH IS HOW THE LAUNCHER'S MENU IS CURATED.
#
# fuzzel lists .desktop files, and the only ones any package installs are
# foot, foot-server, footclient and yambar -- three variants of one terminal
# and something already running. That is not a menu. So /usr/share/veron holds
# Veron's own entries -- Browser, Files, Volume, Shut Down, Restart -- and also
# a NoDisplay=true copy of each of the four names above, which is the spec's
# own way of saying "installed, do not show in a menu" rather than deleting
# another package's file.
#
# THIS USED TO BE DONE WITH XDG_DATA_HOME AND THAT WAS THE WRONG VARIABLE.
# The curation worked -- the spec searches XDG_DATA_HOME first and a file found
# first wins -- but XDG_DATA_HOME is not a search path. It is where every
# application on the system is told to WRITE ITS OWN STATE, and pointing it at
# a shipped directory told WebKit, and anything else with a data store, to keep
# per-user data inside the image. Measured on the running system:
#
#     HOME=/  XDG_DATA_HOME=/usr/share/veron  XDG_CACHE_HOME=
#
# XDG_DATA_DIRS is the search path, it is searched in order, and the first hit
# still wins -- so naming /usr/share/veron ahead of the spec default gives
# exactly the same menu with none of the side effect. The default is the
# spec's, /usr/local/share:/usr/share, and it is spelled out rather than
# assumed for the same reason PATH is.
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/share/veron:/usr/local/share:/usr/share}

# AND THE PER-USER DIRECTORIES, WHERE THEY BELONG. /etc/passwd already says
# root's home is /root; nothing was establishing it, because the console shell
# is not a login shell and inherits whatever init had -- which is `/`. These
# are on the tmpfs overlay, so they are writable, and they vanish on reboot,
# which is what a stateless image should do rather than being unable to write
# at all.
export HOME=${HOME:-/root}
[ "$HOME" = "/" ] && export HOME=/root
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" 2>/dev/null || :

# THE LOCALE, WITHOUT WHICH A TERMINAL IS ASCII-ONLY.
#
# glibc defaults to "C" when nothing is set, and C is not a UTF-8 locale. foot
# says so in its own window -- "'C' is not a UTF-8 locale, and failed to find a
# fallback" -- which is how this was noticed: the first working screenshot
# showed a rendered desktop with an error banner in the terminal.
#
# C.UTF-8 is generated at build time by veron-system's locale step; glibc's
# localedef and the C locale source are both in the stage-4 sysroot, so this
# needed no new package.
#
# LANG RATHER THAN LC_ALL. LC_ALL is an override that a user cannot then
# adjust per-category; LANG is the default that LC_* variables refine, which
# is what a system-wide setting should be.
# THE SYSTEM dinit SOCKET, BECAUSE dinitctl DEFAULTS TO THE USER ONE AND THIS
# SYSTEM HAS NO USER INSTANCE.
#
# The privilege model here is that there is no root shell at all: members of
# the `power` group act on root-owned services through /run/dinitctl. But a
# bare `dinitctl start labwc` looks for /run/user/1000/dinitctl and fails with
#
#     dinitctl: connecting to socket: /run/user/1000/dinitctl: No such file
#     dinitctl: perhaps no user instance is running?
#
# -- so the documented way to obtain privilege did not work without a flag
# nobody would guess. Found while trying to restart a compositor from a
# console, which is exactly when a person can least afford to guess.
#
# SET, NOT FORCED. Anything that genuinely wants a user instance can override
# it; this only supplies the default the group membership implies.
export DINIT_SOCKET_PATH=${DINIT_SOCKET_PATH:-/run/dinitctl}

export LANG=C.UTF-8

# TZ, BECAUSE WITHOUT IT EVERYTHING IS UTC AND ALMOST NOBODY IS.
#
# There is no /etc/localtime and no tzdata package, so glibc falls back to UTC.
# CreepJS shows the result plainly: locale en-US beside Coordinated Universal
# Time, on a machine whose address geolocates to the US east coast. A clock
# that disagrees with the IP is a signal bot detection weighs, and it is wrong
# for the person using the machine besides -- every timestamp reads four or
# five hours off.
#
# A POSIX TZ STRING, NOT A ZONE NAME. TZ=America/New_York needs
# /usr/share/zoneinfo/America/New_York and this image ships no zoneinfo at all;
# glibc silently falls back to UTC when the file is missing, so the wrong form
# fails invisibly. The POSIX form carries the offset and the DST rules inline
# and needs no file:
#
#   EST5EDT      standard is UTC-5, daylight is UTC-4
#   M3.2.0       DST starts the second Sunday in March
#   M11.1.0      and ends the first Sunday in November
#
# THAT ENCODES A LOCATION AND A LAW, WHICH IS THE COST. US rules changed in
# 2007 and could change again; a zone name would follow tzdata, this will not.
# It is also simply wrong for anyone not on US eastern time. Shipping tzdata
# and a real /etc/localtime is the correct answer and is a package this set
# does not have.
export TZ=${TZ:-EST5EDT,M3.2.0,M11.1.0}

# NO GPU, SO SKIA PAINTS ON THE CPU. SkiaPaintingEngine.cpp:55: "If
# WEBKIT_SKIA_ENABLE_CPU_RENDERING is unset, we will allocate a GPU-ONLY
# worker pool". mesa here is llvmpipe, so that pool reaches the same CPU by a
# longer route.
#
# IT IS SET IN TWO PLACES ON PURPOSE. labwc-session sets it for everything the
# compositor autostarts; this sets it for anything launched from a LOGIN
# SHELL, which is how the screenshot test starts MiniBrowser and how a user
# would start it by hand. dinit does not source /etc/profile, so neither
# location covers the other.
export WEBKIT_SKIA_ENABLE_CPU_RENDERING=1
# AND THE VARIABLE THAT ACTUALLY REMOVES THE GPU BUFFER PATH.
# WPEDisplay.cpp:632 reads LIBGL_ALWAYS_SOFTWARE and makes
# wpe_display_get_drm_device() return nullptr, which makes
# WebProcessPoolGLib.cpp:200 skip RendererBufferTransportMode::Hardware and
# leaves only SharedMemory -- so the web process presents through wl_shm and
# never asks Mesa for a GBM buffer it cannot allocate.
#
# Set here as well as in labwc-session because dinit does not source this
# file: labwc-session covers what the compositor autostarts, this covers a
# login shell, and neither covers the other.
export LIBGL_ALWAYS_SOFTWARE=1
