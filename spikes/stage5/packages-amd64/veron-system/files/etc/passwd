root:x:0:0:root:/root:/bin/sh
# THE DESKTOP RUNS AS THIS ACCOUNT, NOT AS ROOT.
#
# Everything used to run as uid 0: the compositor, the bar, the terminal and
# the browser. A WebKit bug was therefore a whole-machine compromise on a
# system with a writable /persist -- and a browser is the single largest piece
# of attack surface in this image by a wide margin.
#
# uid 1000 IS THE CONVENTION AND NOT AN ARBITRARY NUMBER: it is the first
# non-system uid on every Linux distribution, so anything that heuristically
# distinguishes "a person" from "a daemon" gets the right answer.
#
# THE SHELL IS REAL. This account is meant to be usable from the terminal the
# desktop starts, so /bin/false would break foot.
veron:x:1000:1000:veron:/home/veron:/bin/sh
# THE GREETER RUNS THE CREDENTIAL UI AND NOTHING ELSE. A separate uid so
# a compromised login screen holds no user data: its home is empty, its
# shell is false, and its groups admit it to the seat and to reading the
# auth records -- not to the person's files, the network state, or dinit.
greeter:x:999:999:session greeter:/var/lib/greeter:/bin/false
_dhcpcd:x:52:52:dhcpcd privsep:/var/lib/dhcpcd:/bin/false
_chrony:x:53:53:chrony:/var/lib/chrony:/bin/false
nobody:x:65534:65534:nobody:/:/bin/false
