<?xml version="1.0"?>
<!-- THE GREETER'S COMPOSITOR CONFIG, AND EMPTINESS IS THE POINT: a
     <keyboard> and <mouse> declared with no binds REPLACE labwc's
     defaults, so there is no Super+Enter terminal, no menu, no way to
     make this compositor do anything but host the credential surface.
     The lock covers everything the moment it starts; this config is
     what there ISN'T underneath it. -->
<labwc_config>
  <keyboard></keyboard>
  <mouse></mouse>
</labwc_config>
