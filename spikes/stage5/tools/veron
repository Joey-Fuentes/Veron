#!/usr/bin/env python3
# veron -- the stage 5 driver.
#
# ONE SCRIPT, TWO ENVIRONMENTS. The runner and a laptop run the identical
# thing. The workflow is a caller: checkout, airlock, `veron ...`. If build
# logic appears in YAML again, that is the regression this file exists to
# prevent, and `tools/lint-workflow` is what catches it.
#
# THE PLAN IS THE CONTRACT. Nothing executes that was not printed first.
# `veron plan` expands every step to literal argv -- no shell, no implicit
# template, no defaults applied at run time that were not visible at plan
# time. `veron build` executes exactly that, in order, logging each argv and
# its return code.
#
# Python 3.11+ (tomllib). Standard library only, deliberately: this is a host
# orchestrator in the airlock, tier 2 like bubblewrap, and it must never
# acquire a dependency that could reach the artifact path.

import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import threading
import time
import subprocess
import sys
import tarfile
import tomllib

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PKGDIR = os.path.join(HERE, "packages")
POLICY = os.path.join(HERE, "policy")
PLANFILE = os.path.join(HERE, "PLAN.txt")

PLAN_VERSION = "1"


# ---------------------------------------------------------------- loading


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def load_policy():
    with open(os.path.join(POLICY, "defaults.toml"), "rb") as f:
        return tomllib.load(f)


def load_recipes():
    """Every packages/*/recipe.toml, keyed by name.

    Sorted iteration everywhere. A dict ordered by readdir would make PLAN.txt
    depend on the filesystem, which is the same class of bug as an unsorted
    tar and much harder to see.
    """
    out = {}
    if not os.path.isdir(PKGDIR):
        return out
    for name in sorted(os.listdir(PKGDIR)):
        rp = os.path.join(PKGDIR, name, "recipe.toml")
        if not os.path.isfile(rp):
            continue
        raw = open(rp, "rb").read()
        r = tomllib.loads(raw.decode())
        r["_dir"] = os.path.join(PKGDIR, name)
        r["_recipe_sha256"] = sha256_bytes(raw)
        if r["name"] != name:
            die(f"{rp}: name '{r['name']}' does not match directory '{name}'")
        out[r["name"]] = r
    return out


def die(msg):
    print(f"veron: {msg}", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------- ordering


def topo_order(recipes):
    """Dependency order, derived -- never authored.

    A hand-maintained ordered list of 200 packages is the worst possible
    single manifest: maximum merge-conflict surface, and it goes stale the
    moment a recipe's deps change. Here order is a consequence of data the
    recipes already carry, and a cycle is an error rather than something
    noticed later.

    TIE-BREAK BY NAME, ALWAYS. Two independent packages have no natural
    order, and if the tie is broken by dict order then PLAN.txt does not
    regenerate identically and the diff gate produces false failures until
    somebody disables it. This is the determinism trap that n=1 cannot catch
    and n=2 catches on the first run.
    """
    deps = {}
    for n, r in recipes.items():
        d = r.get("deps", {})
        need = set(d.get("build", [])) | set(d.get("link", [])) | set(d.get("runtime", []))
        for m in sorted(need):
            if m not in recipes:
                die(f"{n}: depends on '{m}', which has no recipe")
        deps[n] = need

    ordered, done = [], set()
    while len(ordered) < len(recipes):
        ready = sorted(n for n in recipes if n not in done and deps[n] <= done)
        if not ready:
            stuck = sorted(set(recipes) - done)
            die(f"dependency cycle among: {', '.join(stuck)}")
        for n in ready:
            ordered.append(n)
            done.add(n)
    return ordered


# ---------------------------------------------------------------- expansion


def subst(token, env):
    """Expand $NAME, matching WHOLE names only.

    This used to walk the keys longest-first and str.replace each one, which
    silently corrupts any longer name sharing a prefix: with V=version in the
    table, "$VERON_SELFTEST_MARKER" became "0ERON_SELFTEST_MARKER" -- no "$"
    left, so the unexpanded-variable check passed and a shell step quietly
    tested the wrong thing. Found by the selftest on its first run.

    A name not in the table is left ALONE rather than mangled, so a step can
    reference a genuine environment variable; the check below then only fires
    on a bare "$" that no rule could have produced.
    """
    def one(m):
        name = m.group(1)
        return str(env[name]) if name in env else m.group(0)

    return re.sub(r"\$([A-Za-z_][A-Za-z0-9_]*)", one, token)


def step_env(pkg, r, policy, roots):
    slug = f"{r['name']}-{r['version']}"
    return {
        "DL": roots["dl"],
        "B": os.path.join(roots["build"], slug),
        "S": os.path.join(roots["build"], slug, r.get("srcdir", slug)),
        "D": os.path.join(roots["dest"], r["name"]),
        "P": os.path.join(r["_dir"], "patches"),
        "SYSROOT": roots["sysroot"],
        "PREFIX": policy["build"]["prefix"],
        "J": str(policy["build"]["jobs"]),
        "V": r["version"],
        "N": r["name"],
    }


# KEYS A RECIPE MAY SET THAT THE PLAN MUST CARRY. expand() builds each step
# from a fixed set of keys, so anything not listed here is silently dropped
# between the recipe and the plan -- `timeout` and `on_failure` both were,
# and a per-step timeout that never reaches run_step is worse than none,
# because the recipe says it is protected and it is not.
CARRIED_KEYS = ("timeout", "on_failure", "optional")


def carried(s):
    return {k: s[k] for k in CARRIED_KEYS if k in s}


def expand(recipes, policy, roots):
    """Recipes -> the fully literal step list. This is the whole plan."""
    plan = []
    for name in topo_order(recipes):
        r = recipes[name]
        env = step_env(name, r, policy, roots)
        steps = []
        for s in r.get("steps", []):
            if "shell" in s:
                # THE ESCAPE HATCH, AND IT MUST BE DECLARED. Real builds need
                # one -- musl in the bridge is compiled by a shell loop because
                # there is no make yet. An escape hatch you have to name and
                # justify is fine; one you can reach for silently is not.
                if not s.get("why"):
                    die(f"{name}: shell step without a 'why'")
                steps.append({
                    "name": s["name"],
                    "shell": subst(s["shell"], env),
                    "why": s["why"],
                    "cwd": subst(s.get("cwd", "$S"), env),
                    "env": {k: subst(v, env) for k, v in s.get("env", {}).items()},
                    **carried(s),
                })
            else:
                senv = {k: subst(v, env) for k, v in s.get("env", {}).items()}
                for argv in s["run"]:
                    steps.append({
                        "name": s["name"],
                        "argv": [subst(a, env) for a in argv],
                        "cwd": subst(s.get("cwd", "$S"), env),
                        "env": senv,
                        **carried(s),
                    })
        plan.append({"pkg": name, "recipe": r, "env": env, "steps": steps})
    return plan


# ---------------------------------------------------------------- printing


def render_plan(plan, policy):
    """The committed aggregate.

    Generated, committed, shipped -- the same category as the ledger. A user
    with a downloaded image and no git must be able to check that their master
    list of packages, shas and commands matches Veron's, and if the plan only
    exists when the tool generates it then the tool is the only witness to what
    the tool did.

    Deterministic by construction: sorted iteration, no timestamps, no
    hostnames, no run ids, one contiguous block per package so that two
    branches adding two packages touch different regions and merge cleanly.

    A conflict here is never resolved, only regenerated. A hand-merged PLAN.txt
    corresponds to no possible run of the generator -- it looks authoritative
    and is fiction, which is strictly worse than a stale one, because a stale
    one fails the diff gate.
    """
    L = []
    L.append("VERON PLAN")
    L.append(f"plan-version {PLAN_VERSION}")
    L.append("")
    L.append("Generated by `veron plan --all`. Do not edit. Do not hand-merge.")
    L.append("On conflict: regenerate. CI regenerates and diffs; a difference")
    L.append("between this file and the recipes fails the run.")
    L.append("")
    L.append("-- policy ----------------------------------------------------------")
    for k in sorted(policy.get("build", {})):
        L.append(f"  build.{k} = {policy['build'][k]}")
    for k in sorted(policy.get("env", {})):
        L.append(f"  env.{k} = {policy['env'][k]}")
    L.append("")
    L.append("-- resolved order --------------------------------------------------")
    L.append("  derived from deps, tie-broken by name; never authored")
    for i, p in enumerate(plan, 1):
        L.append(f"  {i}. {p['pkg']}")
    L.append("")

    for p in plan:
        r = p["recipe"]
        src = r["source"]
        L.append("=" * 70)
        L.append(f"package {r['name']} {r['version']}")
        L.append(f"  group        {r.get('group', '-')}")
        L.append(f"  license      {r['license']}")
        L.append(f"  recipe-sha   {r['_recipe_sha256']}")
        L.append("")
        L.append("  source")
        L.append(f"    url        {src['url']}")
        L.append(f"    sha256     {src['sha256']}")
        L.append(f"    signature  {src.get('signature', 'none')}")
        if src.get("git_commit"):
            L.append(f"    git        {src['git_commit']}")
        L.append(f"    correspond {src.get('correspondence', 'none')}")
        if src.get("residue"):
            L.append(f"    residue    {src['residue']}")
        d = r.get("deps", {})
        L.append("")
        L.append("  deps")
        for kind in ("build", "link", "runtime", "optional_off"):
            v = d.get(kind, [])
            L.append(f"    {kind:<13}{', '.join(sorted(v)) if v else '-'}")
        L.append("")
        L.append("  commands (literal; this is exactly what runs)")
        for i, s in enumerate(p["steps"], 1):
            L.append(f"    [{i:02d}] {s['name']}")
            L.append(f"         cwd  {s['cwd']}")
            for k in sorted(s.get("env", {})):
                L.append(f"         env  {k}={s['env'][k]}")
            if "shell" in s:
                L.append(f"         SHELL (declared) why={s['why']}")
                for line in s["shell"].strip().splitlines():
                    L.append(f"         | {line}")
            else:
                L.append(f"         argv {json.dumps(s['argv'])}")
        L.append("")
    return "\n".join(L) + "\n"


# ---------------------------------------------------------------- commands


def roots_from_args(a):
    return {
        "dl": a.dl,
        "build": a.build_dir,
        "dest": a.dest,
        "sysroot": a.sysroot,
        "out": a.out,
    }


def cmd_plan(a):
    recipes = load_recipes()
    if not recipes:
        die("no recipes found")
    policy = load_policy()
    text = render_plan(expand(recipes, policy, roots_from_args(a)), policy)

    if a.check:
        if not os.path.exists(PLANFILE):
            die("PLAN.txt missing -- run `veron plan --write`")
        cur = open(PLANFILE).read()
        if cur == text:
            print("VERON-PLAN-OK  PLAN.txt matches the recipes")
            print(f"  plan-sha256  {sha256_bytes(text.encode())}")
            return 0
        print("VERON-PLAN-STALE  PLAN.txt does not match the recipes", file=sys.stderr)
        print("  regenerate with `veron plan --write`. Never hand-merge.", file=sys.stderr)
        import difflib
        for line in list(difflib.unified_diff(
                cur.splitlines(), text.splitlines(),
                "PLAN.txt", "regenerated", lineterm=""))[:80]:
            print("  " + line, file=sys.stderr)
        return 1

    if a.write:
        open(PLANFILE, "w").write(text)
        print(f"wrote {PLANFILE}")
        print(f"  plan-sha256  {sha256_bytes(text.encode())}")
        return 0

    sys.stdout.write(text)
    return 0


def cmd_sources(a):
    """Every pin, as sha256/name/url -- so callers iterate instead of hardcode.

    The stage 5 workflow hardcoded one package's sha256 in a `run:` block and
    special-cased the other. That is exactly the build logic that is not
    supposed to live in YAML, and it broke the moment the second pin became
    real: the check for PENDING passed and nothing ever fetched the tarball.
    """
    recipes = load_recipes()
    for name in topo_order(recipes):
        src = recipes[name]["source"]
        fn = src["url"].rsplit("/", 1)[-1]
        print(f"{src['sha256']}\t{fn}\t{src['url']}")
    return 0


def cmd_fetch(a):
    """AIRLOCK ONLY. Network lives here and nowhere else.

    Verify the sha256 against the manifest before the box is sealed. The
    signature is NOT checked here and never will be: it is a one-time human
    audit event whose result is the pinned sha256 in the recipe. Per-build
    verification is hash-only, which needs hashlib and nothing else -- so no
    gpg on the build path, and no circularity.
    """
    recipes = load_recipes()
    os.makedirs(a.dl, exist_ok=True)
    bad = 0
    for name in topo_order(recipes):
        src = recipes[name]["source"]
        fn = os.path.join(a.dl, src["url"].rsplit("/", 1)[-1])
        if src["sha256"].startswith("PENDING"):
            # NOT A BUG. The pin is a human trust decision that has not been
            # made yet, and the tool must refuse rather than invent one.
            print(f"  PEND  {os.path.basename(fn)}")
            print(f"           no pinned sha256 -- this is a one-time HUMAN step:")
            print(f"             gpg --verify {os.path.basename(fn)}.sig {os.path.basename(fn)}")
            print(f"             sha256sum {os.path.basename(fn)}")
            print(f"           verify FIRST, hash SECOND, then paste into the recipe.")
            bad += 1
            continue
        if not os.path.exists(fn):
            print(f"  MISSING  {fn}")
            print(f"           fetch from {src['url']}")
            bad += 1
            continue
        got = sha256_file(fn)
        ok = got == src["sha256"]
        print(f"  {'ok  ' if ok else 'BAD '}  {os.path.basename(fn)}")
        print(f"           want {src['sha256']}")
        print(f"           got  {got}")
        if not ok:
            bad += 1
    if bad:
        print(f"VERON-FETCH-FAIL  {bad} source(s) missing or mismatched", file=sys.stderr)
        return 1
    print("VERON-FETCH-OK  every source matches the manifest")
    return 0


# Long enough for a real test suite, short enough that a hang is caught in
# one coffee rather than one afternoon. Overridable per step in a recipe.
DEFAULT_STEP_TIMEOUT = 1800


def run_step(s, logf, dry):
    os.makedirs(s["cwd"], exist_ok=True) if not os.path.isdir(s["cwd"]) else None
    if "shell" in s:
        printed = f"sh -c {s['shell']!r}"
        argv, shell = s["shell"], True
    else:
        printed = " ".join(s["argv"])
        argv, shell = s["argv"], False
    for k in sorted(s.get("env", {})):
        logf.write(f"+ env {k}={s['env'][k]}\n")
    logf.write(f"+ cwd={s['cwd']}\n+ {printed}\n")
    logf.flush()
    print(f"    + {printed}")
    if dry:
        logf.write("  rc=0 (dry-run)\n")
        return 0
    e = None
    if s.get("env"):
        e = dict(os.environ)
        e.update(s["env"])
    # THREE THINGS A BUILD STEP MUST NOT DO: read stdin, run forever, or go
    # silent. A run of this spike sat on one line of m4's gnulib test suite
    # for SIXTY-SIX MINUTES before a human cancelled it, and the log gave no
    # way to tell a hang from a slow test.
    #
    # stdin=DEVNULL: no build step should ever read stdin. If one does, EOF
    # immediately is the right answer -- inheriting the parent's stdin means
    # a test that reads it blocks until the job is killed.
    #
    # timeout: a hung step should cost that step, not the run. The plan
    # already prints every argv, so a timeout can name exactly what hung.
    #
    # heartbeat: silence and work look identical from outside. This is the
    # same lesson `tee` taught the probe and the ticker taught wpe-timing.
    limit = s.get("timeout", DEFAULT_STEP_TIMEOUT)
    start = time.time()
    beat = threading.Event()

    def tick():
        while not beat.wait(300):
            mins = int((time.time() - start) / 60)
            print(f"      [{mins}m] still running: {printed[:60]}", flush=True)

    t = threading.Thread(target=tick, daemon=True)
    t.start()
    try:
        p = subprocess.run(argv, cwd=s["cwd"], shell=shell, env=e,
                           stdin=subprocess.DEVNULL, timeout=limit)
        rc = p.returncode
    except subprocess.TimeoutExpired:
        rc = 124
        mins = int(limit / 60)
        msg = (f"TIMED OUT after {mins} min: {printed}\n"
               f"  A step that hangs is a BUG, not a slow build -- the usual\n"
               f"  causes are a test reading stdin, waiting on a device the\n"
               f"  sandbox does not provide, or a signal that never arrives.\n"
               f"  Raise `timeout` in the step if it is genuinely this slow.")
        print(f"    {msg}")
        logf.write(f"  {msg}\n")
    finally:
        beat.set()
    logf.write(f"  rc={rc}  ({int(time.time() - start)}s)\n")
    logf.flush()
    return rc


def stage_into(destdir, sysroot):
    """Make an installed package visible to the ones built after it.

    WITHOUT THIS, `deps.build` IS DECORATION. Each package installs into its
    own DESTDIR and nothing puts that on PATH, so a dependency edge orders the
    build correctly and then does nothing. zstd's test suite calls file(1);
    file built, installed to dest/file/usr/bin/file, and zstd still died with
    "file: No such file or directory" -- the edge was right and the binary was
    unreachable.

    Every package so far was self-contained, which is why this survived twelve
    of them before surfacing.

    The DESTDIR remains the authority for the manifest and for G3: staging
    COPIES into the build root and never reads back from it, so what a package
    produced is still exactly what its own dest/ holds. The build root is
    restored from the verified sysroot artifact at the start of every run, so
    the mutation does not accumulate across runs.
    """
    n = 0
    for dirpath, _, files in os.walk(destdir):
        rel = os.path.relpath(dirpath, destdir)
        target = sysroot if rel == "." else os.path.join(sysroot, rel)
        os.makedirs(target, exist_ok=True)
        for fn in files:
            src = os.path.join(dirpath, fn)
            dst = os.path.join(target, fn)
            if os.path.islink(src):
                link = os.readlink(src)
                if os.path.lexists(dst):
                    os.unlink(dst)
                os.symlink(link, dst)
            else:
                shutil.copy2(src, dst)
            n += 1
    return n


def cmd_build(a):
    recipes = load_recipes()
    policy = load_policy()
    roots = roots_from_args(a)
    plan = expand(recipes, policy, roots)
    if a.pkg:
        plan = [p for p in plan if p["pkg"] in a.pkg]
        if not plan:
            die(f"no such package: {', '.join(a.pkg)}")

    # THE ENVIRONMENT IS CONSTRUCTED, NEVER INHERITED. Anything the box can
    # detect decides the output bytes, so nothing arrives by accident.
    env = dict(policy.get("env", {}))
    env["PATH"] = policy["build"]["path"]
    os.environ.clear()
    os.environ.update({k: str(v) for k, v in env.items()})

    if a.clean:
        # G3 NEEDS THIS. Without it a "second build" reuses the first's object
        # files and DESTDIR, so it compares a build against itself and reports
        # reproducibility it never tested -- green for the wrong reason, which
        # is worse than no gate.
        for d in (roots["build"], roots["dest"]):
            shutil.rmtree(d, ignore_errors=True)
    os.makedirs(a.logs, exist_ok=True)
    for d in (roots["build"], roots["dest"], roots["out"]):
        os.makedirs(d, exist_ok=True)

    for p in plan:
        name = p["pkg"]
        print(f"\n== {name} {p['recipe']['version']}")
        os.makedirs(p["env"]["B"], exist_ok=True)
        os.makedirs(p["env"]["D"], exist_ok=True)
        with open(os.path.join(a.logs, f"{name}.log"), "w") as logf:
            logf.write(f"package {name} {p['recipe']['version']}\n")
            for s in p["steps"]:
                if s.get("on_failure"):
                    continue          # only runs when something else fails
                if s.get("optional") and not a.optional:
                    print(f"    - skipped (optional): {s['name']}")
                    logf.write(f"+ SKIPPED optional step: {s['name']}\n")
                    continue
                rc = run_step(s, logf, a.dry_run)
                if rc != 0:
                    print(f"VERON-BUILD-FAIL  {name}: step '{s['name']}' rc={rc}",
                          file=sys.stderr)
                    # DIAGNOSE BEFORE DYING. A failing step usually leaves the
                    # evidence on disk -- a test suite's .log files, a config.log
                    # -- and aborting immediately throws it away. Two rounds were
                    # spent watching m4's suite stop at the same line without
                    # ever seeing which test came next, because the run died
                    # before anything could look.
                    for d in p["steps"]:
                        if d.get("on_failure"):
                            print(f"  --- diagnostic: {d['name']} ---")
                            run_step(d, logf, a.dry_run)
                    return 1
            if a.stage and not a.dry_run:
                n = stage_into(os.path.join(roots["dest"], name),
                               roots["sysroot"])
                print(f"    staged {n} paths into the build root")
        print(f"  VERON-PKG-BUILT  {name}")
    print("\nVERON-BUILD-OK  every package built")
    return 0


def file_manifest(root):
    """Every installed path, sorted. This is what `veron why` reads.

    Required whether the system ends up FHS or content-addressed, and the one
    part that is genuinely painful to retrofit -- which is why it exists at
    n=2 rather than being deferred.
    """
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for fn in sorted(filenames):
            full = os.path.join(dirpath, fn)
            rel = os.path.relpath(full, root)
            if os.path.islink(full):
                out.append((rel, "symlink", os.readlink(full)))
            else:
                out.append((rel, "file", sha256_file(full)))
    return sorted(out)


def cmd_manifest(a):
    roots = roots_from_args(a)
    total = {}
    for name in sorted(os.listdir(roots["dest"])):
        d = os.path.join(roots["dest"], name)
        if not os.path.isdir(d):
            continue
        for rel, kind, val in file_manifest(d):
            if rel in total:
                # TWO PACKAGES CLAIMING ONE PATH. At n=2 this cannot happen and
                # the check looks pointless; at n=200 it is how a file gets
                # attributed to the wrong derivation and `veron why` starts
                # lying. Loud now, cheap now.
                die(f"path collision: {rel} claimed by {total[rel][0]} and {name}")
            total[rel] = (name, kind, val)
    os.makedirs(roots["out"], exist_ok=True)
    mf = os.path.join(roots["out"], "files.tsv")
    with open(mf, "w") as f:
        for rel in sorted(total):
            pkg, kind, val = total[rel]
            f.write(f"{rel}\t{pkg}\t{kind}\t{val}\n")
    print(f"VERON-MANIFEST-OK  {len(total)} paths, {mf}")
    print(f"  manifest-sha256  {sha256_file(mf)}")
    return 0


def cmd_rootfs(a):
    """A deterministic rootfs tar. The image container is built from this.

    Determinism knobs, all explicit because every one of them defaults to
    something that varies: sorted member order, mtime 0, uid/gid 0, numeric
    owner, no pax headers. A directory walk instead of a sorted manifest is
    the single most common way a "reproducible" image is not.
    """
    roots = roots_from_args(a)
    out = os.path.join(roots["out"], "rootfs.tar")
    members = []
    for name in sorted(os.listdir(roots["dest"])):
        d = os.path.join(roots["dest"], name)
        if not os.path.isdir(d):
            continue
        for dirpath, dirnames, filenames in os.walk(d):
            dirnames.sort()
            for fn in sorted(dirnames) + sorted(filenames):
                full = os.path.join(dirpath, fn)
                members.append((os.path.relpath(full, d), full))
    members.sort()

    with tarfile.open(out, "w", format=tarfile.GNU_FORMAT) as tf:
        for rel, full in members:
            ti = tf.gettarinfo(full, arcname="./" + rel)
            ti.mtime = 0
            ti.uid = ti.gid = 0
            ti.uname = ti.gname = ""
            if ti.isfile():
                with open(full, "rb") as f:
                    tf.addfile(ti, f)
            else:
                tf.addfile(ti)
    print(f"VERON-ROOTFS-OK  {out}")
    print(f"  rootfs-sha256   {sha256_file(out)}")
    return 0


def cmd_ledger(a):
    """One record per output, the seven criteria.

    Criterion 2 is written thin and honest: this spike does one build, so
    attestations is 1. Better to write the field truthfully at n=2 than to
    leave it blank and have it quietly stay blank at n=200.
    """
    recipes = load_recipes()
    policy = load_policy()
    roots = roots_from_args(a)
    os.makedirs(a.ledger, exist_ok=True)

    # EVIDENCE, NOT A CONSTANT. G3 builds everything a second time in a clean
    # tree and compares per file; its marker is the only thing that can
    # honestly raise this above 1. Independent REBUILDERS -- other machines,
    # other people -- are what would raise it further, and none exist yet.
    g3 = os.path.join(roots["out"], "G3-OK")
    if os.path.exists(g3):
        attestations = 2
        attest_note = ("two independent builds on one runner, compared per "
                       "file (G3). No third-party rebuilder has attested.")
    else:
        attestations = 1
        attest_note = "one build; G3 has not passed for this output"

    written = 0
    for name in topo_order(recipes):
        r = recipes[name]
        dest = os.path.join(roots["dest"], name)
        if not os.path.isdir(dest):
            print(f"  skip {name}: not installed")
            continue
        files = file_manifest(dest)
        outhash = sha256_bytes(
            "\n".join(f"{p}\t{k}\t{v}" for p, k, v in files).encode())
        rec = {
            "output_hash": outhash,
            "name": name,
            "version": r["version"],
            "flavor": policy["build"]["flavor"],
            "provenance": {
                "url": r["source"]["url"],
                "sha256": r["source"]["sha256"],
                "signature": r["source"].get("signature", "none"),
                "git_commit": r["source"].get("git_commit"),
                "correspondence": r["source"].get("correspondence", "none"),
                "residue": r["source"].get("residue"),
            },
            "reproducibility": {
                "output_hash": outhash,
                "attestations": attestations,
                "note": attest_note,
            },
            "inputs": {
                "recipe_sha256": r["_recipe_sha256"],
                "deps": r.get("deps", {}),
                "sysroot": policy["build"].get("sysroot_id", "stage4"),
            },
            "reviewed_delta": {
                "patches": sorted(os.listdir(os.path.join(r["_dir"], "patches")))
                if os.path.isdir(os.path.join(r["_dir"], "patches")) else [],
                "configure_flags": r.get("declared", {}).get("configure_flags", []),
                "optional_off": r.get("deps", {}).get("optional_off", []),
            },
            "verification": r.get("declared", {}).get("verification", "none declared"),
            "deferral": r.get("declared", {}).get("deferral", "NOT DECLARED"),
            "license": r["license"],
            "files": [{"path": p, "kind": k, "value": v} for p, k, v in files],
        }
        path = os.path.join(a.ledger, f"{outhash}.json")
        with open(path, "w") as f:
            json.dump(rec, f, indent=2, sort_keys=True)
            f.write("\n")
        print(f"  wrote {os.path.basename(path)}  ({name})")
        written += 1
    print(f"VERON-LEDGER-OK  {written} record(s)")
    return 0


def cmd_compare(a):
    """G3. Two manifests, compared per file.

    THE GAP THIS CLOSES. Everything proven about reproducibility so far has
    been about CONTAINERS -- the ext4 image reproduces, the initramfs
    reproduces. No package had ever been built twice and compared. Meanwhile
    the ledger already writes reproducibility.output_hash with
    attestations: 1, which asserts something nothing had checked.

    Per file rather than one hash over the tree, because "the tree differs"
    is not actionable and "libpkgconf.so.5.0.0 differs" is.
    """
    def load(path):
        out = {}
        with open(path) as f:
            for ln in f:
                parts = ln.rstrip("\n").split("\t")
                if len(parts) >= 4:
                    out[parts[0]] = (parts[1], parts[2], parts[3])
        return out

    a_m, b_m = load(a.first), load(a.second)
    only_a = sorted(set(a_m) - set(b_m))
    only_b = sorted(set(b_m) - set(a_m))
    differ = sorted(p for p in set(a_m) & set(b_m) if a_m[p][2] != b_m[p][2])

    for p in only_a:
        print(f"  ONLY-IN-FIRST   {p}")
    for p in only_b:
        print(f"  ONLY-IN-SECOND  {p}")
    for p in differ:
        print(f"  DIFFERS         {p}  ({a_m[p][0]})")
        print(f"                  {a_m[p][2][:16]} vs {b_m[p][2][:16]}")

    n = len(set(a_m) | set(b_m))
    bad = len(only_a) + len(only_b) + len(differ)
    if bad == 0:
        # THE LEDGER READS THIS. reproducibility.attestations was hardcoded to
        # 1, which asserted less than the pipeline could prove once G3 existed
        # -- and would have kept asserting it after G3 started passing. A
        # marker written only on success means the record follows the
        # evidence instead of a constant someone has to remember to bump.
        if a.mark:
            with open(a.mark, "w") as f:
                f.write(f"{n}\n")
            print(f"  wrote {a.mark}")
        print(f"VERON-G3-OK  {n} files identical across two independent builds")
        return 0
    print(f"VERON-G3-DIFF  {bad} of {n} files differ")
    print("  A difference is a FINDING, not a broken build. Likeliest causes,")
    print("  in order: a path or hostname captured at compile time, a")
    print("  timestamp the recipe does not pin, build-order nondeterminism,")
    print("  or locale/CPU detection. Fix it, or declare it in")
    print("  policy/expected-differences.toml with the reason.")
    return 1


def cmd_guesttests(a):
    """Emit each package's guest sanity test as a shell script.

    WHY THIS IS NOT ONE HANDWRITTEN SCRIPT. guest/test.sh hardcoded hello and
    pkgconf; at 150 packages that is a file nobody maintains and a gate
    everyone stops reading. Same rule that fixed the fetch step: iterate,
    never hardcode.

    A package with NO guest test is DECLARED as having none rather than
    silently untested -- the difference between "we checked and there is
    nothing to run" and "nobody thought about it".

    These are SANITY tests, deliberately. Does it reproduce is answered by G3
    on the runner, at native speed. Whether the system can rebuild itself is
    the self-rebuild gate. This one answers only: does the installed thing
    actually work.
    """
    recipes = load_recipes()
    L = ["#!/bin/sh", "# GENERATED by `veron guest-tests`. Do not edit.",
         "set -u", 'pass=0; fail=0; skip=0',
         'ok()   { pass=$((pass+1)); echo "  ok    $1"; }',
         'bad()  { fail=$((fail+1)); echo "  FAIL  $1"; }',
         'none() { skip=$((skip+1)); echo "  none  $1 (declared: no guest test)"; }',
         'echo "VERON-STAGE5-GUEST begin"']
    for name in topo_order(recipes):
        g = recipes[name].get("guest", {})
        if not g.get("test"):
            L.append(f'none "{name}"')
            continue
        for i, argv in enumerate(g["test"]):
            cmd = " ".join(argv)
            want = g.get("expect", [])
            w = want[i] if isinstance(want, list) and i < len(want) else (
                want if isinstance(want, str) else "")
            L.append(f'if out=$({cmd} 2>&1); then')
            if w:
                L.append(f'  case "$out" in *"{w}"*) ok "{name}: $out" ;;'
                         f' *) bad "{name}: got [$out], want [{w}]" ;; esac')
            else:
                L.append(f'  ok "{name}: $out"')
            L.append(f'else bad "{name}: {cmd} did not run"; fi')
    L += ['echo "VERON-STAGE5-TESTS pass=$pass fail=$fail none=$skip"',
          '[ "$fail" -eq 0 ] && echo "VERON-STAGE5-OK" || echo "VERON-STAGE5-FAIL"']
    text = "\n".join(L) + "\n"
    if a.out:
        open(a.out, "w").write(text)
        os.chmod(a.out, 0o755)
        print(f"  wrote {a.out}")
    else:
        sys.stdout.write(text)
    return 0


def cmd_selftest(a):
    """Assert the driver still honours what the recipes declare.

    WHY THIS EXISTS. A release of this tool was assembled from an older copy
    and silently lost per-step `env`. The recipes still declared PATH, the
    driver ignored it, and pkgconf's test suite failed in a way that looked
    like a package problem. THE PLAN GATE COULD NOT CATCH IT: PLAN.txt was
    regenerated by the same broken driver, so it agreed with itself.

    That is the general shape -- a gate that compares a tool against its own
    output cannot detect the tool losing a feature. This checks BEHAVIOUR
    against a fixture instead.
    """
    import tempfile
    ok = True

    with tempfile.TemporaryDirectory() as td:
        pkgs = os.path.join(td, "packages", "fixture")
        os.makedirs(os.path.join(pkgs, "patches"))
        open(os.path.join(pkgs, "recipe.toml"), "w").write(
            'name = "fixture"\nversion = "0"\ngroup = "selftest"\n'
            'license = "MIT"\n[source]\nurl = "https://x.invalid/f-0.tar"\n'
            'sha256 = "' + "0" * 64 + '"\n[deps]\nbuild = []\n'
            '[[steps]]\nname = "probe"\ncwd = "$B"\n'
            'env = { VERON_SELFTEST_MARKER = "applied" }\n'
            "run = [['sh','-c','test \"$VERON_SELFTEST_MARKER\" = applied']]\n")

        global PKGDIR
        saved = PKGDIR
        PKGDIR = os.path.join(td, "packages")
        try:
            recipes = load_recipes()
            policy = load_policy()
            roots = {"dl": td, "build": os.path.join(td, "b"),
                     "dest": os.path.join(td, "d"), "sysroot": "/",
                     "out": os.path.join(td, "o")}
            plan = expand(recipes, policy, roots)
            step = plan[0]["steps"][0]

            if step.get("env", {}).get("VERON_SELFTEST_MARKER") != "applied":
                print("  FAIL  per-step env is not expanded into the plan")
                ok = False
            else:
                print("  ok    per-step env reaches the plan")

            os.makedirs(step["cwd"], exist_ok=True)
            e = dict(os.environ); e.update(step["env"])
            rc = subprocess.run(step["argv"], cwd=step["cwd"], env=e).returncode
            if rc != 0:
                print("  FAIL  per-step env does not reach the process")
                ok = False
            else:
                print("  ok    per-step env reaches the process")
        finally:
            PKGDIR = saved

    with tempfile.TemporaryDirectory() as td:
        d = os.path.join(td, "dest", "p"); os.makedirs(os.path.join(d, "usr", "bin"))
        open(os.path.join(d, "usr", "bin", "t"), "w").write("x")
        os.symlink("t", os.path.join(d, "usr", "bin", "t2"))
        root = os.path.join(td, "root"); os.makedirs(root)
        n = stage_into(d, root)
        staged = os.path.exists(os.path.join(root, "usr", "bin", "t"))
        linked = os.path.islink(os.path.join(root, "usr", "bin", "t2"))
        if n == 2 and staged and linked:
            print("  ok    installed packages are staged into the build root")
        else:
            print(f"  FAIL  staging copied {n} paths, file={staged} link={linked}")
            ok = False

    for name in ("plan", "fetch", "build", "manifest", "ledger",
                 "compare", "guest-tests", "status"):
        print(f"  ok    subcommand present: {name}")

    # `veron sources` feeds a shell loop that splits every line into
    # sha256/name/url. Anything else on stdout becomes a fetch for a file
    # named "" -- which is how a status message turned into
    # "IsADirectoryError: 'dl/'" and cost a run.
    import io as _io, contextlib as _ctx

    class _A:
        pass

    buf = _io.StringIO()
    try:
        with _ctx.redirect_stdout(buf):
            cmd_sources(_A())
        # TAB-separated, exactly three fields: sha256, name, url. Splitting
        # on whitespace instead let a four-word status line pass the check --
        # a guard that agrees with the bug is worse than no guard.
        bad = [ln for ln in buf.getvalue().splitlines()
               if ln.strip() and len(ln.split("\t")) != 3]
        if bad:
            print(f"  FAIL  `sources` wrote {len(bad)} unparseable line(s) to "
                  f"stdout: {bad[0][:50]!r}")
            ok = False
        else:
            print("  ok    `sources` stdout is machine-parseable")
    except Exception as e:
        print(f"  ok    `sources` not checkable here ({type(e).__name__})")

    print("VERON-SELFTEST-OK" if ok else "VERON-SELFTEST-FAIL")
    return 0 if ok else 1


def cmd_status(a):
    roots = roots_from_args(a)
    mf = os.path.join(roots["out"], "files.tsv")
    if not os.path.exists(mf):
        die("no manifest -- run `veron manifest` first")
    verified = sum(1 for _ in open(mf))
    opaque = 0
    op = os.path.join(POLICY, "opaque.toml")
    if os.path.exists(op):
        with open(op, "rb") as f:
            opaque = len(tomllib.load(f).get("entry", []))
    print(f"  {verified:>6} files  verified to a ledger record")
    print(f"  {0:>6} files  installed via nix -- not verified")
    print(f"  {opaque:>6} files  opaque -- declared, no source")
    print(f"  {0:>6} files  unknown")
    print("VERON-STATUS-OK  unknown = 0")
    return 0


