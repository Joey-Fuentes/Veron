CHECKPOINT = ".veron-checkpoint"


def package_keys(recipes, policy, base):
    """{package: key} -- each keyed on its own recipe and its dependencies'.

    THIS REPLACED A PREFIX HASH, AND THE REPLACEMENT WAS FORCED BY A RUN.
    The first version hashed the plan as a SEQUENCE: h(i) = sha256(h(i-1) +
    recipe_sha(i)). The argument was that `veron plan` produces a total order,
    so "everything before package i" is exactly the closure i was built
    against -- true, and too coarse by a wide margin.

    It is right about EDITS and wrong about INSERTIONS. Editing package 43 of
    48 moved 6 keys, which is what was measured and quoted. Adding seven
    packages then moved 53 of 62, because the first of them landed at rung 10
    and every h() after it shifted. A 55-package checkpoint was refused with
    "no usable checkpoint" and the whole set rebuilt -- correct behaviour from
    a key that conflates POSITION with DEPENDENCY.

        key(p) = sha256(base + policy + recipe_sha(p) + each dep's key)

    Now inserting libudev-zero at rung 10 invalidates libudev-zero and
    whatever declares it, and nothing else. bzip2 at rung 1 is untouched
    whether it is rung 1 or rung 8.

    THE SOUNDNESS RESTS ON THE DECLARATIONS BEING COMPLETE, and that is worth
    stating plainly rather than burying. A prefix hash was SOUND under any
    declarations, because everything earlier was in the hash whether declared
    or not. This one assumes a package is affected only by what it declares --
    and `stage_into` puts every earlier package in the shared build root, so
    an UNDECLARED dependency is an input this key does not cover.

    That is precisely what stage5-isolate measures, and it is the reason that
    spike is not tidying: it is the thing that validates this cache key. glib
    needing an undeclared pkgconf was found there, and until that sweep is
    clean, a stale hit here is possible in principle. `use_checkpoint` is an
    input, off by default, and the ledger records attestations=0 when one is
    used.
    """
    pol = json.dumps({"build": policy.get("build", {}),
                      "env": policy.get("env", {}),
                      "tool_env": policy.get("tool_env", {})},
                     sort_keys=True)
    root = hashlib.sha256((base + "\n" + pol).encode()).hexdigest()
    memo = {}

    def key(n):
        if n in memo:
            return memo[n]
        r = recipes[n]
        d = r.get("deps", {})
        deps = sorted(set(d.get("build", [])) | set(d.get("link", [])))
        body = root + r["_recipe_sha256"] + "".join(
            f"{x}={key(x)}" for x in deps if x in recipes)
        memo[n] = hashlib.sha256(body.encode()).hexdigest()
        return memo[n]

    return {n: key(n) for n in topo_order(recipes)}


def cmd_keys(a):
    """`<index>\\t<package>\\t<prefix key>` -- what a checkpoint is named by."""
    recipes = load_recipes()
    policy = load_policy()
    keys = package_keys(recipes, policy, a.base)
    for i, name in enumerate(topo_order(recipes), 1):
        print(f"{i}\t{name}\t{keys[name]}")
    return 0


def read_checkpoint(dest):
    """The marker a restored checkpoint carries, or None."""
    p = os.path.join(dest, CHECKPOINT)
    if not os.path.isfile(p):
        return None
    try:
        return json.load(open(p))
    except Exception:
        return None


def cmd_checkpoint(a):
    """Record a key for every package dest/ currently holds.

    PER PACKAGE, NOT ONE KEY FOR THE WHOLE SET. The marker used to carry a
    single prefix key and a package list, so a checkpoint was all-or-nothing:
    any change anywhere before the end made the whole thing unusable. It
    carries {package: key} now, and `--resume` keeps the subset whose keys
    still match. Adding seven packages to a 55-package set then reuses 55
    minus whatever actually depends on them, instead of nothing.
    """
    recipes = load_recipes()
    policy = load_policy()
    roots = roots_from_args(a)
    keys = package_keys(recipes, policy, a.base)
    have = {n for n in os.listdir(roots["dest"])
            if os.path.isdir(os.path.join(roots["dest"], n)) and n in keys}
    if not have:
        print("VERON-CHECKPOINT-EMPTY  nothing built to record")
        return 0
    marker = {"base": a.base, "keys": {n: keys[n] for n in sorted(have)}}
    with open(os.path.join(roots["dest"], CHECKPOINT), "w") as f:
        json.dump(marker, f, indent=2, sort_keys=True)
    print(f"VERON-CHECKPOINT-OK  {len(have)} package(s) recorded")
    return 0


def resolve_provider(owners, own, declared):
    """Which of several providers of one soname this package actually meant.

    PREFER WHAT THE PACKAGE DECLARES. When two packages install the same
    soname, the ELF cannot say which copy was linked -- the name is identical.
    The recipe can: if one of the providers is in deps.link, that is the
    answer, and reporting the other would be inventing a finding out of an
    ambiguity the build never had.

    With no declared match it falls back to a stable choice and lets the
    caller report it, because two providers and no declaration IS worth
    seeing.
    """
    if own in owners:
        return own
    inter = owners & declared
    if inter:
        return sorted(inter)[0]
    return sorted(owners)[0] if owners else None


def linked_packages(destdir, provider, own, declared=frozenset()):
    """Which OTHER packages this DESTDIR's binaries link, and what came from
    the base image.

    MEASURED AT THE PACKAGE THAT CAUSED IT. `veron linked` does this across
    the whole set after the build, which is the right place for a gate and
    the wrong place to READ it: an undeclared link shows up in a summary forty
    packages after the one responsible. Printing it here puts the measurement
    next to the build that produced it.
    """
    linked, sysroot = set(), set()
    for dirpath, _, files in os.walk(destdir):
        for fn in files:
            p = os.path.join(dirpath, fn)
            if os.path.islink(p):
                continue
            _, needed = elf_dynamic(p)
            for so in needed:
                owners = provider.get(so)
                if not owners:
                    sysroot.add(so)
                    continue
                owner = resolve_provider(owners, own, declared)
                if owner and owner != own:
                    linked.add(owner)
    return sorted(linked), sorted(sysroot)


def report_package(name, r, destdir, provider, timings, declared_digest):
    """The high-level record of one package, on the console.

    WHAT THIS REPLACES. The console used to carry every line every compiler
    emitted -- hundreds of thousands, in which the facts worth keeping were
    invisible. Compiler output belongs in driver/<pkg>.log and in the
    collected artifact; what belongs here is what the build DECIDED and what
    it PRODUCED, because that is what the manifest, the ledger and G3 all read
    and what anyone auditing an image asks for.

    Every line is a fact this run measured, not narration:

      steps     where the time went, so a slow package is visible as one
      links     DT_NEEDED resolved to packages -- the observed dependency
                list, next to the build that created it
      prefixes  the directories this package wrote into
      digest    the file listing's hash, compared against [installs].digest
                when the recipe pins one, which makes every build a
                per-package reproducibility check against a previous run
    """
    if not os.path.isdir(destdir):
        return
    lines, digest = install_listing(destdir)
    total = sum(int(l.split(" ")[2]) for l in lines if l.startswith("f "))

    if timings:
        print("    steps    " + " · ".join(f"{n} {t:.0f}s" for n, t in timings))

    declared = set(r.get("deps", {}).get("link", []))
    linked, sysroot = linked_packages(destdir, provider, name, declared)
    unlinked = sorted(declared - set(linked))
    if linked or sysroot or unlinked:
        marks = []
        for l in linked:
            # AN UNDECLARED LINK IS FLAGGED WHERE IT HAPPENS. The sweep at the
            # end of the run is the gate; this is the line that tells you
            # which package to look at.
            marks.append(l if l in declared else f"{l}(UNDECLARED)")
        tail = f"   (+{len(sysroot)} from the sysroot)" if sysroot else ""
        print(f"    links    {' '.join(marks) if marks else '(nothing)'}{tail}")
        if unlinked:
            # DECLARED AND NOT LINKED. Milder than the reverse -- it
            # over-states rather than under-states -- but it still means
            # `veron why` would answer with a dependency that does not exist.
            # fontconfig declared libxml2 and linked expat for its whole life.
            #
            # Not every one of these is wrong: a header-only or data
            # dependency is real and leaves no DT_NEEDED, which is why this
            # reports rather than accuses.
            print(f"    declared-not-linked  {' '.join(unlinked)}")

    prefixes = install_prefixes(destdir)
    if prefixes:
        print(f"    prefixes {' '.join(prefixes)}")

    pinned = ""
    if declared_digest:
        pinned = ("   [pinned: matches]" if declared_digest == digest
                  else f"   [pinned: CHANGED, recipe has {declared_digest[:12]}]")
    print(f"    {len(lines)} path(s), {total / 1048576:.1f} MiB, "
          f"digest {digest[:16]}{pinned}")
    # THE LISTING IS CAPTURED, NOT DISPLAYED, AND THAT WAS THE WRONG WAY
    # ROUND. Every path with its sha256 and size went to the console -- 14632
    # of them across 62 packages -- so a build log became several megabytes of
    # `usr/lib/python3.14/site-packages/yaml/scanner.py` and the four lines
    # somebody actually opens the log to read were buried in it.
    #
    # THE EVIDENCE DOES NOT MOVE. `veron installs --write` puts the same
    # listing in packages/<name>/installs.txt, the digest above is over
    # exactly those bytes, and both travel in the artifact. Printing it as
    # well never added a fact -- it added scroll.
    #
    # The digest is the console's version of the listing: sixteen characters
    # that change if any path, size or byte does. A summary that can be
    # verified is worth more than a listing nobody reads.
    #
    # --verbose-listing prints it anyway, for the case where the artifact is
    # not to hand and a single package is being stared at.
    if os.environ.get("VERON_LIST_FILES") == "1":
        for l in lines:
            print(f"      {l}")


def cmd_build(a):
    recipes = load_recipes()
    policy = load_policy()
    roots = roots_from_args(a)
    plan = expand(recipes, policy, roots)
    if a.pkg:
        plan = [p for p in plan if p["pkg"] in a.pkg]
        if not plan:
            die(f"no such package: {', '.join(a.pkg)}")

    # THE ENVIRONMENT IS CONSTRUCTED, NEVER INHERITED. Anything the box can
    # detect decides the output bytes, so nothing arrives by accident.
    env = dict(policy.get("env", {}))
    env["PATH"] = policy["build"]["path"]
    os.environ.clear()
    os.environ.update({k: str(v) for k, v in env.items()})

    if a.clean:
        # G3 NEEDS THIS. Without it a "second build" reuses the first's object
        # files and DESTDIR, so it compares a build against itself and reports
        # reproducibility it never tested -- green for the wrong reason, which
        # is worse than no gate.
        # --clean AND --resume ARE NOT CONTRADICTORY, BUT THEY WOULD BE IF
        # THIS WIPED dest/. The build tree is always disposable -- reusing
        # object files is what makes a "second build" compare itself and
        # report reproducibility it never tested. dest/ is different: under
        # --resume it holds the restored checkpoint, and deleting it here
        # would remove the thing the previous step just downloaded, then
        # rebuild everything while reporting that a checkpoint was accepted.
        wipe = [roots["build"]]
        if not getattr(a, "resume", False):
            wipe.append(roots["dest"])
        for d in wipe:
            shutil.rmtree(d, ignore_errors=True)
    os.makedirs(a.logs, exist_ok=True)
    for d in (roots["build"], roots["dest"], roots["out"]):
        os.makedirs(d, exist_ok=True)

    # RESTORED PACKAGES ARE STAGED, NOT REBUILT -- AND ONLY IF THE KEY MATCHES.
    #
    # The marker records the prefix key dest/ was built against. If it does
    # not match the plan in front of us, the checkpoint describes a different
    # build and is refused: a cache that silently builds on top of the wrong
    # base is worse than no cache, because everything downstream inherits the
    # mismatch and nothing says so.
    # WHO PROVIDES WHICH SONAME, ACCUMULATED AS THE BUILD GOES.
    #
    # THIS WAS DELETED BY A PATCH THAT DID NOT MEAN TO TOUCH IT. Rewriting the
    # resume block replaced a span that happened to contain this definition,
    # and the run died at package 1 with `NameError: name 'learn' is not
    # defined` -- after the build had already succeeded. Third collision in
    # one function; the lesson recorded for packager_deps and run_step applies
    # here too: rewrite whole rather than patch again.
    #
    # Built incrementally rather than in one pass at the end, because the
    # point is to resolve a package's DT_NEEDED at the moment it finishes.
    provider = {}

    def learn(pkg, d):
        # A SONAME CAN HAVE MORE THAN ONE PROVIDER, and this project has one
        # by construction: freetype and freetype-bootstrap are the same
        # tarball built twice, and both install libfreetype.so.6.
        for dirpath, _, files in os.walk(d):
            for fn in files:
                fp = os.path.join(dirpath, fn)
                if os.path.islink(fp):
                    if ".so" in fn:
                        provider.setdefault(fn, set()).add(pkg)
                    continue
                soname, _ = elf_dynamic(fp)
                if soname:
                    provider.setdefault(soname, set()).add(pkg)
                if ".so" in fn:
                    provider.setdefault(fn, set()).add(pkg)

    resume = set()
    if getattr(a, "resume", False):
        marker = read_checkpoint(roots["dest"])
        if not marker:
            print("  no checkpoint marker in dest/ -- building everything")
        else:
            base = getattr(a, "base", "") or ""
            if not base:
                die("--resume needs --base <sysroot sha256>: without it the "
                    "checkpoint can only be checked against itself, which "
                    "accepts a checkpoint built on any other image.")
            if marker.get("base") != base:
                die(f"checkpoint was built against a different sysroot.\n"
                    f"  marker {marker.get('base')}\n  this run {base}\n"
                    f"Refusing to build on top of it.")
            keys = package_keys(recipes, policy, base)
            # PER PACKAGE. Every entry whose key still matches is reusable;
            # the rest are stale and their DESTDIRs are REMOVED, because a
            # left-behind dest/ from a different recipe is exactly what
            # `--resume` must never build on top of.
            stale = []
            for n, k in marker.get("keys", {}).items():
                d = os.path.join(roots["dest"], n)
                if n in keys and keys[n] == k and os.path.isdir(d):
                    resume.add(n)
                elif os.path.isdir(d):
                    stale.append(n)
                    if not a.dry_run:
                        shutil.rmtree(d, ignore_errors=True)
            print(f"  checkpoint: {len(resume)} package(s) reusable, "
                  f"{len(stale)} stale and discarded")
            if stale:
                print(f"    stale: {', '.join(sorted(stale)[:8])}"
                      + (" ..." if len(stale) > 8 else ""))

    for p in plan:
        name = p["pkg"]
        if name in resume:
            d = os.path.join(roots["dest"], name)
            learn(name, d)
            if a.stage and not a.dry_run:
                n = stage_into(d, roots["sysroot"])
                print(f"== {name} {p['recipe']['version']}  RESTORED "
                      f"({n} paths staged, not rebuilt)")
            continue
        idx = plan.index(p) + 1
        src = p["recipe"]["source"]
        print(f"\n[{idx}/{len(plan)}] {name} {p['recipe']['version']}"
              f"    group {p['recipe'].get('group', '?')}")
        if source_kind(p["recipe"]) == "git":
            print(f"    source   {source_filename(name, p['recipe'])}  "
                  f"commit {src['commit'][:12]}")
        else:
            print(f"    source   {source_filename(name, p['recipe'])}  "
                  f"sha256 {src['sha256'][:12]}")
        os.makedirs(p["env"]["B"], exist_ok=True)
        os.makedirs(p["env"]["D"], exist_ok=True)
        timings = []
        with open(os.path.join(a.logs, f"{name}.log"), "w") as logf:
            logf.write(f"package {name} {p['recipe']['version']}\n")
            for s in p["steps"]:
                if s.get("on_failure"):
                    continue          # only runs when something else fails
                if s.get("optional") and not a.optional:
                    print(f"    - skipped (optional): {s['name']}")
                    logf.write(f"+ SKIPPED optional step: {s['name']}\n")
                    continue
                _t0 = time.time()
                rc = run_step(s, logf, a.dry_run, may_create=(s is p["steps"][0]))
                timings.append((s["name"], time.time() - _t0))
                if rc == 0 and not a.dry_run:
                    # REPORTS, DOES NOT DECIDE -- AND THAT IS A CORRECTION.
                    #
                    # This was a hard failure keyed on the substring
                    # "Found CMake:" appearing in meson's log. Run 52 is what
                    # that cost: glib's `meson setup` SUCCEEDED for the first
                    # time -- full summary, gvdb subproject resolved, ninja
                    # located -- and this gate failed the package anyway,
                    # printing no evidence, and ended the run.
                    #
                    # The substring was chosen from ONE line in run 51's log
                    # and never checked against what meson prints when the
                    # lookup FAILS. A gate built out of the same assumption it
                    # is meant to test cannot test it; it only launders the
                    # guess into something shaped like a measurement.
                    #
                    # So: print the lines, verbatim, and let the run continue.
                    # `veron collect` preserves the whole log. Once the actual
                    # strings are known -- both the found and the not-found
                    # form -- this becomes a real gate keyed on the one that
                    # means the backend is live, and it prints its evidence
                    # when it fires.
                    for rel, lines in cmake_log_lines(s["cwd"]):
                        print(f"    --- cmake mentions in {rel} ---")
                        for ln in lines:
                            print(f"    | {ln}")
                        logf.write(f"+ cmake mentions in {rel}: "
                                   f"{len(lines)} line(s)\n")
                if rc == 0 and s is p["steps"][0]:
                    # After the unpack, before anything reads the source.
                    applied = apply_patches(p["recipe"]["_dir"],
                                            p["env"]["S"], a.dry_run)
                    for fn in applied:
                        logf.write(f"+ patch {fn}\n")
                if rc != 0:
                    print(f"VERON-BUILD-FAIL  {name}: step '{s['name']}' rc={rc}",
                          file=sys.stderr)
                    # DIAGNOSE BEFORE DYING. A failing step usually leaves the
                    # evidence on disk -- a test suite's .log files, a config.log
                    # -- and aborting immediately throws it away. Two rounds were
                    # spent watching m4's suite stop at the same line without
                    # ever seeing which test came next, because the run died
                    # before anything could look.
                    for d in p["steps"]:
                        if d.get("on_failure"):
                            print(f"  --- diagnostic: {d['name']} ---")
                            run_step(d, logf, a.dry_run)
                    return 1
            # WHAT THIS PACKAGE PUT IN THE IMAGE -- COUNTED AND HASHED HERE,
            # LISTED IN THE ARTIFACT.
            #
            # The console used to carry every line every compiler emitted --
            # hundreds of thousands of them, in which the one fact worth
            # keeping was invisible. Replacing that with every INSTALLED path
            # was a large improvement and still the same mistake one size
            # down: 14632 lines of sha256-and-path across 62 packages, in
            # which the four lines somebody opens a log to read were again
            # invisible.
            #
            # What matters afterwards is not how a file was produced but WHICH
            # files exist, how big they are and what they hash to -- and the
            # DIGEST answers all three in sixteen characters that change if
            # any of them do. The listing itself lives in
            # packages/<pkg>/installs.txt and in the collected artifact, which
            # is where an audit reads it from anyway.
            #
            # Compiler output is in driver/<pkg>.log. One computation, summarised
            # here and pinned there, rather than two that can disagree.
            # VERON_LIST_FILES=1 prints the full listing when a single package
            # is being stared at and the artifact is not to hand.
            if not a.dry_run:
                learn(name, os.path.join(roots["dest"], name))
                report_package(name, p["recipe"],
                               os.path.join(roots["dest"], name), provider,
                               timings,
                               p["recipe"].get("installs", {}).get("digest"))
            if a.stage and not a.dry_run:
                n = stage_into(os.path.join(roots["dest"], name),
                               roots["sysroot"])
                print(f"    staged {n} paths into the build root")
                # A PACKAGE THAT INSTALLS NOTHING IS NOT A PACKAGE.
                #
                # cmake's install step had no DESTDIR, so `ninja install`
                # wrote to /usr -- which inside the sandbox IS the build root.
                # cmake therefore worked: it ran, its guest test passed, and
                # everything built against it. dest/cmake/ stayed empty, so
                # the manifest never listed a cmake file, the ledger record
                # described a package that installed nothing, and G3 would
                # have compared two empty directories and reported cmake
                # reproducible. The run printed "staged 0 paths" and carried
                # on, which is the whole problem: the evidence was on screen
                # and nothing was watching for it.
                #
                # There is no legitimate zero-install package in this set, so
                # this is a hard failure rather than a warning.
                if n == 0:
                    die(f"{name}: installed 0 paths into {roots['dest']}/"
                        f"{name}. Its install step is almost certainly "
                        f"missing `env = {{ DESTDIR = \"$D\" }}` and wrote "
                        f"into the build root directly -- which appears to "
                        f"work and leaves the package out of the manifest, "
                        f"the ledger and every reproducibility comparison.")
        print(f"  VERON-PKG-BUILT  {name}")
    print("\nVERON-BUILD-OK  every package built")
    return 0


def cmd_merge(a):
    """Merge every package's DESTDIR into the system root.

    THIS WAS A `cp -a` LOOP IN THE WORKFLOW, AND IT WAS THE SAME BUG THE
    DRIVER ALREADY FIXED ONCE. Run 55 got all the way past the manifest and
    the ledger and then died three packages into the merge:

        merging bash
        cp: cannot create regular file 'sysroot/./usr/bin/bashbug':
            Permission denied

    Not a permissions problem with the runner -- a permissions problem with
    the FILE. stage_into() had already copied bash's 121 paths into the build
    root during the build, so the merge was writing over files that already
    existed, and `cp` opens the destination for writing instead of replacing
    it. A mode that is not user-writable then fails outright.

    stage_into() has carried the fix for this since it destroyed busybox:
    ALWAYS UNLINK FIRST. Replacing the link or file is what installing over an
    existing path should do; writing through it is how bzip2 once overwrote
    the busybox binary that `tar` was a symlink to.

    THE WORKFLOW HAD A SECOND IMPLEMENTATION OF STAGING AND IT WAS THE ONE
    WITHOUT THE LESSON. That is the same defect as the `find` list that used
    to duplicate BUILD_LOGS and as `[declared]` drifting from the argv: two
    copies of one fact, and nothing comparing them. There is one implementation
    now, in the driver, where the comment explaining why lives next to the code.
    """
    recipes = load_recipes()
    roots = roots_from_args(a)
    if not os.path.isdir(a.sysroot):
        die(f"merge target {a.sysroot!r} does not exist")
    total, skipped = 0, []
    for name in sorted(os.listdir(roots["dest"])):
        d = os.path.join(roots["dest"], name)
        if not os.path.isdir(d):
            continue
        if build_only(recipes, name):
            skipped.append(name)
            continue
        n = stage_into(d, a.sysroot)
        total += n
        print(f"  merged {name}  ({n} paths)")
    for name in skipped:
        print(f"  build-only, not merged: {name}")
    print(f"VERON-MERGE-OK  {total} paths into {a.sysroot}")
    return 0


def cmd_tarball_names(a):
    """`<package>\t<tarball filename>`, one per line.

    THE TARBALL NAME IS NOT THE PACKAGE NAME and there is no rule connecting
    them: freetype-bootstrap unpacks freetype-2.14.1, sqlite ships as
    sqlite-autoconf-3530400, icu's tarball is icu4c-78_2-src. Anything that
    needs to find a package's tarball has to read the recipe, and the
    alternative -- a mapping table in a workflow -- is a second copy of a fact
    the recipes already carry, which is the defect this repository keeps
    finding in its own gates.
    """
    # source_filename(), NOT THE URL -- AND THIS CALL SITE WAS MISSED ONCE.
    # cmd_fetch was fixed to use it and this was not, so stage5-reconcile
    # reported
    #     no tarball for libsfdo (libsfdo.git)
    #     no tarball for libxkbcommon (libxkbcommon.git)
    # and skipped the static half for all three git-pinned packages. A git
    # remote's last path component is the REPOSITORY, never the archive
    # fetch-git.sh writes. One helper, every caller.
    for name, r in sorted(load_recipes().items()):
        print(f"{name}\t{source_filename(name, r)}")
    return 0


def cmd_build_only_names(a):
    """The build-only package names, space-separated, for the merge step.

    DERIVED, NEVER LISTED IN YAML. The workflow needs to know which DESTDIRs
    not to merge, and a name pattern or a hardcoded list there would be a
    second copy of a fact the recipes already carry -- the same defect as the
    `find` list that used to duplicate BUILD_LOGS.
    """
    print(" ".join(n for n in sorted(load_recipes()) if build_only(load_recipes(), n)))
    return 0


def cmd_collect(a):
    """Everything needed to diagnose this run, WITHOUT RE-RUNNING IT.

    THE PROBLEM THIS SOLVES. A stage-5 run is hours long. When it ends badly
    the runner is destroyed, and until now that destroyed:

      - logs/<pkg>.log, the driver's own record of every argv, every env var,
        every rc and every step duration. Written on every run since the
        driver existed, bound into the sandbox, and NEVER ONCE COLLECTED,
        PRINTED OR UPLOADED. Nobody has read one.
      - out/logs/, which the workflow populated with `find` and then dropped
        on the floor, because there was no upload step at all. It printed
        "collected 32 log files" and preserved none of them.

    So every diagnosis cost another multi-hour run, and a change made in
    between meant the next run answered a different question than the one
    that was asked.

    THREE RULES, EACH FROM A SPECIFIC FAILURE.

    1. UNCONDITIONAL. The collector was `if: failure()`. The run that most
       needed reading was one where `meson setup` SUCCEEDED and the driver
       failed the package afterwards -- so nothing was collected, because
       nothing had "failed" in the shape the condition expected. A green run
       that is wrong is exactly the run whose evidence is hardest to get.

    2. ABSENCE IS EVIDENCE. INDEX.txt lists what was looked for and NOT
       found, not only what was. "config.log missing" distinguishes a package
       that died before configure from one that died during it, and a
       collector that silently omits it makes those two look identical.

    3. ONE LIST, NOT TWO. The workflow used to `find` a hardcoded set of
       filenames that duplicated BUILD_LOGS in this file. Two lists that must
       agree and nothing comparing them is the same defect as `[declared]`
       drifting from the argv -- so the driver, which owns BUILD_LOGS, does
       the collecting.

    Caps are per-file tails rather than a total cap: truncating the last file
    because earlier ones were large loses exactly the evidence most likely to
    matter.
    """
    roots = roots_from_args(a)
    diag = os.path.join(roots["out"], "diag")
    shutil.rmtree(diag, ignore_errors=True)
    for sub in ("driver", "buildsys", "probe"):
        os.makedirs(os.path.join(diag, sub), exist_ok=True)

    index, cap = [], a.max_bytes

    def keep(src, dst, why):
        """Copy at most `cap` trailing bytes, and say what happened."""
        try:
            size = os.path.getsize(src)
            with open(src, "rb") as f:
                if size > cap:
                    f.seek(size - cap)
                    body = b"[TRUNCATED -- showing the last %d of %d bytes]\n" % (
                        cap, size) + f.read()
                else:
                    body = f.read()
            with open(dst, "wb") as o:
                o.write(body)
            index.append(f"  kept    {why}  ({size} bytes"
                         f"{', truncated' if size > cap else ''})")
            return True
        except OSError as e:
            index.append(f"  FAILED  {why}: {type(e).__name__}: {e}")
            return False

    # 1. THE DRIVER'S OWN RECORD. This is the file that says what actually
    #    ran, in order, with what environment -- and it is the one that has
    #    never been preserved.
    if os.path.isdir(a.logs):
        for fn in sorted(os.listdir(a.logs)):
            if fn.endswith(".log"):
                keep(os.path.join(a.logs, fn),
                     os.path.join(diag, "driver", fn), f"driver/{fn}")
    else:
        index.append(f"  ABSENT  driver logs -- {a.logs} does not exist")

    # 2. WHAT EACH BUILD SYSTEM WROTE DOWN, for every package that has a
    #    build tree, not only the one that failed. A package can succeed and
    #    still have configured wrong, which is the case that started this.
    seen = 0
    if os.path.isdir(roots["build"]):
        for pkg in sorted(os.listdir(roots["build"])):
            pdir = os.path.join(roots["build"], pkg)
            if not os.path.isdir(pdir):
                continue
            for sub in sorted(os.listdir(pdir)):
                for rel in BUILD_LOGS:
                    src = os.path.join(pdir, sub, rel)
                    if not os.path.isfile(src):
                        continue
                    flat = f"{pkg}__{rel.replace('/', '_')}"
                    if keep(src, os.path.join(diag, "buildsys", flat),
                            f"buildsys/{flat}"):
                        seen += 1
        if seen == 0:
            index.append("  ABSENT  no build-system logs under "
                         f"{roots['build']} -- nothing reached configure")
    else:
        index.append(f"  ABSENT  build tree -- {roots['build']} does not exist")

    # 3. THE MECHANISM UNDER TEST, EXTRACTED. A full meson log is 8000 lines
    #    and the question is usually about six of them. This is deliberately
    #    a DUMP AND NOT A VERDICT: it reports the lines verbatim so the next
    #    reader decides what they mean. The gate that tried to decide for
    #    them matched a substring nobody had ever seen meson emit, and failed
    #    a build on it.
    probe = os.path.join(diag, "probe", "meson-cmake.txt")
    hits = 0
    with open(probe, "w") as out:
        out.write("Every line mentioning cmake in every meson log this run.\n"
                  "Verbatim. No interpretation -- that is the point.\n\n")
        bs = os.path.join(diag, "buildsys")
        for fn in sorted(os.listdir(bs)) if os.path.isdir(bs) else []:
            if "meson-log" not in fn:
                continue
            out.write(f"===== {fn}\n")
            try:
                for i, ln in enumerate(open(os.path.join(bs, fn),
                                            errors="replace"), 1):
                    if "cmake" in ln.lower():
                        out.write(f"{i:6}| {ln.rstrip()}\n")
                        hits += 1
            except OSError as e:
                out.write(f"  (unreadable: {e})\n")
            out.write("\n")
    index.append(f"  kept    probe/meson-cmake.txt  ({hits} matching lines)")

    # 4. WHAT THE BOX WAS. A log without its environment cannot be compared
    #    against another run, and comparing runs that were not the same build
    #    is a mistake DERIVATIONS.md records four rounds lost to.
    with open(os.path.join(diag, "RUN.txt"), "w") as f:
        f.write("veron collect\n\n")
        f.write(f"uname            {' '.join(os.uname())}\n")
        f.write(f"python           {sys.version.split()[0]}\n")
        f.write(f"cwd              {os.getcwd()}\n")
        for k in ("GITHUB_SHA", "GITHUB_RUN_ID", "GITHUB_RUN_ATTEMPT",
                  "GITHUB_WORKFLOW"):
            f.write(f"{k:16} {os.environ.get(k, '(unset)')}\n")
        f.write("\n-- resolved environment --\n")
        for k in sorted(os.environ):
            f.write(f"  {k}={os.environ[k]}\n")
        f.write("\n-- policy --\n")
        try:
            pol = load_policy()
            for sec in sorted(pol):
                f.write(f"  [{sec}] {pol[sec]}\n")
        except Exception as e:
            f.write(f"  (unreadable: {type(e).__name__}: {e})\n")
        f.write("\n-- tools on PATH --\n")
        # BISON, FLEX, M4 AND PERL ARE NOT STAGE-5 PACKAGES and are required
        # by things that are -- libxkbcommon will not build without bison
        # >= 3.6. They come from the stage-4 sysroot, which stage5-entry
        # trims six things out of. Recording where each resolves means a trim
        # that removes one shows up in this file rather than in a build
        # failure three rungs later.
        for tool in ("meson", "ninja", "cmake", "pkgconf", "pkg-config",
                     "python3", "gcc", "g++", "patch", "tar",
                     "bison", "flex", "m4", "perl"):
            w = shutil.which(tool, path=os.environ.get("PATH", ""))
            f.write(f"  {tool:12} {w or 'NOT FOUND'}\n")

    with open(os.path.join(diag, "INDEX.txt"), "w") as f:
        f.write("What this run preserved, and what it looked for and did "
                "not find.\n\n")
        f.write("\n".join(index) + "\n")

    print(f"VERON-COLLECT-OK  {len(index)} entries -> {diag}")
    for line in index[:25]:
        print(line)
    if len(index) > 25:
        print(f"  ... and {len(index) - 25} more (see INDEX.txt)")
    return 0


def file_manifest(root):
    """Every installed path, sorted. This is what `veron why` reads.

    Required whether the system ends up FHS or content-addressed, and the one
    part that is genuinely painful to retrofit -- which is why it exists at
    n=2 rather than being deferred.
    """
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for fn in sorted(filenames):
            full = os.path.join(dirpath, fn)
            rel = os.path.relpath(full, root)
            if os.path.islink(full):
                out.append((rel, "symlink", os.readlink(full)))
            else:
                out.append((rel, "file", sha256_file(full)))
    return sorted(out)


def build_only(recipes, name):
    """Is this package a build-time rung that ships nothing?

    THE CASE THAT FORCED THIS. freetype-bootstrap and freetype are the SAME
    freetype 2.14.1 at the same prefix, built twice: once --without-harfbuzz so
    harfbuzz has something to link, once --with-harfbuzz for the system. So
    every path the bootstrap installs collides with the real one, and
    `veron manifest` failed on the first alphabetically:

        path collision: usr/bin/freetype-config claimed by freetype
                        and freetype-bootstrap

    THE GATE WAS RIGHT, AND IT STOPPED SOMETHING WORSE. The merge step is
    `for d in dest/*/`, which the shell sorts -- so `dest/freetype/` copies
    first and `dest/freetype-bootstrap/` copies OVER it. The image would have
    shipped the freetype built WITHOUT harfbuzz, under a manifest naming the
    other one, and everything would have looked green.

    A bootstrap rung is a real category, not an exception: it is built, it is
    staged so later packages can link it, and then it is superseded. Saying so
    in the recipe is the difference between a declared supersession and a
    collision nobody can attribute.
    """
    return bool(recipes.get(name, {}).get("build_only", False))


# ---------------------------------------------------------------- DT_NEEDED


def elf_dynamic(path):
    """(soname, [needed]) from an ELF's dynamic section. Pure Python.

    WHY NOT readelf. `probe linked` shells out to it, which is fine on a
    runner and wrong everywhere else: the build sandbox is busybox with no
    binutils, and guest/selfrebuild.sh runs inside the booted image where the
    same is true. A check on what the system actually links must not need a
    tool the system does not have -- that is how a gate ends up running in one
    place and quietly skipped in the two that matter.

    The format is fixed and small. The only fiddly part is that DT_STRTAB is a
    VIRTUAL ADDRESS, so it has to be mapped back to a file offset through the
    PT_LOAD segments; reading it as an offset works on most binaries and is
    wrong on exactly the ones that are laid out unusually.

    Returns (None, []) for anything that is not an ELF, rather than raising --
    a DESTDIR is full of scripts, headers and data.
    """
    try:
        with open(path, "rb") as f:
            b = f.read()
    except OSError:
        return None, []
    if len(b) < 64 or b[:4] != b"\x7fELF":
        return None, []

    bits, endian = b[4], b[5]
    e = "<" if endian == 1 else ">"
    W = 8 if bits == 2 else 4

    def u(off, size):
        return int.from_bytes(b[off:off + size], "little" if e == "<" else "big")

    # Program headers: e_phoff, e_phentsize, e_phnum
    if bits == 2:
        phoff, phentsize, phnum = u(0x20, 8), u(0x36, 2), u(0x38, 2)
        PT_OFF, PT_VADDR, PT_FILESZ = 0x08, 0x10, 0x20
    else:
        phoff, phentsize, phnum = u(0x1C, 4), u(0x2A, 2), u(0x2C, 2)
        PT_OFF, PT_VADDR, PT_FILESZ = 0x04, 0x08, 0x10

    loads, dyn = [], None
    for i in range(phnum):
        p = phoff + i * phentsize
        if p + phentsize > len(b):
            return None, []
        ptype = u(p, 4)
        off = u(p + PT_OFF, W)
        vaddr = u(p + PT_VADDR, W)
        filesz = u(p + PT_FILESZ, W)
        if ptype == 1:                      # PT_LOAD
            loads.append((vaddr, off, filesz))
        elif ptype == 2:                    # PT_DYNAMIC
            dyn = (off, filesz)
    if not dyn:
        return None, []

    def v2o(vaddr):
        """Virtual address -> file offset, through PT_LOAD."""
        for lv, lo, lsz in loads:
            if lv <= vaddr < lv + lsz:
                return lo + (vaddr - lv)
        return None

    strtab = strsz = None
    entries = []
    off, size = dyn
    step = W * 2
    for p in range(off, min(off + size, len(b) - step + 1), step):
        tag = u(p, W)
        val = u(p + W, W)
        if tag == 0:                        # DT_NULL
            break
        entries.append((tag, val))
        if tag == 5:                        # DT_STRTAB
            strtab = val
        elif tag == 10:                     # DT_STRSZ
            strsz = val
    if strtab is None:
        return None, []
    base = v2o(strtab)
    if base is None:
        return None, []
    end = base + (strsz or 0)

    def s(idx):
        i = base + idx
        if i >= len(b):
            return ""
        j = b.find(b"\x00", i, end if strsz else len(b))
        return b[i:j if j > 0 else i].decode("utf-8", "replace")

    soname, needed = None, []
    for tag, val in entries:
        if tag == 1:                        # DT_NEEDED
            needed.append(s(val))
        elif tag == 14:                     # DT_SONAME
            soname = s(val)
    return soname, needed


def cmd_linked(a):
    """DT_NEEDED against deps.link, in both directions.

    THE ONLY DETECTOR THAT MEASURES WHAT HAPPENED. The static scan reads what
    a build file ASKS for and the distro half reads what someone else
    DECLARES; both are statements about intent. This reads the ELF a build
    actually produced, and it is the only one that can catch the direction the
    others structurally cannot:

        LINKED BUT NOT DECLARED -- a library that was sitting in the sysroot
        for another package's sake, found by a configure script nobody told to
        look, and now a real runtime dependency that no record mentions.

    That is the case where the build is green and the ledger is wrong, which
    is the one an audit claim cannot survive.

    DECLARED BUT NOT LINKED is the other direction and is milder: fontconfig
    declared libxml2 and links expat. Milder because it over-states rather
    than under-states -- but it still means `veron why` would answer with a
    dependency that does not exist.

    WHAT IT CANNOT SEE, stated so the absence is not read as a clean bill:
      - static archives. A .a linked into a binary leaves no DT_NEEDED.
      - dlopen. A plugin loaded at runtime is invisible here and in every
        other detector this project has.
      - header-only and build-tool dependencies. Those belong in deps.build,
        which this does not check, because a compiler is not linked.
    """
    recipes = load_recipes()
    roots = roots_from_args(a)
    dest = roots["dest"]
    if not os.path.isdir(dest):
        die(f"no DESTDIRs at {dest} -- run `veron build` first")

    # WHO PROVIDES WHAT, from the built artifacts rather than from a name.
    # A package provides a soname if one of its own ELFs declares it, and
    # also under any .so filename it installs -- symlinks included, because
    # `libfoo.so.1` is usually a link to `libfoo.so.1.2.3` and DT_NEEDED
    # names the link.
    provider, elfs = {}, {}
    for pkg in sorted(os.listdir(dest)):
        d = os.path.join(dest, pkg)
        if not os.path.isdir(d):
            continue
        mine = []
        for dirpath, _, files in os.walk(d):
            for fn in files:
                p = os.path.join(dirpath, fn)
                # SET, NOT FIRST-WINS -- see resolve_provider(). freetype and
                # freetype-bootstrap both install libfreetype.so.6, and
                # walking dest/ alphabetically made every consumer of the
                # bootstrap copy look like an undeclared link on `freetype`.
                if os.path.islink(p):
                    if ".so" in fn:
                        provider.setdefault(fn, set()).add(pkg)
                    continue
                soname, needed = elf_dynamic(p)
                if soname:
                    provider.setdefault(soname, set()).add(pkg)
                if ".so" in fn:
                    provider.setdefault(fn, set()).add(pkg)
                if needed:
                    mine.append((os.path.relpath(p, d), needed))
        elfs[pkg] = mine

    problems, sysroot_libs = 0, {}
    for pkg in sorted(elfs):
        r = recipes.get(pkg)
        if r is None:
            continue
        declared = set(r.get("deps", {}).get("link", []))
        linked, where = set(), {}
        for rel, needed in elfs[pkg]:
            for so in needed:
                owners = provider.get(so)
                if not owners:
                    # NOT A GAP -- the base image. libc, libm, libstdc++ and
                    # friends come from the stage-4 sysroot, which no stage-5
                    # recipe owns. Counted separately so the number is visible
                    # rather than absent, the way `veron status` treats opaque.
                    sysroot_libs.setdefault(so, set()).add(pkg)
                    continue
                owner = resolve_provider(owners, pkg, declared)
                if owner == pkg:
                    continue
                linked.add(owner)
                where.setdefault(owner, (so, rel))

        undeclared = sorted(linked - declared)
        # A DEPENDENCY THAT SHIPS NO SHARED LIBRARY CANNOT APPEAR IN
        # DT_NEEDED, AND REPORTING IT AS UNLINKED IS THE DETECTOR ACCUSING
        # SOMETHING IT CANNOT SEE.
        #
        # bzip2's recipe runs `make`, which builds libbz2.a and the bzip2
        # binary -- the shared library needs a separate Makefile-libbz2_so
        # that we do not invoke. So cmake, libarchive and python link bzip2
        # STATICALLY, correctly declare it in deps.link, and leave no
        # DT_NEEDED behind. Nine of the first sweep's eleven findings had this
        # single cause.
        #
        # Static linking IS linking; the declaration is right and the
        # measurement is blind. Skipping providers with no shared object is
        # the honest scope, and it is checkable rather than a judgement: if a
        # package installs a .so, it is in scope; if it does not, it is not.
        def ships_shared(pkg):
            dd = os.path.join(dest, pkg)
            for dp, _, fs in os.walk(dd):
                for fn in fs:
                    if ".so" in fn:
                        return True
            return False

        unlinked = sorted(d for d in (declared - linked)
                          if d in recipes and ships_shared(d))
        static_only = sorted(d for d in (declared - linked)
                             if d in recipes and not ships_shared(d))
        if static_only:
            # SAID, NOT SILENT. These are real declarations this detector is
            # structurally unable to confirm, and a run that never mentions
            # them reads as though it checked them.
            print(f"== {pkg}\n  static-only  {' '.join(static_only)} "
                  f"ship no shared library; linkage not observable here")
            if not undeclared and not unlinked:
                continue
        elif not undeclared and not unlinked:
            continue
        if not static_only:
            print(f"== {pkg}")
        for u in undeclared:
            so, rel = where[u]
            problems += 1
            print(f"  {'LINKED-UNDECLARED' if a.mode == 'fail' else 'linked-undeclared'}"
                  f"  {pkg} links {u} ({so} via {rel}) and deps.link does not "
                  f"say so")
        for u in unlinked:
            problems += 1
            print(f"  {'DECLARED-UNLINKED' if a.mode == 'fail' else 'declared-unlinked'}"
                  f"  {pkg} declares {u} in deps.link and links nothing it "
                  f"provides")

    if sysroot_libs:
        print(f"\n  {len(sysroot_libs)} soname(s) come from the stage-4 "
              f"sysroot, owned by no stage-5 recipe:")
        for so in sorted(sysroot_libs):
            users = sorted(sysroot_libs[so])
            more = f" (+{len(users) - 3} more)" if len(users) > 3 else ""
            print(f"    {so:<24} {', '.join(users[:3])}{more}")

    print(f"\nVERON-LINKED-{'FAIL' if (problems and a.mode == 'fail') else 'OK'}"
          f"  {problems} mismatch(es) across {len(elfs)} package(s)")
    return 1 if (problems and a.mode == "fail") else 0


def install_prefixes(destdir, depth=3):
    """The distinct install prefixes under a DESTDIR, at a fixed depth.

    DEPTH 3 IS THE UNIT A DECISION IS MADE AT. `usr` alone says nothing --
    every package installs under it. Full paths would list ten thousand files
    and change on every upstream release. `usr/share/hwdata` and
    `usr/lib/modprobe.d` are the level at which somebody looks and says yes or
    no, which is exactly the level hwdata's stray modprobe config would have
    been caught at.
    """
    out = set()
    for dirpath, _, files in os.walk(destdir):
        rel = os.path.relpath(dirpath, destdir)
        if rel == "." or not files:
            continue
        parts = rel.split(os.sep)
        out.add("/".join(parts[:depth]))
    return sorted(out)


def install_listing(destdir):
    """(lines, digest) -- every path a package installs, with size and sha256.

    FILE-LEVEL, NOT SET-LEVEL, AND THE FIRST VERSION OF THIS WAS WEAKER FOR A
    REASON THAT DOES NOT APPLY HERE. It hashed only the path set, on the
    argument that content hashes churn on any rebuild that is not
    bit-reproducible and that reproducibility is G3's job.

    But this project MEASURES byte-reproducibility and has it:

        VERON-IMAGE-REPRO-OK  two builds, identical bytes

    so per-file digests are stable, and a digest that moved would be either a
    real change or a reproducibility REGRESSION -- both of which are worth
    stopping for. Leaving contents out would have thrown away the strongest
    property the build already has.

    IT IS ALSO ALREADY COMPUTED. `file_manifest` has recorded sha256 per file
    and the target per symlink since n=2; it was simply never pinned per
    package. This records the same facts where a recipe can carry them.

    AND IT IS CHEAPER THAN G3. G3 builds everything a SECOND time in the same
    run and compares -- which is why it was switched off, since it doubles
    every build. Comparing this run's bytes against a digest committed by a
    previous run is per-package reproducibility across TIME, for the cost of
    a hash of files that were just written.

        f <sha256> <size> <path>
        l <target> <path>

    Symlinks carry their target rather than a hash: the target is what a
    symlink IS, and hashing what it points at would make a link's identity
    depend on a file that may belong to another package.
    """
    lines = []
    for dirpath, _, files in os.walk(destdir):
        for fn in files:
            p = os.path.join(dirpath, fn)
            rel = os.path.relpath(p, destdir)
            if os.path.islink(p):
                lines.append(f"l {os.readlink(p)} {rel}")
            else:
                try:
                    lines.append(f"f {sha256_file(p)} {os.path.getsize(p)} {rel}")
                except OSError as e:
                    lines.append(f"? unreadable:{type(e).__name__} 0 {rel}")
    lines.sort(key=lambda l: l.rsplit(" ", 1)[-1])
    body = "\n".join(lines) + ("\n" if lines else "")
    return lines, hashlib.sha256(body.encode()).hexdigest()


def cmd_installs(a):
    """Check -- or propose -- what each package is allowed to install.

    THE CONTRACT. A recipe declares the prefixes it installs into; anything
    outside them fails the package by name. `veron build` already refuses a
    package that installs NOTHING, after cmake spent its whole life writing
    into /usr instead of its DESTDIR. This is the other half: a package that
    installs somewhere nobody expected.

    WHY IT MATTERS MORE THAN IT SOUNDS. hwdata drops a modprobe blacklist into
    $(libdir)/modprobe.d by default, in a system with no kmod to read it.
    harfbuzz installs three utilities nobody asked for. Neither breaks
    anything; both put files in the image that no decision put there, and the
    manifest records them as though someone had chosen.

    --propose EMITS THE CURRENT PREFIXES, because writing 48 of these by hand
    from memory is how they end up wrong. Run it against a real build, read
    the output, paste what is correct -- the same shape as the reconciler's
    proposals, and for the same reason.
    """
    recipes = load_recipes()
    roots = roots_from_args(a)
    dest = roots["dest"]
    if not os.path.isdir(dest):
        die(f"no DESTDIRs at {dest} -- run `veron build` first")

    # COUNTED SEPARATELY. The first version added both to one total and
    # then called it "stray prefix(es)", so a content change was reported
    # under the name of a different check. A summary that misnames what
    # it counted is worse than one that counts nothing.
    stray_n, changed_n, missing = 0, 0, []
    for pkg in sorted(os.listdir(dest)):
        d = os.path.join(dest, pkg)
        if not os.path.isdir(d) or pkg not in recipes:
            continue
        actual = install_prefixes(d)
        lines, digest = install_listing(d)
        ins = recipes[pkg].get("installs", {})
        declared = ins.get("prefixes")
        if a.propose:
            lst = ", ".join(f'"{p}"' for p in actual)
            print(f"# ---- packages/{pkg}/recipe.toml")
            print("[installs]")
            print(f"prefixes = [{lst}]")
            print(f"files    = {len(lines)}")
            print(f"digest   = \"{digest}\"\n")
            listing = os.path.join(recipes[pkg]["_dir"], "installs.txt")
            with open(listing, "w") as f:
                f.write("\n".join(lines) + ("\n" if lines else ""))
            print(f"# wrote {listing} ({len(lines)} paths)")
            if a.write:
                # WRITTEN IN, NOT PASTED IN. Forty-eight blocks transcribed by
                # hand is forty-eight chances to put the right digest under the
                # wrong package -- and the whole value of the digest is that it
                # is the one this build measured. The recipe is the only place
                # it can be edited by hand afterwards, and git diff is the
                # review.
                block = (f"[installs]\nprefixes = [{lst}]\n"
                         f"files    = {len(lines)}\n"
                         f'digest   = "{digest}"\n')
                rp = os.path.join(recipes[pkg]["_dir"], "recipe.toml")
                t = open(rp).read()
                m = re.search(r"^\[installs\]\n(?:(?!^\[).*\n)*", t, re.M)
                if m:
                    t = t[:m.start()] + block + t[m.end():]
                else:
                    i = t.index("\n[[steps]]")
                    t = t[:i] + "\n" + block + t[i:]
                open(rp, "w").write(t)
                print(f"# wrote {rp}")
            print()
            continue
        if declared is None:
            missing.append(pkg)
            continue
        stray = [p for p in actual
                 if not any(p == d2 or p.startswith(d2 + "/") for d2 in declared)]
        for p in stray:
            stray_n += 1
            print(f"  {'UNDECLARED-PREFIX' if a.mode == 'fail' else 'undeclared-prefix'}"
                  f"  {pkg} installs into {p}, which [installs].prefixes does "
                  f"not allow")

        # THE FILE SET, WHICH prefixes CANNOT SEE. An upstream that starts
        # shipping one more binary installs it into a prefix already allowed,
        # so the prefix check passes and the image quietly grows. The digest
        # turns that into a decision: the gate fails, somebody looks, and
        # either the recipe or the flags change.
        want = ins.get("digest")
        if want and want != digest:
            changed_n += 1
            print(f"  {'INSTALL-SET-CHANGED' if a.mode == 'fail' else 'install-set-changed'}"
                  f"  {pkg}: {len(lines)} path(s) now, digest {digest[:16]}, "
                  f"recipe pins {want[:16]}")
            # AND SAY WHICH FILES, because "the digest moved" is a fact nobody
            # can act on. installs.txt is the committed expansion of that
            # digest, so the diff is available without a second build.
            listing = os.path.join(recipes[pkg]["_dir"], "installs.txt")
            if os.path.isfile(listing):
                was = set(open(listing).read().splitlines())
                now = set(lines)
                for x in sorted(now - was)[:8]:
                    print(f"      + {x}")
                for x in sorted(was - now)[:8]:
                    print(f"      - {x}")
                extra = len(now ^ was) - min(len(now ^ was), 16)
                if extra > 0:
                    print(f"      ... and {extra} more")
            else:
                print(f"      no installs.txt to diff against -- run "
                      f"`veron installs --propose` to write one")
    if a.propose:
        return 0
    if missing:
        # NOT SILENCE. A package with no [installs] block is UNCHECKED, and a
        # run that reports zero problems while most packages are unchecked is
        # the reassuring zero this project keeps finding.
        print(f"\n  {len(missing)} package(s) declare no [installs].prefixes "
              f"and were NOT checked:")
        print(f"    {', '.join(missing)}")
    # IN fail MODE, UNCHECKED IS A FAILURE.
    #
    # With no [installs] block a package is not checked at all, so a run over
    # 48 unseeded recipes reports "0 stray prefixes" and passes -- a zero over
    # an unchecked set, which is the reassuring number this project has caught
    # three times now. Turning the mode up must therefore also require that
    # there is something to check, or the gate certifies its own blindness.
    problems = stray_n + changed_n + (len(missing) if a.mode == "fail" else 0)
    print(f"\nVERON-INSTALLS-{'FAIL' if (problems and a.mode == 'fail') else 'OK'}"
          f"  {stray_n} stray prefix(es), {changed_n} changed install set(s), "
          f"{len(missing)} unchecked")
    return 1 if (problems and a.mode == "fail") else 0


def cmd_isolate(a):
    """Build each package in a root composed of ONLY its declared dependencies.

    THE QUESTION THIS ANSWERS. `stage_into` copies every package into one
    shared root, so by the time glib builds, all thirty-odd predecessors are
    visible to it. `deps.build` therefore ORDERS the build correctly and
    proves nothing about what a package can reach -- which is why an
    undeclared dependency is currently detectable (probe, reconcile,
    DT_NEEDED) but never impossible.

    Here each package gets: the stage-4 sysroot, plus the DESTDIRs of the
    packages it DECLARES, and nothing else. An undeclared dependency stops
    being a finding and becomes a build failure that names itself.

    OVERLAY, NOT COPYING, AND OUR OWN bwrap. The layers are stacked with
    bubblewrap's --overlay-src, so nothing is copied and no build can mutate
    the shared sysroot even by accident -- which also means stage_into's whole
    mutation model is absent here rather than merely unused.
    bubblewrap 0.11.0 is already pinned and mirrored in this repository with
    two routes, and the airlock builds it: the alternative was apt's binary,
    whose version decides whether --overlay-src exists at all. A spike whose
    result depends on what the runner happened to ship is a spike about the
    runner.

    DIRECT DEPENDENCIES, NOT THE CLOSURE. glib sees pcre2 because it declares
    pcre2; it does not see zlib because pcre2 was built after zlib. That is
    the strict reading and it is the one that finds things -- a failure that
    turns out to be "we should have declared this" is the finding, not noise.

    IT KEEPS GOING. The main spike stops at the first failure because its job
    is a working image. This one's deliverable is the LIST of packages that
    cannot build in isolation and why, so stopping at package 9 would throw
    away the measurement. It is therefore never a gate.

    WHAT IT CANNOT ISOLATE, stated so the result is not over-read: the stage-4
    sysroot is in every root. bison, gcc, perl and m4 come from there and stay
    reachable by everything. This tightens stage 5 against itself, not against
    its base -- which is exactly what [undeclarable] records.
    """
    recipes = load_recipes()
    roots = roots_from_args(a)
    order = topo_order(recipes)
    if a.pkg:
        order = [n for n in order if n in a.pkg]

    results, missing_bwrap = [], not (a.dry_run or os.path.exists(a.bwrap))
    if missing_bwrap:
        die(f"no bwrap at {a.bwrap} -- the airlock builds it from the pinned "
            f"bubblewrap tarball; pass --bwrap or --dry-run")

    for name in order:
        r = recipes[name]
        # EACH DECLARED DEPENDENCY, PLUS WHAT IT NEEDS TO RUN.
        #
        # The first sweep failed 17 of 48 and every dominant cause was the
        # same shape:
        #
        #     ImportError: libz.so.1: cannot open shared object file
        #     cmake: error while loading shared libraries: libcurl.so.4
        #     libncursesw.so.6, needed by libreadline.so, not found
        #
        # meson declares `python`; python was in the root; python could not
        # START, because python's own runtime closure was not. The recipes
        # were right -- `python runtime=[zlib, ...]`, `cmake runtime=[curl,
        # ...]` -- and the composition rule was wrong. A BUILD TOOL YOU CANNOT
        # EXECUTE IS NOT A BUILD TOOL.
        #
        # This is NOT the transitive-build-deps reading, and the distinction
        # is the whole point of the exercise: glib still does not see zlib
        # merely because pcre2 needed zlib to BUILD. It sees zlib because it
        # declares python and python needs zlib to RUN. Build closure stays
        # strict; runtime closure travels with the thing that has it, which is
        # what "declaring a dependency" has to mean if it means anything.
        direct = set(r.get("deps", {}).get("build", [])) \
            | set(r.get("deps", {}).get("link", []))
        deps, seen = set(direct), set()
        queue = list(direct)
        while queue:
            d = queue.pop()
            if d in seen:
                continue
            seen.add(d)
            rr = recipes.get(d)
            if not rr:
                continue
            for rt in rr.get("deps", {}).get("runtime", []):
                if rt not in deps:
                    deps.add(rt)
                    queue.append(rt)
        # A PACKAGE IS NOT ITS OWN DEPENDENCY, AND THE CLOSURE FOUND ONE.
        #
        #     == freetype: SKIPPED, declared deps not built here: freetype
        #
        # freetype declares harfbuzz; harfbuzz's RUNTIME declares freetype --
        # both correct, and together a cycle the runtime walk follows straight
        # back to where it started. It then cascaded: fontconfig, cairo and
        # pango were all skipped because freetype was.
        #
        # The data is right and the walk was naive. That cycle is the reason
        # freetype-bootstrap exists at all, so it was always going to appear
        # here; discarding the package itself is the whole fix.
        deps.discard(name)
        deps = sorted(deps)
        layers, absent = [], []
        for d in deps:
            dd = os.path.join(roots["dest"], d)
            (layers if os.path.isdir(dd) else absent).append(dd if os.path.isdir(dd) else d)
        if absent:
            # A DECLARED DEPENDENCY WITH NO DESTDIR means it has not been
            # built yet in this run -- which under --pkg is expected and
            # otherwise is a plan bug. Said either way rather than silently
            # producing a thinner root than the recipe asked for.
            print(f"== {name}: SKIPPED, declared deps not built here: "
                  f"{', '.join(absent)}")
            results.append((name, "skipped", ",".join(absent)))
            continue

        mine = os.path.join(roots["dest"], name)
        os.makedirs(mine, exist_ok=True)
        os.makedirs(roots["build"], exist_ok=True)
        os.makedirs(a.logs, exist_ok=True)

        argv = [a.bwrap, "--unshare-all", "--die-with-parent", "--new-session",
                "--overlay-src", roots["sysroot"]]
        for l in layers:
            argv += ["--overlay-src", l]
        argv += ["--tmp-overlay", "/",
                 "--bind", os.path.abspath(roots["build"]), "/build",
                 "--bind", os.path.abspath(mine), f"/dest/{name}",
                 "--bind", os.path.abspath(roots["dl"]), "/dl",
                 "--bind", os.path.abspath(a.logs), "/logs",
                 "--ro-bind", os.path.abspath(PKGDIR), "/packages",
                 "--ro-bind", os.path.abspath(POLICY), "/policy",
                 "--ro-bind", os.path.abspath(os.path.dirname(
                     os.path.abspath(__file__))), "/tools",
                 "--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp",
                 "--setenv", "PATH", "/usr/bin:/usr/sbin:/bin",
                 "--setenv", "HOME", "/build", "--setenv", "SHELL", "/bin/sh",
                 "--chdir", "/",
                 "/usr/bin/python3", "/tools/veron",
                 "--dl", "/dl", "--build-dir", "/build", "--dest", "/dest",
                 "--logs", "/logs", "--out", "/build/out", "--sysroot", "/",
                 # NO STAGING. Staging exists to make a package visible to the
                 # ones after it in a SHARED root; here the layers do that,
                 # and writing into an overlay tmpfs would vanish anyway.
                 # POSITIONAL, NOT --pkg. `build` takes package names as
                 # positionals; `--pkg` is not an option and argparse exits 2.
                 # Every one of the 48 packages failed that way on the first
                 # run -- a uniform rc=2 that looks like a structural problem
                 # with the overlay and was a typo in this list.
                 "build", name, "--no-stage"]

        # AND THE COMPOSED COMMAND IS CHECKED AGAINST THE REAL PARSER.
        #
        # The selftest validates every `veron ...` line in every WORKFLOW, and
        # could not see this one: an argv built in Python is not a line of
        # YAML. So the check moves to where the argv is built. This is the
        # third veron invocation this project has got wrong -- `merge --dest`
        # with a global after the subcommand, a three-field read of a
        # four-field producer, and now this -- and the first two each cost a
        # full run to discover.
        tail = argv[argv.index("/tools/veron") + 1:]
        try:
            buf_e = io.StringIO()
            with contextlib.redirect_stderr(buf_e):
                build_parser().parse_args(tail)
        except SystemExit:
            die(f"the composed command for {name} does not parse:\n"
                f"  veron {' '.join(tail)}\n{buf_e.getvalue().strip()}")

        print(f"== {name}  ({len(layers)} declared dep layer(s))")
        if a.dry_run:
            print("   " + " ".join(argv))
            results.append((name, "dry-run", ""))
            continue
        p = subprocess.run(argv)
        state = "ok" if p.returncode == 0 else f"FAILED rc={p.returncode}"
        print(f"   {state}")
        results.append((name, "ok" if p.returncode == 0 else "failed",
                        "" if p.returncode == 0 else str(p.returncode)))

    ok_n = sum(1 for _, s, _ in results if s == "ok")
    failed = [(n, d) for n, s, d in results if s == "failed"]
    skipped = [n for n, s, _ in results if s == "skipped"]
    print(f"\n  {ok_n} built in isolation, {len(failed)} failed, "
          f"{len(skipped)} skipped")
    for n, d in failed:
        print(f"    FAILED   {n}  ({d})")
    for n in skipped:
        print(f"    skipped  {n}")
    print(f"\nVERON-ISOLATE-DONE  {len(failed)} package(s) could not build "
          f"from their declared dependencies alone")
    # NEVER A GATE. The failures are the deliverable.
    return 0


def cmd_manifest(a):
    recipes = load_recipes()
    roots = roots_from_args(a)
    total = {}
    skipped = []
    for name in sorted(os.listdir(roots["dest"])):
        d = os.path.join(roots["dest"], name)
        if not os.path.isdir(d):
            continue
        if build_only(recipes, name):
            # DECLARED, NOT SILENTLY DROPPED. The count is printed so a
            # package that vanishes from the image is visible in the log
            # rather than merely absent from a list.
            skipped.append(name)
            continue
        for rel, kind, val in file_manifest(d):
            if rel in total:
                # TWO PACKAGES CLAIMING ONE PATH. At n=2 this cannot happen and
                # the check looks pointless; at n=200 it is how a file gets
                # attributed to the wrong derivation and `veron why` starts
                # lying. Loud now, cheap now.
                die(f"path collision: {rel} claimed by {total[rel][0]} and {name}")
            total[rel] = (name, kind, val)
    os.makedirs(roots["out"], exist_ok=True)
    mf = os.path.join(roots["out"], "files.tsv")
    with open(mf, "w") as f:
        for rel in sorted(total):
            pkg, kind, val = total[rel]
            f.write(f"{rel}\t{pkg}\t{kind}\t{val}\n")
    print(f"VERON-MANIFEST-OK  {len(total)} paths, {mf}")
    print(f"  manifest-sha256  {sha256_file(mf)}")
    for name in skipped:
        print(f"  build-only, not in the image: {name}")
    return 0


def cmd_rootfs(a):
    """A deterministic rootfs tar. The image container is built from this.

    Determinism knobs, all explicit because every one of them defaults to
    something that varies: sorted member order, mtime 0, uid/gid 0, numeric
    owner, no pax headers. A directory walk instead of a sorted manifest is
    the single most common way a "reproducible" image is not.
    """
    roots = roots_from_args(a)
    out = os.path.join(roots["out"], "rootfs.tar")
    members = []
    for name in sorted(os.listdir(roots["dest"])):
        d = os.path.join(roots["dest"], name)
        if not os.path.isdir(d):
            continue
        for dirpath, dirnames, filenames in os.walk(d):
            dirnames.sort()
            for fn in sorted(dirnames) + sorted(filenames):
                full = os.path.join(dirpath, fn)
                members.append((os.path.relpath(full, d), full))
    members.sort()

    with tarfile.open(out, "w", format=tarfile.GNU_FORMAT) as tf:
        for rel, full in members:
            ti = tf.gettarinfo(full, arcname="./" + rel)
            ti.mtime = 0
            ti.uid = ti.gid = 0
            ti.uname = ti.gname = ""
            if ti.isfile():
                with open(full, "rb") as f:
                    tf.addfile(ti, f)
            else:
                tf.addfile(ti)
    print(f"VERON-ROOTFS-OK  {out}")
    print(f"  rootfs-sha256   {sha256_file(out)}")
    return 0


def cmd_ledger(a):
    """One record per output, the seven criteria.

    Criterion 2 is written thin and honest: this spike does one build, so
    attestations is 1. Better to write the field truthfully at n=2 than to
    leave it blank and have it quietly stay blank at n=200.
    """
    recipes = load_recipes()
    policy = load_policy()
    roots = roots_from_args(a)
    os.makedirs(a.ledger, exist_ok=True)

    # EVIDENCE, NOT A CONSTANT. G3 builds everything a second time in a clean
    # tree and compares per file; its marker is the only thing that can
    # honestly raise this above 1. Independent REBUILDERS -- other machines,
    # other people -- are what would raise it further, and none exist yet.
    # A RESTORED CHECKPOINT MUST APPEAR IN THE RECORD. If some packages were
    # staged from a cache rather than built, this run did not build them, and
    # a ledger that does not say so describes work it did not do. The
    # checkpoint is content-addressed and its key is recorded, so the claim
    # stays checkable -- but it is a weaker claim than a full build and the
    # record has to be the thing that says which.
    ckpt = read_checkpoint(roots["dest"])
    g3 = os.path.join(roots["out"], "G3-OK")
    if ckpt:
        attestations = 0
        # READ THE MARKER THE WAY cmd_checkpoint WRITES IT. This used to read
        # ckpt['index'] and ckpt['key'], which was the shape before the
        # checkpoint key became per package -- and the run died here with
        # KeyError: 'index' AFTER all 62 packages had built, the manifest had
        # passed and the ledger was the next thing to write.
        #
        # Second time a producer change has broken a reader: `veron
        # git-sources` gained a fourth column and the spike's shell `read` was
        # left at three. The name-binding gate cannot see this one, because a
        # dict key is not a name.
        n = len(ckpt.get("keys", {}))
        attest_note = (f"NOT A FULL BUILD: {n} package(s) were restored from "
                       f"a checkpoint rather than built in this run. No "
                       f"reproducibility claim follows from it.")
    elif os.path.exists(g3):
        attestations = 2
        attest_note = ("two independent builds on one runner, compared per "
                       "file (G3). No third-party rebuilder has attested.")
    else:
        attestations = 1
        attest_note = "one build; G3 has not passed for this output"

    written = 0
    for name in topo_order(recipes):
        r = recipes[name]
        dest = os.path.join(roots["dest"], name)
        if not os.path.isdir(dest):
            print(f"  skip {name}: not installed")
            continue
        files = file_manifest(dest)
        outhash = sha256_bytes(
            "\n".join(f"{p}\t{k}\t{v}" for p, k, v in files).encode())
        rec = {
            "output_hash": outhash,
            "name": name,
            "version": r["version"],
            "flavor": policy["build"]["flavor"],
            "provenance": {
                "url": r["source"]["url"],
                "sha256": r["source"]["sha256"],
                "signature": r["source"].get("signature", "none"),
                "git_commit": r["source"].get("git_commit"),
                "correspondence": r["source"].get("correspondence", "none"),
                "residue": r["source"].get("residue"),
            },
            "reproducibility": {
                "output_hash": outhash,
                "attestations": attestations,
                "note": attest_note,
            },
            "inputs": {
                "recipe_sha256": r["_recipe_sha256"],
                "deps": r.get("deps", {}),
                "sysroot": policy["build"].get("sysroot_id", "stage4"),
            },
            "reviewed_delta": {
                "patches": sorted(os.listdir(os.path.join(r["_dir"], "patches")))
                if os.path.isdir(os.path.join(r["_dir"], "patches")) else [],
                "configure_flags": r.get("declared", {}).get("configure_flags", []),
                "optional_off": r.get("deps", {}).get("optional_off", []),
            },
            "verification": r.get("declared", {}).get("verification", "none declared"),
            "deferral": r.get("declared", {}).get("deferral", "NOT DECLARED"),
            "license": r["license"],
            "files": [{"path": p, "kind": k, "value": v} for p, k, v in files],
        }
        path = os.path.join(a.ledger, f"{outhash}.json")
        with open(path, "w") as f:
            json.dump(rec, f, indent=2, sort_keys=True)
            f.write("\n")
        print(f"  wrote {os.path.basename(path)}  ({name})")
        written += 1
    print(f"VERON-LEDGER-OK  {written} record(s)")
    return 0


def cmd_compare(a):
    """G3. Two manifests, compared per file.

    THE GAP THIS CLOSES. Everything proven about reproducibility so far has
    been about CONTAINERS -- the ext4 image reproduces, the initramfs
    reproduces. No package had ever been built twice and compared. Meanwhile
    the ledger already writes reproducibility.output_hash with
    attestations: 1, which asserts something nothing had checked.

    Per file rather than one hash over the tree, because "the tree differs"
    is not actionable and "libpkgconf.so.5.0.0 differs" is.
    """
    def load(path):
        out = {}
        with open(path) as f:
            for ln in f:
                parts = ln.rstrip("\n").split("\t")
                if len(parts) >= 4:
                    out[parts[0]] = (parts[1], parts[2], parts[3])
        return out

    a_m, b_m = load(a.first), load(a.second)
    only_a = sorted(set(a_m) - set(b_m))
    only_b = sorted(set(b_m) - set(a_m))
    differ = sorted(p for p in set(a_m) & set(b_m) if a_m[p][2] != b_m[p][2])

    for p in only_a:
        print(f"  ONLY-IN-FIRST   {p}")
    for p in only_b:
        print(f"  ONLY-IN-SECOND  {p}")
    for p in differ:
        print(f"  DIFFERS         {p}  ({a_m[p][0]})")
        print(f"                  {a_m[p][2][:16]} vs {b_m[p][2][:16]}")

    n = len(set(a_m) | set(b_m))
    bad = len(only_a) + len(only_b) + len(differ)
    if bad == 0:
        # THE LEDGER READS THIS. reproducibility.attestations was hardcoded to
        # 1, which asserted less than the pipeline could prove once G3 existed
        # -- and would have kept asserting it after G3 started passing. A
        # marker written only on success means the record follows the
        # evidence instead of a constant someone has to remember to bump.
        if a.mark:
            with open(a.mark, "w") as f:
                f.write(f"{n}\n")
            print(f"  wrote {a.mark}")
        print(f"VERON-G3-OK  {n} files identical across two independent builds")
        return 0
    print(f"VERON-G3-DIFF  {bad} of {n} files differ")
    print("  A difference is a FINDING, not a broken build. Likeliest causes,")
    print("  in order: a path or hostname captured at compile time, a")
    print("  timestamp the recipe does not pin, build-order nondeterminism,")
    print("  or locale/CPU detection. Fix it, or declare it in")
    print("  policy/expected-differences.toml with the reason.")
    return 1


def cmd_guesttests(a):
    """Emit each package's guest sanity test as a shell script.

    WHY THIS IS NOT ONE HANDWRITTEN SCRIPT. guest/test.sh hardcoded hello and
    pkgconf; at 150 packages that is a file nobody maintains and a gate
    everyone stops reading. Same rule that fixed the fetch step: iterate,
    never hardcode.

    A package with NO guest test is DECLARED as having none rather than
    silently untested -- the difference between "we checked and there is
    nothing to run" and "nobody thought about it".

    These are SANITY tests, deliberately. Does it reproduce is answered by G3
    on the runner, at native speed. Whether the system can rebuild itself is
    the self-rebuild gate. This one answers only: does the installed thing
    actually work.
    """
    recipes = load_recipes()
    L = ["#!/bin/sh", "# GENERATED by `veron guest-tests`. Do not edit.",
         "set -u", 'pass=0; fail=0; skip=0',
         'ok()   { pass=$((pass+1)); echo "  ok    $1"; }',
         'bad()  { fail=$((fail+1)); echo "  FAIL  $1"; }',
         'none() { skip=$((skip+1)); echo "  none  $1 (declared: no guest test)"; }',
         'echo "VERON-STAGE5-GUEST begin"']
    for name in topo_order(recipes):
        if recipes[name].get("build_only"):
            # NOT "no test" -- NOTHING TO TEST. A build-only rung installs no
            # file into the image, so a guest test would be checking a path
            # another package owns.
            L.append(f'none "{name} (build-only: nothing ships)"')
            continue
        g = recipes[name].get("guest", {})
        if not g.get("test"):
            L.append(f'none "{name}"')
            continue
        for i, argv in enumerate(g["test"]):
            # QUOTE EVERY ARGUMENT. Joining argv with spaces produces valid
            # shell only while no argument contains anything the shell cares
            # about. python's test passes
            #     -c "import zlib,bz2,lzma,ctypes; print('modules ok')"
            # which unquoted became a bare `;` and a bare `(` in the middle of
            # a generated script:
            #     /usr/bin/veron-stage5-test: line 69: syntax error:
            #     unexpected word (expecting ")")
            # -- and took the whole test file down with it, not just that one
            # test. shlex.quote is what turns an argv back into shell.
            cmd = " ".join(shlex.quote(x) for x in argv)
            want = g.get("expect", [])
            w = want[i] if isinstance(want, list) and i < len(want) else (
                want if isinstance(want, str) else "")
            L.append(f'if out=$({cmd} 2>&1); then')
            if w:
                L.append(f'  case "$out" in *"{w}"*) ok "{name}: $out" ;;'
                         f' *) bad "{name}: got [$out], want [{w}]" ;; esac')
            else:
                L.append(f'  ok "{name}: $out"')
            L.append(f'else bad "{name}: {cmd} did not run"; fi')
    L += ['echo "VERON-STAGE5-TESTS pass=$pass fail=$fail none=$skip"',
          '[ "$fail" -eq 0 ] && echo "VERON-STAGE5-OK" || echo "VERON-STAGE5-FAIL"']
    text = "\n".join(L) + "\n"
    if a.out:
        open(a.out, "w").write(text)
        os.chmod(a.out, 0o755)
        print(f"  wrote {a.out}")
    else:
        sys.stdout.write(text)
    return 0


def cmd_selftest(a):
    """Assert the driver still honours what the recipes declare.

    WHY THIS EXISTS. A release of this tool was assembled from an older copy
    and silently lost per-step `env`. The recipes still declared PATH, the
    driver ignored it, and pkgconf's test suite failed in a way that looked
    like a package problem. THE PLAN GATE COULD NOT CATCH IT: PLAN.txt was
    regenerated by the same broken driver, so it agreed with itself.

    That is the general shape -- a gate that compares a tool against its own
    output cannot detect the tool losing a feature. This checks BEHAVIOUR
    against a fixture instead.
    """
    import tempfile
    ok = True

    with tempfile.TemporaryDirectory() as td:
        pkgs = os.path.join(td, "packages", "fixture")
        os.makedirs(os.path.join(pkgs, "patches"))
        open(os.path.join(pkgs, "recipe.toml"), "w").write(
            'name = "fixture"\nversion = "0"\ngroup = "selftest"\n'
            'license = "MIT"\n[source]\nurl = "https://x.invalid/f-0.tar"\n'
            'sha256 = "' + "0" * 64 + '"\n[deps]\nbuild = []\n'
            '[[steps]]\nname = "probe"\ncwd = "$B"\n'
            'env = { VERON_SELFTEST_MARKER = "applied" }\n'
            "run = [['sh','-c','test \"$VERON_SELFTEST_MARKER\" = applied']]\n")

        global PKGDIR
        saved = PKGDIR
        PKGDIR = os.path.join(td, "packages")
        try:
            recipes = load_recipes()
            policy = load_policy()
            roots = {"dl": td, "build": os.path.join(td, "b"),
                     "dest": os.path.join(td, "d"), "sysroot": "/",
                     "out": os.path.join(td, "o")}
            plan = expand(recipes, policy, roots)
            step = plan[0]["steps"][0]

            if step.get("env", {}).get("VERON_SELFTEST_MARKER") != "applied":
                print("  FAIL  per-step env is not expanded into the plan")
                ok = False
            else:
                print("  ok    per-step env reaches the plan")

            os.makedirs(step["cwd"], exist_ok=True)
            e = dict(os.environ); e.update(step["env"])
            rc = subprocess.run(step["argv"], cwd=step["cwd"], env=e).returncode
            if rc != 0:
                print("  FAIL  per-step env does not reach the process")
                ok = False
            else:
                print("  ok    per-step env reaches the process")
        finally:
            PKGDIR = saved

    with tempfile.TemporaryDirectory() as td:
        d = os.path.join(td, "dest", "p"); os.makedirs(os.path.join(d, "usr", "bin"))
        open(os.path.join(d, "usr", "bin", "t"), "w").write("x")
        os.symlink("t", os.path.join(d, "usr", "bin", "t2"))
        # A REAL BUILD ROOT, because the guard rejects anything else -- and
        # it caught this fixture the moment it was added, which is the guard
        # working rather than the fixture being unlucky.
        root = os.path.join(td, "root"); rb = os.path.join(root, "usr", "bin")
        os.makedirs(rb)
        # THE FIXTURE MUST LOOK LIKE THE REAL BUILD ROOT: a multi-call binary
        # with a crowd of symlinks pointing at it. Staging into an EMPTY root
        # cannot reproduce writing through a link, which is why the first
        # version of this test passed while staging was destroying busybox.
        open(os.path.join(rb, "multicall"), "w").write("INTACT")
        os.symlink("multicall", os.path.join(rb, "t"))
        n = stage_into(d, root)
        staged = os.path.exists(os.path.join(root, "usr", "bin", "t"))
        linked = os.path.islink(os.path.join(root, "usr", "bin", "t2"))
        survived = open(os.path.join(rb, "multicall")).read() == "INTACT"
        if n == 2 and staged and linked and survived:
            print("  ok    staging replaces symlinks without writing through them")
        else:
            print(f"  FAIL  staged={n} file={staged} link={linked} "
                  f"multicall-intact={survived}")
            ok = False

    # THE CMAKE POLICY MUST BE IN FORCE. policy/defaults.toml sets $CMAKE to a
    # path that cannot exist so that meson's CMake dependency backend reports
    # not-found instead of crashing on cmake 4.x trace output. That is an
    # assertion about how the build behaves, and the build only demonstrates
    # it on a package that has a missing optional dependency -- so if the line
    # were dropped, the set would keep building until it reached one and then
    # fail somewhere that looks unrelated. Checking it statically costs
    # nothing and names the cause up front.
    try:
        pol = load_policy()
        cmake_env = pol.get("tool_env", {}).get("meson", {}).get("CMAKE")
        if pol.get("env", {}).get("CMAKE"):
            print("  FAIL  CMAKE is in the GLOBAL [env] -- it reaches cmake's "
                  "own bootstrap and every configure script. It belongs in "
                  "[tool_env.meson].")
            ok = False
        elif not cmake_env:
            print("  FAIL  policy sets no [tool_env.meson] CMAKE -- meson's "
                  "CMake dependency backend is reachable")
            ok = False
        elif os.path.exists(cmake_env):
            print(f"  FAIL  CMAKE={cmake_env!r} EXISTS, so meson will use it "
                  f"as a dependency backend")
            ok = False
        else:
            print("  ok    meson cannot reach its CMake dependency backend")
        # tool_env IS KEYED ON argv[0], so a step that reaches meson through a
        # shell never gets it -- and would crash exactly the way glib did,
        # with the policy looking correct. No recipe does this today; the
        # check is here so that the day one does, it says so rather than
        # failing 1500 lines into a meson log.
        shelled = []
        for rname, r in sorted(load_recipes().items()):
            for st in r.get("steps", []):
                sh = st.get("shell", "")
                if re.search(r"(^|[;&|\s])meson\s", sh):
                    shelled.append(f"{rname}/{st['name']}")
        if shelled:
            for c in shelled:
                print(f"  FAIL  {c} invokes meson from a shell step -- "
                      f"[tool_env.meson] cannot reach it")
            ok = False
        else:
            print("  ok    every meson invocation is an argv step")
    except Exception as e:
        print(f"  FAIL  CMAKE policy check could not run: "
              f"{type(e).__name__}: {e}")
        ok = False

    # EVERY RECIPE MUST INSTALL INTO ITS OWN DESTDIR. A step that installs to
    # /usr succeeds inside the sandbox, because / IS the build root -- so the
    # package works, and is simultaneously absent from the manifest, from the
    # ledger and from every reproducibility comparison. cmake did exactly this
    # for the whole life of the recipe while its own deferral note claimed
    # otherwise. `veron build` now fails on a zero-path staging, but that only
    # fires on a run that gets that far; this fires on a laptop in a second.
    #
    # $D AND $DL ARE DIFFERENT NAMES. The expander matches whole names, and a
    # check that did not would count `$DL/foo.tar.gz` as a DESTDIR reference
    # and pass every recipe in the tree -- the same prefix bug subst() was
    # rewritten to avoid.
    try:
        dref = re.compile(r"\$D(?![A-Za-z0-9_])")
        missing = []
        for rname, r in sorted(load_recipes().items()):
            found = False
            for st in r.get("steps", []):
                blobs = list(st.get("env", {}).values())
                blobs += [t for argv in st.get("run", []) for t in argv]
                if st.get("shell"):
                    blobs.append(st["shell"])
                if any(dref.search(str(b)) for b in blobs):
                    found = True
                    break
            if not found:
                missing.append(rname)
        if missing:
            for m in missing:
                print(f"  FAIL  {m} never references $D -- nothing it builds "
                      f"reaches its DESTDIR")
            ok = False
        else:
            print("  ok    every recipe installs into its own DESTDIR")
    except Exception as e:
        print(f"  FAIL  DESTDIR check could not run: {type(e).__name__}: {e}")
        ok = False

    # SHELL STEPS MUST NOT NAME A VARIABLE THE EXPANDER OWNS. A recipe wrote
    # `P=$D/usr/bin/python3.14` and then used "$P" -- but $P is the patches
    # directory, so the expansion silently replaced the interpreter with a
    # path to patches/. That one was caught only because $P is absolute and
    # differs between machines, so the plan hash moved. A collision with $D or
    # $S would expand the same everywhere and sail through the gate.
    recipes_dir = PKGDIR
    collisions = []
    try:
        for rname, r in sorted(load_recipes().items()):
            for st in r.get("steps", []):
                sh = st.get("shell")
                if not sh:
                    continue
                for var in ("B", "S", "D", "P", "J", "V", "N", "DL"):
                    if re.search(rf"(^|[;&|\s]){var}=", sh):
                        collisions.append(f"{rname}/{st['name']}: assigns ${var}")
    except Exception:
        collisions = None
    if collisions is None:
        print("  ok    shell-variable collision check skipped (no recipes here)")
    elif collisions:
        for c in collisions:
            print(f"  FAIL  {c} -- that name belongs to the expander")
        ok = False
    else:
        print("  ok    no shell step assigns a name the expander owns")

    # THE GENERATED GUEST TEST MUST BE VALID SHELL. This driver writes that
    # file and never runs it, so a quoting bug in it surfaces only inside a
    # booted guest -- as "line 69: syntax error: unexpected word", which took
    # down the entire test file rather than the one test that caused it.
    # `sh -n` parses without executing, which is exactly the check that was
    # missing.
    try:
        import contextlib as _c, io as _i, subprocess as _sp, tempfile as _tf
        with _tf.NamedTemporaryFile("w", suffix=".sh", delete=False) as f:
            buf = _i.StringIO()
            with _c.redirect_stdout(buf):
                class _G:
                    out = None
                cmd_guesttests(_G())
            f.write(buf.getvalue())
            path = f.name
        r = _sp.run(["sh", "-n", path], capture_output=True, text=True)
        os.unlink(path)
        if r.returncode == 0:
            print("  ok    the generated guest test parses as shell")
        else:
            print(f"  FAIL  generated guest test is not valid shell: "
                  f"{r.stderr.strip()[:70]}")
            ok = False
    except FileNotFoundError:
        # No `sh` available. Genuinely not checkable, and said plainly.
        print("  --    guest-test syntax check needs sh, which is absent here")
    except Exception as e:
        # ANY OTHER FAILURE IS THE CHECK BEING BROKEN, not the check being
        # inapplicable. The first version swallowed an UnboundLocalError and
        # printed "ok ... skipped" on every run -- a gate that reads green and
        # verifies nothing is worse than no gate.
        print(f"  FAIL  guest-test syntax check itself failed: "
              f"{type(e).__name__}: {e}")
        ok = False

    # NO ABSOLUTE PATHS IN THE PLAN. PLAN.txt is generated and committed, so
    # anything machine-specific in it makes `plan --check` fail everywhere
    # else -- which is exactly what a patch step did, embedding
    # /home/claude/... on one machine and /home/runner/... on the other. The
    # gate failed correctly and told nobody why.
    try:
        import io as _i2, contextlib as _c2

        class _P:
            write = False
            check = False
            # cmd_plan resolves the roots, so the fixture has to supply them.
            # The defaults are what the workflow passes; any value works
            # because the check is for absolute paths, not for these values.
            dl = "dl"
            build_dir = "build"
            dest = "dest"
            sysroot = "sysroot"
            out = "out"
        buf2 = _i2.StringIO()
        with _c2.redirect_stdout(buf2):
            cmd_plan(_P())
        bad = [ln.strip()[:70] for ln in buf2.getvalue().splitlines()
               if re.search(r"/(home|Users|root)/", ln)]
        if bad:
            print(f"  FAIL  the plan contains {len(bad)} machine-specific "
                  f"path(s): {bad[0]!r}")
            ok = False
        else:
            print("  ok    the plan has no machine-specific paths")
    except Exception as e:
        # NOT "ok". A check that cannot run is a check that is not running,
        # and printing ok for it is how a gate comes to read green while
        # verifying nothing -- which has already happened twice in this file.
        print(f"  FAIL  plan path check could not run: "
              f"{type(e).__name__}: {e}")
        ok = False

    # EVERY SUBCOMMAND THE WORKFLOWS ACTUALLY CALL. A hand-kept list drifts:
    # `git-sources` was called by stage5-spike.yml and absent from this
    # driver, and the run died with
    #     invalid choice: 'git-sources'
    # while this check reported the CLI intact -- because git-sources was not
    # on the list.
    #
    # Only names that ARE subcommands are looked for. A first version reported
    # every word following the string "veron" and produced eight false alarms
    # from prose and file paths; a check that cries wolf is a check people
    # stop reading.
    KNOWN = ("plan", "fetch", "build", "manifest", "rootfs", "ledger",
             "selftest", "guest-tests", "compare", "status", "sources",
             "git-sources", "collect", "build-only-names", "merge",
             "tarball-names", "linked",
             "keys", "checkpoint", "installs",
             "isolate")
    called = set()
    wfdir = os.path.join(HERE, "..", "..", ".github", "workflows")
    if os.path.isdir(wfdir):
        for fn in sorted(os.listdir(wfdir)):
            if not fn.endswith((".yml", ".yaml")):
                continue
            try:
                text = open(os.path.join(wfdir, fn), errors="replace").read()
            except OSError:
                continue
            for k in KNOWN:
                if re.search(rf"veron[^\n]*\s{re.escape(k)}\b", text):
                    called.add(k)

    # ASK THE PARSER, DO NOT PRINT A LIST. This loop printed "ok subcommand
    # present" for every name it was given and checked nothing -- renaming
    # git-sources in the parser left it reporting ok. A decorative gate is
    # worse than none: it occupies the place where a real one would go.
    # The parser is built inside main(), and calling main() would parse
    # sys.argv and exit -- so read the registrations from this file instead.
    # Less elegant than asking argparse, and it works without side effects.
    parser_names = set()
    try:
        src = open(os.path.abspath(__file__), errors="replace").read()
        parser_names = set(re.findall(r'sub\.add_parser\(\s*"([a-z-]+)"', src))
        if not parser_names:
            print("  FAIL  found no subcommand registrations to check against")
            ok = False
    except OSError as e:
        print(f"  FAIL  could not read this file: {e}")
        ok = False

    for name in sorted(called | {"plan", "fetch", "build", "manifest",
                                 "ledger", "compare", "guest-tests",
                                 "status"}):
        if name in parser_names:
            print(f"  ok    subcommand present: {name}")
        else:
            print(f"  FAIL  `veron {name}` is called but the parser has no "
                  f"such subcommand")
            ok = False

    # `veron sources` feeds a shell loop that splits every line into
    # sha256/name/url. Anything else on stdout becomes a fetch for a file
    # named "" -- which is how a status message turned into
    # "IsADirectoryError: 'dl/'" and cost a run.
    import io as _io, contextlib as _ctx

    class _A:
        pass

    buf = _io.StringIO()
    try:
        with _ctx.redirect_stdout(buf):
            cmd_sources(_A())
        # TAB-separated, exactly three fields: sha256, name, url. Splitting
        # on whitespace instead let a four-word status line pass the check --
        # a guard that agrees with the bug is worse than no guard.
        bad = [ln for ln in buf.getvalue().splitlines()
               if ln.strip() and len(ln.split("\t")) != 3]
        if bad:
            print(f"  FAIL  `sources` wrote {len(bad)} unparseable line(s) to "
                  f"stdout: {bad[0][:50]!r}")
            ok = False
        else:
            print("  ok    `sources` stdout is machine-parseable")
    except Exception as e:
        print(f"  ok    `sources` not checkable here ({type(e).__name__})")

    # EVERY `veron ...` LINE IN EVERY WORKFLOW, HANDED TO THE REAL PARSER.
    #
    # The check above asserts each subcommand EXISTS. Run 56 proved that is
    # not enough: after a clean 45-package build, the merge step died with
    #
    #     veron: error: unrecognized arguments: --dest dest --sysroot sysroot
    #
    # because --dest and --sysroot are registered on the TOP-LEVEL parser and
    # must precede the subcommand. The subcommand existed, was spelled right,
    # and the call was still malformed. Only argparse itself knows that.
    #
    # WHAT IS SKIPPED IS COUNTED, NOT IGNORED. A line carrying shell
    # substitution or a GitHub expression cannot be tokenised honestly, and
    # quietly passing it would make this the third decorative gate in this
    # file's history.
    import shlex as _shlex
    checked = skipped = 0
    bad = []
    wfdir2 = os.path.join(HERE, "..", "..", ".github", "workflows")
    if os.path.isdir(wfdir2):
        parser = build_parser()
        for fn in sorted(os.listdir(wfdir2)):
            if not fn.endswith((".yml", ".yaml")):
                continue
            text = open(os.path.join(wfdir2, fn), errors="replace").read()
            # Join shell continuations so a wrapped invocation is one line.
            text = re.sub(r"\\\s*\n\s*", " ", text)
            for m in re.finditer(r"(?:python3|/usr/bin/python3)\s+\S*(?:tools/)?veron\s+([^\n]*)",
                                 text):
                rest = m.group(1)
                # Stop at anything that ends the command.
                rest = re.split(r"[|;>]|&&", rest)[0].strip()
                if "${{" in rest or "$(" in rest:
                    skipped += 1
                    continue
                try:
                    toks = _shlex.split(rest)
                except ValueError:
                    skipped += 1
                    continue
                # A shell variable as a VALUE is fine -- substitute a stand-in
                # so argparse sees the shape rather than the content.
                toks = ["PLACEHOLDER" if t.startswith("$") else t for t in toks]
                if not toks:
                    skipped += 1
                    continue
                checked += 1
                buf_err = _i.StringIO()
                try:
                    with _c.redirect_stderr(buf_err):
                        parser.parse_args(toks)
                except SystemExit:
                    bad.append(f"{fn}: veron {rest}")
                except Exception:
                    bad.append(f"{fn}: veron {rest}")
    if bad:
        for b in bad:
            print(f"  FAIL  malformed invocation -- {b}")
        ok = False
    elif checked:
        print(f"  ok    {checked} workflow veron invocation(s) parse "
              f"({skipped} not tokenisable, skipped)")
    else:
        print("  FAIL  found no workflow veron invocations to check")
        ok = False
    # THE ELF READER, AGAINST A BINARY THIS INTERPRETER IS RUNNING ON.
    #
    # It replaces a readelf subprocess, so nothing external can corroborate it
    # at runtime -- which is the point (busybox has no binutils) and also the
    # risk. python3 itself is a dynamically linked ELF with a known shape: it
    # must report libc, and its DT_NEEDED list must be non-empty. A parser
    # that silently returns nothing would otherwise make every package look
    # like it links nothing at all, and the check would pass everywhere.
    try:
        me = os.path.realpath(sys.executable)
        soname, needed = elf_dynamic(me)
        if needed and any(n.startswith("libc.") for n in needed):
            print(f"  ok    the ELF reader finds DT_NEEDED ({len(needed)} on "
                  f"this interpreter)")
        else:
            print(f"  FAIL  ELF reader returned {needed!r} for {me} -- a "
                  f"parser that finds nothing makes every package look clean")
            ok = False
        if elf_dynamic(os.path.abspath(__file__))[1]:
            print("  FAIL  ELF reader returned DT_NEEDED for a shell script")
            ok = False
        else:
            print("  ok    the ELF reader ignores non-ELF files")
    except Exception as e:
        print(f"  FAIL  ELF reader raised: {type(e).__name__}: {e}")
        ok = False

    # EVERY KEY A READER TAKES FROM THE CHECKPOINT MARKER MUST BE ONE
    # cmd_checkpoint ACTUALLY WRITES.
    #
    # The marker went from {"key", "index", "packages"} to {"base", "keys"}
    # when the checkpoint key became per package, and cmd_ledger was left
    # reading the old shape. The run died with `KeyError: 'index'` AFTER all
    # 62 packages had built, the manifest had passed, and the ledger was the
    # next thing to write -- so the cost was a full build.
    #
    # THE NAME-BINDING GATE CANNOT SEE THIS: a dict key is not a name. This is
    # the same failure as `veron git-sources` gaining a fourth column while
    # the spike's shell `read` stayed at three -- a producer changed and one
    # of its readers did not. Both are only checkable by comparing the two
    # ends, which is what this does.
    # MATCHED ON THE AST, NOT THE TEXT. The first version used a regex over
    # the source and flagged `index` and `key` -- from the COMMENT above
    # explaining that those were the old names. A checker that reads its own
    # documentation as code is worse than none, because the fix is to delete
    # the explanation.
    written, read = set(), set()
    _mtree = ast.parse(open(os.path.abspath(__file__)).read())
    for node in ast.walk(_mtree):
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Dict) \
           and any(isinstance(t, ast.Name) and t.id == "marker"
                   for t in node.targets):
            written |= {k.value for k in node.value.keys
                        if isinstance(k, ast.Constant) and isinstance(k.value, str)}
        if isinstance(node, ast.Subscript) and isinstance(node.value, ast.Name) \
           and node.value.id in ("ckpt", "marker") \
           and isinstance(node.slice, ast.Constant) \
           and isinstance(node.slice.value, str):
            read.add(node.slice.value)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) \
           and node.func.attr == "get" \
           and isinstance(node.func.value, ast.Name) \
           and node.func.value.id in ("ckpt", "marker") and node.args \
           and isinstance(node.args[0], ast.Constant) \
           and isinstance(node.args[0].value, str):
            read.add(node.args[0].value)
    unknown = read - written
    if not written:
        print("  FAIL  could not find the checkpoint marker literal to check")
        ok = False
    elif unknown:
        print(f"  FAIL  checkpoint marker read with key(s) it never writes: "
              f"{sorted(unknown)} -- writes {sorted(written)}")
        ok = False
    else:
        print(f"  ok    every checkpoint marker key read is one it writes "
              f"({', '.join(sorted(written))})")

    # EVERY NAME THE DRIVER USES MUST EXIST, CHECKED WITHOUT RUNNING IT.
    #
    # `NameError: name 'learn' is not defined` reached CI and killed a run at
    # package 1 -- AFTER that package had built. A patch to the resume block
    # replaced a span that happened to contain the definition, which is the
    # third collision in this one function: packager_deps and run_step each
    # had the same accident and each was eventually rewritten whole.
    #
    # Python resolves names at CALL time, so a deleted helper is invisible to
    # import, invisible to `ast.parse`, and invisible to every selftest that
    # does not execute that exact branch. `compile()` will not catch it and
    # neither will anything short of running the build.
    #
    # So walk the AST: for each function, every Name it LOADS must be bound
    # somewhere reachable -- its own locals, an enclosing function, module
    # scope, or builtins. This is the check that would have failed here
    # instead of in CI, in under a second.
    import builtins as _bi
    src = open(os.path.abspath(__file__)).read()
    tree = ast.parse(src)
    module_names = set(dir(_bi))
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
            module_names.add(node.name)
        elif isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
            for t in ast.walk(node):
                if isinstance(t, ast.Name):
                    module_names.add(t.id)
        else:
            # WALK INTO IT, because a module-level import can be inside a
            # `try:` -- which is exactly how `import yaml` is guarded here,
            # and the first version of this scanner only looked at direct
            # children of the module body and then flagged yaml as unbound.
            for n in ast.walk(node):
                if isinstance(n, (ast.Import, ast.ImportFrom)):
                    for al in n.names:
                        module_names.add((al.asname or al.name).split(".")[0])
                elif isinstance(n, ast.Name) and isinstance(n.ctx, ast.Store):
                    module_names.add(n.id)

    def _bound(fn):
        # PERMISSIVE ON PURPOSE. Proper scoping would track each nested
        # function separately; this unions everything bound ANYWHERE inside,
        # including nested functions' parameters and comprehension targets.
        # A union can miss a name bound only on a branch that never runs --
        # but it cannot report a name that is genuinely there, and a checker
        # with false positives is one that gets deleted. The failure it exists
        # to catch is a definition DELETED outright, which no scope contains.
        out = set()
        for n in ast.walk(fn):
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef,
                              ast.Lambda)):
                a = n.args
                out.update(x.arg for x in a.args + a.kwonlyargs + a.posonlyargs)
                if a.vararg:
                    out.add(a.vararg.arg)
                if a.kwarg:
                    out.add(a.kwarg.arg)
        for n in ast.walk(fn):
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                out.add(n.name)
            elif isinstance(n, ast.Name) and isinstance(n.ctx, (ast.Store, ast.Del)):
                out.add(n.id)
            elif isinstance(n, ast.ExceptHandler) and n.name:
                out.add(n.name)
            elif isinstance(n, (ast.Import, ast.ImportFrom)):
                for al in n.names:
                    out.add((al.asname or al.name).split(".")[0])
            elif isinstance(n, ast.Global) or isinstance(n, ast.Nonlocal):
                out.update(n.names)
        return out

    unbound = []
    for fn in [n for n in tree.body if isinstance(n, ast.FunctionDef)]:
        a = fn.args
        scope = module_names | _bound(fn) \
            | {x.arg for x in a.args + a.kwonlyargs + a.posonlyargs} \
            | ({a.vararg.arg} if a.vararg else set()) \
            | ({a.kwarg.arg} if a.kwarg else set())
        for n in ast.walk(fn):
            if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load) \
               and n.id not in scope:
                unbound.append(f"{fn.name}(): {n.id} (line {n.lineno})")
    if unbound:
        for u in sorted(set(unbound))[:8]:
            print(f"  FAIL  name used and never bound -- {u}")
        ok = False
    else:
        print(f"  ok    every name the driver uses is bound "
              f"({len(tree.body)} top-level definitions)")

    # EVERY WORKFLOW INPUT MUST BE REFERENCED BY SOMETHING IN ITS WORKFLOW.
    #
    # `seed_installs` kept its description -- "write [installs] blocks and
    # installs.txt from this build, and upload them" -- for two dispatches
    # after a splice deleted the step it described. Both runs ticked the box,
    # produced no listings, and reported success, because an input that
    # drives nothing cannot fail. The description was the only surviving
    # evidence that the feature had ever existed.
    #
    # A step is not a name, so the AST gate cannot see this. What it IS is a
    # producer/consumer pair -- an input declared and never consumed -- which
    # is the same shape as the checkpoint marker keys, and checkable the same
    # way: grep the file for `inputs.<name>` outside its own declaration.
    _wfdir = os.path.join(HERE, "..", "..", ".github", "workflows")
    _found = sorted(glob.glob(os.path.join(_wfdir, "*.yml")))
    if not _found:
        # A CHECK THAT FINDS NO FILES PASSES, AND THAT IS THE FAILURE MODE
        # THIS WHOLE GATE EXISTS TO CATCH. The first version had the wrong
        # number of `..` and reported "ok" over zero workflows.
        print(f"  FAIL  no workflows found under {_wfdir}")
        ok = False
    for wf in _found:
        body = open(wf).read()
        m = re.search(r"^  workflow_dispatch:\n(?:    inputs:\n)?"
                      r"((?:      \S.*\n(?:        .*\n)*)*)", body, re.M)
        if not m:
            continue
        declared = re.findall(r"^      (\w+):", m.group(1), re.M)
        unused = [d for d in declared
                  if f"inputs.{d}" not in body and f"inputs['{d}']" not in body]
        if unused:
            # WARN, NOT FAIL, AND ONLY BECAUSE TWO PRE-EXISTING ONES EXIST.
            # stage3-watchpoint's `width` and stage5-order's `reuse` are dead
            # today; failing on them would block every run over something
            # unrelated to the change that introduced this check. They should
            # be deleted, and when they are this should become a FAIL -- a
            # warning that is never acted on is the same as no check.
            print(f"  warn  {os.path.basename(wf)}: input(s) declared and "
                  f"never used: {', '.join(unused)}")
    if _found:
        print(f"  ok    {len(_found)} workflow(s) checked for dead inputs")

    # EVERY `run:` BLOCK MUST BE VALID SHELL.
    #
    # A workflow can parse as YAML and still be nonsense: moving a block out
    # of a step left the `fi` of its `if` behind, and the run died with
    #
    #     syntax error near unexpected token `fi'
    #
    # after the packages had built and the tests had passed. The YAML check
    # cannot see it -- to YAML a `run:` block is a string -- and `sh -n` finds
    # it in milliseconds.
    #
    # Skips blocks containing ${{ }}, since those are not shell until Actions
    # substitutes them and a bare `${{ inputs.x }}` is a syntax error on its
    # own.
    import subprocess as _sp
    _bad_shell = []
    for wf in (_found if yaml else []):
        try:
            y = yaml.safe_load(open(wf))
        except Exception:
            continue
        for job in (y or {}).get("jobs", {}).values():
            for st in job.get("steps", []) or []:
                body = st.get("run")
                if not body or "${{" in body:
                    continue
                # bash -n, NOT sh -n. GitHub's default shell on Linux is
                # `bash -e`, and checking with sh flagged five steps that use
                # arrays and [[ ]] -- correct bash, and the checker was the
                # thing that was wrong.
                sh = "bash" if "sh" not in str(st.get("shell", "")) \
                     or "bash" in str(st.get("shell", "")) else "sh"
                r = _sp.run([sh, "-n", "-"], input=body,
                            capture_output=True, text=True)
                if r.returncode:
                    # WARN, LIKE THE DEAD-INPUT CHECK, AND FOR THE SAME
                    # REASON. Two pre-existing workflows have unbalanced
                    # quotes; failing every run over them would block work
                    # unrelated to the change that added this. They should be
                    # fixed and this should then become a FAIL -- a warning
                    # nobody acts on is the same as no check.
                    _bad_shell.append(
                        f"{os.path.basename(wf)}: "
                        f"{st.get('name','(unnamed)')!r}")
    if _bad_shell:
        for b in _bad_shell:
            print(f"  warn  not valid shell: {b}")
    print(f"  ok    every other run: block is valid shell")



    # NO WORKFLOW MAY DECLARE THE SAME STEP NAME TWICE.
    #
    # stage5-reconcile ran its git-pinned generation step TWICE, and the run
    # log showed it plainly -- steps 6 and 7, identical names, identical
    # bodies. Nothing failed: fetch-git.sh caches, so the second call printed
    # "cached" and exited 0. A duplicate that is merely wasteful is exactly
    # the kind that survives, because the only symptom is a step nobody reads
    # twice.
    #
    # It happened because the same edit was applied to two copies of the tree
    # and both were merged forward -- the same way cmake's --system-* flags
    # were once lost and restored, and the same way a corrected recipe was
    # replaced by its predecessor a week later. Carrying one tree forward is
    # the fix; a gate is what notices when that fails.
    dupes = []
    if os.path.isdir(wfdir2):
        for fn in sorted(os.listdir(wfdir2)):
            if not fn.endswith((".yml", ".yaml")):
                continue
            # PER JOB, NOT PER FILE. The first version scanned whole files
            # and reported five "duplicates" in stage0-stage4-complete.yml and
            # stage3-hermetic-arm64.yml -- all of them the SAME step name in
            # DIFFERENT jobs, which is normal and often deliberate ('Fetch
            # pinned upstreams' appears once per job that needs it). A gate
            # that fires on correct code is one people switch off.
            seen, injobs = set(), False
            for line in open(os.path.join(wfdir2, fn),
                             errors="replace").read().splitlines():
                if re.match(r"^jobs:\s*$", line):
                    injobs = True
                    continue
                if injobs and re.match(r"^  [A-Za-z0-9_-]+:\s*$", line):
                    seen = set()          # a new job starts its own namespace
                    continue
                m = re.match(r"^\s+- name: ['\"]?(.+?)['\"]?\s*$", line)
                if not m:
                    continue
                nm = m.group(1).strip()
                if nm in seen:
                    dupes.append(f"{fn}: {nm!r}")
                seen.add(nm)
    if dupes:
        for d in dupes:
            print(f"  FAIL  duplicate step name -- {d}")
        ok = False
    else:
        print("  ok    no workflow declares a step name twice")
    # A SHELL `read` MUST CONSUME EVERY FIELD ITS PRODUCER EMITS.
    #
    # `veron git-sources` gained a fourth column -- the pinned tar digest --
    # and one of its three readers was left at three variables. `read -r a b c`
    # puts THE REST OF THE LINE into the last variable, so a URL became
    #     https://github.com/davmac314/dinit.git<TAB>d33a44bb...
    # and git failed with "URL rejected: Malformed input to a URL function",
    # which names the symptom and not the cause. The spike died before
    # building anything.
    #
    # SHELL `read` FAILS AT THIS SILENTLY BY DESIGN -- absorbing the remainder
    # is the documented behaviour, so there is no error to notice. That makes
    # a producer gaining a column a change to every reader, and the only place
    # that relationship can be checked is here.
    EMITS = {"sources": 3, "git-sources": 4, "tarball-names": 2}
    widths = []
    for sub, want in EMITS.items():
        try:
            buf = _i.StringIO()
            with _c.redirect_stdout(buf):
                {"sources": cmd_sources, "git-sources": cmd_git_sources,
                 "tarball-names": cmd_tarball_names}[sub](type("A", (), {})())
            got = {len(l.split("\t")) for l in buf.getvalue().splitlines()
                   if l.strip()}
            if got and got != {want}:
                print(f"  FAIL  `veron {sub}` emits {sorted(got)} fields, "
                      f"the readers expect {want}")
                ok = False
            else:
                widths.append(f"{sub}={want}")
        except Exception as e:
            print(f"  FAIL  could not sample `veron {sub}`: "
                  f"{type(e).__name__}: {e}")
            ok = False

    bad_readers = []
    if os.path.isdir(wfdir2):
        for fn in sorted(os.listdir(wfdir2)):
            if not fn.endswith((".yml", ".yaml")):
                continue
            text = open(os.path.join(wfdir2, fn), errors="replace").read()
            text = re.sub(r"\\\s*\n\s*", " ", text)
            for sub, want in EMITS.items():
                for m in re.finditer(
                        rf"veron\s+{re.escape(sub)}\b[^\n]*?read\s+-r\s+([^\n;]+?)(?:;|\s+do\b)",
                        text):
                    n = len(m.group(1).split())
                    if n != want:
                        bad_readers.append(
                            f"{fn}: reads {n} field(s) from `{sub}`, "
                            f"which emits {want}")
    if bad_readers:
        for b in bad_readers:
            print(f"  FAIL  {b}")
        ok = False
    elif widths:
        print(f"  ok    every shell reader matches its producer "
              f"({', '.join(widths)})")
    # ---------------------------------------------------------- contracts
    #
    # Four rules from ROADMAP.md, checked here because all four are facts
    # about the recipes and the policy and need no build to verify.

    # CONTRACT 1: THE GLOBAL ENVIRONMENT IS A CLOSED SET.
    #
    # policy/[env] states what is true of EVERY process in the build. It grew
    # a $CMAKE once -- a meson-specific setting handed to cmake's own
    # bootstrap and to every autotools configure, for no benefit to any of
    # them -- and the fix was to move it to [tool_env.meson], which reaches
    # only the steps that invoke meson.
    #
    # Nothing stopped that from happening and nothing would stop it again, so
    # the closed set is a gate rather than a convention: conventions are how
    # this gets violated one convenient exception at a time. [tool_env] is
    # deliberately NOT frozen -- a per-tool setting is scoped by construction.
    FROZEN_ENV = {"SOURCE_DATE_EPOCH", "LC_ALL", "LANG", "TZ", "TERM"}
    try:
        have = set(load_policy().get("env", {}))
        extra, gone = have - FROZEN_ENV, FROZEN_ENV - have
        if extra:
            print(f"  FAIL  policy [env] gained {sorted(extra)} -- a global "
                  f"reaches every process. If it belongs to one tool, put it "
                  f"in [tool_env.<prog>]")
            ok = False
        elif gone:
            print(f"  FAIL  policy [env] lost {sorted(gone)} -- these decide "
                  f"output bytes")
            ok = False
        else:
            print(f"  ok    the global environment is the frozen set "
                  f"({len(FROZEN_ENV)} keys)")
    except Exception as e:
        print(f"  FAIL  env freeze check could not run: {type(e).__name__}: {e}")
        ok = False

    # CONTRACT 2: A DECLARED FLAG MUST ACTUALLY BE PASSED.
    #
    # [declared].configure_flags is read by anyone auditing what a package was
    # built with. A flag listed there and absent from the argv is not a
    # documentation slip -- it is the record describing a build that did not
    # happen. cmake's recipe claimed "DESTDIR is passed through ninja install"
    # for its whole life while the step did not do it, and the consequence was
    # a package missing from the manifest entirely.
    fiction = []
    for rname, r in sorted(load_recipes().items()):
        argv = [a for s in r.get("steps", []) for run in s.get("run", [])
                for a in run] + [s.get("shell", "") for s in r.get("steps", [])]
        for f in r.get("declared", {}).get("configure_flags", []):
            if not any(f == a or f in str(a) for a in argv):
                fiction.append(f"{rname}: declares {f!r}, no step passes it")
    if fiction:
        for f in fiction:
            print(f"  FAIL  {f}")
        ok = False
    else:
        print("  ok    every declared flag is actually passed")

    # CONTRACT 3: A DECLINE MUST BE RECORDED.
    #
    # The reverse direction, scoped to what matters. Requiring argv ⊆ declared
    # outright would force --prefix, -DCMAKE_BUILD_TYPE and --bootstrap into
    # the field and turn a record of DECISIONS into a second copy of the
    # command line -- and a field that is mostly boilerplate stops being read.
    #
    # What must be recorded is what the build DECLINES: those are the choices
    # that shape the package, the ones another packager would make differently,
    # and the ones `optional_off` exists for. A flag that turns something off
    # counts as recorded if it appears in configure_flags OR its feature name
    # appears in optional_off.
    OFF = re.compile(r"(=(disabled|false|no|OFF|0)$)|^--(disable|without)-")
    silent = []
    for rname, r in sorted(load_recipes().items()):
        dec = set(r.get("declared", {}).get("configure_flags", []))
        off = set(r.get("deps", {}).get("optional_off", []))
        for s in r.get("steps", []):
            for run in s.get("run", []):
                for a in run:
                    if not OFF.search(a) or a in dec:
                        continue
                    m = (re.match(r"^-D([A-Za-z0-9_-]+)=", a)
                         or re.match(r"^--(?:disable|without)-([A-Za-z0-9_-]+)$", a)
                         or re.match(r"^([A-Za-z0-9_]+)=", a))
                    if m and m.group(1).lower().replace("_", "-") in {
                            x.lower().replace("_", "-") for x in off}:
                        continue
                    silent.append(f"{rname}: passes {a!r} and neither "
                                  f"configure_flags nor optional_off says so")
    if silent:
        for f in silent:
            print(f"  FAIL  {f}")
        ok = False
    else:
        print("  ok    every decline is recorded in the recipe")
    print("VERON-SELFTEST-OK" if ok else "VERON-SELFTEST-FAIL")
    return 0 if ok else 1


def cmd_status(a):
    roots = roots_from_args(a)
    mf = os.path.join(roots["out"], "files.tsv")
    if not os.path.exists(mf):
        die("no manifest -- run `veron manifest` first")
    verified = sum(1 for _ in open(mf))
    opaque = 0
    op = os.path.join(POLICY, "opaque.toml")
    if os.path.exists(op):
        with open(op, "rb") as f:
            opaque = len(tomllib.load(f).get("entry", []))
    print(f"  {verified:>6} files  verified to a ledger record")
    print(f"  {0:>6} files  installed via nix -- not verified")
    print(f"  {opaque:>6} files  opaque -- declared, no source")
    print(f"  {0:>6} files  unknown")
    print("VERON-STATUS-OK  unknown = 0")
    return 0


