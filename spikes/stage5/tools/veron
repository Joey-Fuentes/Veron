PLANFILE = os.path.join(HERE, "PLAN.txt")

PLAN_VERSION = "1"


# ---------------------------------------------------------------- loading


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def load_policy():
    with open(os.path.join(POLICY, "defaults.toml"), "rb") as f:
        return tomllib.load(f)


def load_recipes():
    """Every packages/*/recipe.toml, keyed by name.

    Sorted iteration everywhere. A dict ordered by readdir would make PLAN.txt
    depend on the filesystem, which is the same class of bug as an unsorted
    tar and much harder to see.
    """
    out = {}
    if not os.path.isdir(PKGDIR):
        return out
    for name in sorted(os.listdir(PKGDIR)):
        rp = os.path.join(PKGDIR, name, "recipe.toml")
        if not os.path.isfile(rp):
            continue
        raw = open(rp, "rb").read()
        r = tomllib.loads(raw.decode())
        r["_dir"] = os.path.join(PKGDIR, name)
        # THE RECIPE IS NOT THE WHOLE INPUT FOR A LOCAL PACKAGE, AND THAT
        # SHIPPED A STALE /etc.
        #
        # For every other package the source is a pinned tarball, so hashing
        # recipe.toml identifies the build completely. `kind = "local"` breaks
        # that: veron-system's source IS its files/ directory, and editing
        # /etc/dinit.d/early-filesystems does not touch recipe.toml.
        #
        # So the key did not move, the checkpoint restored the old DESTDIR,
        # and a boot fixed and tested locally failed in CI with the identical
        # error -- because the image still carried the previous /etc. The
        # restore was correct about the key and the key was wrong about the
        # inputs.
        #
        # files/ is folded in, sorted, path and content both, so a rename is
        # as visible as an edit.
        h = hashlib.sha256(raw)
        fdir = os.path.join(PKGDIR, name, "files")
        if os.path.isdir(fdir):
            for root, dirs, fs in os.walk(fdir):
                dirs.sort()
                for fn in sorted(fs):
                    fp = os.path.join(root, fn)
                    rel = os.path.relpath(fp, fdir).encode()
                    h.update(b"\0" + rel + b"\0")
                    if os.path.islink(fp):
                        h.update(b"L" + os.readlink(fp).encode())
                    else:
                        with open(fp, "rb") as fh:
                            h.update(b"F" + fh.read())
        r["_recipe_sha256"] = h.hexdigest()
        if r["name"] != name:
            die(f"{rp}: name '{r['name']}' does not match directory '{name}'")
        out[r["name"]] = r
    return out


def die(msg):
    print(f"veron: {msg}", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------- ordering


def topo_order(recipes):
    """Dependency order, derived -- never authored.

    A hand-maintained ordered list of 200 packages is the worst possible
    single manifest: maximum merge-conflict surface, and it goes stale the
    moment a recipe's deps change. Here order is a consequence of data the
    recipes already carry, and a cycle is an error rather than something
    noticed later.

    TIE-BREAK BY NAME, ALWAYS. Two independent packages have no natural
    order, and if the tie is broken by dict order then PLAN.txt does not
    regenerate identically and the diff gate produces false failures until
    somebody disables it. This is the determinism trap that n=1 cannot catch
    and n=2 catches on the first run.
    """
    deps = {}
    for n, r in recipes.items():
        d = r.get("deps", {})
        # RUNTIME DEPS DO NOT CONSTRAIN BUILD ORDER. Only build and link do.
        #
        # This was merging all three, which made harfbuzz -> freetype ->
        # harfbuzz a cycle: harfbuzz links freetype-bootstrap at BUILD time and
        # runs against the final freetype at RUN time, and both statements are
        # true. Ordering the build by a runtime fact turned an accurate
        # description into a contradiction.
        #
        # A runtime dependency says what must be INSTALLED alongside, which
        # matters to the image and the ledger and not to the order things
        # compile in. Every name is still validated, so a typo in a runtime
        # dep is still an error -- it just is not an edge.
        order = set(d.get("build", [])) | set(d.get("link", []))
        named = order | set(d.get("runtime", []))
        for m in sorted(named):
            if m not in recipes:
                die(f"{n}: depends on '{m}', which has no recipe")
        deps[n] = order

    ordered, done = [], set()
    while len(ordered) < len(recipes):
        ready = sorted(n for n in recipes if n not in done and deps[n] <= done)
        if not ready:
            stuck = sorted(set(recipes) - done)
            die(f"dependency cycle among: {', '.join(stuck)}")
        for n in ready:
            ordered.append(n)
            done.add(n)
    return ordered


# ---------------------------------------------------------------- expansion


def subst(token, env):
    """Expand $NAME, matching WHOLE names only.

    This used to walk the keys longest-first and str.replace each one, which
    silently corrupts any longer name sharing a prefix: with V=version in the
    table, "$VERON_SELFTEST_MARKER" became "0ERON_SELFTEST_MARKER" -- no "$"
    left, so the unexpanded-variable check passed and a shell step quietly
    tested the wrong thing. Found by the selftest on its first run.

    A name not in the table is left ALONE rather than mangled, so a step can
    reference a genuine environment variable; the check below then only fires
    on a bare "$" that no rule could have produced.
    """
    def one(m):
        name = m.group(1)
        return str(env[name]) if name in env else m.group(0)

    return re.sub(r"\$([A-Za-z_][A-Za-z0-9_]*)", one, token)


def step_env(pkg, r, policy, roots):
    slug = f"{r['name']}-{r['version']}"
    return {
        "DL": roots["dl"],
        "B": os.path.join(roots["build"], slug),
        "S": os.path.join(roots["build"], slug, r.get("srcdir", slug)),
        "D": os.path.join(roots["dest"], r["name"]),
        "P": os.path.join(r["_dir"], "patches"),
        "SYSROOT": roots["sysroot"],
        "PREFIX": policy["build"]["prefix"],
        "J": str(policy["build"]["jobs"]),
        "V": r["version"],
        "N": r["name"],
    }


# KEYS A RECIPE MAY SET THAT THE PLAN MUST CARRY. expand() builds each step
# from a fixed set of keys, so anything not listed here is silently dropped
# between the recipe and the plan -- `timeout` and `on_failure` both were,
# and a per-step timeout that never reaches run_step is worse than none,
# because the recipe says it is protected and it is not.
CARRIED_KEYS = ("timeout", "on_failure", "optional")


def carried(s):
    return {k: s[k] for k in CARRIED_KEYS if k in s}


def expand(recipes, policy, roots):
    """Recipes -> the fully literal step list. This is the whole plan."""
    plan = []
    for name in topo_order(recipes):
        r = recipes[name]
        env = step_env(name, r, policy, roots)
        steps = []
        # OUTSIDE THE STEP LOOP, DELIBERATELY. This was assigned on the last
        # iteration of the loop below and read after it, so a recipe with NO
        # steps did not get an empty patch list -- it inherited whatever
        # package was expanded before it, because the name survives across
        # iterations of the outer loop too. The first such recipe in the order
        # would instead raise NameError. Nothing in the set has zero steps
        # today, which is the only reason this has never fired.
        pdir = os.path.join(r["_dir"], "patches")
        for s in r.get("steps", []):
            if "shell" in s:
                # THE ESCAPE HATCH, AND IT MUST BE DECLARED. Real builds need
                # one -- musl in the bridge is compiled by a shell loop because
                # there is no make yet. An escape hatch you have to name and
                # justify is fine; one you can reach for silently is not.
                if not s.get("why"):
                    die(f"{name}: shell step without a 'why'")
                steps.append({
                    "name": s["name"],
                    "shell": subst(s["shell"], env),
                    "why": s["why"],
                    "cwd": subst(s.get("cwd", "$S"), env),
                    "env": {k: subst(v, env) for k, v in s.get("env", {}).items()},
                    **carried(s),
                })
            else:
                senv = {k: subst(v, env) for k, v in s.get("env", {}).items()}
                for argv in s["run"]:
                    argv = [subst(a, env) for a in argv]
                    # PER-TOOL ENVIRONMENT. policy [tool_env.<prog>] reaches
                    # only the steps that actually invoke <prog>, keyed on
                    # argv[0]. $CMAKE lived in the global [env] first, where
                    # it was handed to cmake's own bootstrap and to every
                    # autotools configure in the set for no benefit to any of
                    # them -- a setting with more reach than audience.
                    #
                    # A RECIPE STILL WINS. If a step declares the same name
                    # explicitly it keeps its value, because a recipe saying
                    # something outright should not be overridden by a default
                    # it cannot see.
                    tenv = policy.get("tool_env", {}).get(
                        os.path.basename(argv[0]), {})
                    merged = {**{k: subst(str(v), env) for k, v in tenv.items()},
                              **senv}
                    steps.append({
                        "name": s["name"],
                        "argv": argv,
                        "cwd": subst(s.get("cwd", "$S"), env),
                        "env": merged,
                        **carried(s),
                    })
        patches = sorted(f for f in os.listdir(pdir)
                         if f.endswith(".patch")) if os.path.isdir(pdir) else []
        plan.append({"pkg": name, "recipe": r, "env": env, "steps": steps,
                     "patches": patches})
    return plan


# ---------------------------------------------------------------- printing


def render_plan(plan, policy):
    """The committed aggregate.

    Generated, committed, shipped -- the same category as the ledger. A user
    with a downloaded image and no git must be able to check that their master
    list of packages, shas and commands matches Veron's, and if the plan only
    exists when the tool generates it then the tool is the only witness to what
    the tool did.

    Deterministic by construction: sorted iteration, no timestamps, no
    hostnames, no run ids, one contiguous block per package so that two
    branches adding two packages touch different regions and merge cleanly.

    A conflict here is never resolved, only regenerated. A hand-merged PLAN.txt
    corresponds to no possible run of the generator -- it looks authoritative
    and is fiction, which is strictly worse than a stale one, because a stale
    one fails the diff gate.
    """
    L = []
    L.append("VERON PLAN")
    L.append(f"plan-version {PLAN_VERSION}")
    L.append("")
    L.append("Generated by `veron plan --all`. Do not edit. Do not hand-merge.")
    L.append("On conflict: regenerate. CI regenerates and diffs; a difference")
    L.append("between this file and the recipes fails the run.")
    L.append("")
    L.append("-- policy ----------------------------------------------------------")
    for k in sorted(policy.get("build", {})):
        L.append(f"  build.{k} = {policy['build'][k]}")
    for k in sorted(policy.get("env", {})):
        L.append(f"  env.{k} = {policy['env'][k]}")
    # PER-TOOL ENVIRONMENT BELONGS IN THE COMMITTED PLAN. It changes what
    # steps run with, so leaving it out would make PLAN.txt agree with itself
    # while describing a build nobody ran -- and the per-step `env` lines
    # below would appear to come from nowhere.
    for prog in sorted(policy.get("tool_env", {})):
        for k in sorted(policy["tool_env"][prog]):
            L.append(f"  tool_env.{prog}.{k} = {policy['tool_env'][prog][k]}")
    L.append("")
    L.append("-- resolved order --------------------------------------------------")
    L.append("  derived from deps, tie-broken by name; never authored")
    for i, p in enumerate(plan, 1):
        L.append(f"  {i}. {p['pkg']}")
    L.append("")

    for p in plan:
        r = p["recipe"]
        src = r["source"]
        L.append("=" * 70)
        L.append(f"package {r['name']} {r['version']}")
        L.append(f"  group        {r.get('group', '-')}")
        # A PACKAGE THAT SHIPS NOTHING MUST SAY SO IN THE PLAN. Otherwise the
        # only visible difference between freetype-bootstrap and freetype is
        # two configure flags, and which one reaches the image is decided by
        # shell glob order in a workflow.
        if r.get("build_only"):
            L.append("  build-only   yes -- staged for later packages, "
                     "not installed into the image")
        L.append(f"  license      {r['license']}")
        L.append(f"  recipe-sha   {r['_recipe_sha256']}")
        L.append("")
        L.append("  source")
        L.append(f"    url        {src['url']}")
        # THE COMMIT IS THE PIN FOR A GIT SOURCE, AND THE PLAN MUST SAY SO.
        # `git_commit` below is a different field -- provenance metadata on a
        # TARBALL-pinned recipe, recording which commit the tarball claims to
        # correspond to. This one is the thing fetch-git.sh verifies HEAD
        # against and the reason there is an artifact at all. A plan that
        # showed only the sha256 would describe the derived archive while
        # silently omitting what it was derived from.
        if source_kind(r) == "git":
            L.append(f"    kind       git")
            L.append(f"    commit     {src['commit']}")
                # OF THE TAR, AND THE PLAN SHOULD NOT LET ANYONE ASSUME
            # OTHERWISE. gzip output is not portable; the tar is.
            L.append(f"    sha256     {src['sha256']}  "
                     f"(of the UNCOMPRESSED tar we derive)")
        else:
            L.append(f"    sha256     {src['sha256']}")
        L.append(f"    signature  {src.get('signature', 'none')}")
        if src.get("git_commit"):
            L.append(f"    git        {src['git_commit']}")
        L.append(f"    correspond {src.get('correspondence', 'none')}")
        if src.get("residue"):
            L.append(f"    residue    {src['residue']}")
        d = r.get("deps", {})
        L.append("")
        L.append("  deps")
        for kind in ("build", "link", "runtime", "optional_off"):
            v = d.get(kind, [])
            L.append(f"    {kind:<13}{', '.join(sorted(v)) if v else '-'}")
        if p.get("patches"):
            # NAMES, NOT PATHS. The path they live at differs between a laptop
            # and a runner and belongs nowhere near a hashed plan; which
            # patches apply is a fact about the build and belongs here.
            L.append("")
            L.append("  patches (applied after unpack, in this order)")
            for fn in p["patches"]:
                L.append(f"    {fn}")
        L.append("")
        L.append("  commands (literal; this is exactly what runs)")
        for i, s in enumerate(p["steps"], 1):
            L.append(f"    [{i:02d}] {s['name']}")
            L.append(f"         cwd  {s['cwd']}")
            for k in sorted(s.get("env", {})):
                L.append(f"         env  {k}={s['env'][k]}")
            if "shell" in s:
                L.append(f"         SHELL (declared) why={s['why']}")
                for line in s["shell"].strip().splitlines():
                    L.append(f"         | {line}")
            else:
                L.append(f"         argv {json.dumps(s['argv'])}")
        L.append("")
    return "\n".join(L) + "\n"


# ---------------------------------------------------------------- commands


def roots_from_args(a):
    return {
        "dl": a.dl,
        "build": a.build_dir,
        "dest": a.dest,
        "sysroot": a.sysroot,
        "out": a.out,
    }


def cmd_plan(a):
    recipes = load_recipes()
    if not recipes:
        die("no recipes found")
    policy = load_policy()
    text = render_plan(expand(recipes, policy, roots_from_args(a)), policy)

    if a.check:
        if not os.path.exists(PLANFILE):
            die("PLAN.txt missing -- run `veron plan --write`")
        cur = open(PLANFILE).read()
        if cur == text:
            print("VERON-PLAN-OK  PLAN.txt matches the recipes")
            print(f"  plan-sha256  {sha256_bytes(text.encode())}")
            return 0
        print("VERON-PLAN-STALE  PLAN.txt does not match the recipes", file=sys.stderr)
        print("  regenerate with `veron plan --write`. Never hand-merge.", file=sys.stderr)
        import difflib
        for line in list(difflib.unified_diff(
                cur.splitlines(), text.splitlines(),
                "PLAN.txt", "regenerated", lineterm=""))[:80]:
            print("  " + line, file=sys.stderr)
        return 1

    if a.write:
        open(PLANFILE, "w").write(text)
        print(f"wrote {PLANFILE}")
        print(f"  plan-sha256  {sha256_bytes(text.encode())}")
        return 0

    sys.stdout.write(text)
    return 0


def source_kind(r):
    """tarball or git -- a recipe says which by what it pins.

    SOME UPSTREAMS PUBLISH NO TARBALL AT ALL. libsfdo, dinit and libxkbcommon
    only push git tags, and the "archive" a forge offers is synthesised on
    request using that forge's git, gzip settings and export-subst handling --
    all of which change without notice. GitHub's generated tarballs shifted
    for the whole ecosystem once already. A commit cannot move: it is a Merkle
    hash over the tree and its history.
    """
    return r["source"].get("kind", "tarball")


def source_is_local(r):
    """kind = "local" -- the source is this repository.

    THE FIRST PACKAGE WHOSE UPSTREAM IS US. /etc and the dinit service
    definitions are not something anyone publishes a tarball of; they are
    decisions this project makes about the system it produces.

    Making them a PACKAGE rather than a step in the workflow is the whole
    point. A workflow step that copies files into the image would bypass the
    DESTDIR, and therefore the manifest, the ledger, `[installs]` and the
    collision check -- so /etc would be the one part of the system with no
    record of where it came from, in a project whose claim is that every file
    traces to a recorded source. As a package it goes through all of them, and
    `veron why /etc/fstab` answers.

    Its provenance is the repository commit, which is exactly what the
    git-pinned packages already record for someone else's tree."""
    return source_kind(r) == "local"


def source_filename(name, r):
    """The file this recipe's source arrives as, for BOTH kinds of pin.

    A TARBALL PIN NAMES ITS FILE; A COMMIT PIN DOES NOT. `cmd_fetch` derived
    the filename from the URL's last path component, which for a git remote is
    the repository -- `libxkbcommon.git`, not `libxkbcommon-1.13.0.tar.gz`. So
    the moment a recipe used kind = "git", fetch would look for a file
    fetch-git.sh never writes and report it missing. That was latent rather
    than broken only because no recipe uses a commit pin yet.

    fetch-git.sh writes `<name>-<version>.tar.gz`, so that is the name here.
    """
    if source_kind(r) == "git":
        return f"{name}-{r['version']}.tar.gz"
    return r["source"]["url"].rsplit("/", 1)[-1]


def cmd_git_sources(a):
    """commit / name / url for every git-pinned recipe, machine-parsed.

    THE WORKFLOW HAS BEEN CALLING THIS AND THE DRIVER HAS NOT HAD IT:

        veron: error: argument cmd: invalid choice: 'git-sources'

    Harmless so far only because no recipe uses kind = "git" yet -- the three
    that will are not written. It was lost rebuilding a deliverable from a
    mixed set of trees, which is the same way cmake's --system-* flags were
    lost and then restored.
    """
    for name, r in sorted(load_recipes().items()):
        if source_kind(r) != "git":
            continue
        src = r["source"]
        # THE ARCHIVE DIGEST TOO, WHEN THE RECIPE HAS ONE. The commit is the
        # provenance; the sha256 is of the artifact fetch-git.sh derives from
        # it, and a pin nothing compares against is the llvm mistake again --
        # fetch-git.sh has been PRINTING that digest and no caller checked it.
        print(f"{src['commit']}\t{name}-{r['version']}\t{src['url']}\t"
              f"{src.get('sha256', '')}")
    return 0


def cmd_sources(a):
    """Every pin, as sha256/name/url -- so callers iterate instead of hardcode.

    The stage 5 workflow hardcoded one package's sha256 in a `run:` block and
    special-cased the other. That is exactly the build logic that is not
    supposed to live in YAML, and it broke the moment the second pin became
    real: the check for PENDING passed and nothing ever fetched the tarball.
    """
    recipes = load_recipes()
    for name in topo_order(recipes):
        r = recipes[name]
        src = r["source"]
        # GIT-PINNED SOURCES ARE NOT FETCHABLE FROM THIS LIST. Their bytes do
        # not exist upstream -- they are generated from a commit by
        # tools/fetch-git.sh -- so emitting a URL here would send the mirror
        # to a git remote expecting a tarball. `veron git-sources` is the
        # list for those, and stage5-mirror-upload iterates both.
        if source_kind(r) in ("git", "local"):
            continue
        print(f"{src['sha256']}\t{source_filename(name, r)}\t{src['url']}")
    return 0


def cmd_fetch(a):
    """AIRLOCK ONLY. Network lives here and nowhere else.

    Verify the sha256 against the manifest before the box is sealed. The
    signature is NOT checked here and never will be: it is a one-time human
    audit event whose result is the pinned sha256 in the recipe. Per-build
    verification is hash-only, which needs hashlib and nothing else -- so no
    gpg on the build path, and no circularity.
    """
    recipes = load_recipes()
    os.makedirs(a.dl, exist_ok=True)
    bad = 0
    for name in topo_order(recipes):
        if source_is_local(recipes[name]):
            # NOTHING TO FETCH AND NOTHING TO VERIFY AGAINST. The bytes are in
            # this checkout; the thing that pins them is the commit, and the
            # thing that detects a change is [installs].digest, same as any
            # other package.
            print(f"  local   {name}  (source is this repository)")
            continue
        src = recipes[name]["source"]
        fn = os.path.join(a.dl, source_filename(name, recipes[name]))
        if src["sha256"].startswith("PENDING"):
            # NOT A BUG. The pin is a human trust decision that has not been
            # made yet, and the tool must refuse rather than invent one.
            print(f"  PEND  {os.path.basename(fn)}")
            print(f"           no pinned sha256 -- this is a one-time HUMAN step:")
            print(f"             gpg --verify {os.path.basename(fn)}.sig {os.path.basename(fn)}")
            print(f"             sha256sum {os.path.basename(fn)}")
            print(f"           verify FIRST, hash SECOND, then paste into the recipe.")
            bad += 1
            continue
        if not os.path.exists(fn):
            print(f"  MISSING  {fn}")
            print(f"           fetch from {src['url']}")
            bad += 1
            continue
        # A GIT SOURCE'S PIN IS OVER THE UNCOMPRESSED TAR. Hashing the
        # .tar.gz here would compare against a digest of something else and
        # fail on every runner whose gzip differs from the one that pinned it
        # -- which is exactly what the first mirror run did.
        if source_kind(recipes[name]) == "git":
            import gzip as _gz
            h = hashlib.sha256()
            with _gz.open(fn, "rb") as g:
                for chunk in iter(lambda: g.read(1 << 20), b""):
                    h.update(chunk)
            got = h.hexdigest()
        else:
            got = sha256_file(fn)
        ok = got == src["sha256"]
        print(f"  {'ok  ' if ok else 'BAD '}  {os.path.basename(fn)}")
        print(f"           want {src['sha256']}")
        print(f"           got  {got}")
        if not ok:
            bad += 1
    if bad:
        print(f"VERON-FETCH-FAIL  {bad} source(s) missing or mismatched", file=sys.stderr)
        return 1
    print("VERON-FETCH-OK  every source matches the manifest")
    return 0


# Long enough for a real test suite, short enough that a hang is caught in
# one coffee rather than one afternoon. Overridable per step in a recipe.
DEFAULT_STEP_TIMEOUT = 1800


def run_step(s, logf, dry, may_create=False):
    # CREATING A MISSING cwd HIDES THE ERROR THAT MATTERS. Python's tarball
    # unpacks to Python-3.14.6 while the driver derived python-3.14.6 from the
    # package name -- so the configure step's cwd did not exist, this happily
    # created an empty one, and the failure surfaced as
    # "FileNotFoundError: ./configure" with no hint that the source tree was
    # somewhere else entirely.
    #
    # The FIRST step of a package legitimately needs its directory made; every
    # later one is standing in a tree the earlier steps produced, and a
    # missing directory there means something upstream did not do what the
    # recipe thinks.
    if not os.path.isdir(s["cwd"]):
        if may_create:
            os.makedirs(s["cwd"], exist_ok=True)
        else:
            die(f"step {s['name']!r}: cwd {s['cwd']!r} does not exist. "
                f"If the tarball unpacks to a differently-named directory, "
                f"set `srcdir` in the recipe.")
    if "shell" in s:
        printed = f"sh -c {s['shell']!r}"
        argv, shell = s["shell"], True
    else:
        printed = " ".join(s["argv"])
        argv, shell = s["argv"], False
    for k in sorted(s.get("env", {})):
        logf.write(f"+ env {k}={s['env'][k]}\n")
    logf.write(f"+ cwd={s['cwd']}\n+ {printed}\n")
    logf.flush()
    print(f"    + {printed}")
    if dry:
        logf.write("  rc=0 (dry-run)\n")
        return 0
    e = None
    if s.get("env"):
        e = dict(os.environ)
        e.update(s["env"])
    # THREE THINGS A BUILD STEP MUST NOT DO: read stdin, run forever, or go
    # silent. A run of this spike sat on one line of m4's gnulib test suite
    # for SIXTY-SIX MINUTES before a human cancelled it, and the log gave no
    # way to tell a hang from a slow test.
    #
    # stdin=DEVNULL: no build step should ever read stdin. If one does, EOF
    # immediately is the right answer -- inheriting the parent's stdin means
    # a test that reads it blocks until the job is killed.
    #
    # timeout: a hung step should cost that step, not the run. The plan
    # already prints every argv, so a timeout can name exactly what hung.
    #
    # heartbeat: silence and work look identical from outside. This is the
    # same lesson `tee` taught the probe and the ticker taught wpe-timing.
    limit = s.get("timeout", DEFAULT_STEP_TIMEOUT)
    start = time.time()
    beat = threading.Event()

    def tick():
        while not beat.wait(300):
            mins = int((time.time() - start) / 60)
            print(f"      [{mins}m] still running: {printed[:60]}", flush=True)

    t = threading.Thread(target=tick, daemon=True)
    t.start()
    try:
        # THE STEP'S OWN OUTPUT GOES INTO THE LOG, NOT ONLY THE CONSOLE.
        #
        # libxkbcommon failed at `ninja -C _b` with a compile error naming an
        # undefined macro, and `veron collect` preserved none of it. The
        # driver log had the argv and `rc=1 (6s)`; BUILD_LOGS collects meson's
        # CONFIGURE log, which was clean because configure succeeded. The one
        # line explaining the failure existed only in the GitHub job log,
        # which is not the artifact anyone is handed.
        #
        # WRITTEN STRAIGHT TO THE FILE, NOT THROUGH A PIPE, AND THAT MATTERS.
        # Teeing through subprocess.PIPE was tried first and quietly destroyed
        # the step timeout: reading the pipe blocks until EOF, EOF waits for
        # every GRANDCHILD that inherited it, and a 2-second limit on
        # `sh -c 'sleep 30'` took the full thirty seconds and left sleep
        # running. Three attempts to rescue that with threads and process
        # groups each failed the same test.
        #
        # That timeout is not decorative -- a run once sat SIXTY-SIX MINUTES
        # on one line of m4's gnulib suite. Handing subprocess.run a real file
        # descriptor keeps its timeout handling exactly as it was and still
        # puts every byte in the log. The console loses live output; the
        # heartbeat below already exists to keep the job alive without it, and
        # on failure the tail is printed.
        logf.flush()
        p = subprocess.run(argv, cwd=s["cwd"], shell=shell, env=e,
                           stdin=subprocess.DEVNULL,
                           stdout=logf, stderr=subprocess.STDOUT,
                           timeout=limit)
        logf.flush()
        rc = p.returncode
        if rc != 0:
            # THE TAIL, ON THE CONSOLE, BECAUSE A FAILURE MUST BE READABLE
            # WITHOUT DOWNLOADING AN ARTIFACT.
            try:
                with open(logf.name, errors="replace") as rf:
                    tail = rf.read().splitlines()[-40:]
                print("    --- last 40 lines of this step ---")
                for t in tail:
                    print(f"    {t}")
            except Exception:
                pass
    except subprocess.TimeoutExpired:
        rc = 124
        mins = int(limit / 60)
        msg = (f"TIMED OUT after {mins} min: {printed}\n"
               f"  A step that hangs is a BUG, not a slow build -- the usual\n"
               f"  causes are a test reading stdin, waiting on a device the\n"
               f"  sandbox does not provide, or a signal that never arrives.\n"
               f"  Raise `timeout` in the step if it is genuinely this slow.")
        print(f"    {msg}")
        logf.write(f"  {msg}\n")
    finally:
        beat.set()
    logf.write(f"  rc={rc}  ({int(time.time() - start)}s)\n")
    logf.flush()
    if rc != 0:
        step_context(s, rc)
    return rc


# EVERY BUILD SYSTEM WRITES ITS OWN LOG, AND NONE OF THEM PRINT IT.
#
# meson dies with "ERROR: Unhandled python exception / This is a Meson bug"
# and puts the traceback in meson-logs/meson-log.txt. autotools prints
# "configure: error: ..." and puts the test that actually failed in
# config.log. cmake says "Configuring incomplete" and writes CMakeError.log.
# In every case the console shows the symptom and the file holds the cause.
#
# THIS WAS BEING SOLVED ONE PACKAGE AT A TIME. m4 got a bespoke on_failure
# step, then libtool got one, then glib needed another -- each written after a
# failure, each costing a whole run to surface something the build had already
# written down. A fixed list of filenames covers all 111 packages and every
# build system in the set.
BUILD_LOGS = (
    "meson-logs/meson-log.txt",
    "_b/meson-logs/meson-log.txt",
    "config.log",
    "CMakeFiles/CMakeError.log",
    "CMakeFiles/CMakeOutput.log",
    "_b/CMakeFiles/CMakeError.log",
)


def apply_patches(pkgdir, srcdir, dry):
    """Apply patches/*.patch after unpack, in sorted order.

    BUSYBOX PATCH, NOT GNU PATCH. Inside the sandbox /usr/bin/patch is a
    busybox applet, and busybox's patch takes only -p, -i, -R, -N, -E and -f.
    A first version passed --batch --forward --dry-run, which GNU accepts and
    busybox rejects as unknown options -- so the probe exited non-zero and the
    code read that as "the patch does not apply", failing a build against a
    tree the patch fitted perfectly. It applied cleanly on a laptop every
    time, which is exactly why it took a run to find.

    -N is busybox's spelling of --forward: skip a hunk that is already
    applied. There is no dry run, so there is no probe -- and none is needed,
    because builds here are --clean and every one starts from a fresh unpack.

    NOT A RECIPE STEP. A step would have to name the patches directory, and
    that path is absolute -- so PLAN.txt held /home/claude/... on one machine
    and /home/runner/... on the other, and `plan --check` failed before
    anything built. The plan records WHICH patches apply, which is a fact
    about the build, rather than where the tree happens to live.

    Failing here is fatal: a patch that does not apply means the source is not
    what the recipe was written against, and building anyway produces
    something nobody described.
    """
    pdir = os.path.join(pkgdir, "patches")
    if not os.path.isdir(pdir):
        return []
    names = sorted(f for f in os.listdir(pdir) if f.endswith(".patch"))
    for fn in names:
        # ABSOLUTE: patch runs with cwd=srcdir, so a path relative to the
        # driver's cwd resolves to nothing there.
        full = os.path.abspath(os.path.join(pdir, fn))
        print(f"    patch {fn}")
        if dry:
            continue
        r = subprocess.run(["patch", "-p1", "-N", "-i", full],
                           cwd=srcdir, capture_output=True, text=True)
        out = (r.stdout or "") + (r.stderr or "")
        if r.returncode != 0:
            if "already applied" in out.lower() or "reversed" in out.lower():
                print(f"      already applied: {fn}")
                continue
            die(f"patch {fn} does not apply in {srcdir}:\n"
                f"{out.strip()[:500]}")
    return names


MESON_LOGS = ("meson-logs/meson-log.txt", "_b/meson-logs/meson-log.txt")


def cmake_log_lines(cwd, limit=12):
    """The cmake-related lines of any meson log under `cwd`, verbatim.

    NOT A VERDICT. The previous version of this returned a boolean keyed on
    the substring "Found CMake:", and a boolean is exactly what nobody could
    check: the string was taken from a single line of one failing run and was
    never compared against what meson logs when the lookup does NOT find
    cmake. If those two messages share a prefix, the gate fires on the absence
    of the thing it guards -- and it fired, on a `meson setup` that had just
    succeeded, printing nothing to say why.

    Reporting the lines costs one screen and settles the question on the next
    run instead of the one after it. A verdict can be written once the strings
    are known; it cannot be written from a guess about them.
    """
    out = []
    for rel in MESON_LOGS:
        path = os.path.join(cwd, rel)
        if not os.path.isfile(path):
            continue
        try:
            hits = [ln.rstrip() for ln in open(path, errors="replace")
                    if "cmake" in ln.lower()]
        except OSError:
            continue
        if hits:
            extra = ([] if len(hits) <= limit
                     else [f"... {len(hits) - limit} more (see veron collect)"])
            out.append((rel, hits[:limit] + extra))
    return out


def build_log_tail(cwd, lines=40):
    """The build system's own explanation of what went wrong."""
    out = []
    for rel in BUILD_LOGS:
        path = os.path.join(cwd, rel)
        if not os.path.isfile(path):
            continue
        try:
            text = open(path, errors="replace").read().splitlines()
        except OSError:
            continue
        out.append((rel, len(text), text[-lines:]))
    return out


def step_context(s, rc):
    """When a step fails, say what the box looked like.

    `tar -xf /dl/file-5.48.tar.gz` returned 1 and printed NOTHING -- no error,
    no message -- and the only way to guess why was to reason about what the
    previous package might have changed. A failing command that says nothing
    is the worst case to debug remotely, and every one of these round trips
    has cost a full CI run.

    So: whenever a step fails, print the few facts that distinguish the usual
    causes -- a missing input, an unresolvable interpreter, a cwd that is not
    what the recipe thought, a tool shadowed by something just staged.
    """
    argv0 = (s["argv"][0] if "argv" in s else "sh")
    print(f"    --- context for rc={rc} ---")
    try:
        print(f"    cwd {s['cwd']} exists={os.path.isdir(s['cwd'])}")
        which = shutil.which(argv0, path=os.environ.get("PATH", ""))
        print(f"    {argv0} -> {which or 'NOT ON PATH'}")
        if which and os.path.islink(which):
            print(f"    {which} is a symlink -> {os.readlink(which)}")
        for tok in (s.get("argv") or [])[1:]:
            if tok.startswith("/") and not tok.startswith("/dev"):
                ok = os.path.exists(tok)
                extra = ""
                if ok and os.path.isfile(tok):
                    extra = f" ({os.path.getsize(tok)} bytes)"
                print(f"    arg {tok} exists={ok}{extra}")
    except Exception as e:
        print(f"    (context unavailable: {type(e).__name__})")

    # AND WHAT THE BUILD SYSTEM ITSELF SAID, inline. A failure that needs a
    # second run to explain itself costs more than the run that produced it.
    try:
        logs = build_log_tail(s["cwd"])
        if not logs:
            # A step may fail before any log exists -- an unpack, say -- and
            # saying so beats silence that reads like nothing was looked for.
            print(f"    --- no build-system log under {s['cwd']} ---")
        for rel, total, tail in logs:
            print(f"    --- {rel}  (last {len(tail)} of {total} lines) ---")
            for ln in tail:
                print(f"    | {ln}")
    except Exception as e:
        print(f"    (build log unavailable: {type(e).__name__})")


def stage_into(destdir, sysroot):
    """Make an installed package visible to the ones built after it.

    WITHOUT THIS, `deps.build` IS DECORATION. Each package installs into its
    own DESTDIR and nothing puts that on PATH, so a dependency edge orders the
    build correctly and then does nothing. zstd's test suite calls file(1);
    file built, installed to dest/file/usr/bin/file, and zstd still died with
    "file: No such file or directory" -- the edge was right and the binary was
    unreachable.

    Every package so far was self-contained, which is why this survived twelve
    of them before surfacing.

    The DESTDIR remains the authority for the manifest and for G3: staging
    COPIES into the build root and never reads back from it, so what a package
    produced is still exactly what its own dest/ holds. The build root is
    restored from the verified sysroot artifact at the start of every run, so
    the mutation does not accumulate across runs.
    """
    # THE TARGET MUST BE A ROOT, AND SAYING SO IS THE WHOLE POINT. Staging
    # reported "staged 11 paths" into /sysroot -- a directory that did not
    # exist until os.makedirs created it -- because inside the sandbox the
    # build root is mounted at "/" and nothing passed --sysroot. Copying into
    # a fresh empty directory succeeds perfectly and helps nobody: zstd still
    # could not find file(1), and the log said staging had worked.
    #
    # A real build root has /usr/bin in it. Anything else is a typo with a
    # success message attached.
    if not os.path.isdir(os.path.join(sysroot, "usr", "bin")):
        die(f"stage target {sysroot!r} has no usr/bin -- it is not a build "
            f"root. Pass --sysroot with the path the packages should be "
            f"visible in ('/' inside the sandbox).")

    n = 0
    for dirpath, _, files in os.walk(destdir):
        rel = os.path.relpath(dirpath, destdir)
        target = sysroot if rel == "." else os.path.join(sysroot, rel)
        os.makedirs(target, exist_ok=True)
        for fn in files:
            src = os.path.join(dirpath, fn)
            dst = os.path.join(target, fn)
            # ALWAYS UNLINK FIRST. THIS DESTROYED BUSYBOX.
            #
            # shutil.copy2 opens the destination for writing, and if that
            # destination is a SYMLINK it follows it. The build root's
            # /usr/bin is almost entirely symlinks to /usr/bin/busybox, so
            # staging bzip2 -- whose install writes bzcat, bunzip2 and friends
            # -- wrote the bzip2 binary THROUGH those links and over busybox
            # itself.
            #
            # Everything downstream then failed inexplicably: `tar` is a
            # busybox symlink, so `tar -xf foo.tar.gz` became the bzip2 binary
            # and exited 1 while printing bzip2's usage. Several rounds went
            # into theories about PAX headers and archive formats, when the
            # extractor had simply been overwritten.
            #
            # Unlinking replaces the LINK instead of writing through it, which
            # is what installing a package over a busybox alias should do.
            if os.path.lexists(dst):
                os.unlink(dst)
            if os.path.islink(src):
                os.symlink(os.readlink(src), dst)
            else:
                shutil.copy2(src, dst)
            n += 1
    return n


