def reset_inherited_signals():
    """SIG_IGN is inherited across fork AND exec. Undo what the CI gave us.

    The GitHub Actions runner ignores SIGPIPE (actions/runner #2684, where a
    shell pipeline "gets stuck" for exactly this reason), and an ignored
    disposition propagates into every child this driver spawns. gnulib's
    test-execute expects a child to DIE of SIGPIPE; with it ignored the child
    survives, exits 71, and the pipeline never tears down -- which is both the
    failure and the 66-minute hang we spent several rounds chasing.

    A shell `trap - PIPE` does not reliably undo an inherited SIG_IGN, so the
    reset belongs here, in the process that actually spawns the builds.
    SIGXFSZ and SIGXCPU get the same treatment: both are occasionally ignored
    by CI harnesses and both are supposed to be fatal.
    """
    for name in ("SIGPIPE", "SIGXFSZ", "SIGXCPU"):
        sig = getattr(signal, name, None)
        if sig is None:
            continue
        try:
            if signal.getsignal(sig) == signal.SIG_IGN:
                signal.signal(sig, signal.SIG_DFL)
                # STDERR, NOT STDOUT. `veron sources` output is a data
                # channel -- the workflow's fetch loop parses it line by line
                # -- so a status line printed to stdout becomes a row with an
                # empty filename and mirror.py is handed the directory `dl/`.
                # This is the second time a progress message has been written
                # to a pipe someone was parsing; blfs.py did the same thing
                # with its "book: N pages" line.
                print(f"  reset {name} from SIG_IGN to SIG_DFL "
                      f"(inherited from the caller)", file=sys.stderr)
        except (OSError, ValueError):
            pass


def build_parser():
    """The parser, separately from running it.

    SO THAT SOMETHING CAN CHECK THE WORKFLOWS AGAINST IT. The selftest already
    asserted that every subcommand a workflow calls exists -- and run 56 still
    died on `veron merge --dest dest --sysroot sysroot`, because existing and
    being called correctly are different things. --dest is a GLOBAL option and
    has to precede the subcommand. Handing the real parser a real command line
    is the only check that would have caught it.
    """
    ap = argparse.ArgumentParser(prog="veron")
    ap.add_argument("--dl", default="dl")
    ap.add_argument("--build-dir", default="build")
    ap.add_argument("--dest", default="dest")
    ap.add_argument("--out", default="out")
    ap.add_argument("--logs", default="logs")
    ap.add_argument("--ledger", default="ledger")
    # NO DEFAULT WORTH TRUSTING. "/sysroot" was wrong inside the sandbox and
    # wrong outside it, and the wrongness was silent. Required, so it is
    # always a decision.
    ap.add_argument("--sysroot", default="/sysroot",
                    help="the root installed packages must become visible in")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("plan", help="expand every step to literal argv")
    p.add_argument("--write", action="store_true", help="write PLAN.txt")
    p.add_argument("--check", action="store_true", help="regenerate and diff")
    p.set_defaults(fn=cmd_plan)

    p = sub.add_parser("sources", help="sha256/name/url per recipe, for the fetcher")
    p.set_defaults(fn=cmd_sources)

    p = sub.add_parser("git-sources",
                       help="commit/name/url for every git-pinned recipe")
    p.set_defaults(fn=cmd_git_sources)

    p = sub.add_parser("fetch", help="airlock: verify sha256 against the manifest")
    p.set_defaults(fn=cmd_fetch)

    p = sub.add_parser("build", help="execute exactly the plan")
    p.add_argument("pkg", nargs="*")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--resume", action="store_true",
                   help="stage packages a restored checkpoint already built")
    p.add_argument("--base", default="",
                   help="sysroot sha256 this run builds on; required by "
                        "--resume so the checkpoint is checked against the "
                        "run rather than against itself")
    p.add_argument("--no-stage", dest="stage", action="store_false", default=True,
                   help="do not copy each package into the build root after install")
    p.add_argument("--optional", action="store_true",
                   help="also run steps marked optional (investigations)")
    p.add_argument("--clean", action="store_true",
                   help="wipe build/ and dest/ first -- required for a real second build")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("manifest", help="every installed path -> its package")
    p.set_defaults(fn=cmd_manifest)

    p = sub.add_parser("merge", help="merge every DESTDIR into the system root")
    p.set_defaults(fn=cmd_merge)

    p = sub.add_parser("isolate",
                       help="build each package from its declared deps alone")
    p.add_argument("pkg", nargs="*", help="packages (default: all)")
    p.add_argument("--bwrap", default="/usr/local/bin/bwrap",
                   help="the bubblewrap WE built, not the runner's")
    p.add_argument("--dry-run", action="store_true",
                   help="print each composed root instead of building")
    p.add_argument("--logs", dest="logs", default="logs")
    p.set_defaults(fn=cmd_isolate)

    p = sub.add_parser("installs",
                       help="what each package installs, against what it declares")
    p.add_argument("--propose", action="store_true",
                   help="emit [installs] blocks from a real build")
    p.add_argument("--write", action="store_true",
                   help="with --propose, also write the block into each recipe")
    p.add_argument("--mode", choices=["warn", "fail"], default="warn")
    p.set_defaults(fn=cmd_installs)

    p = sub.add_parser("keys", help="prefix hash per package -- checkpoint names")
    p.add_argument("--base", default="", help="sysroot sha256 the plan builds on")
    p.set_defaults(fn=cmd_keys)

    p = sub.add_parser("checkpoint", help="record what dest/ currently holds")
    p.add_argument("--base", default="", help="sysroot sha256 the plan builds on")
    p.set_defaults(fn=cmd_checkpoint)

    p = sub.add_parser("linked",
                       help="DT_NEEDED against deps.link, both directions")
    p.add_argument("--mode", choices=["warn", "fail"], default="warn")
    p.set_defaults(fn=cmd_linked)

    p = sub.add_parser("tarball-names",
                       help="package -> the tarball filename its recipe pins")
    p.set_defaults(fn=cmd_tarball_names)

    p = sub.add_parser("build-only-names",
                       help="packages that are staged but never installed")
    p.set_defaults(fn=cmd_build_only_names)

    p = sub.add_parser("collect", help="gather everything needed to diagnose "
                                       "this run without re-running it")
    p.add_argument("--max-bytes", type=int, default=512 * 1024,
                   help="per-file tail cap (default 512K)")
    p.set_defaults(fn=cmd_collect)

    p = sub.add_parser("rootfs", help="deterministic rootfs tar")
    p.set_defaults(fn=cmd_rootfs)

    p = sub.add_parser("ledger", help="write one record per output")
    p.set_defaults(fn=cmd_ledger)

    p = sub.add_parser("selftest", help="assert the driver honours what recipes declare")
    p.set_defaults(fn=cmd_selftest)

    p = sub.add_parser("guest-tests", help="generate the guest sanity script from recipes")
    p.add_argument("--out")
    p.set_defaults(fn=cmd_guesttests)

    p = sub.add_parser("compare", help="G3: diff two file manifests, per file")
    p.add_argument("first")
    p.add_argument("second")
    p.add_argument("--mark", help="on success, write this file for the ledger to read")
    p.set_defaults(fn=cmd_compare)

    p = sub.add_parser("status", help="verified / nix / opaque / unknown")
    p.set_defaults(fn=cmd_status)

    return ap


def main():
    # LINE BUFFERING, OR THE CONSOLE SHOWS NOTHING UNTIL THE END.
    #
    # Step output used to go straight to fd 1 from the child process, so a
    # build looked alive even though the driver's own `print()` calls were
    # sitting in Python's block buffer. Sending step output to the log file
    # instead removed that accident, and the console went silent: a
    # thirty-minute build printed its preamble and nothing else until it
    # finished.
    #
    # A build that shows no progress is one nobody can tell from a hung one,
    # which is the exact confusion the heartbeat exists to prevent.
    try:
        sys.stdout.reconfigure(line_buffering=True)
        sys.stderr.reconfigure(line_buffering=True)
    except Exception:
        pass
    reset_inherited_signals()
    a = build_parser().parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
