#!/bin/sh
# veron-maintenance-gate -- boot the consumer image the way a person does,
# enter maintenance mode the way a person does, and SEE that the boot stick
# became writable.
#
# WHAT A PERSON DOES, AND NOTHING ELSE. Every step below has a counterpart in
# someone at the machine:
#
#   1. power on from the USB stick, wait for the desktop
#   2. Super+Return opens foot
#   3. type `veron-flasher`, Enter
#   4. look at the flasher  ........................ 01-flasher-normal.png
#   5. click "Reflash this boot device..."
#   6. watch it arm and reboot itself ............... 02-flasher-armed.png
#   7. the machine comes back up, into RAM, to the desktop
#   8. Super+Return, `veron-flasher`, Enter, again
#   9. look: the stick is now a listed target ....... 03-flasher-maintenance.png
#
# NOTHING IS MOCKED. The VM boots from the SAME image bytes a consumer dd's,
# attached as USB MASS STORAGE (the stick), through OVMF's removable fallback
# path -- the same firmware path, the same loader, the same one-shot marker
# on the ESP, the same reboot. The keyboard and the pointer are qemu's virtio
# input devices driven through the human monitor; the screen is read back
# with `screendump`, exactly as stage 5's desktop test reads its frame.
#
# THE SERIAL LINE IS FOR WATCHING, NOT FOR DRIVING. The kernel, the loader
# and veron-maintenance-init all narrate to ttyS0; the waits below read that
# narration instead of sleeping for guesses. At the very end, the console
# shell (the same `veron` shell a person gets on the serial port) is asked
# to print the facts the verdict rests on -- the cmdline, the mount table,
# the flasher service's status line, the block devices -- so that the
# screenshot a human reads and the verdict a machine reads are about the
# same system state. No command typed there changes anything.
#
# ONE qemu PROCESS FOR BOTH BOOTS. The reboot into maintenance mode happens
# INSIDE the VM (the flasher asks the power service, dinit reboots, OVMF
# starts again). That is why there is no -no-reboot here, and why the image
# is attached snapshot=on: the one-shot marker flashd writes to the ESP has
# to survive the reboot -- it lives in the process-lifetime overlay -- while
# the backing image is never written. The before/after digest check proves
# the second half.
#
# usage: veron-maintenance-gate --image IMG --out DIR
#            [--ovmf /usr/share/ovmf/OVMF.fd] [--mem 6144] [--kvm auto|on|off]
# exit 0 = VERON-MAINTENANCE-GATE-OK, 1 = a named failure, 2 = usage.
set -u

IMG=; OUT=; OVMF=/usr/share/ovmf/OVMF.fd; MEM=6144; KVM=auto
while [ $# -gt 0 ]; do
    case "$1" in
        --image) IMG=$2; shift 2 ;;
        --out)   OUT=$2; shift 2 ;;
        --ovmf)  OVMF=$2; shift 2 ;;
        --mem)   MEM=$2; shift 2 ;;
        --kvm)   KVM=$2; shift 2 ;;
        *) echo "usage: $0 --image IMG --out DIR [--ovmf F] [--mem MB] [--kvm auto|on|off]" >&2; exit 2 ;;
    esac
done
[ -s "$IMG" ] && [ -n "$OUT" ] || { echo "usage: $0 --image IMG --out DIR" >&2; exit 2; }
[ -s "$OVMF" ] || { echo "VERON-MAINTENANCE-GATE-FAIL  no OVMF at $OVMF" >&2; exit 1; }

HERE=$(cd "$(dirname "$0")" && pwd)
S5=$(cd "$HERE/../../stage5/tools" && pwd)      # qemu-monitor.py, ppm2png.py
MON="$S5/qemu-monitor.py"
PNG="$S5/ppm2png.py"
FIND="$HERE/frame-find.py"
for t in "$MON" "$PNG" "$FIND"; do
    [ -s "$t" ] || { echo "VERON-MAINTENANCE-GATE-FAIL  missing tool $t" >&2; exit 1; }
done

mkdir -p "$OUT"
OUT=$(cd "$OUT" && pwd)
SER="$OUT/maintenance-serial.log"
SOCK="$OUT/maint-mon.sock"
FIFO="$OUT/maint-console.in"
rm -f "$SER" "$SER.timed" "$SOCK" "$FIFO" "$OUT"/0?-*.png "$OUT"/probe.ppm "$OUT"/shot.ppm "$OUT"/qemu.pid
qpid=0
mkfifo "$FIFO"

fail=0
ok()   { echo "  ok    $*"; }
bad()  { echo "  FAIL  $*"; fail=1; }
note() { echo "  $*" >&2; }   # stderr: several callers capture stdout

# ---- the VM ---------------------------------------------------------------
before_sha=$(sha256sum "$IMG" | cut -d' ' -f1)
note "image before: $before_sha"

ACCEL="-cpu qemu64"
case "$KVM" in
    on)   ACCEL="-enable-kvm -cpu qemu64" ;;
    auto) if [ -w /dev/kvm ]; then ACCEL="-enable-kvm -cpu qemu64"; fi ;;
esac
note "accel: $ACCEL"

# HOLD THE FIFO OPEN for the life of the run; a `>` that finishes closes the
# write end, the guest's serial shell sees EOF and exits (stage 5 learned this).
( exec sleep 100000 ) > "$FIFO" &
holder=$!

# THE STICK IS USB, AND IT SAYS SO. usb-storage behind xhci is what a
# consumer's port looks like to the kernel; the flasher lists /sys/block
# entries with removable=1, and that is what a real stick reports. qemu's
# usb-storage reports removable=0 unless told otherwise -- run 88168607444
# reached the maintenance flasher with every fact right and the Target list
# showing only the DVD-ROM: sda was a "fixed disk" that no flasher would ever
# list. removable=on makes the VM's stick say what the hardware says.
qemu-system-x86_64 \
    -machine q35 $ACCEL -smp 4 -m "$MEM" \
    -display none -nic none \
    -bios "$OVMF" \
    -device qemu-xhci -device usb-storage,drive=d0,removable=on \
    -drive if=none,id=d0,format=raw,file="$IMG",snapshot=on \
    -vga none -device virtio-gpu-pci \
    -device virtio-keyboard-pci \
    -serial stdio -pidfile "$OUT/qemu.pid" \
    -monitor unix:"$SOCK",server,nowait \
    < "$FIFO" 2>&1 | tee "$SER" | python3 -u -c '
# EVERY SERIAL LINE, STAMPED WITH WALL SECONDS SINCE QEMU STARTED. dinit does
# not timestamp its lines and the kernel only stamps its own; a boot is judged
# by WHEN the desktop parts arrived, not in what order.
import sys, time
t0 = time.monotonic()
for line in sys.stdin:
    sys.stdout.write("[%8.3f] %s" % (time.monotonic() - t0, line))
' > "$SER.timed" &
pipe=$!

cleanup() {
    [ "${qpid:-0}" != 0 ] && kill "$qpid" 2>/dev/null; kill "$holder" 2>/dev/null; sleep 1
    [ "${qpid:-0}" != 0 ] && kill -9 "$qpid" 2>/dev/null; kill -9 "$holder" 2>/dev/null
    wait "$pipe" 2>/dev/null
    rm -f "$SOCK" "$FIFO" "$OUT"/probe.ppm "$OUT"/shot.ppm "$OUT"/qemu.pid
}

# await_file PATH SECONDS -- wait for PATH to exist and be non-empty. This is
# a kernel event (inotify) when inotifywait is installed, which the workflow
# does. The poll branch exists only so the tool still runs on a machine
# without inotify-tools; it is not the path CI takes.
await_file() {
    [ -s "$1" ] && return 0
    if command -v inotifywait >/dev/null 2>&1; then
        timeout "$2" inotifywait -q -e close_write -e moved_to "$(dirname "$1")" >/dev/null 2>&1 || true
        [ -s "$1" ] && return 0
    fi
    _i=0; while [ ! -s "$1" ] && [ "$_i" -lt "$(($2 * 10))" ]; do _i=$((_i + 1)); /bin/sleep 0.1; done
    [ -s "$1" ]
}

# BOTH the pidfile and the monitor socket: qemu creates them at different
# moments, and the original loop waited for both. await_file covers the
# pidfile; the socket is a second inotify wait on the same directory (it is
# a socket inode, so -s does not apply -- test -S).
await_file "$OUT/qemu.pid" 30
_i=0; while [ ! -S "$SOCK" ] && [ "$_i" -lt 30 ]; do
    command -v inotifywait >/dev/null 2>&1 \
        && timeout 1 inotifywait -q -e create "$OUT" >/dev/null 2>&1 \
        || /bin/sleep 0.1
    _i=$((_i + 1))
done
qpid=$(cat "$OUT/qemu.pid" 2>/dev/null || echo 0)
[ -S "$SOCK" ] && [ "$qpid" != 0 ] || { bad "qemu never opened its monitor socket"; tail -20 "$SER"; cleanup; exit 1; }

alive() { kill -0 "$qpid" 2>/dev/null; }
mon()   { python3 "$MON" "$SOCK" "$@" 2>/dev/null; }


# prompt -- nudge the serial shell with a newline and wait for its prompt to
# come back, rather than sleeping a guessed second and hoping it has.
prompt() {
    # a newline makes the shell print a fresh prompt. Mark the log BEFORE
    # sending it, then follow from that mark: a prompt already in the log
    # cannot satisfy it, and one that lands before the follower starts is
    # still seen.
    _m=$(mark)
    printf '\n' > "$FIFO"
    follow_until 'veron\$' 5 1 "$_m" >/dev/null
}

# wait_serial REGEX SECONDS [COUNT] -- until the serial log matches, or the
# ceiling. COUNT lets the same line be awaited for the SECOND boot.
# wait_proc NAME SECONDS -- the guest-side event "process NAME exists". A
# single command is typed that loops INSIDE the guest (busybox pgrep, which
# returns the moment the process is there) and then prints a marker; the host
# does one event-driven wait for that marker. Replaces polling screendumps
# for "did the window appear" -- the process existing is the event the
# pixels were a proxy for, and it is observable without a frame at all.
wait_proc() {
    ask "n=0; while ! pgrep -x $1 >/dev/null && [ \$n -lt $(($2 * 10)) ]; do n=\$((n+1)); sleep 0.1; done; pgrep -x $1 >/dev/null && echo MG-PROC-$1-UP" "$3" "$2" \
        && grep -aq "MG-PROC-$1-UP" "$SER"
}

# follow_until REGEX SECONDS [COUNT] [fromnow] -- THE ONE STREAM PRIMITIVE.
# tail -f follows the live serial log (from the start, or from now), grep -m
# COUNT reads it and exits on the match. tail is then killed EXPLICITLY: a
# tail whose reader has gone only dies on SIGPIPE at its next write, so a
# guest that falls silent right after the event would otherwise hold the
# caller until the watchdog -- measured: a 3s scenario took 36s before this
# kill was added. The matched line is printed; exit 0 on match, 1 on the
# watchdog or a dead guest.
follow_until() {
    # FROM is a line number: follow from that line onward, so an event that
    # landed between "the action" and "the follower starting" is not missed.
    # Callers snapshot the count with `mark` BEFORE acting. No "from now":
    # that raced the guest and lost the reboot line (measured, 30s stall).
    _re=$1; _max=$2; _n=${3:-1}; _from=${4:-1}
    _p=$(mktemp -u); mkfifo "$_p"
    tail -n "+$_from" -f "$SER" --pid="$qpid" > "$_p" 2>/dev/null &
    _tail=$!
    _hit=$(timeout "$_max" grep -aE -m "$_n" "$_re" < "$_p")
    kill "$_tail" 2>/dev/null; wait "$_tail" 2>/dev/null; rm -f "$_p"
    [ -n "$_hit" ] && { printf '%s\n' "$_hit"; return 0; }
    return 1
}
# mark -- the line to follow from: the log's length now, plus one.
mark() { echo $(( $(wc -l < "$SER" 2>/dev/null || echo 0) + 1 )); }

# EVENT-DRIVEN. The serial log is a live file tee writes as the guest speaks,
# so it is FOLLOWED, not re-scanned: tail -f blocks in the kernel until bytes
# land, grep -m N exits on the N-th match, and the closed pipe ends tail. No
# sleep, no tick, no ceiling counted in iterations. `timeout` on the tail is
# the only clock, and it only ever fires for a guest that never says the
# line. --pid ends the wait if qemu dies first. (Before: grep -c the whole
# file every 0.1s, which is a poll dressed up as an event.)
wait_serial() {
    _re=$1; _max=$2; _n=${3:-1}
    _t0=$(date +%s.%N)
    if follow_until "$_re" "$_max" "$_n" >/dev/null; then
        note "'$_re' (x$_n) after $(echo "$(date +%s.%N) - $_t0" | bc)s"
        return 0
    fi
    alive || { note "qemu exited while waiting for '$_re'"; return 1; }
    note "TIMEOUT ${_max}s waiting for '$_re' (x$_n)"
    return 1
}

# screen_block COLOUR MINRUN -- one screendump, then frame-find; prints "x y w h rows"
screen_block() {
    rm -f "$OUT/probe.ppm"
    mon --wait=0.6 "screendump $OUT/probe.ppm" >/dev/null
    [ -s "$OUT/probe.ppm" ] || return 1
    python3 "$FIND" "$OUT/probe.ppm" "$1" --min-run "$2"
}
# wait_block COLOUR MINRUN SECONDS -- poll the frame until the block shows
# THE CEILING IS WALL-CLOCK, NOT AN ITERATION COUNT. screen_block is not
# free: a full screendump plus a Python frame-find over a 1280x800 frame,
# one to two seconds each. Counting sleeps as time here was the bug that
# turned a 2-minute gate into a 10-minute one (main, 2026-08-22): with the
# tick cut to 0.1s the body ran back-to-back, and a "30s" ceiling became 300
# iterations of ~2s. The loop now reads the clock, so the ceiling means what
# the caller said regardless of how long each probe takes, and it runs the
# probe as often as the probe allows -- no sleep, because the body is the
# rate limit.
# wait_block is gone. It polled screendumps -- a full frame plus a Python
# frame-find per iteration -- to learn whether a window had appeared, and
# with a fast tick that became a tight loop whose "30s" ceiling was 300
# iterations of ~2s: the 10-minute gate (main, 2026-08-22). The window
# appearing has a guest-side event, the process existing, and that is what
# is waited on now (wait_proc). The screendump is taken ONCE after that
# event, for the pane coordinates the click needs and for the evidence PNG.
# snapshot NAME -- a full frame to PNG
snapshot() {
    rm -f "$OUT/shot.ppm"
    mon "screendump $OUT/shot.ppm" >/dev/null
    await_file "$OUT/shot.ppm" 5
    [ -s "$OUT/shot.ppm" ] || { note "(no frame for $1)"; return 1; }
    python3 "$PNG" "$OUT/shot.ppm" "$OUT/$1" | sed 's/^/    /'
    rm -f "$OUT/shot.ppm"
}
# type_line "text" -- every key in ONE monitor connection, then Enter
type_line() {
    _s=$1; _keys=""
    while [ -n "$_s" ]; do
        _c=${_s%"${_s#?}"}; _s=${_s#?}
        case "$_c" in
            -) _k=minus ;;  .) _k=dot ;;  /) _k=slash ;;  " ") _k=spc ;;
            \;) _k=semicolon ;; \$) _k=shift-4 ;; \() _k=shift-9 ;; \)) _k=shift-0 ;;
            \*) _k=shift-8 ;; \|) _k=shift-backslash ;; "'") _k=apostrophe ;;
            \>) _k=shift-dot ;; \<) _k=shift-comma ;; =) _k=equal ;; _) _k=shift-minus ;;
            [A-Z]) _k=shift-$(echo "$_c" | tr 'A-Z' 'a-z') ;;
            *) _k=$_c ;;
        esac
        _keys="$_keys,$_k"
    done
    mon "--keys=${_keys#,},ret" >/dev/null
}
# open_flasher -- Super+Return until foot shows, then `veron-flasher`, then
# wait for its white log pane. Prints the pane's "x y w h rows".
open_flasher() {
    _foot=""
    # Super+Return is repeated because the desktop's readiness is not on the
    # serial line (labwc logs to /run/labwc.log); a press before the
    # compositor is up lands on an empty VT and does nothing, a press after
    # opens foot. Twelve tries, twenty seconds apart, is four minutes of
    # patience for a TCG boot.
    for _try in 1 2 3 4 5 6; do
        mon "sendkey meta_l-ret" >/dev/null
        wait_proc foot 15 "40+$_try" && { _foot=yes; break; }
    done
    [ -n "$_foot" ] || { note "foot never appeared (no foot process after 6 tries)"; return 1; }
    note "foot is up"
    type_line "veron-flasher"
    wait_proc veron-flasher 30 "50+0" || { note "veron-flasher never started"; return 1; }
    # the process is up; ONE frame now, for the pane geometry the click needs
    _pane=$(screen_block ffffff 500) || { note "veron-flasher is running but its log pane (white, >=500px) is not on screen"; return 1; }
    note "flasher pane at [$_pane]"
    echo "$_pane"
}
# ask "shell line" MARKER SECONDS -- type a line into the serial shell and wait
# for MARKER in its OUTPUT. The marker is produced by arithmetic the typed
# text does not contain, so the echo of the command cannot satisfy the wait.
ask() {
    printf '%s; echo VERON-MG-$((%s))\n' "$1" "$2" > "$FIFO"
    wait_serial "VERON-MG-$(( $2 ))" "$3" >/dev/null
}

# =========================== BOOT 1: normal ================================
echo "=== boot 1: the normal system, from the USB stick ==="
wait_serial "veron-boot: normal boot" 90 || { bad "the loader did not run the normal path"; }
wait_serial "as init process" 60 || { bad "the kernel never started init on boot 1"; }
# dinit announces each service on the console; labwc's line is the first
# word that the desktop is being started (its readiness is polled visually).
wait_serial "labwc" 120 || { bad "labwc never started on boot 1"; }
[ "$fail" = 0 ] || { tail -40 "$SER"; cleanup; exit 1; }

# A FILE IN THE USER'S HOME, BEFORE ANYTHING ELSE. This is the user's own
# test (hardware, 2026-08-21: `touch ~/testy`, reboot into maintenance, `ls`
# -- gone). The serial shell is the same veron account as the desktop, and
# /home/veron is the persist-backed home on a normal boot, so the file lands
# on the stick's persist partition; boot 2 must show it from the RAM bank.
prompt
ask 'touch ~/veron-gate-testy && echo "MG-TESTY-WRITTEN $(ls -ld ~ | cut -c1-10) $(df -P ~ | tail -1 | cut -d" " -f1)"' "20+0" 20
grep -a "MG-TESTY-WRITTEN" "$SER" | grep -av 'echo "MG-TESTY' | tail -1 | sed 's/^/    /'

# desktop_evidence -- when the desktop is not there, the facts that say why:
# labwc's own log (veron-readable since device-nodes made it so), the DRM
# cards and connectors the kernel has, the splash's placement, and dinit's
# view of the three session services. Read over the serial shell; nothing
# is changed.
desktop_evidence() {
    prompt
    ask 'tail -40 /run/labwc.log 2>&1 | sed s/^/MG-LABWC:/' "30+0" 15
    ask 'for c in /sys/class/drm/card*; do echo "MG-DRM ${c##*/} driver=$(basename $(readlink $c/device/driver 2>/dev/null) 2>/dev/null) status=$(cat $c/status 2>/dev/null) enabled=$(cat $c/enabled 2>/dev/null)"; done' "31+0" 15
    ask 'ls -l /dev/dri /dev/fb0 2>&1 | sed s/^/MG-NODES:/' "32+0" 15
    ask 'cat /run/splash.ini 2>&1 | sed s/^/MG-SPLASH:/; cat /sys/class/graphics/fb0/virtual_size 2>&1 | sed s/^/MG-FB0:/' "33+0" 15
    ask 'for s in splash labwc yambar swaybg; do echo "MG-DINIT $(dinitctl status $s 2>&1 | head -3 | tr "\n" " ")"; done' "34+0" 15
    grep -a "MG-LABWC:\|MG-DRM \|MG-NODES:\|MG-SPLASH:\|MG-FB0:\|MG-DINIT " "$SER" | grep -av 'sed s/^/MG-\|echo "MG-' | sed 's/^/    /'
}

pane=$(open_flasher) || { bad "could not open the flasher on the normal desktop"; snapshot 01-flasher-normal.png; desktop_evidence; tail -30 "$SER"; cleanup; exit 1; }
snapshot 01-flasher-normal.png
ok "boot 1: desktop, foot, veron-flasher -- 01-flasher-normal.png"

# ---- the click -------------------------------------------------------------
# THE BUTTON IS FOUND FROM THE WINDOW, THE WINDOW FROM ITS LOG PANE'S BOTTOM.
# main.cxx lays the window out in fixed client coordinates: the
# Fl_Text_Display at (10,140) 660x310 -- its white interior, inside a 2px
# frame, spans client rows 142..447 -- and "Reflash this boot device..." at
# (400,106) 270x26, centre (535,119). Wayland does not let a client pick its
# position, so the window is wherever labwc put it; reading the pane off the
# frame is how a person finds the button too.
#
# THE BOTTOM EDGE, NOT THE TOP. The flasher writes its own lines into the
# pane, and the long ones leave less than a 200px white run on their rows --
# so frame-find's block splits at the text and the biggest piece is the empty
# lower part (run 1: a 224-row block at y=420 where the pane's top was 338).
# The top of that piece is wherever the last line of text happens to end; the
# bottom of it is the bottom of the pane, always. The tablet speaks absolute
# coordinates 0..32767 across the whole screen.
set -- $pane
px=$1; py=$2; ph=$4
dims=$(python3 "$FIND" "$OUT/probe.ppm" ffffff --size 2>/dev/null || echo "1280 800")
set -- $dims
sw=$1; sh=$2
wx=$((px - 12)); wy=$((py + ph - 1 - 447))
bx=$((wx + 535)); by=$((wy + 119))
note "screen ${sw}x${sh}; pane bottom at y=$((py + ph - 1)); window client origin ($wx,$wy); button centre ($bx,$by)"
# arm_wait SECONDS -- poll flashd's status through the serial shell for ARMED.
# (world-readable; the flasher tails it, so can the serial shell.) The echo of
# the typed line carries "MG-ARM-/", never "MG-ARM-<digit>".
# SUCCESS IS ALSO THE REBOOT ITSELF. flashd writes ARMED and then the flasher
# asks powerd to reboot, so the ARMED line is in a file that exists for a
# blink before the machine goes down -- a 3s poll can sample on either side
# of it every time even when the arm worked. Run 88364882265 did exactly
# that: every poll MG-ARM-0, the gate said FAIL, then `reboot: Restarting
# system` at t=75.8 and the loader took the one-shot marker. The kernel's
# reboot line and the loader's "maintenance command line armed" are proof the
# arm happened that cannot be missed by timing, so either counts as success.
arm_wait() {
    # ONE EVENT. The arm shows up on the serial stream as one of: the kernel
    # rebooting, the loader taking the one-shot marker, or flashd refusing.
    # Follow the stream from now and return on whichever lands first. No
    # typed status probe: the reboot line is the proof and it cannot be
    # missed, where the ARMED line in a file lived for a blink and was.
    _hit=$(follow_until "reboot: Restarting system|veron-boot: maintenance command line armed|REFUSED" "$1" 1 "$2")
    case "$_hit" in
        *REFUSED*) return 1 ;;
        *reboot*|*armed*) return 0 ;;
    esac
    # nothing arrived: the guest may have already rebooted before we started
    # following, which is success -- check the full log once, not in a loop
    grep -aq "reboot: Restarting system\|veron-boot: maintenance command line armed" "$SER" && return 0
    return 1
}
prompt

# ROUTE 1: THE POINTER. Motion in a few steps (libinput wants to see the
# device move before it believes a button), then press, then release.
# THE MOUSE IS PS/2 AND SPEAKS RELATIVE DELTAS, not tablet absolutes. The
# tablet never moved the cursor at all (both screenshots in run 88364882265
# show it parked at the same spot before and after the click), so every run
# silently fell through to the keyboard route. With a relative device the
# position is made deterministic by pinning the cursor to the top-left
# corner first -- a delta far larger than the screen clamps at (0,0) -- and
# then moving by exactly the button's pixel offset. Motion in steps so
# libinput sees the device move before it believes a button.
mon "info mice" | sed 's/^/    mice: /'
mon "mouse_move -4000 -4000" >/dev/null
mon "mouse_move -4000 -4000" >/dev/null
mon "mouse_move $((bx / 2)) $((by / 2))" >/dev/null
mon "mouse_move $((bx - bx / 2)) $((by - by / 2))" >/dev/null
# THE FRAME BEFORE THE CLICK: did the cursor arrive on the button? Taken with
# no click in the picture, so it answers that one question on its own.
snapshot 02a-flasher-pre-click.png
_m=$(mark)
mon "mouse_button 1" >/dev/null
mon "mouse_button 0" >/dev/null
snapshot 02-flasher-armed.png
if arm_wait 30 "$_m"; then
    ok "clicked 'Reflash this boot device...' -- flashd reports ARMED (02-flasher-armed.png)"
else
    # THE POINTER DID NOT REACH THE BUTTON. Say what the machine knows about
    # the pointer -- qemu's view, the kernel's, and labwc's -- so the next
    # edit is aimed, then take the other road a person has: the keyboard.
    note "the pointer click did not arm (run 2: centre was exact, flashd's status stayed empty) -- pointer evidence:"
    # every input device the kernel has, by name and handler (event node);
    # the PS/2 mouse q35 always carries should be here beside the tablet.
    ask 'grep "^N:\|^H:\|^B: EV" /proc/bus/input/devices | sed s/^/MG-INPUT:/' "10+0" 15
    ask 'ls -l /dev/input | sed s/^/MG-NODES:/' "11+0" 15
    # labwc's own account of what libinput added. /run/labwc.log is veron's
    # after device-nodes ran; if it is not, that is reported, not hidden.
    ask 'grep -i "adding\|pointer\|tablet\|mouse\|libinput\|seat" /run/labwc.log 2>&1 | tail -12 | sed s/^/MG-LABWC:/' "12+0" 15
    grep -a "MG-INPUT:\|MG-NODES:\|MG-LABWC:" "$SER" | grep -av "sed s/^/MG-" | sed 's/^/    /'
    # ROUTE 2: THE KEYBOARD. FLTK traverses focus in creation order; the
    # window comes up with focus on "Download latest release" (the dotted
    # focus box in 02-flasher-armed.png), and the skipped, deactivated
    # "Write + verify" is not a stop. Nine Tabs reach the button; Space fires
    # it. If focus started one widget off, a Shift+Tab or a Tab and another
    # Space corrects it -- the only other things those can land on are the
    # empty confirm box (a typed space) and the text pane (nothing).
    note "trying the keyboard route: Tab x9 to the button, Space"
    _m=$(mark)
    mon "--keys=tab,tab,tab,tab,tab,tab,tab,tab,tab,spc" >/dev/null
    if arm_wait 20 "$_m"; then
        ok "keyboard route armed maintenance mode (Tab x9, Space) -- the pointer route is the defect to fix"
    else
        _m=$(mark)
        mon "--keys=shift-tab,spc" >/dev/null
        if arm_wait 15 "$_m"; then
            ok "keyboard route armed maintenance mode (Tab x8) -- the pointer route is the defect to fix"
        else
            _m=$(mark)
            mon "--keys=tab,tab,spc" >/dev/null
            if arm_wait 15 "$_m"; then
                ok "keyboard route armed maintenance mode (Tab x10) -- the pointer route is the defect to fix"
            else
                bad "neither the pointer nor the keyboard armed maintenance mode"
                note "flashd's status, as the flasher saw it:"
                ask 'cat /run/veron-flash/status | sed s/^/MG-ST:/' "8+0" 15
                grep -a "MG-ST:" "$SER" | grep -av "sed s/^/MG-ST" | sed 's/^/    /'
                snapshot 02b-flasher-after-keys.png
                cleanup; exit 1
            fi
        fi
    fi
    # A DIFFERENT NAME, ON PURPOSE. This used to overwrite 02-flasher-armed.png,
    # which was taken right after the pointer click and is the only frame that
    # shows where the cursor actually went. By the time the keyboard route has
    # won, the machine has rebooted, so the overwrite replaced the cursor
    # evidence with a black "Display output is not active" frame -- on every
    # run, since the keyboard route wins every run. Runs 88364882265 and the
    # one after both lost the pointer answer to this.
    snapshot 02c-flasher-keyboard-armed.png
fi

# ======================= BOOT 2: maintenance ===============================
echo "=== boot 2: the reboot into RAM ==="
# The flasher asked flashd to arm; flashd wrote the marker; the flasher asked
# powerd to reboot; dinit rebooted; OVMF ran the loader again. The loader's
# own line is the first proof the marker was there and was taken.
wait_serial "veron-boot: maintenance command line armed" 90 \
    && ok "the loader found and took the one-shot marker" \
    || bad "no maintenance boot: the loader never reported an armed marker (did the click land? did flashd arm? did the reboot happen?)"
[ "$fail" = 0 ] || { grep -aE "ARMED|REFUSED|veron-flashd|veron-boot|reboot|shutdown" "$SER" | tail -20; cleanup; exit 1; }
wait_serial "Kernel command line:.*veron.maintenance=1|Command line:.*veron.maintenance=1" 30 \
    && ok "the kernel booted with veron.maintenance=1 on its command line" \
    || bad "the kernel's command line does not carry the maintenance flags (LoadOptions dropped? CMDLINE_OVERRIDE?)"
wait_serial "VERON-MAINTENANCE: entering maintenance mode" 30 \
    && ok "veron-maintenance-init is PID 1" \
    || bad "init= was not honoured: veron-maintenance-init never ran"
# THE PIVOT EITHER FINISHES OR HALTS, AND BOTH ARE ONE LINE. It takes seconds
# on KVM; two minutes is already generous. init's fatal() prints "ABORTED"
# the moment it gives up, and that ends the wait at once. While waiting,
# init's latest line is echoed so a stall is visible as the step it stalled on.
# FOLLOW THE PIVOT AS IT NARRATES. Each VERON-MAINTENANCE: line is printed
# the instant it lands; the wait ends on the terminal line (running from
# RAM, or ABORTED). One stream read, no tick, no re-scan. 120s watchdog.
_t0=$(date +%s.%N)
timeout 120 tail -n +1 -f "$SER" --pid="$qpid" 2>/dev/null \
  | grep -a --line-buffered "VERON-MAINTENANCE:" \
  | while IFS= read -r _now; do
        note "$(echo "$(date +%s.%N) - $_t0" | bc)s  $_now"
        case "$_now" in *"running from RAM"*|*ABORTED*) break ;; esac
    done
alive || note "qemu exited during the pivot"
if grep -aq "VERON-MAINTENANCE: running from RAM; the boot disk is released" "$SER"; then
    ok "the pivot completed and the stick was verified released (${_t}s)"
else
    bad "the pivot did not complete -- veron-maintenance-init said:"
    grep -a "VERON-MAINTENANCE" "$SER" | tail -20 | sed 's/^/    /'
fi
[ "$fail" = 0 ] || { cleanup; exit 1; }
# NO WAIT FOR THE DESKTOP HERE. The pivot's own last line is the event that
# matters; after it, open_flasher presses Super+Return until foot appears,
# which is the desktop announcing itself on the screen -- the only place a
# person sees it. A dinit-line wait sat here and twice failed a desktop that
# was up in seconds (its own baseline was wrong); it is gone.
pane=$(open_flasher) || { bad "could not open the flasher on the maintenance desktop"; snapshot 03-flasher-maintenance.png; desktop_evidence; tail -30 "$SER"; cleanup; exit 1; }
snapshot 03-flasher-maintenance.png
ok "boot 2: desktop, foot, veron-flasher in MAINTENANCE mode -- 03-flasher-maintenance.png"

# ---- the facts behind the frame ------------------------------------------
echo "=== the facts the third frame shows, read from the same machine ==="
prompt
ask 'echo "MG-CMDLINE $(cat /proc/cmdline)"' "1+0" 20
ask 'echo "MG-ROOT $(awk '"'"'$2=="/"{print $3}'"'"' /proc/mounts)"' "2+0" 20
ask 'echo "MG-OLDROOT $(grep -c oldroot /proc/mounts)"' "3+0" 20
ask 'for b in /sys/block/*; do echo "MG-BLOCK ${b##*/} removable=$(cat $b/removable)"; done' "4+0" 20
ask 'echo "MG-PERSIST $(grep " /persist " /proc/mounts | grep -c "^/dev/") $(grep " /persist " /proc/mounts | cut -d" " -f1,3 | head -1)"' "5+0" 20
ask 'echo "MG-HOME $(grep " /home/veron " /proc/mounts | cut -d" " -f1,3 | head -1) testy=$([ -e ~/veron-gate-testy ] && echo present || echo MISSING)"' "13+0" 20
ask 'cat /run/veron-flash/status | sed s/^/MG-FLASHD:/' "6+0" 20
ask 'cat /run/veron-maintenance.log | sed s/^/MG-LOG:/' "7+0" 20
grep -a "MG-" "$SER" | grep -av 'echo "MG-\|sed s/^/MG-\|VERON-MG-' | sed 's/^/    /'

grep -aq "MG-CMDLINE .*veron.maintenance=1" "$SER" \
    && ok "cmdline carries veron.maintenance=1 (what the flasher and flashd read)" \
    || bad "the running cmdline lacks veron.maintenance=1"
grep -aq "MG-ROOT tmpfs" "$SER" \
    && ok "/ is a tmpfs -- the system is in RAM" \
    || bad "/ is not a tmpfs"
grep -aq "MG-OLDROOT 0" "$SER" \
    && ok "nothing remains mounted from the old root" \
    || bad "the old root is still in the mount table"
grep -aq "MG-PERSIST 0" "$SER" \
    && ok "/persist is not mounted from the stick ($(grep -a 'MG-PERSIST 0' "$SER" | grep -av 'echo "MG-PERSIST' | tail -1 | cut -d' ' -f3-))" \
    || bad "/persist is mounted from the stick during maintenance -- the flasher would write under a live filesystem"
grep -aq "MG-HOME .*testy=present" "$SER" \
    && ok "the file left in ~ on the normal boot is in ~ in maintenance mode -- the user's persist is there, from RAM" \
    || bad "the user's persist is NOT in maintenance mode: ~/veron-gate-testy missing ($(grep -a 'MG-HOME' "$SER" | grep -av 'echo "MG-HOME' | tail -1))"
grep -aq "MG-BLOCK sd[a-z] removable=1" "$SER" \
    && ok "the USB stick is present as a removable block device -- the list the flasher builds" \
    || bad "no removable block device: the stick is not something the flasher would list"
grep -aq "MG-FLASHD:veron-flashd: maintenance mode -- the boot device is a legal target" "$SER" \
    && ok "flashd itself reports maintenance mode: the boot device is a legal target" \
    || bad "flashd did not enter maintenance mode"
grep -aq "MG-LOG:.*running from RAM" "$SER" \
    && ok "/run/veron-maintenance.log is readable from the running system" \
    || bad "the maintenance log is missing from /run (hidden by a later tmpfs mount?)"

cleanup

# ---- the boot timelines -----------------------------------------------------
# Seconds from the kernel's handoff to init until each desktop part reported,
# per boot. This is the number "the boot feels slow" turns into.
echo "=== boot timelines (seconds after the kernel started init) ==="
python3 - "$SER.timed" <<'PY'
import re, sys
lines = open(sys.argv[1], errors="replace").read().splitlines()
marks = [("init",  r"Run /usr/bin/veron-(maintenance-)?init as init process"),
         ("early-filesystems", r"OK  \] early-filesystems"),
         ("hotplug", r"OK  \] hotplug"),
         ("labwc",   r"OK  \] labwc"),
         ("yambar",  r"OK  \] yambar"),
         ("swaybg",  r"OK  \] swaybg"),
         ("boot complete", r"OK  \] boot")]
boots, cur = [], None
for l in lines:
    m = re.match(r"\[\s*([0-9.]+)\] (.*)", l)
    if not m: continue
    t, body = float(m.group(1)), m.group(2)
    if re.search(marks[0][1], body):
        cur = {"init": t}; boots.append(cur); continue
    if cur is None: continue
    for name, pat in marks[1:]:
        if name not in cur and re.search(pat, body): cur[name] = t
for i, b in enumerate(boots, 1):
    t0 = b["init"]
    print("  boot %d:" % i, "  ".join("%s +%.1fs" % (n, b[n]-t0) for n, _ in marks[1:] if n in b))
    missing = [n for n, _ in marks[1:] if n not in b]
    if missing: print("  boot %d: never reported: %s" % (i, ", ".join(missing)))
PY
# SERVICE FAILURES FAIL THE GATE. A boot that reaches the desktop but leaves a
# service [FAILED], calls a missing binary, or crash-loops a helper is NOT a
# passing boot -- a green light over those is a false assurance (this section
# once printed them under the heading "noise", which was wrong and hid real
# maintenance-mode defects). Each distinct problem is listed and counted, and
# its presence sets the gate to FAIL.
_problems=$(grep -aE "\[FAILED\]|No such file or directory|restarting too quickly|process terminated with exit code [1-9]" "$SER" \
            | sort | uniq -c | sort -rn | head -20)
if [ -n "$_problems" ]; then
    echo "  SERVICE FAILURES ON THE BOOT (these fail the gate):"
    printf '%s\n' "$_problems" | sed 's/^/    FAIL  /'
    bad "the boot left service failures above -- not a clean boot"
else
    ok "no service failures, missing binaries, or crash-loops on either boot"
fi

after_sha=$(sha256sum "$IMG" | cut -d' ' -f1)
note "image after:  $after_sha"
[ "$before_sha" = "$after_sha" ] \
    && ok "the backing image is unchanged (two boots, one marker, all in the snapshot overlay)" \
    || bad "the gate MUTATED the image: a boot wrote through to the backing file"

if [ "$fail" = 0 ]; then
    echo "VERON-MAINTENANCE-GATE-OK  normal desktop -> flasher -> button -> reboot into RAM -> flasher sees the stick"
    exit 0
fi
echo "VERON-MAINTENANCE-GATE-FAIL  see the ok/FAIL lines above, the three PNGs and maintenance-serial.log"
exit 1
