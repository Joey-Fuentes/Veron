#!/usr/bin/env python3
# veron-site -- generate the whole storefront from a release manifest.
#
# THE SITE IS A FUNCTION OF ALL CURRENT RELEASES (ruled): stage 6 hands
# this tool one manifest describing every architecture's current release,
# and the ENTIRE site is regenerated -- no partial updates exist. Output:
#   site/index.html     the page: downloads, verify, the honest asterisks
#   site/index.json     the machine endpoint veron-update and About consume
#   site/SHA256SUMS     full digests, the file sha256sum -c reads
#
# ZERO EXTERNAL ASSETS, ON PURPOSE. No font CDN, no framework, no
# analytics, no second request: a project whose claim is "nothing
# borrowed" does not load its homepage from other people's servers. One
# HTML file, styles inlined, system fonts -- the page itself is auditable
# the same way the OS is.
#
# manifest.json shape (input):
# { "commit": "<full sha>", "generated": "<runid>",
#   "arches": { "x86_64": {
#       "release_tag": "release/<commit7>",
#       "assets": [ {"name","sha256","size","kind":"img|iso|sums|prov"} ],
#       "attestation_url": "...", "kernels": {"minimal":"sha","generic":"sha"} } } }
import argparse, html, json, os, sys

def human(n):
    for u in ("bytes", "KiB", "MiB", "GiB"):
        if n < 1024 or u == "GiB":
            return f"{n:.1f} {u}" if u != "bytes" else f"{n} bytes"
        n /= 1024.0

