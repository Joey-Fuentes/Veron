LADDER = """<span class="dim">$</span> veron-trace /usr/bin/foot
usr/bin/foot   sha256 36acaaef…   <span class="ok">[matches the bytes on disk]</span>

  built by   foot 1.27.0          [stage 5]
  built with the stage-4 toolchain
             gcc 15.2.0 &lt;- gcc 10.2.0 &lt;- gcc 4.7.4 &lt;- tcc

  <b>3/6/tcc-amd64</b>            090429cf…   [x86_64]
  <b>3/5/tcc-arm64-to-amd64</b>   f1f58aee…   [x86_64]
  <b>3/4/tcc-arm64</b>            4cc4343a…   [aarch64]  &lt;- crosses architectures
  <b>3/3/hex2</b>                 0b85f9ce…   [aarch64]
  <b>2/2/pico-c</b>               1305e1c9…   [aarch64]
  <b>1/1/self-assembler</b>       e97e2969…   [aarch64]
  <span class="ok">ROOT REACHED</span>  1/1/self-assembler assembles itself"""

def render_releases(m):
    """upstream.html -- every GitHub release, one table, linked. The point
    is that a stranger can survey the ENTIRE ladder -- 150+ releases of
    stages, checkpoints and kernels -- without learning the GitHub UI:
    tag, what it is, its assets, one click to the release itself where
    the attestations and digests live."""
    rows = []
    for r in m.get("upstream_releases", []):
        assets = ", ".join(html.escape(a) for a in r.get("assets", [])[:8])
        more = len(r.get("assets", [])) - 8
        if more > 0:
            assets += f" … +{more}"
        rows.append(f"""<tr><td class="mono"><a href="{html.escape(r['url'])}">{html.escape(r['tag'])}</a></td>
<td>{html.escape(r.get('title',''))}</td><td class="mono dim">{assets}</td></tr>""")
    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Veron — every release</title><style>{CSS}
table{{width:100%;border-collapse:collapse;font-size:.86rem}}
td,th{{padding:8px 10px;border-bottom:1px solid var(--rule);text-align:left;
vertical-align:top}}th{{color:var(--amber);font-family:var(--mono)}}</style>
</head><body><main>
<h1>every release</h1>
<p class="tag"><a href="index.html">← downloads</a> · the whole ladder as
published: every stage, checkpoint and kernel, each with its digests and
attestation on its release page.</p>
<table><tr><th>tag</th><th>what it is</th><th>assets</th></tr>
{"".join(rows)}</table>
<footer>generated from commit {html.escape(m["commit"])}</footer>
</main></body></html>"""

def render_licenses(m):
    lic = m.get("licenses", {})
    pkgs = lic.get("packages", [])
    by = {}
    for p in pkgs:
        by.setdefault(p["license"], []).append(f'{p["name"]} {p["version"]}')
    groups = []
    for name in sorted(by):
        items = ", ".join(html.escape(x) for x in sorted(by[name]))
        groups.append(f'<div class="card"><h3>{html.escape(name)}</h3>'
                      f'<div class="meta">{items}</div></div>')
    fw = lic.get("firmware")
    fw_html = ("<p>Firmware blobs are pinned by digest in "
               "<span class='mono'>sources/firmware.toml</span> and ship "
               "INSIDE the image at <span class='mono'>usr/lib/firmware</span> "
               "with their license files beside them. The per-blob listing "
               "renders here once the image build absorbs them "
               "(in progress; stated, not hidden).</p>"
               if not fw else
               "".join(f'<div class="card"><h3>{html.escape(f["name"])}</h3>'
                       f'<div class="meta">{html.escape(f["license"])}</div></div>'
                       for f in fw))
    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Veron — licenses</title><style>{CSS}</style></head><body><main>
<h1>licenses</h1>
<p class="tag"><a href="index.html">← downloads</a> · every package's
license, from the build records themselves; sources for everything are
pinned in the repository and mirrored forever.</p>
<h2>packages ({len(pkgs)})</h2>
{"".join(groups)}
<h2>firmware</h2>
{fw_html}
<footer>generated from commit {html.escape(m["commit"])}</footer>
</main></body></html>"""

def render(m):
    commit = m["commit"]
    parts = [f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Veron</title><style>{CSS}</style></head><body><main>
<h1>Veron</h1>
<p class="tag">a Linux distribution built from source, from a seed —
every byte traceable to 3,720 bytes of hand-written assembly.</p>
<div class="ladder">{LADDER}</div>
<p>That trace runs <em>on the installed system</em>, offline. Every file,
every symlink, every build command, back to the root of trust — and the
verifier is a shell script you can read on the machine it verifies.</p>
"""]
    parts.append('<h2>download</h2>')
    parts.append('<p class="req">x86_64 &nbsp;·&nbsp; UEFI only &nbsp;·&nbsp; '
                 'disable Secure Boot</p>')
    consumer = {a: r for a, r in m.get("arches", {}).items()
                if any(x["kind"] in ("img", "iso") and not
                       x["name"].endswith(".NOBOOT.img") for x in r["assets"])}
    if not consumer:
        # AN EMPTY DOWNLOAD SECTION IS A STATEMENT, NOT A GAP: consumer
        # images publish only after they boot under the gate. Meanwhile
        # the developer artifacts below are real, verified and attested.
        parts.append('<div class="card"><h3>consumer images: not yet</h3>'
            '<div class="meta">The bootable disk image and live ISO publish '
            'here once they pass the boot gate. Everything the project has '
            'shipped so far is below, verified and attested.</div></div>')
    for arch, rel in sorted(consumer.items()):
        for a in rel["assets"]:
            if a["kind"] not in ("img", "iso"):
                continue
            what = ("Disk image — write to a USB stick or drive; boots to a "
                    "complete system on the A/B layout. The automatic updater "
                    "and persistent-home service are in development — today, "
                    "what you write is what runs" if a["kind"] == "img" else
                    "Live ISO — try Veron without installing; works burned, "
                    "dd'd, or dropped onto a Ventoy stick")
            parts.append(f"""<div class="card">
<h3>{html.escape(a["name"])}</h3>
<div class="meta">{html.escape(what)} · {human(a["size"])} · {html.escape(arch)}</div>
<div class="sha">sha256 {html.escape(a["sha256"])}</div>
<a class="btn" href="https://github.com/Joey-Fuentes/Veron/releases/download/{html.escape(rel["release_tag"])}/{html.escape(a["name"])}">Download</a>
<a class="btn quiet" href="{html.escape(rel["attestation_url"])}">Attestation</a>
</div>""")
        parts.append(f'<p class="tag">release {html.escape(rel["release_tag"])} '
                     f'· commit {html.escape(commit[:7])} · '
                     f'<a href="SHA256SUMS">SHA256SUMS</a> · '
                     f'<a href="index.json">index.json</a></p>')

    # ---- developer downloads: the stage releases, fully linked --------
    dev = m.get("developer", [])
    if dev:
        parts.append('<h2>developer downloads</h2>')
        parts.append('<p>The stage artifacts the project itself builds '
            'from: each release page carries every asset, its digests and '
            'its Sigstore attestation. These are consumed with the '
            'repository\'s own tooling, not written to a stick.</p>')
        for d in dev:
            assets = "".join(
                f'<div class="sha">{html.escape(a["name"])}  ·  '
                f'{human(a["size"])}  ·  sha256 {html.escape(a["sha256"])}</div>'
                for a in d.get("assets", []) if a.get("sha256"))
            parts.append(f"""<div class="card">
<h3>{html.escape(d["tag"])}</h3>
<div class="meta">{html.escape(d["desc"])}</div>
{assets}
<a class="btn quiet" href="{html.escape(d["url"])}">Release page</a>
<a class="btn quiet" href="https://github.com/Joey-Fuentes/Veron/attestations">Attestations</a>
</div>""")
        parts.append('<p class="tag"><a href="upstream.html">every release '
            'ever published →</a> · <a href="licenses.html">licenses →</a></p>')

    parts.append(f"""<h2>verify</h2>
<p>Three checks, strongest last. The digest proves the bytes; the
attestation proves the builder; the trace proves the ancestry.</p>
<pre>sha256sum -c SHA256SUMS --ignore-missing

gh attestation verify veron-*.img -R Joey-Fuentes/Veron

# on the running system, offline:
veron-trace --verify --hash-files --strays --root /</pre>

<h2>flash</h2>
<p>Copy-paste on any Linux machine — the commands resolve the current
release's filename themselves:</p>
<pre>cd ~/Downloads
curl -LO "https://github.com/Joey-Fuentes/Veron/releases/download/6/latest/SHA256SUMS"
IMG=$(grep -o 'veron-x86_64-[0-9a-f]*[.]img[.]zst' SHA256SUMS | head -1)
curl -LO "https://github.com/Joey-Fuentes/Veron/releases/download/6/latest/$IMG"
sha256sum -c SHA256SUMS --ignore-missing   # must print: OK
zstd -d "$IMG"

lsblk    # plug the stick in; the device that APPEARS is the stick
sudo dd if="${{IMG%.zst}}" of=/dev/sdX bs=4M conv=fsync status=progress</pre>
<p>The image is a whole-disk image: <span class="mono">of=</span> must be
the stick — writing an internal drive erases that machine's OS. Then
reboot, open the firmware boot menu (F9 on HP), pick the stick's UEFI
entry. Secure Boot off. No bootloader appears — the kernel is the boot
program, loaded from the path every UEFI firmware tries first.</p>
<p>Veron is x86_64 UEFI only. Signing, Secure Boot and TPM support are on
the roadmap; legacy BIOS is not.</p>

<h2>what is not from source</h2>
<p>Two things, stated rather than buried:</p>
<ul>
<li><b>Firmware blobs</b> in the generic kernel's tree — binary files no
one can build; each pinned by digest and listed with its license.</li>
<li><b>The stage-4 interior</b> of the trace is one coarse edge today
("substage records pending") — the compilers' ladder is attested and its
inputs pinned, but per-step records inside stage 4 are still being
written, and the tracer says so instead of pretending.</li>
</ul>

<h2>updates</h2>
<p>The design, shipping in stages: true A/B — an update writes the
inactive slot, verifies it by hash, and boots it exactly once; if the
new system doesn't prove itself, the firmware falls back to the
untouched old one, and your data lives on its own partition no update
ever touches. The disk layout for all of this is already in every
image. The automatic updater itself is in development; until it ships,
updating means writing the new image.</p>

<footer>generated from commit {html.escape(commit)} · run {html.escape(str(m.get("generated","")))}
· <a href="https://github.com/Joey-Fuentes/Veron">source</a>
· every artifact on this page is attested in the
<a href="https://github.com/Joey-Fuentes/Veron/attestations">public log</a></footer>
</main></body></html>""")
    return "".join(parts)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--manifest", required=True)
    ap.add_argument("--out", required=True)
    a = ap.parse_args()
    m = json.load(open(a.manifest))
    os.makedirs(a.out, exist_ok=True)
    open(os.path.join(a.out, "index.html"), "w").write(render(m))
    open(os.path.join(a.out, "upstream.html"), "w").write(render_releases(m))
    open(os.path.join(a.out, "licenses.html"), "w").write(render_licenses(m))
    json.dump(m, open(os.path.join(a.out, "index.json"), "w"), indent=1, sort_keys=True)
    with open(os.path.join(a.out, "SHA256SUMS"), "w") as f:
        for arch, rel in sorted(m["arches"].items()):
            for asset in rel["assets"]:
                f.write(f"{asset['sha256']}  {asset['name']}\n")
    print(f"veron-site: {a.out}/ regenerated for {len(m['arches'])} arch(es)")

if __name__ == "__main__":
    sys.exit(main())
