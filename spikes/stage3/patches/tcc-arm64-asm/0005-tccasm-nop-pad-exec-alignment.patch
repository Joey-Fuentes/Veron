Subject: [PATCH 5/3] tccasm: pad executable-section alignment with NOPs on arm64

Not part of the posted series -- ours, and required for the RESULT TO RUN.

tcc pads .align/.balign/.p2align with zero bytes unconditionally:

    v = 0;
    ...
    memset(ptr, v, size);

On x86 a run of zero bytes is harmless-ish filler. On arm64 a zero word is
UDF #0 -- permanently undefined -- so any padding that control FALLS THROUGH
raises SIGILL.

musl's memset.S does exactly that:

        sub     count, count, 128
        .p2align 4
    .Lzva_loop:
        add     dst, dst, 64
        dc      zva, dst

The padding is in the fall-through path, so a tcc-assembled memset faults the
moment that branch is taken. Observed as:

    Program received signal SIGILL
    => 0x400dac:  udf  #0
       0x400db0:  add  x3, x3, #0x40
       0x400db4:  dc   zva, x3
    #1 __init_libc  #2 __libc_start_main  #3 _start_c

Note the path is guarded by `mrs zva_val, dczid_el0; cmp zva_val, 4`, so
whether it executes depends on the CPU's ZVA block size. That is presumably
how "enough to compile musl 1.2.5" was true for the author and still produced
a libc that dies on startup here: compiling was never the same as running.

This fills implicit alignment padding in SHF_EXECINSTR sections with NOP
(0xd503201f), matching what GNU as does, and only when both the current
offset and the padding size are whole instructions. An explicit ",fill"
argument is still honoured verbatim.

Verified: memset.o's .text is unchanged in length, the UDF at 0xbc becomes a
NOP, and all 16 of musl 1.2.5's aarch64 asm files still assemble.
---
diff --git a/tccasm.c b/tccasm.c
index 92b8c79..8fc7279 100644
--- a/tccasm.c
+++ b/tccasm.c
@@ -491,12 +491,13 @@ static void pop_section(TCCState *s1)
     cur_text_section->prev = NULL;
     use_section1(s1, prev);
 }
 
 static void asm_parse_directive(TCCState *s1, int global)
 {
+    int do_nop_fill;
     int n, offset, v, size, tok1;
     Section *sec;
     uint8_t *ptr;
 
     /* assembler directive */
     sec = cur_text_section;
@@ -513,20 +514,22 @@ static void asm_parse_directive(TCCState *s1, int global)
         {
             if (n < 0 || n > 30)
                 tcc_error("invalid p2align, must be between 0 and 30");
             n = 1 << n;
             tok1 = TOK_ASMDIR_align;
         }
+        do_nop_fill = 0;
         if (tok1 == TOK_ASMDIR_align || tok1 == TOK_ASMDIR_balign) {
             if (n <= 0 || (n & (n-1)) != 0)
                 tcc_error("alignment must be a positive power of two");
             offset = (ind + n - 1) & -n;
             size = offset - ind;
             /* the section must have a compatible alignment */
             if (sec->sh_addralign < n)
                 sec->sh_addralign = n;
+            do_nop_fill = 1;
         } else {
 	    if (n < 0)
 	        n = 0;
             size = n;
         }
         v = 0;
@@ -536,12 +539,26 @@ static void asm_parse_directive(TCCState *s1, int global)
         }
     zero_pad:
         if (sec->sh_type != SHT_NOBITS) {
             sec->data_offset = ind;
             ptr = section_ptr_add(sec, size);
             memset(ptr, v, size);
+#ifdef TCC_TARGET_ARM64
+            /* Alignment padding in an EXECUTABLE section must be NOPs, not
+               zeroes: on arm64 a zero word is UDF #0, which faults if control
+               falls through the padding -- as it does in musl's memset.S,
+               where .p2align 4 sits between the count adjustment and the
+               .Lzva_loop head. Only for implicit fill (no ",fill" given) and
+               only when both the offset and the size are whole instructions. */
+            if (do_nop_fill && v == 0 && (sec->sh_flags & SHF_EXECINSTR)
+                && (ind & 3) == 0 && (size & 3) == 0) {
+                int nf; uint32_t *np = (uint32_t *)ptr;
+                for (nf = 0; nf < size / 4; nf++)
+                    write32le((unsigned char *)(np + nf), 0xd503201f);
+            }
+#endif
         }
         ind += size;
         break;
     case TOK_ASMDIR_quad:
 #ifdef TCC_TARGET_X86_64
 	size = 8;
