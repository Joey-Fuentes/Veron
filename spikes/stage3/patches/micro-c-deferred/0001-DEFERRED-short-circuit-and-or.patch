+/* SHORT-CIRCUIT && AND ||.
+ *
+ * These were general_recursion with a bitwise and/or, which evaluates BOTH
+ * sides and combines them. C does not permit that, and tcc depends on it not
+ * happening in forty-eight places of the form
+ *
+ *     if (esym && esym->st_shndx == SHN_UNDEF)
+ *     if (!sym || sym->type.t & VT_STATIC)
+ *
+ * where evaluating the right-hand side with a null left-hand side is a null
+ * dereference. Any of those is a segfault, and which one you hit depends on
+ * the path taken -- which is exactly the pattern seen here: two probes dying
+ * at different points after the same last successful call.
+ *
+ * The emitted shape:
+ *
+ *     &&                          ||
+ *     <left in R0>                <left in R0>
+ *     jump-if-zero  -> false      jump-if-zero  -> eval right
+ *     <right in R0>               R0 = 1
+ *     jump-if-zero  -> false      jump         -> end
+ *     R0 = 1                      <right in R0>
+ *     jump -> end                 jump-if-zero -> false
+ *     false: R0 = 0               R0 = 1; jump -> end
+ *     end:                        false: R0 = 0
+ *                                 end:
+ *
+ * The result is normalised to 0 or 1, which the bitwise version also did --
+ * every comparison feeding these already produces 0 or 1 -- so nothing
+ * downstream changes except that the right-hand side is no longer evaluated
+ * when the left-hand side settles it. */
+void logical_recursion(FUNCTION f, int is_and, char* name, FUNCTION iterate)
+{
+	require(NULL != global_token, "Received EOF in logical_recursion\n");
+	if(!match(name, global_token->s)) return;
+
+	char* number_string = int2str(current_count, 10, TRUE);
+	current_count = current_count + 1;
+	char* short_id = create_unique_id("SC_SHORT_", "l", number_string);
+	char* end_id = create_unique_id("SC_END_", "l", number_string);
+
+	/* SAVE x16 ACROSS THE BRANCHES.
+	 *
+	 * emit_jump_if_zero reaches a far label by loading it into REGISTER_TEMP
+	 * and branching through it. At STATEMENT level -- where if and while use
+	 * it -- that register is dead and nothing notices. Inside an EXPRESSION it
+	 * is not: micro-c's call sequence holds the callee's new base pointer in
+	 * x16 between `mov_x16,x18` and `mov_x17,x16`, so a && appearing in an
+	 * ARGUMENT LIST destroyed it and the callee ran with a garbage frame.
+	 *
+	 * That is what the first version of this did, and it broke tcc_new -- a
+	 * function whose arguments are full of conditions -- while leaving every
+	 * simple test passing.
+	 *
+	 * Both paths through the sequence reach the end label, so one save and one
+	 * restore covers them: pushed here, popped after END, and balanced no
+	 * matter which branch is taken. */
+	emit_push(REGISTER_TEMP, "protect the temp register across &&/||");
+
+	/* Left operand is already in REGISTER_ZERO. */
+	if(is_and)
+	{
+		emit_jump_if_zero(REGISTER_ZERO, "", short_id, "&& left is false");
+	}
+	else
+	{
+		emit_jump_if_not_zero(REGISTER_ZERO, "", short_id, "|| left is true");
+	}
+
+	require_extra_token();
+	f();
+
+	if(is_and)
+	{
+		emit_jump_if_zero(REGISTER_ZERO, "", short_id, "&& right is false");
+		emit_load_immediate(REGISTER_ZERO, TRUE, "both true");
+	}
+	else
+	{
+		emit_jump_if_not_zero(REGISTER_ZERO, "", short_id, "|| right is true");
+		emit_load_immediate(REGISTER_ZERO, FALSE, "neither true");
+	}
+	emit_unconditional_jump("", end_id, "skip the short-circuit result");
+
+	emit_label("", short_id);
+	if(is_and) emit_load_immediate(REGISTER_ZERO, FALSE, "&& short-circuited");
+	else emit_load_immediate(REGISTER_ZERO, TRUE, "|| short-circuited");
+
+	emit_label("", end_id);
+	emit_pop(REGISTER_TEMP, "restore the temp register after &&/||");
+	iterate();
+}
+
