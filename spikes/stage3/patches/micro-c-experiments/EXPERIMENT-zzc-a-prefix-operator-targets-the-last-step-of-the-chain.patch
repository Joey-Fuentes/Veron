-	if((!match("=", global_token->s) && !is_compound_assignment(global_token->s) && !is_postfix_operator && (register_size >= i->size) && !member_is_array && (TRUE != Address_of)))
+	/* THE LAST STEP OF THE CHAIN IS THE LVALUE, AND ONLY THE LAST.
+	 *
+	 * A prefix ++/-- wants the ADDRESS of its target. is_postfix_operator
