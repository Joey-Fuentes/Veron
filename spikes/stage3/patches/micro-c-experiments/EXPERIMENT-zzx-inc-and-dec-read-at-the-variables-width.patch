+		if(NULL != current_target && register_size >= current_target->size)
+		{
+			emit_out(load_value(current_target->size, current_target->is_signed));
+		}
+		else
+		{
+			emit_dereference(REGISTER_ZERO, "Deref to get value");
+		}
 
