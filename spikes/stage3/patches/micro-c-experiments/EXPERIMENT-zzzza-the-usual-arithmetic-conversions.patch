+	 * reached rung 6.
+	 *
+	 * emit_usual_arithmetic_conversion has always had this guard; this function
+	 * was written from it and the one line did not carry over. */
+	if(4 != current_target->size) return;
+
+	emit_narrowing_cast(current_target);
