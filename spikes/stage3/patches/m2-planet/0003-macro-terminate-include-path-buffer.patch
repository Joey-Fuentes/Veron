From: Veron
Subject: [PATCH] cc_macro: terminate the include path buffer, so -I past the first works

copy_string copies characters and returns the count. It does NOT write a NUL --
every caller has to remember. The -I search loop and the M2libc fallback did
not, and both reuse ONE buffer across attempts, so any path shorter than a
previous attempt inherited that attempt's tail. Only the FIRST -I ever worked.

--- a/cc_macro.c
+++ b/cc_macro.c
@@ -677,7 +677,12 @@ void handle_include(void)
 		offset = copy_string(buffer, inc->path, MAX_STRING);
 		buffer[offset] = '/';
 		offset = offset + 1;
-		copy_string(buffer + offset, include_filename, MAX_STRING - offset);
+		offset = offset + copy_string(buffer + offset, include_filename, MAX_STRING - offset);
+		/* TERMINATE IT. copy_string copies and counts; it does not write a NUL.
+		 * One buffer is reused for every -I in turn, so any path shorter than a
+		 * previous attempt inherits that attempt's tail and fopen is handed
+		 * garbage -- in effect only the FIRST -I ever worked. */
+		buffer[offset] = 0;
 
 		f = fopen(buffer, "r");
 
@@ -688,7 +693,8 @@ void handle_include(void)
 	{
 		/* If all else fails, try to look in M2libc in the CWD */
 		offset = copy_string(buffer, "./M2libc/", MAX_STRING);
-		copy_string(buffer + offset, include_filename, MAX_STRING - offset);
+		offset = offset + copy_string(buffer + offset, include_filename, MAX_STRING - offset);
+		buffer[offset] = 0;   /* same reason as above */
 		f = fopen(buffer, "r");
 	}
 
