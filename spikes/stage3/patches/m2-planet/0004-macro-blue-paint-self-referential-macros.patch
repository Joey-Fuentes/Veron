From: Veron
Subject: [PATCH] cc_macro: blue paint -- a macro name in its own expansion is not re-expanded

C does not re-expand a macro name appearing inside its own expansion. tcc.h
relies on it thirteen times. M2-Planet expanded forever:

    #define WRAP(x) ((s)->x)
    #define total_bytes WRAP(total_bytes)
    int main(){ total_bytes = 1; return 0; }        ->  hangs

CARRYING THE FLAG TOOK THREE ATTEMPTS -- this file has TWO independent
field-by-field token copies and each silently drops a field not listed in it.

--- a/cc.h
+++ b/cc.h
@@ -140,6 +140,10 @@ struct token_list
 	int linenumber;
 	int array_modifier;
 	int options;
+	/* BLUE PAINT. Set on a token that names the macro currently being
+	 * expanded, so it is never expanded again. C requires this: a macro name
+	 * appearing in its own expansion is not re-expanded. */
+	int no_expand;
 };
 
 struct case_list
--- a/cc_macro.c
+++ b/cc_macro.c
@@ -127,6 +127,9 @@ struct token_list* insert_tokens(struct token_list* point, struct token_list* to
 		copy->s = token->s;
 		copy->filename = token->filename;
 		copy->linenumber = token->linenumber;
+		/* Carry the paint. This file has TWO independent field-by-field token
+		 * copies and each silently drops any field not enumerated in it. */
+		copy->no_expand = token->no_expand;
 
 		if(NULL == first)
 		{
@@ -965,6 +968,7 @@ struct token_list* deep_copy_token_list(struct token_list* from)
 	to->arguments = from->arguments;
 	to->depth = from->depth;
 	to->linenumber = from->linenumber;
+	to->no_expand = from->no_expand;   /* see insert_tokens */
 
 	return to;
 }
@@ -978,6 +982,14 @@ struct token_list* maybe_expand(struct token_list* token)
 		exit(EXIT_FAILURE);
 	}
 
+	/* PAINTED TOKENS ARE NOT MACRO INVOCATIONS. Without this, tcc.h's
+	 * thirteen self-referential defines expand forever:
+	 *     #define total_bytes TCC_STATE_VAR(total_bytes) */
+	if(token->no_expand)
+	{
+		return token->next;
+	}
+
 	struct macro_list* hold = lookup_macro(token);
 	if(NULL == token->next)
 	{
@@ -1118,6 +1130,18 @@ struct token_list* maybe_expand(struct token_list* token)
 		return token->next;
 	}
 
+	/* Paint every occurrence of this macro's own name in what is about to be
+	 * spliced, so the inner one can never be expanded. */
+	struct token_list* paint = expansion;
+	while(NULL != paint)
+	{
+		if(match(hold->symbol, paint->s))
+		{
+			paint->no_expand = TRUE;
+		}
+		paint = paint->next;
+	}
+
 	struct token_list* hold2 = insert_tokens(token, expansion);
 
 	return hold2->next;
