DEBUG ONLY -- NOT PART OF ANY BUILD.

Markers through tcc_set_output_type, with the final CONDITION SPLIT.

    T1  entered              T2/T3  system include path
    T4/T5  tccelf_new        T6/T7  library path
    T8/T9  tcc_split_path
    TD  about to evaluate output_type != TCC_OUTPUT_MEMORY
    TE  that operand survived; about to read s->nostdlib
    TF  both operands survived
    TA/TB  tccelf_add_crtbegin, only when the condition holds
    TC  about to return

WHY SPLIT IT. Every run so far ends at T9, which says the fault is in the
if -- and an if with two operands and an && between them is three things,
not one. A marker before a compound condition cannot say which part faulted,
and rounds were spent assuming it could.

    dies after TD   reading output_type, a plain parameter
    dies after TE   reading s->nostdlib, an unsigned char member
    dies after TF   the && itself, or the branch
    reaches TC      the condition is fine and the fault is the return

--- a/libtcc.c
+++ b/libtcc.c
@@ -971,12 +971,15 @@
     if (output_type == TCC_OUTPUT_EXE)
         output_type |= TCC_OUTPUT_DYN;
 #endif
+    write(2, "T1\n", 3);
     s->output_type = output_type;
 
     if (!s->nostdinc) {
         /* default include paths */
         /* -isystem paths have already been handled */
+        write(2, "T2\n", 3);
         tcc_add_sysinclude_path(s, CONFIG_TCC_SYSINCLUDEPATHS);
+        write(2, "T3\n", 3);
     }
 
     if (output_type == TCC_OUTPUT_PREPROCESS) {
@@ -985,7 +988,9 @@
     }
 
     /* add sections */
+    write(2, "T4\n", 3);
     tccelf_new(s);
+    write(2, "T5\n", 3);
 
     if (output_type == TCC_OUTPUT_OBJ) {
         /* always elf for objects */
@@ -994,7 +999,9 @@
     }
 
     if (!s->nostdlib_paths)
+        write(2, "T6\n", 3);
         tcc_add_library_path(s, CONFIG_TCC_LIBPATHS);
+        write(2, "T7\n", 3);
 
 #ifdef TCC_TARGET_PE
 # ifdef TCC_IS_NATIVE
@@ -1007,10 +1014,28 @@
 # endif
 #else
     /* paths for crt objects */
+    write(2, "T8\n", 3);
     tcc_split_path(s, &s->crt_paths, &s->nb_crt_paths, CONFIG_TCC_CRTPREFIX);
-    if (output_type != TCC_OUTPUT_MEMORY && !s->nostdlib)
-        tccelf_add_crtbegin(s);
+    write(2, "T9\n", 3);
+    {
+        /* SPLIT DELIBERATELY. Written as one condition, a fault could be
+         * either operand or the && between them, and the marker before it
+         * cannot say which. Each operand now gets its own. */
+        int cond_a;
+        int cond_b;
+        write(2, "TD\n", 3);
+        cond_a = (output_type != TCC_OUTPUT_MEMORY);
+        write(2, "TE\n", 3);
+        cond_b = !s->nostdlib;
+        write(2, "TF\n", 3);
+        if (cond_a && cond_b) {
+            write(2, "TA\n", 3);
+            tccelf_add_crtbegin(s);
+            write(2, "TB\n", 3);
+        }
+    }
 #endif
+    write(2, "TC\n", 3);
     return 0;
 }
 
