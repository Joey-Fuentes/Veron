DEBUG ONLY -- NOT PART OF ANY BUILD.

Markers through tcc_set_output_type, now including the return.

    T1  entered                T2/T3  system include path
    T4/T5  tccelf_new          T6/T7  library path
    T8/T9  tcc_split_path      TA/TB  tccelf_add_crtbegin (skipped when the
                                      output type is MEMORY)
    TC  the if is done, about to return

TC is the one that matters. The compile-only probe reaches T9, skips crtbegin
because its output type is MEMORY, and dies before its caller sees control
again. Either the if faults, the return faults, or something corrupted earlier
surfaces there -- and TC tells those apart.

--- a/libtcc.c
+++ b/libtcc.c
@@ -971,12 +971,15 @@
     if (output_type == TCC_OUTPUT_EXE)
         output_type |= TCC_OUTPUT_DYN;
 #endif
+    write(2, "T1\n", 3);
     s->output_type = output_type;
 
     if (!s->nostdinc) {
         /* default include paths */
         /* -isystem paths have already been handled */
+        write(2, "T2\n", 3);
         tcc_add_sysinclude_path(s, CONFIG_TCC_SYSINCLUDEPATHS);
+        write(2, "T3\n", 3);
     }
 
     if (output_type == TCC_OUTPUT_PREPROCESS) {
@@ -985,7 +988,9 @@
     }
 
     /* add sections */
+    write(2, "T4\n", 3);
     tccelf_new(s);
+    write(2, "T5\n", 3);
 
     if (output_type == TCC_OUTPUT_OBJ) {
         /* always elf for objects */
@@ -994,7 +999,9 @@
     }
 
     if (!s->nostdlib_paths)
+        write(2, "T6\n", 3);
         tcc_add_library_path(s, CONFIG_TCC_LIBPATHS);
+        write(2, "T7\n", 3);
 
 #ifdef TCC_TARGET_PE
 # ifdef TCC_IS_NATIVE
@@ -1007,10 +1014,15 @@
 # endif
 #else
     /* paths for crt objects */
+    write(2, "T8\n", 3);
     tcc_split_path(s, &s->crt_paths, &s->nb_crt_paths, CONFIG_TCC_CRTPREFIX);
+    write(2, "T9\n", 3);
     if (output_type != TCC_OUTPUT_MEMORY && !s->nostdlib)
+        write(2, "TA\n", 3);
         tccelf_add_crtbegin(s);
+        write(2, "TB\n", 3);
 #endif
+    write(2, "TC\n", 3);   /* the if is done; about to return */
     return 0;
 }
 
