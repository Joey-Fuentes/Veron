DEBUG: dump the state entering the external-symbol path.

The crash needs only

    int f(int);
    void g(void){ f(1); }

-- a call to a function DECLARED and not defined. A fixed prototype is enough;
variadic, escapes and string literals were all red herrings. It is
deterministic, 10/10 with and without ASLR, and it does not reproduce under
qemu-user: the same binary compiles that file cleanly there and emits a
structurally sound object. It cannot be reduced anywhere but the runner.

Knowing which STATEMENT faults still leaves what that statement was handed.
These print the arguments on entry to put_extern_sym2 and greloca -- before the
fault by construction, whatever it turns out to be -- and the symbol's own
name, so the log says which declared-but-undefined function is in hand.

NO `else` ANYWHERE IN IT, AND THAT IS NOT STYLE. instrument.py inserts a marker
after every statement, including a closing brace, so

    if (x) { a(); }
    else   { b(); }

becomes

    if (x) { a(); }
    write(2, "P19\n", 4);
    else   { b(); }

By the time micro-c reaches the `else` the if-statement is already complete, so
`else` starts a new statement, gets parsed as an expression, and is looked up
as an identifier. The first version of this patch had exactly that shape and
took the build down with

    tccgen.c:594: else is not a defined symbol

-- which is micro-c's generic unknown-identifier message, not a parser saying
"else without if". Debug code that will itself be instrumented has to be shaped
so it can be: two ifs, or a value printed instead of a branch. The safety of
the name lookup is printed as a number rather than chosen with an if, for that
reason.

The lookup is still guarded -- sym->v is range-checked against tok_ident before
table_ident is indexed -- because an out-of-range v is one of the things this is
hunting, and dereferencing it would crash the diagnostic instead of reporting
it.

write() and a hand-rolled formatter: a buffered line is lost when the process
dies, and the last line printed is the whole point.

A tcc-debug patch -- the micro-c copy only, never the control.

diff --git a/tccgen.c b/tccgen.c
index 6d42de6..bc5c35b 100644
--- a/tccgen.c
+++ b/tccgen.c
@@ -513,6 +513,50 @@ ST_FUNC void update_storage(Sym *sym)
 /* update sym->c so that it points to an external symbol in section
    'section' with value 'value' */
 
+
+/* DEBUG: dump the state on the way into the external-symbol path.
+ *
+ * The crash needs only `int f(int); void g(void){ f(1); }` -- a call to a
+ * function DECLARED and not defined. It does not reproduce under qemu-user,
+ * so it cannot be reduced off the runner. Knowing which STATEMENT faults
+ * still leaves what that statement was handed; these print the arguments on
+ * entry, which is before the fault by construction.
+ *
+ * EVERY BRANCH IS BRACED, ON PURPOSE. instrument.py inserts a marker after
+ * each statement, and an unbraced `if (x) a(); else b();` becomes
+ * `if (x) a(); marker; else b();` -- which is a syntax error, and it took the
+ * build down with "else is not a defined symbol". Debug code that is going to
+ * be instrumented has to be shaped so it can be.
+ *
+ * write() and a hand-rolled formatter: a buffered line is lost when the
+ * process dies, and the last line printed is the whole point. */
+static void dbg_num(const char *tag, long long v)
+{
+    char b[32]; int i = 0; int n = 0; long long x = v;
+    while (tag[n]) { n++; }
+    write(2, tag, n);
+    if (x < 0) { write(2, "-", 1); x = -x; }
+    if (x == 0) { write(2, "0", 1); }
+    else {
+        char d[32]; int j = 0;
+        while (x) { d[j] = 48 + (int)(x % 10); j = j + 1; x = x / 10; }
+        while (j) { j = j - 1; b[i] = d[j]; i = i + 1; }
+        write(2, b, i);
+    }
+    write(2, "\n", 1);
+}
+
+static void dbg_str(const char *tag, const char *s)
+{
+    int n = 0; int m = 0;
+    while (tag[n]) { n++; }
+    write(2, tag, n);
+    if (!s) { write(2, "(null)\n", 7); return; }
+    while (s[m] && m < 64) { m++; }
+    write(2, s, m);
+    write(2, "\n", 1);
+}
+
 ST_FUNC void put_extern_sym2(Sym *sym, int sh_num,
                             addr_t value, unsigned long size,
                             int can_add_underscore)
@@ -520,6 +564,31 @@ ST_FUNC void put_extern_sym2(Sym *sym, int sh_num,
     int sym_type, sym_bind, info, other, t;
     ElfSym *esym;
     const char *name;
+
+    write(2, "PES-enter\n", 10);
+    dbg_num("  sym=", (long long)sym);
+    dbg_num("  sh_num=", sh_num);
+    dbg_num("  value=", (long long)value);
+    dbg_num("  size=", (long long)size);
+    if (sym) {
+        dbg_num("  sym->v=", sym->v);
+        dbg_num("  sym->type.t=", sym->type.t);
+        dbg_num("  sym->c=", sym->c);
+        dbg_num("  sym->r=", sym->r);
+        dbg_num("  sym->type.ref=", (long long)sym->type.ref);
+        dbg_num("  tok_ident=", tok_ident);
+        /* TWO IFS, NO ELSE. instrument.py puts a marker after each statement
+         * INCLUDING a closing brace, so `} else {` becomes `} marker; else {`
+         * -- a syntax error that took the build down with "else is not a
+         * defined symbol". Debug code that will itself be instrumented must
+         * not contain an else at all. */
+        dbg_num("  name-lookup-safe=", sym->v >= TOK_IDENT
+                && sym->v - TOK_IDENT < tok_ident - TOK_IDENT
+                && table_ident != 0);
+        if (sym->v >= TOK_IDENT && sym->v - TOK_IDENT < tok_ident - TOK_IDENT && table_ident) {
+            dbg_str("  name=", table_ident[sym->v - TOK_IDENT]->str);
+        }
+    }
     char buf1[256];
 
     if (!sym->c) {
@@ -594,6 +663,15 @@ ST_FUNC void greloca(Section *s, Sym *sym, unsigned long offset, int type,
 {
     int c = 0;
 
+    write(2, "GRL-enter\n", 10);
+    dbg_num("  s=", (long long)s);
+    dbg_num("  sym=", (long long)sym);
+    dbg_num("  offset=", (long long)offset);
+    dbg_num("  type=", type);
+    dbg_num("  addend=", (long long)addend);
+    if (s) { dbg_num("  s->sh_num=", s->sh_num); }
+    if (sym) { dbg_num("  sym->c=", sym->c); }
+
     if (nocode_wanted && s == cur_text_section)
         return;
 
