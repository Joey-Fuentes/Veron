+    case TOK_ASM_oshst:
+        crm = 2;
+        break;
+    case TOK_ASM_osh:
+        crm = 3;
+        break;
+    case TOK_ASM_nshld:
+        crm = 5;
+        break;
+    case TOK_ASM_nshst:
+        crm = 6;
+        break;
+    case TOK_ASM_nsh:
+        crm = 7;
+        break;
+    case TOK_ASM_ishld:
+        crm = 9;
+        break;
+    case TOK_ASM_ishst:
+        crm = 10;
+        break;
+    case TOK_ASM_ish:
+        crm = 11;
+        break;
+    case TOK_ASM_ld:
+        crm = 13;
+        break;
+    case TOK_ASM_st:
+        crm = 14;
+        break;
+    case TOK_ASM_sy:
+        crm = 15;
+        break;
+    default:
+        expect("barrier limitation");
+    }
+
+    gen_le32(0xd50330bf | (crm << 8));
