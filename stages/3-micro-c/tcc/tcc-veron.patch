+{
+    int cond;
+    if (tok < TOK_ASM_eq || tok > TOK_ASM_lo) {
+        expect("condition code");
+    }
+    if (tok >= TOK_ASM_hs) {
+        cond = TOK_ASM_hs - tok + (TOK_ASM_cs - TOK_ASM_eq);
+    } else {
+        cond = tok - TOK_ASM_eq;
+    }
+    next();
+    return cond;
