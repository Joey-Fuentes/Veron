+static uint32_t copy_gpr_size_to_permitted_mask(uint32_t source, uint32_t general_mask) {
+    if (OPT_IS_X(source)) {
+        return general_mask & OPT_ANY_X;
+    } else {
+        return general_mask & OPT_ANY_W;
+    }
+}
