+static int asm_get_op_reg(Operand *op, unsigned permitted_mask)
+{
+    if (op->type & permitted_mask) {
+        if (OPT_IS_31(op->type)) {
+            return 31;
+        }
+        return op->reg;
+    }
+    tcc_error("unexpected operand");
+}
