# stages/4-toolchain-kernel/generic/veron-generic.fragment
#
# THE VERON DELTA for the generic kernel: applied on top of the pinned Arch
# base config with scripts/kconfig/merge_config.sh. Arch's config is the
# generic-hardware baseline (it tracks latest stable, so it exists FOR our
# kernel version); this fragment is everything Veron requires regardless of
# what the base drifts to. The gate file REQUIRED-CONFIGS checks the RESULT,
# so a base change that silently drops something we need fails the build.
#
# WHY EACH GROUP (research: live-ISO kernel, 2026-08; STAGE5.md hardware table):

# --- the live-boot spine: find the medium, mount the system ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
# =y, NOT =m, and machine #1 proved why (2026-08-16): guest/init mounts
# the overlay FROM THE INITRAMFS -- two files, no modules, nothing to
# autoload from -- and on failure falls through to the harness and powers
# off. The ro-base + tmpfs-upper overlay is Veron's boot model, not
# optional live-media plumbing: it rides in the spine.
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=m
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BLK_DEV_INITRD=y

# --- storage spine: BUILT IN, deliberately against distro habit. A
#     distro ships dracut to choreograph storage modules in an initramfs;
#     Veron has no such tool and wants none. =y costs a couple MB of
#     vmlinuz and buys a kernel that can reach ANY root or live medium
#     before a single module loads -- the initramfs's job shrinks to
#     "find medium, overlay, switch_root", and bare metal can mount an
#     ext4-on-nvme root with no initramfs plumbing at all. ---
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# --- early input: a keyboard must work before any module policy exists.
#     AND A POINTER IS INPUT -- machine #1 (2026-08-16) booted to a desktop
#     with a dead touchpad and a dead USB mouse, and the image's auth model
#     has no runtime root to modprobe them alive. The whole input stack
#     rides in the spine, as the proven laptop kernel always did; amdgpu
#     and wifi stay modular as the hotplug work's first customers. ---
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_HID_CORE=y
# the touchpad stack, whole, from the tree's own war story: AMD64.md
# ("Exactly the PINCTRL lesson, one layer down") and the spike's proven
# set_cfg block, spikes/stage4/bridge/sysroot-amd64.sh:1496 -- in 7.x the
# designware PLATFORM depends on the CORE rather than selecting it, so
# the core must be stated or olddefconfig discards the platform in silence
CONFIG_COMMON_CLK=y
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_GPIOLIB=y

# --- display: simpledrm drives the firmware framebuffer from boot;
#     native DRM drivers take over at module load (labwc needs DRM/KMS) ---
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m

# --- firmware loading: the full tree ships zstd-compressed on the medium;
#     the loader decompresses; NOTHING is compiled into vmlinuz
#     (CONFIG_EXTRA_FIRMWARE off: non-GPL blobs in a GPL image) ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- microcode: early-cpio, both vendors ---
CONFIG_MICROCODE=y

# --- wireless spine (drivers ride the Arch base; these must not drop) ---
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m

# --- compression. DECOMPRESSION support is in-kernel code and costs the
#     sysroot nothing: zstd firmware, zstd squashfs, zstd initramfs all
#     load fine. BUILD-time compression needs the zstd BINARY, which the
#     stage-4 sysroot does not carry yet -- so the kernel image is gzip and
#     modules are uncompressed IN THE BOX; stage 6 compresses modules at
#     packaging time. WHEN stage 4 gains zstd (LFS builds it one chapter
#     over), flip these two lines to KERNEL_ZSTD / MODULE_COMPRESS_ZSTD. ---
CONFIG_KERNEL_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y

# --- reproducibility ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# =========================================================================
# GENERIC HARDWARE SURFACE, v1. OWNED, NOT COPIED: the base is the pinned
# kernel's own x86_64 defconfig (arch/x86/configs/ inside linux-7.1.5 --
# already under our pin); everything below is Veron's editorial voice.
# Distro configs (Arch, Debian, Alpine) were read as REFERENCE ONLY.
# COVERAGE POLICY: a family earns its lines from evidence -- machine #0 is
# the CI qemu gate, machine #1 is the STAGE5.md laptop; new hardware adds
# lines when its lspci demands them, with the machine named in the comment.
# =========================================================================

# --- machine #0: the CI boot gate is a qemu guest ---
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=m
CONFIG_SCSI_VIRTIO=m
CONFIG_DRM_VIRTIO_GPU=m
# the stage-5 harness mounts its sysroot over virtio-9p and plugs a
# virtio keyboard; built in so the guest needs no module plumbing
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_VIRTIO_INPUT=y

# --- wifi families beyond machine #1's rtw89: the big five cover the
#     overwhelming majority of laptops in the field ---
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_BRCMFMAC=m

# --- wired: the common laptop/desktop NICs and usb dongles ---
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_USBNET=m

# --- sound: HDA spine (machine #1: ALC236) + SOF for modern laptop mics
#     + usb audio ---
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_RENOIR=m
CONFIG_SND_USB_AUDIO=m

# --- input breadth: any keyboard, any touchpad, any mouse ---
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_APPLE=m
CONFIG_HID_ELAN=m

# --- sandboxing: WebKit's bubblewrap web-process sandbox creates user
#     namespaces at spawn; defconfig leaves USER_NS off and the browser
#     dies in under a second (machine #1, 2026-08-16). The proven laptop
#     kernel set this explicitly (sysroot-amd64.sh set_cfg block) -- the
#     last gap the proven-vs-generic diff found. ---
CONFIG_USER_NS=y

# --- hotplug: the userspace has NO udev (libudev-zero, no daemon;
#     devtmpfs makes the nodes). veron-system's device-nodes script names
#     its own limit and its plan: "wiring busybox mdev as the kernel's
#     hotplug helper". That is the legacy /proc/sys/kernel/hotplug
#     mechanism, which modern kernels DEFAULT OFF -- without these lines
#     the planned fix hits a kernel with the mechanism compiled out.
#     (The netlink path needs nothing; it is unconditional.) ---
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- platform: power, type-c, thunderbolt, efi vars, webcam, bluetooth ---
CONFIG_X86_AMD_PSTATE=y
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB4=m
CONFIG_EFIVAR_FS=y
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
