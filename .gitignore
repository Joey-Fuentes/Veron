# Derived / build outputs — never committed
/build/
/result/
*.o
*.elf

# The official working tree (docs/DESIGN.md §2): derived state lives ONLY in
# these three — `git status` staying clean after a full build is itself a
# hermeticity check.
/in/
/out/

# Local caches
/.cache/
__pycache__/
*.pyc

# fetch-git / mirror scratch — artifacts live in releases, never in git
/dl/

# The box (stages/box.sh) and stage 4's scratch (stages/4-toolchain-kernel/
# build.sh): assembled per run, deleted freely, never committed. The rule
# above holds -- `git status` clean after every phase of every stage.
/box/
/box4/
/pins/
/tccsrc/
/lfs/
/rel/
/boot/
/toolchain/
/manifest/
/buildlogs/
/box5/
/box4g/
/dl-sysroot/
/boot-generic/
/spikes/stage5/sysroot/
/spikes/stage5/dl/
/spikes/stage5/build/
/spikes/stage5/dest/
/spikes/stage5/out/
/spikes/stage5/logs/
/dl-tools/
/veron-tools/
/box-pack.*/
